+	@GameTest(template = "shearing", timeoutTicks = 80)
+	public static void creativeCrateRefund(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var pos = helper.absolutePos(new BlockPos(2, 2, 2)).above(20);
+		helper.runAtTickTime(4, () -> {
+			for (int scenario = 0; scenario < 4; scenario++) {
+				level.setBlock(pos, Blocks.AIR.defaultBlockState(), 3);
+				level.setBlock(pos, com.simibubi.create.AllBlocks.CREATIVE_CRATE.getDefaultState(), 3);
+				var crate = (com.simibubi.create.content.logistics.crate.CreativeCrateBlockEntity) level.getBlockEntity(pos);
+				var filter = crate.getBehaviour(com.simibubi.create.foundation.blockEntity.behaviour.filtering.FilteringBehaviour.TYPE);
+				var player = helper.makeMockPlayer(scenario == 0 ? net.minecraft.world.level.GameType.SURVIVAL : net.minecraft.world.level.GameType.CREATIVE);
+				var held = com.simibubi.create.AllItems.FILTER.asStack();
+				var tag = new net.minecraft.nbt.CompoundTag(); tag.putInt("marker", 17);
+				held.set(net.minecraft.core.component.DataComponents.CUSTOM_DATA, net.minecraft.world.item.component.CustomData.of(tag));
+				player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, held);
+				var top = new net.minecraft.world.phys.Vec3(pos.getX()+.5, pos.getY()+.875, pos.getZ()+.5);
+				var hit = new net.minecraft.world.phys.BlockHitResult(top, net.minecraft.core.Direction.UP, pos, false);
+				filter.onShortInteract(player, net.minecraft.world.InteractionHand.MAIN_HAND, net.minecraft.core.Direction.UP, hit);
+				int handAfterSet = player.getMainHandItem().getCount();
+				int configuredCount = filter.getFilter().getCount();
+				System.out.println("CREATE_CRATE_FILTER_NBT " + filter.getFilter().saveOptional(level.registryAccess()));
+				if (scenario == 1) player.getInventory().setItem(1, player.getMainHandItem().copy());
+				if (scenario == 3) player.getInventory().setItem(1, filter.getFilter().copy());
+				System.out.println("CREATE_CRATE_COMPARISON " + scenario + " " + player.getInventory().getItem(1) + " " + filter.getFilter() + " " + ItemStack.isSameItemSameComponents(player.getInventory().getItem(1), filter.getFilter()));
+				player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, new ItemStack(Items.IRON_INGOT, 7));
+				filter.onShortInteract(player, net.minecraft.world.InteractionHand.MAIN_HAND, net.minecraft.core.Direction.UP, hit);
+				int returned = 0; boolean retained = false;
+				for (var stack : player.getInventory().items) if (stack.is(com.simibubi.create.AllItems.FILTER.get())) {
+					returned += stack.getCount();
+					var data = stack.get(net.minecraft.core.component.DataComponents.CUSTOM_DATA);
+					retained |= data != null && data.copyTag().getInt("marker") == 17;
+				}
+				System.out.printf("CREATE_CRATE_REFUND,%s,%d,%d,%d,%s,%d,%s%n", new String[]{"survival","creative_has_copy","creative_no_copy","creative_exact_copy"}[scenario], handAfterSet, configuredCount, returned, retained, player.getMainHandItem().getCount(), net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(filter.getFilter().getItem()));
+				if (configuredCount != 1 || returned != (scenario == 1 ? 2 : 1) || !retained || player.getMainHandItem().getCount() != 7 || !filter.getFilter().is(Items.IRON_INGOT) || handAfterSet != (scenario == 0 ? 0 : 1))
+					throw new IllegalStateException("Unexpected Creative Crate refund");
+			}
+			helper.succeed();
+		});
+	}
+
