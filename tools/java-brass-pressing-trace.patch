+	@GameTest(template = "wheat_milling", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
+	public static void brassHandPressing(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var horizontal = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var east = net.minecraft.core.Direction.EAST;
+		var motorState = AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, east);
+		BlockPos motorPos = new BlockPos(1, 11, 1);
+		BlockPos pressPos = new BlockPos(2, 11, 1);
+		BlockPos depotPos = pressPos.below(2);
+		level.setBlockAndUpdate(helper.absolutePos(motorPos), motorState);
+		level.setBlockAndUpdate(helper.absolutePos(pressPos),
+			AllBlocks.MECHANICAL_PRESS.getDefaultState().setValue(horizontal, east));
+		level.setBlockAndUpdate(helper.absolutePos(depotPos), AllBlocks.DEPOT.getDefaultState());
+		var motor = (com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity) helper.getBlockEntity(motorPos);
+		motor.generatedSpeed.setValue(128);
+		var press = (com.simibubi.create.content.kinetics.press.MechanicalPressBlockEntity) helper.getBlockEntity(pressPos);
+		var depot = (com.simibubi.create.content.logistics.depot.DepotBlockEntity) helper.getBlockEntity(depotPos);
+		depot.setHeldItem(new ItemStack(AllItems.BRASS_INGOT.get(), 2));
+		var sounds = new java.util.ArrayList<String>();
+		java.util.function.Consumer<net.neoforged.neoforge.event.PlayLevelSoundEvent.AtPosition> listen = event -> {
+			if (event.getLevel() != level || event.getSound() == null)
+				return;
+			var name = event.getSound().value().getLocation();
+			if (name.getPath().startsWith("mechanical_press_activation"))
+				sounds.add(String.format(java.util.Locale.ROOT, "%s/%.6f/%.6f",
+					name, event.getNewVolume(), event.getNewPitch()));
+		};
+		net.neoforged.neoforge.common.NeoForge.EVENT_BUS.addListener(listen);
+
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			if (!sounds.isEmpty()) {
+				System.out.printf(java.util.Locale.ROOT, "CREATE_DEPOT_PRESS_SOUND %d,%s%n",
+					tick, String.join(";", sounds));
+				sounds.clear();
+			}
+			var behaviour = press.getPressingBehaviour();
+			var nbt = depot.saveWithoutMetadata(level.registryAccess());
+			var held = depot.getHeldItem();
+			var output = nbt.getCompound("OutputBuffer").getList("Items", 10);
+			int buffered = 0;
+			for (int slot = 0; slot < output.size(); slot++)
+				buffered += output.getCompound(slot).getInt("count");
+			System.out.printf(java.util.Locale.ROOT, "CREATE_BRASS_PRESS %d %d %d %d %d %d %d %d %d %.6f%n",
+				tick, (int) press.getSpeed(), behaviour.running ? 1 : 0, behaviour.finished ? 1 : 0,
+				behaviour.mode.ordinal(), behaviour.runningTicks,
+				held.is(AllItems.BRASS_INGOT.get()) ? held.getCount() : 0,
+				held.is(AllItems.BRASS_SHEET.get()) ? held.getCount() : 0, buffered,
+				behaviour.getRenderedHeadOffset(.5f) * behaviour.mode.headOffset);
+			if (tick == 15)
+				level.setBlockAndUpdate(helper.absolutePos(motorPos), net.minecraft.world.level.block.Blocks.AIR.defaultBlockState());
+			if (tick == 21) {
+				level.setBlockAndUpdate(helper.absolutePos(motorPos), motorState);
+				var replacement = (com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity)
+					helper.getBlockEntity(motorPos);
+				replacement.generatedSpeed.setValue(128);
+			}
+			helper.assertTrue(tick >= 70, "Waiting for both press cycles");
+			helper.assertTrue(held.is(AllItems.BRASS_SHEET.get()) && buffered == 1, "Both sheets should remain on the depot");
+			net.neoforged.neoforge.common.NeoForge.EVENT_BUS.unregister(listen);
+		});
+	}
+
 }
