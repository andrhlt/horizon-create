+            final int fixtureSeed = seed;
+            final int tick = 4;
+            helper.runAtTickTime(tick, () -> {
+                System.setProperty("parity.tree.seed", Integer.toString(fixtureSeed));
+                for (BlockPos delta : BlockPos.betweenClosed(-12, -1, -12, 12, 24, 12))
+                    level.setBlock(origin.offset(delta), delta.getY() == -1 ? Blocks.DIRT.defaultBlockState() : Blocks.AIR.defaultBlockState(), 2);
+                var scenario = System.getenv().getOrDefault("ACACIA_FIXTURE_ENV", "clear");
+                if (scenario.equals("barriers")) {
+                    level.setBlock(origin.offset(0, 2, 0), Blocks.BEDROCK.defaultBlockState(), 2);
+                    level.setBlock(origin.offset(1, 4, 0), Blocks.STONE.defaultBlockState(), 2);
+                    level.setBlock(origin.offset(-2, 6, 0), Blocks.STONE.defaultBlockState(), 2);
+                    level.setBlock(origin.offset(2, 6, -2), Blocks.BEDROCK.defaultBlockState(), 2);
+                } else if (scenario.equals("canopy")) {
+                    level.setBlock(origin.offset(0, 2, 0), Blocks.BEDROCK.defaultBlockState(), 2);
+                    level.setBlock(origin.offset(0, 3, 0), Blocks.STONE.defaultBlockState(), 2);
+                    level.setBlock(origin.offset(-2, 7, -3), Blocks.STONE.defaultBlockState(), 2);
+                    level.setBlock(origin.offset(2, 7, -2), Blocks.BEDROCK.defaultBlockState(), 2);
+                } else if (scenario.equals("coarse")) {
+                    level.setBlock(origin.below(), Blocks.COARSE_DIRT.defaultBlockState(), 2);
+                } else if (scenario.equals("grass")) {
+                    level.setBlock(origin.below(), Blocks.GRASS_BLOCK.defaultBlockState(), 2);
+                } else if (scenario.equals("podzol")) {
+                    level.setBlock(origin.below(), Blocks.PODZOL.defaultBlockState(), 2);
+                } else if (scenario.equals("mud")) {
+                    level.setBlock(origin.below(), Blocks.MUD.defaultBlockState(), 2);
+                } else if (scenario.equals("mycelium")) {
+                    level.setBlock(origin.below(), Blocks.MYCELIUM.defaultBlockState(), 2);
+                } else if (scenario.equals("moss")) {
+                    level.setBlock(origin.below(), Blocks.MOSS_BLOCK.defaultBlockState(), 2);
+                } else if (scenario.equals("muddy_roots")) {
+                    level.setBlock(origin.below(), Blocks.MUDDY_MANGROVE_ROOTS.defaultBlockState(), 2);
+                }
+                var species = System.getenv().getOrDefault("TREE_FIXTURE_SPECIES", "acacia");
