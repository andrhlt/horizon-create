+    private static void captureAcacia(net.minecraft.server.level.ServerLevel level, BlockPos origin, int seed, int tick) {
+        System.out.printf("CREATE_ACACIA_SOIL,%d,%d,%s%n", seed, tick, level.getBlockState(origin.below()));
