+	private static BlockPos setupMountedComparator(CreateGameTestHelper helper, net.minecraft.world.level.block.Block expected) {
+		var level = helper.getLevel();
+		var port = helper.absolutePos(new BlockPos(4, 3, 2));
+		var comparator = port.east();
+		var wire = comparator.east();
+		helper.assertTrue(level.getBlockState(port).is(expected),
+			"Expected the stationary portable interface at " + port + " but found " + level.getBlockState(port));
+		level.setBlockAndUpdate(comparator.below(), Blocks.SMOOTH_STONE.defaultBlockState());
+		level.setBlockAndUpdate(wire.below(), Blocks.SMOOTH_STONE.defaultBlockState());
+		level.setBlockAndUpdate(wire, Blocks.REDSTONE_WIRE.defaultBlockState());
+		level.setBlockAndUpdate(comparator, Blocks.COMPARATOR.defaultBlockState().setValue(
+			net.minecraft.world.level.block.ComparatorBlock.FACING, net.minecraft.core.Direction.WEST));
+		return port;
+	}
+
+	private static boolean traceMountedComparator(CreateGameTestHelper helper, BlockPos port) {
+		var level = helper.getLevel();
+		var comparator = port.east();
+		var wire = comparator.east();
+		var psi = (com.simibubi.create.content.contraptions.actors.psi.PortableStorageInterfaceBlockEntity)
+			level.getBlockEntity(port);
+		var meter = (net.minecraft.world.level.block.entity.ComparatorBlockEntity) level.getBlockEntity(comparator);
+		int raw = psi.saveWithoutMetadata(level.registryAccess()).getInt("Timer");
+		int direct = psi.getBlockState().getAnalogOutputSignal(level, port);
+		int dust = level.getBlockState(wire).getValue(net.minecraft.world.level.block.RedStoneWireBlock.POWER);
+		System.out.printf("MOUNTED_PORT_COMPARATOR %d;%d;%b;%d;%d;%d%n",
+			helper.getTick(), raw, psi.canTransfer(), direct, meter.getOutputSignal(), dust);
+		return raw == 0 && meter.getOutputSignal() == 0 && dust == 0;
+	}
