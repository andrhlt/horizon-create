+package com.simibubi.create.infrastructure.gametest.tests;
+
+import com.simibubi.create.content.contraptions.elevator.ElevatorPulleyBlockEntity;
+import net.minecraft.core.BlockPos;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.event.tick.ServerTickEvent;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+@EventBusSubscriber
+public class JavaElevatorServerProbe {
+	private static boolean assembled;
+	@SubscribeEvent
+	public static void tick(ServerTickEvent.Post event) {
+		var signal = System.getProperty("parity.elevator.assemble");
+		if (signal == null || assembled || !Files.exists(Path.of(signal)))
+			return;
+		var level = event.getServer().overworld();
+		if (level.getBlockEntity(new BlockPos(8, 107, -9)) instanceof ElevatorPulleyBlockEntity pulley) {
+			pulley.clicked();
+			assembled = true;
+			System.out.println("LIVE_ELEVATOR clicked");
+		}
+	}
+}
