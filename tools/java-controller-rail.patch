+			world.setBlockAndUpdate(comparatorPos.below(), Blocks.STONE.defaultBlockState());
+			world.setBlockAndUpdate(far.below(), Blocks.STONE.defaultBlockState());
+			world.setBlockAndUpdate(far, leverState);
+			for (int dx = 0; dx <= 12; dx++)
+				world.setBlockAndUpdate(line.east(dx), rail);
+			world.setBlockAndUpdate(comparatorPos, Blocks.COMPARATOR.defaultBlockState()
+				.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING,
