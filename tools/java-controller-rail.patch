+			for (int dx = 0; dx <= 12; dx++) {
+				var at = line.east(dx);
+				world.setBlockAndUpdate(at, Blocks.AIR.defaultBlockState());
+				world.setBlockAndUpdate(at.north(), Blocks.AIR.defaultBlockState());
