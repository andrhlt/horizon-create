+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 45)
+	public static void controllerRailMinecarts(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var fixture = helper.absolutePos(new BlockPos(0, 7, 0));
+		var origin = new BlockPos(Math.floorDiv(fixture.getX(), 16) * 16 + 1, fixture.getY(),
+			Math.floorDiv(fixture.getZ(), 16) * 16 + 3);
+		var firstChunk = new net.minecraft.world.level.ChunkPos(origin);
+		var lastChunk = new net.minecraft.world.level.ChunkPos(origin.offset(12, 0, 9));
+		for (int cx = firstChunk.x - 1; cx <= lastChunk.x + 1; cx++)
+			for (int cz = firstChunk.z - 1; cz <= lastChunk.z + 1; cz++)
+				world.setChunkForced(cx, cz, true);
+		var controller = com.simibubi.create.AllBlocks.CONTROLLER_RAIL;
+		var shape = com.simibubi.create.content.redstone.rail.ControllerRailBlock.SHAPE;
+		var power = com.simibubi.create.content.redstone.rail.ControllerRailBlock.POWER;
+		var backwards = com.simibubi.create.content.redstone.rail.ControllerRailBlock.BACKWARDS;
+		var eastWest = net.minecraft.world.level.block.state.properties.RailShape.EAST_WEST;
+		var rail = controller.getDefaultState().setValue(shape, eastWest).setValue(backwards, true);
+		var settings = new int[] {15, 7, 0, 15};
+		var minecarts = new java.util.ArrayList<net.minecraft.world.entity.vehicle.AbstractMinecart>();
+		helper.runAtTickTime(1, () -> {
+			for (int rig = 0; rig < settings.length; rig++) {
+				var start = origin.south(rig * 3);
+				world.getEntitiesOfClass(net.minecraft.world.entity.vehicle.AbstractMinecart.class,
+					new net.minecraft.world.phys.AABB(start).expandTowards(12, 3, 0).inflate(2))
+					.forEach(entity -> entity.discard());
+				for (int dx = 0; dx <= 12; dx++) {
+					var at = start.east(dx);
+					world.setBlockAndUpdate(at, Blocks.AIR.defaultBlockState());
+					world.setBlockAndUpdate(at.below(), Blocks.STONE.defaultBlockState());
+				}
+				for (int end : new int[] {0, 12}) {
+					var source = start.east(end).north();
+					world.setBlockAndUpdate(source, Blocks.AIR.defaultBlockState());
+					world.setBlockAndUpdate(source.below(), Blocks.STONE.defaultBlockState());
+					if (settings[rig] == 15) {
+						world.setBlockAndUpdate(source, Blocks.REDSTONE_BLOCK.defaultBlockState());
+					} else if (settings[rig] == 7) {
+						var lever = com.simibubi.create.AllBlocks.ANALOG_LEVER.getDefaultState()
+							.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.ATTACH_FACE,
+								net.minecraft.world.level.block.state.properties.AttachFace.FLOOR);
+						world.setBlockAndUpdate(source, lever);
+						var entity = (com.simibubi.create.content.redstone.analogLever.AnalogLeverBlockEntity) world.getBlockEntity(source);
+						for (int click = 0; click < 7; click++)
+							entity.changeState(false);
+					}
+				}
+				for (int dx = 0; dx <= 12; dx++)
+					world.setBlockAndUpdate(start.east(dx), rail);
+			}
+		});
+		helper.runAtTickTime(5, () -> {
+			for (int rig = 0; rig < settings.length; rig++) {
+				var cart = net.minecraft.world.entity.EntityType.MINECART.create(world);
+				helper.assertTrue(cart != null, "could not create minecart");
+				var x = origin.getX() + (rig == 2 ? 4.15 : 4.5);
+				cart.moveTo(x, origin.getY() + .0625, origin.getZ() + .5 + rig * 3, 0, 0);
+				cart.setDeltaMovement(rig == 3 ? -0.18 : 0, 0, 0);
+				world.addFreshEntity(cart);
+				minecarts.add(cart);
+			}
+		});
+		helper.succeedWhen(() -> {
+			var tick = helper.getTick() - 5;
+			if (tick < 0)
+				helper.fail("waiting for minecarts");
+			for (int rig = 0; rig < minecarts.size(); rig++) {
+				var cart = minecarts.get(rig);
+				var at = world.getBlockState(cart.blockPosition());
+				System.out.printf(java.util.Locale.ROOT, "CONTROLLER_RAIL_CART %d,%d,%.12f,%.12f,%.12f,%.12f,%d,%d%n",
+					tick, rig, cart.getX() - origin.getX() + 8, cart.getY() - origin.getY() + 174,
+					cart.getZ() - origin.getZ() + 24, cart.getDeltaMovement().x, at.getValue(power), cart.tickCount);
+			}
+			if (tick < 12)
+				helper.fail("waiting for simulator");
+		});
+	}
