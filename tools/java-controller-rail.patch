+			var comparator = (net.minecraft.world.level.block.entity.ComparatorBlockEntity) world.getBlockEntity(comparatorPos);
+			System.out.printf("CONTROLLER_RAIL_GRADIENT %d,%s,%d%n", tick, String.join(",", values), comparator.getOutputSignal());
+			if (tick == 0) {
+				world.setBlockAndUpdate(near, Blocks.REDSTONE_BLOCK.defaultBlockState());
+			} else if (tick == 4) {
+				var lever = (com.simibubi.create.content.redstone.analogLever.AnalogLeverBlockEntity) world.getBlockEntity(far);
+				for (int click = 0; click < 7; click++)
+					lever.changeState(false);
+			} else if (tick == 24) {
+				world.setBlockAndUpdate(near, Blocks.AIR.defaultBlockState());
+			} else if (tick == 28) {
+				world.setBlockAndUpdate(far, Blocks.AIR.defaultBlockState());
+			}
+			if (tick < 34)
+				helper.fail("waiting for dual-source signals");
+		});
+	}
