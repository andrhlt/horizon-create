+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 45)
+	public static void controllerRailPlacementAndPower(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		for (int cx = 0; cx <= 2; cx++)
+			for (int cz = 1; cz <= 2; cz++)
+				world.setChunkForced(cx, cz, true);
+		var controller = com.simibubi.create.AllBlocks.CONTROLLER_RAIL;
+		var shape = com.simibubi.create.content.redstone.rail.ControllerRailBlock.SHAPE;
+		var power = com.simibubi.create.content.redstone.rail.ControllerRailBlock.POWER;
+		var backwards = com.simibubi.create.content.redstone.rail.ControllerRailBlock.BACKWARDS;
+		var water = net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED;
+		var eastWest = net.minecraft.world.level.block.state.properties.RailShape.EAST_WEST;
+		var rail = controller.getDefaultState().setValue(shape, eastWest);
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var line = new BlockPos(8, 170, 38);
+		var near = line.north();
+		var far = line.east(12).north();
+		helper.runAtTickTime(1, () -> {
+			for (int dx = 0; dx <= 12; dx++) {
+				var at = line.east(dx);
+				world.setBlockAndUpdate(at, Blocks.AIR.defaultBlockState());
+				world.setBlockAndUpdate(at.north(), Blocks.AIR.defaultBlockState());
+				world.setBlockAndUpdate(at.below(), Blocks.STONE.defaultBlockState());
+			}
+			for (int dx = 0; dx <= 12; dx++)
+				world.setBlockAndUpdate(line.east(dx), rail);
+			for (int yaw = 0; yaw < 360; yaw += 90) {
+				player.setYRot(yaw);
+				for (int scenario = 0; scenario < 3; scenario++) {
+					var at = new BlockPos(35 + yaw / 30, 170, 24 + scenario * 3);
+					world.setBlockAndUpdate(at, Blocks.AIR.defaultBlockState());
+					world.setBlockAndUpdate(at.below(), Blocks.STONE.defaultBlockState());
+					world.setBlockAndUpdate(at.east().above(), Blocks.AIR.defaultBlockState());
+					world.setBlockAndUpdate(at.east(), Blocks.AIR.defaultBlockState());
+					if (scenario == 1)
+						world.setBlockAndUpdate(at, Blocks.WATER.defaultBlockState());
+					else if (scenario == 2) {
+						world.setBlockAndUpdate(at.east(), Blocks.STONE.defaultBlockState());
+						world.setBlockAndUpdate(at.east().above(), rail);
+					}
+					var held = controller.asStack(2);
+					player.setItemInHand(hand, held);
+					var hit = new net.minecraft.world.phys.BlockHitResult(
+						net.minecraft.world.phys.Vec3.atCenterOf(at.below()),
+						net.minecraft.core.Direction.UP, at.below(), false);
+					var result = held.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+					var state = world.getBlockState(at);
+					helper.assertTrue(result.consumesAction() && controller.has(state), "controller rail placement failed");
+					System.out.printf("CONTROLLER_RAIL_PLACE %d,%d,%s,%s,%s,%d,%d%n",
+						yaw, scenario, state.getValue(shape), state.getValue(backwards), state.getValue(water),
+						state.getValue(power), held.getCount());
+				}
+			}
+		});
+		helper.succeedWhen(() -> {
+			var tick = helper.getTick() - 3;
+			if (tick < 0)
+				helper.fail("waiting for controller rails");
+			var values = new java.util.ArrayList<String>();
+			for (int dx = 0; dx <= 12; dx++) {
+				var state = world.getBlockState(line.east(dx));
+				values.add(state.getValue(power).toString());
+			}
+			System.out.printf("CONTROLLER_RAIL_POWER %d,%s%n", tick, String.join(",", values));
+			if (tick == 0)
+				world.setBlockAndUpdate(near, Blocks.REDSTONE_BLOCK.defaultBlockState());
+			if (tick == 4)
+				world.setBlockAndUpdate(far, Blocks.REDSTONE_BLOCK.defaultBlockState());
+			if (tick == 8)
+				world.setBlockAndUpdate(near, Blocks.AIR.defaultBlockState());
+			if (tick == 12)
+				world.setBlockAndUpdate(far, Blocks.AIR.defaultBlockState());
+			if (tick < 16)
+				helper.fail("waiting for controller rail power changes");
+		});
+	}
