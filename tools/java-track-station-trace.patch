+	@GameTest(template = "threshold_switch_pulley")
+	public static void targetTrainStation(CreateGameTestHelper helper) {
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var level = helper.getLevel();
+		var track = com.simibubi.create.AllBlocks.TRACK.get();
+		var shape = com.simibubi.create.content.trains.track.TrackBlock.SHAPE;
+		var ortho = com.simibubi.create.content.trains.track.TrackShape.XO;
+		var junction = com.simibubi.create.content.trains.track.TrackShape.CR_O;
+		var rail = track.defaultBlockState().setValue(shape, ortho);
+		var stone = Blocks.SMOOTH_STONE.defaultBlockState();
+		var origin = helper.absolutePos(new BlockPos(1, 8, 0));
+		for (int x = -8; x <= 14; x++) {
+			level.setBlockAndUpdate(origin.offset(x,-1,0), stone);
+			level.setBlockAndUpdate(origin.east(x), x == -1 ? rail.setValue(shape, junction) : rail);
+		}
+		var item = (com.simibubi.create.content.trains.track.TrackTargetingBlockItem) com.simibubi.create.AllBlocks.TRACK_STATION.asItem();
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		helper.runAfterDelay(7, () -> {
+			int[][] cases = {{0,0,0,3},{1,4,0,3},{1,6,1,4},{0,5,1,4},{1,-1,0,3},{1,8,0,16}};
+			for (int index=0;index<cases.length;index++) {
+				var spec = cases[index];
+				player.setItemInHand(hand, new ItemStack(item, 2));
+				player.setYRot(spec[2] == 0 ? -90 : 90);
+				player.setXRot(20);
+				var target = origin.east(spec[1]);
+				if (spec[0] != 0)
+					useStationItem(item, player, target);
+				int selected = player.getMainHandItem().has(com.simibubi.create.AllDataComponents.TRACK_TARGETING_ITEM_SELECTED_POS) ? 1 : 0;
+				var destination = target.south(spec[3]);
+				level.setBlockAndUpdate(destination, Blocks.AIR.defaultBlockState());
+				level.setBlockAndUpdate(destination.below(), stone);
+				useStationItem(item, player, destination.below());
+				var station = level.getBlockEntity(destination);
+				var nbt = station == null ? new net.minecraft.nbt.CompoundTag() : station.saveWithoutMetadata(level.registryAccess());
+				var delta = nbt.getIntArray("TargetTrack");
+				System.out.printf(java.util.Locale.ROOT, "CREATE_STATION %d %d %d %d %d %d %d %d %d %d %d%n",
+					index, spec[0], spec[1], spec[2], spec[3], selected, player.getMainHandItem().getCount(),
+					delta.length < 3 ? 0 : delta[0], delta.length < 3 ? 0 : delta[1], delta.length < 3 ? 0 : delta[2],
+					nbt.getBoolean("TargetDirection") ? 1 : 0);
+			}
+			helper.succeed();
+		});
+	}
+
+	private static void useStationItem(com.simibubi.create.content.trains.track.TrackTargetingBlockItem item,
+			net.minecraft.world.entity.player.Player player, BlockPos pos) {
+		var face = net.minecraft.core.Direction.UP;
+		var hit = new net.minecraft.world.phys.BlockHitResult(
+			net.minecraft.world.phys.Vec3.atCenterOf(pos).add(0, .5, 0), face, pos, false);
+		item.useOn(new net.minecraft.world.item.context.UseOnContext(player,
+			net.minecraft.world.InteractionHand.MAIN_HAND, hit));
+	}
