+package com.simibubi.create.infrastructure.gametest.tests;
+
+import com.simibubi.create.AllBlocks;
+import com.simibubi.create.content.logistics.depot.EjectorPlacementPacket;
+import com.simibubi.create.content.logistics.depot.EjectorTargetHandler;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.Vec3;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+import net.neoforged.neoforge.event.entity.player.PlayerInteractEvent;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaEjectorRejoinProbe {
+    private static final BlockPos TARGET = new BlockPos(9, 104, -11);
+    private static final BlockPos BASE = new BlockPos(5, 104, -11);
+    private static boolean captured;
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post event) {
+        String phase = System.getProperty("parity.ejector.rejoin");
+        var game = Minecraft.getInstance();
+        var player = game.player;
+        var level = game.level;
+        if (phase == null || captured || player == null || level == null
+                || !level.getBlockState(TARGET).is(Blocks.SMOOTH_STONE)
+                || !AllBlocks.WEIGHTED_EJECTOR.isIn(player.getMainHandItem())
+                || !AllBlocks.WEIGHTED_EJECTOR.has(level.getBlockState(BASE)))
+            return;
+        EjectorTargetHandler.tick();
+        if (phase.equals("mark")) {
+            var earlier = player.input.shiftKeyDown;
+            player.input.shiftKeyDown = true;
+            try {
+                var hit = new BlockHitResult(Vec3.atCenterOf(TARGET).add(0, .5, 0), Direction.UP, TARGET, false);
+                var click = new PlayerInteractEvent.RightClickBlock(player, InteractionHand.MAIN_HAND, TARGET, hit);
+                EjectorTargetHandler.rightClickingBlocksSelectsThem(click);
+                if (!click.isCanceled() || EjectorTargetHandler.getValidTargetDirection(BASE) != Direction.EAST)
+                    throw new IllegalStateException("Expected the original mark and four-block east target");
+            } finally {
+                player.input.shiftKeyDown = earlier;
+            }
+        } else {
+            if (EjectorTargetHandler.getValidTargetDirection(BASE) != null)
+                throw new IllegalStateException("The original target persisted into the fresh session");
+            new EjectorPlacementPacket.ClientBoundRequest(BASE).handle(player);
+        }
+        System.out.printf("CREATE_JAVA_EJECTOR_REJOIN %s,%s,%s%n", phase, player.getUUID(),
+            EjectorTargetHandler.getValidTargetDirection(BASE));
+        captured = true;
+    }
+}
