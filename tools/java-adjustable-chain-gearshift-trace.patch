+			helper.setBlock(pos, AllBlocks.ADJUSTABLE_CHAIN_GEARSHIFT.getDefaultState()
+				.setValue(BlockStateProperties.AXIS, Direction.Axis.Y)
+				.setValue(DirectionalAxisKineticBlock.AXIS_ALONG_FIRST_COORDINATE, true)
+				.setValue(com.simibubi.create.content.kinetics.chainDrive.ChainDriveBlock.PART,
+					com.simibubi.create.content.kinetics.chainDrive.ChainDriveBlock.Part.START));
+		for (var pos : java.util.List.of(drive, reverseDrive))
+			helper.setBlock(pos, AllBlocks.ENCASED_CHAIN_DRIVE.getDefaultState()
+				.setValue(BlockStateProperties.AXIS, Direction.Axis.Y)
+				.setValue(DirectionalAxisKineticBlock.AXIS_ALONG_FIRST_COORDINATE, true)
+				.setValue(com.simibubi.create.content.kinetics.chainDrive.ChainDriveBlock.PART,
+					com.simibubi.create.content.kinetics.chainDrive.ChainDriveBlock.Part.END));
+		for (var pos : java.util.List.of(shift, drive, reverseShift, reverseDrive))
+			helper.setBlock(pos.above(), AllBlocks.SHAFT.getDefaultState()
+				.setValue(BlockStateProperties.AXIS, Direction.Axis.Y));
+		for (var pos : java.util.List.of(shift.below(), reverseDrive.below())) {
+			helper.setBlock(pos, AllBlocks.CREATIVE_MOTOR.getDefaultState()
+				.setValue(BlockStateProperties.FACING, Direction.UP));
+			helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), pos).generatedSpeed.setValue(24);
+		}
+		for (var pos : java.util.List.of(lever, reverseLever)) {
+			helper.setBlock(pos.below(), net.minecraft.world.level.block.Blocks.STONE);
+			helper.setBlock(pos, AllBlocks.ANALOG_LEVER.getDefaultState()
+				.setValue(BlockStateProperties.ATTACH_FACE,
+					net.minecraft.world.level.block.state.properties.AttachFace.FLOOR));
+		}
+		var first = helper.getBlockEntity(AllBlockEntityTypes.ADJUSTABLE_CHAIN_GEARSHIFT.get(), shift);
+		var second = helper.getBlockEntity(AllBlockEntityTypes.ADJUSTABLE_CHAIN_GEARSHIFT.get(), reverseShift);
+		var a = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), drive.above());
+		var b = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), reverseShift.above());
+		var aLever = helper.getBlockEntity(AllBlockEntityTypes.ANALOG_LEVER.get(), lever);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			System.out.printf(java.util.Locale.ROOT,
+				"CREATE_ADJUSTABLE_CHAIN %d,%d,%b,%b,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f%n", tick,
+				tick > 70 ? 0 : aLever.getState(),
+				helper.getBlockState(shift).getValue(BlockStateProperties.POWERED),
+				helper.getBlockState(reverseShift).getValue(BlockStateProperties.POWERED),
+				first.getModifier(), second.getModifier(), first.getSpeed(), a.getSpeed(),
+				second.getSpeed(), b.getSpeed());
+			if (tick == 4 || tick == 26 || tick == 43) {
