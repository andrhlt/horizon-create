+	@GameTest(template = "wheat_milling", timeoutTicks = 180)
+	public static void fluidFood(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var up = net.minecraft.core.Direction.UP;
+		var heat = com.simibubi.create.content.processing.burner.BlazeBurnerBlock.HEAT_LEVEL;
+		var smouldering = com.simibubi.create.content.processing.burner.BlazeBurnerBlock.HeatLevel.SMOULDERING;
+		var fluids = net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK;
+		var execute = net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE;
+		var milk = net.neoforged.neoforge.common.NeoForgeMod.MILK.get();
+		var lava = net.minecraft.world.level.material.Fluids.LAVA;
+		var ingredients = new net.minecraft.world.item.Item[] {
+			Items.HONEY_BLOCK, AllItems.BAR_OF_CHOCOLATE.get(), Items.COCOA_BEANS,
+		};
+		var mixers = new com.simibubi.create.content.kinetics.mixer.MechanicalMixerBlockEntity[3];
+		var basins = new com.simibubi.create.content.processing.basin.BasinBlockEntity[3];
+		var burnerPositions = new BlockPos[3];
+		for (int rig = 0; rig < mixers.length; rig++) {
+			var motor = new BlockPos(1, 10, rig * 2 + 1);
+			var cog = motor.above();
+			var mixer = cog.east();
+			var basin = mixer.below(2);
+			var heater = basin.below();
+			helper.setBlock(motor, AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, up));
+			helper.setBlock(cog, AllBlocks.COGWHEEL.getDefaultState().setValue(axis, up.getAxis()));
+			helper.setBlock(mixer, AllBlocks.MECHANICAL_MIXER.getDefaultState());
+			helper.setBlock(basin, AllBlocks.BASIN.getDefaultState());
+			helper.setBlock(heater, AllBlocks.BLAZE_BURNER.getDefaultState().setValue(heat, smouldering));
+			var source = (com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity) helper.getBlockEntity(motor);
+			source.generatedSpeed.setValue(256);
+			mixers[rig] = (com.simibubi.create.content.kinetics.mixer.MechanicalMixerBlockEntity) helper.getBlockEntity(mixer);
+			basins[rig] = (com.simibubi.create.content.processing.basin.BasinBlockEntity) helper.getBlockEntity(basin);
+			burnerPositions[rig] = heater;
+		}
+		var filler = new BlockPos(5, 11, 1);
+		var depotPos = filler.below(2);
+		helper.setBlock(filler, AllBlocks.SPOUT.getDefaultState());
+		helper.setBlock(depotPos, AllBlocks.DEPOT.getDefaultState());
+		var spout = (com.simibubi.create.content.fluids.spout.SpoutBlockEntity) helper.getBlockEntity(filler);
+		var depot = (com.simibubi.create.content.logistics.depot.DepotBlockEntity) helper.getBlockEntity(depotPos);
+		level.getCapability(fluids, helper.absolutePos(filler), null)
+			.fill(new net.neoforged.neoforge.fluids.FluidStack(lava, 500), execute);
+		var bucketBasin = new BlockPos(7, 11, 5);
+		helper.setBlock(bucketBasin, AllBlocks.BASIN.getDefaultState());
+		var milkHandler = level.getCapability(fluids, helper.absolutePos(bucketBasin), null);
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		player.setItemInHand(hand, new ItemStack(Items.MILK_BUCKET));
+		helper.useBlock(bucketBasin, player);
+		helper.assertTrue(player.getItemInHand(hand).is(Items.BUCKET)
+			&& milkHandler.getFluidInTank(2).getAmount() == 1000, "The first milk bucket should fill an input tank");
+		player.setItemInHand(hand, new ItemStack(Items.MILK_BUCKET));
+		helper.useBlock(bucketBasin, player);
+		helper.assertTrue(player.getItemInHand(hand).is(Items.MILK_BUCKET)
+			&& milkHandler.getFluidInTank(3).isEmpty(), "A second bucket should leave the full milk tank alone");
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int rig = 0; rig < mixers.length; rig++) {
+				var mixer = mixers[rig];
+				var basin = basins[rig];
+				int out = basin.getTanks().getSecond().getCapability().getFluidInTank(0).getAmount();
+				int in = basin.inputTank.getCapability().getFluidInTank(0).getAmount();
+				System.out.printf(java.util.Locale.ROOT, "CREATE_HEATED_FLUID %d,%d,%d,%d,%d,%d,%d,%d,%d,%.7f,%.7f%n",
+					tick, rig, (int) mixer.getSpeed(), mixer.running ? 1 : 0, mixer.runningTicks, mixer.processingTicks,
+					countFluidFood(basin.getInputInventory(), ingredients[rig]), in, out,
+					mixer.getRenderedHeadOffset(0), mixer.getRenderedHeadRotationSpeed(0));
+				if (tick == 4) {
+					var at = helper.absolutePos(burnerPositions[rig]);
+					com.simibubi.create.content.processing.burner.BlazeBurnerBlock.tryInsert(level.getBlockState(at),
+						level, at, new ItemStack(Items.COAL), true, false, false);
+					basin.getInputInventory().insertItem(0, new ItemStack(ingredients[rig], rig == 0 ? 1 : 2), false);
+					if (rig == 2) {
+						basin.inputTank.getCapability().fill(new net.neoforged.neoforge.fluids.FluidStack(milk, 500), execute);
+						basin.getInputInventory().insertItem(1, new ItemStack(Items.SUGAR, 2), false);
+					}
+				}
+			}
+			var tag = spout.saveWithoutMetadata(level.registryAccess());
+			var held = depot.getHeldItem();
+			int liquid = tag.getList("Tanks", 10).getCompound(0).getCompound("TankContent")
+				.getCompound("Fluid").getInt("amount");
+			System.out.printf("CREATE_CAKE_SPOUT %d,%d,%d,%d,%d%n", tick, tag.getInt("ProcessingTicks"), liquid,
+				held.is(AllItems.BLAZE_CAKE_BASE.get()) ? held.getCount() : 0,
+				held.is(AllItems.BLAZE_CAKE.get()) ? held.getCount() : 0);
+			if (tick == 4)
+				depot.setHeldItem(new ItemStack(AllItems.BLAZE_CAKE_BASE.get()));
+			helper.assertTrue(tick >= 120, "Waiting for the complete fluid cycles");
+			for (int rig = 0; rig < mixers.length; rig++)
+				helper.assertTrue(basins[rig].getTanks().getSecond().getCapability().getFluidInTank(0).getAmount()
+					== (rig == 0 ? 1000 : 500), "Expected mixed output in basin " + rig);
+			helper.assertTrue(held.is(AllItems.BLAZE_CAKE.get()) && liquid == 250, "Expected the filled blaze cake");
+		});
+	}
+
+	private static int countFluidFood(net.neoforged.neoforge.items.IItemHandler inventory,
+		net.minecraft.world.item.Item item) {
+		int count = 0;
+		for (int slot = 0; slot < inventory.getSlots(); slot++) {
+			var stack = inventory.getStackInSlot(slot);
+			if (stack.is(item))
+				count += stack.getCount();
+		}
+		return count;
+	}
