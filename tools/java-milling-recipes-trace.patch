+	private static void traceMillingRecipe(CreateGameTestHelper helper, String name,
+		net.minecraft.world.item.Item input, net.minecraft.world.item.Item output,
+		net.minecraft.world.item.Item bonus, int minimum) {
+		var mill = (com.simibubi.create.content.kinetics.millstone.MillstoneBlockEntity)
+			helper.getBlockEntity(new BlockPos(2, 3, 1));
+		mill.wheatFixtureRandom = net.minecraft.util.RandomSource.create(2L);
+		var barrel = new BlockPos(2, 7, 1);
+		var storage = helper.itemStorageAt(barrel);
+		for (int slot = 0; slot < storage.getSlots(); slot++)
+			storage.extractItem(slot, 64, false);
+		storage.insertItem(0, new ItemStack(input, 1), false);
+		helper.pullLever(new BlockPos(1, 7, 1));
+		var hopper = new BlockPos(2, 2, 1);
+		var chest = new BlockPos(1, 2, 1);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			var hopperItems = helper.getItemContent(hopper);
+			var chestItems = helper.getItemContent(chest);
+			long milled = 0;
+			long milledBonus = 0;
+			for (int slot = 0; slot < mill.outputInv.getSlots(); slot++) {
+				var stack = mill.outputInv.getStackInSlot(slot);
+				if (stack.is(output))
+					milled += stack.getCount();
+				if (stack.is(bonus))
+					milledBonus += stack.getCount();
+			}
+			System.out.printf("CREATE_MILLING %s %d %d %d %d %d %d %d %d %d %d%n", name, tick,
+				helper.getItemContent(barrel).getLong(input), mill.inputInv.getStackInSlot(0).getCount(),
+				mill.timer, milled, milledBonus, hopperItems.getLong(output), hopperItems.getLong(bonus),
+				chestItems.getLong(output), chestItems.getLong(bonus));
+			helper.assertTrue(tick >= 105, "Waiting for all outputs to reach the chest");
+			helper.assertTrue(chestItems.getLong(output) >= minimum, "Missing milled output");
+		});
+	}
+
