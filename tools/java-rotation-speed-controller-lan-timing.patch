+package com.simibubi.create.foundation.mixin.client;
+
+import java.net.InetAddress;
+import java.net.UnknownHostException;
+import net.minecraft.client.server.IntegratedServer;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.ModifyArg;
+
+@Mixin(IntegratedServer.class)
+public class ControllerLanLoopbackMixin {
+    @ModifyArg(method = "publishServer", at = @At(value = "INVOKE", target =
+        "Lnet/minecraft/server/network/ServerConnectionListener;startTcpServerListener(Ljava/net/InetAddress;I)V"),
+        index = 0)
+    private InetAddress controllerLanLoopback(InetAddress address) throws UnknownHostException {
+        return Boolean.getBoolean("parity.controllerLanServer") ? InetAddress.getByAddress(new byte[]{127, 0, 0, 1}) : address;
+    }
+}
