+	@GameTest(template = "shearing", timeoutTicks = 80)
+	public static void treeFertilizerSpecies(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var origin = helper.absolutePos(new BlockPos(2, 2, 2)).above(20);
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var item = com.simibubi.create.AllItems.TREE_FERTILIZER.get();
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		helper.runAtTickTime(4, () -> {
+			for (long seed = 1; seed <= 12; seed++) {
+                System.setProperty("parity.tree.seed", Long.toString(seed));
+                var sapling = Blocks.ACACIA_SAPLING;
+				for (BlockPos delta : BlockPos.betweenClosed(-5, -1, -5, 5, 16, 5))
+					level.setBlock(origin.offset(delta), delta.getY() == -1 ? Blocks.DIRT.defaultBlockState() : Blocks.AIR.defaultBlockState(), 2);
+				level.setBlockAndUpdate(origin, sapling.defaultBlockState());
+				var stack = new ItemStack(item, 2);
+				player.setItemInHand(hand, stack);
+				var hit = new net.minecraft.world.phys.BlockHitResult(net.minecraft.world.phys.Vec3.atCenterOf(origin), net.minecraft.core.Direction.UP, origin, false);
+				var result = item.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+				var registry = net.minecraft.core.registries.BuiltInRegistries.BLOCK;
+				System.out.printf("CREATE_FERTILIZER_VARIANTS,%d,%s,%s,%d,%s,%s%n", seed, registry.getKey(sapling), result, stack.getCount(), registry.getKey(level.getBlockState(origin).getBlock()), registry.getKey(level.getBlockState(origin.above()).getBlock()));
+			}
+			helper.succeed();
+		});
+	}
