+			var stacks = new net.minecraft.world.item.ItemStack[3];
+			for (int scenario = 0; scenario < 3; scenario++) {
+				var target = targets[scenario] = new BlockPos(-12 + 24 * scenario, 112, -9);
+				level.setChunkForced(target.getX() >> 4, target.getZ() >> 4, true);
+				for (BlockPos delta : BlockPos.betweenClosed(-7, -4, -7, 7, 7, 7))
