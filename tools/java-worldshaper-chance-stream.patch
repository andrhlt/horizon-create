+					if (level.getBlockState(target.offset(x, y, z)).is(Blocks.GOLD_BLOCK)) changed.add(x + ":" + y + ":" + z);
+				if (results[scenario] != net.minecraft.world.InteractionResult.SUCCESS || !level.getBlockState(target).is(Blocks.STONE))
+					throw new IllegalStateException("Unexpected use result: " + patterns[scenario] + " " + results[scenario]);
