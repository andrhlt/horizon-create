+				var player = players[scenario] = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+				var stack = stacks[scenario] = com.simibubi.create.AllItems.WORLDSHAPER.asStack();
+				player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, stack);
+				player.setPos(target.getX() + .5, target.getY(), target.getZ() + 2.5);
+				player.setYRot(180); player.setXRot(25);
+				level.setBlock(target, Blocks.GOLD_BLOCK.defaultBlockState(), 2);
+				boolean selected = com.simibubi.create.content.equipment.zapper.ZapperInteractionHandler.trySelect(stack, player);
+				level.setBlock(target, Blocks.STONE.defaultBlockState(), 2);
+				com.simibubi.create.content.equipment.zapper.terrainzapper.WorldshaperItem.configureSettings(stack,
+					patterns[scenario], com.simibubi.create.content.equipment.zapper.terrainzapper.TerrainBrushes.Cuboid,
+					2, 3, 4, com.simibubi.create.content.equipment.zapper.terrainzapper.TerrainTools.Fill,
+					com.simibubi.create.content.equipment.zapper.terrainzapper.PlacementOptions.Attached);
+				var eye = player.position().add(0, player.getEyeHeight(), 0);
+				var hit = level.clip(new net.minecraft.world.level.ClipContext(eye, eye.add(player.getLookAngle().scale(128)),
+					net.minecraft.world.level.ClipContext.Block.OUTLINE, net.minecraft.world.level.ClipContext.Fluid.NONE, player));
+				if (!selected || !hit.getBlockPos().equals(target) || hit.getDirection() != net.minecraft.core.Direction.SOUTH)
+					throw new IllegalStateException("Unexpected setup: " + patterns[scenario] + " " + hit);
+			}
+			long seed = 123456789L;
+			level.random.setSeed(seed);
+			var results = new net.minecraft.world.InteractionResult[3];
+			for (int scenario = 0; scenario < 3; scenario++)
+				results[scenario] = com.simibubi.create.AllItems.WORLDSHAPER.get().use(level, players[scenario], net.minecraft.world.InteractionHand.MAIN_HAND).getResult();
+			long nextLong = level.random.nextLong();
+			for (int scenario = 0; scenario < 3; scenario++) {
+				var target = targets[scenario];
+				var changed = new java.util.ArrayList<String>();
