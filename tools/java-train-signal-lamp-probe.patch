+package com.simibubi.create.infrastructure.gametest.tests;
+
+import com.simibubi.create.content.trains.signal.SignalBlockEntity;
+import com.simibubi.create.content.trains.signal.SignalBlockEntity.SignalState;
+import net.createmod.catnip.animation.AnimationTickHolder;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.Screenshot;
+import net.minecraft.core.BlockPos;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaSignalLampProbe {
+    private static final BlockPos SIGNAL = new BlockPos(8, 96, 40);
+    private static SignalState previous;
+    private static int streak;
+    private static int invalidSamples;
+    private static boolean capturedOn;
+    private static boolean capturedOff;
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post ignored) {
+        if (!Boolean.getBoolean("parity.signalLamp"))
+            return;
+        var mc = Minecraft.getInstance();
+        if (mc.player == null || mc.level == null || mc.screen != null || mc.getOverlay() != null
+            || !(mc.level.getBlockEntity(SIGNAL) instanceof SignalBlockEntity signal))
+            return;
+        var state = signal.getState();
+        if (state != previous) {
+            previous = state;
+            streak = 0;
+        }
+        streak++;
+        if (streak == 8 && (state == SignalState.RED || state == SignalState.GREEN)) {
+            capture(mc, state.toString().toLowerCase());
+            System.out.println("CREATE_SIGNAL_CAPTURE " + state);
+        }
+        if (state != SignalState.INVALID || streak < 8 || invalidSamples >= 40 && capturedOn && capturedOff)
+            return;
+        invalidSamples++;
+        float time = AnimationTickHolder.getRenderTime(mc.level);
+        System.out.printf("CREATE_SIGNAL_BLINK %d,%.4f,%s%n", mc.level.getGameTime(), time, state.isRedLight(time));
+        if (!capturedOn && time % 40 >= 1 && time % 40 < 2) {
+            capturedOn = true;
+            capture(mc, "invalid-on");
+        }
+        if (!capturedOff && time % 40 >= 10 && time % 40 < 11) {
+            capturedOff = true;
+            capture(mc, "invalid-off");
+        }
+        if (invalidSamples >= 40 && capturedOn && capturedOff)
+            System.out.println("CREATE_SIGNAL_CAPTURE DONE");
+    }
+
+    private static void capture(Minecraft mc, String name) {
+        Screenshot.grab(mc.gameDirectory, "signal-" + name + ".png",
+            mc.getMainRenderTarget(), message -> System.out.println(message.getString()));
+    }
+}
