+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 25)
+	public static void copycatPlacementAssist(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var pos = new BlockPos(8, 170, 24);
+		world.setChunkForced(0, 1, true);
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(world);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var panel = com.simibubi.create.AllBlocks.COPYCAT_PANEL;
+		var step = com.simibubi.create.AllBlocks.COPYCAT_STEP;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var half = net.minecraft.world.level.block.state.properties.BlockStateProperties.HALF;
+		var east = net.minecraft.core.Direction.EAST;
+		var west = net.minecraft.core.Direction.WEST;
+		var north = net.minecraft.core.Direction.NORTH;
+		var south = net.minecraft.core.Direction.SOUTH;
+		var up = net.minecraft.core.Direction.UP;
+
+		var rigs = java.util.List.of(
+			new Object[] {"panel-east-on-floor", panel.getDefaultState(), up, east, false, false, false},
+			new Object[] {"panel-up-on-wall", panel.getDefaultState().setValue(facing, north), south, up, false, false, false},
+			new Object[] {"panel-fallback-west", panel.getDefaultState(), up, east, true, false, false},
+			new Object[] {"panel-blocked", panel.getDefaultState(), up, east, true, true, false},
+			new Object[] {"panel-water", panel.getDefaultState(), up, east, false, false, true},
+			new Object[] {"step-extend", step.getDefaultState(), up, east, false, false, false},
+			new Object[] {"step-upper-extend", step.getDefaultState().setValue(half, net.minecraft.world.level.block.state.properties.Half.TOP),
+				up, east, false, false, false},
+			new Object[] {"step-water", step.getDefaultState(), up, east, false, false, true},
+			new Object[] {"panel-flowing-water", panel.getDefaultState(), up, east, false, false, true},
+			new Object[] {"step-flowing-water", step.getDefaultState(), up, east, false, false, true},
+			new Object[] {"step-opposite-facing", step.getDefaultState(), up, east, false, false, false},
+			new Object[] {"step-perpendicular-facing", step.getDefaultState(), up, east, false, false, false}
+		);
+		helper.runAtTickTime(4, () -> {
+			for (var rig : rigs) {
+				String id = (String) rig[0];
+				var state = (net.minecraft.world.level.block.state.BlockState) rig[1];
+				var face = (net.minecraft.core.Direction) rig[2];
+				var desired = (net.minecraft.core.Direction) rig[3];
+				for (var direction : net.minecraft.core.Direction.values())
+					for (int n = 1; n <= 3; n++)
+						world.setBlockAndUpdate(pos.relative(direction, n), Blocks.AIR.defaultBlockState());
+				world.setBlockAndUpdate(pos, state);
+				int reach = 1;
+				if (id.startsWith("step")) {
+					var existing = switch(id) {
+						case "step-opposite-facing" -> state.setValue(
+							net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING, north);
+						case "step-perpendicular-facing" -> state.setValue(
+							net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING, west);
+						default -> state;
+					};
+					world.setBlockAndUpdate(pos.east(), existing);
+					reach = 2;
+				}
+				if ((boolean) rig[4])
+					world.setBlockAndUpdate(pos.relative(desired, reach), Blocks.STONE.defaultBlockState());
+				if (id.equals("panel-fallback-west") || id.equals("panel-blocked")) {
+					world.setBlockAndUpdate(pos.north(), Blocks.STONE.defaultBlockState());
+					world.setBlockAndUpdate(pos.south(), Blocks.STONE.defaultBlockState());
+				}
+				if ((boolean) rig[5])
+					world.setBlockAndUpdate(pos.west(), Blocks.STONE.defaultBlockState());
+				if ((boolean) rig[6]) {
+					var water = Blocks.WATER.defaultBlockState();
+					if (id.contains("flowing-water"))
+						water = water.setValue(net.minecraft.world.level.block.LiquidBlock.LEVEL, 1);
+					world.setBlockAndUpdate(pos.relative(desired, reach), water);
+				}
+
+				player.setPos(pos.getX() + .5, pos.getY() - 1.0, pos.getZ() + 2);
+				player.setYRot(180.0f);
+				player.setYHeadRot(180.0f);
+				player.setShiftKeyDown(false);
+				player.setItemInHand(hand, new ItemStack(state.getBlock(), 2));
+				var hitPos = net.minecraft.world.phys.Vec3.atCenterOf(pos)
+					.add(net.minecraft.world.phys.Vec3.atLowerCornerOf(desired.getNormal()).scale(0.4));
+				var hit = new net.minecraft.world.phys.BlockHitResult(hitPos, face, pos, false);
+				var result = world.getBlockState(pos).useItemOn(player.getItemInHand(hand), world, player, hand, hit);
+				var output = new java.util.ArrayList<String>();
+				for (var direction : net.minecraft.core.Direction.values()) {
+					for (int n = 1; n <= 3; n++) {
+						var neighbor = world.getBlockState(pos.relative(direction, n));
+						if (neighbor.is(state.getBlock()))
+							output.add(direction.getName() + n + "=" + neighbor);
+					}
+				}
+				System.out.printf("COPYCAT_ASSIST %d;%s;%s;%d;%s%n",
+					helper.getTick(), id, result, player.getItemInHand(hand).getCount(), String.join("|", output));
+			}
+			helper.succeed();
+		});
+	}
 }
