+    private static long savedClock;
+    private static final boolean RESTORE = "restore".equals(System.getProperty("parity.reloadArrival"));
 
+    static void snapshot(MinecraftServer server, UUID id) {
+        Path source = server.getWorldPath(LevelResource.ROOT).toAbsolutePath().normalize();
+        Path copy = source.getParent().resolve("MovingPortReloadSnapshot");
+        if (Files.exists(copy))
+            throw new IllegalStateException("The scratch snapshot directory already exists.");
+        long clock = server.overworld().getGameTime();
+        server.saveEverything(true, true, true);
+        try (var files = Files.walk(source)) {
+            for (Path file : files.toList()) {
+                Path below = source.relativize(file);
+                if (below.toString().equals("session.lock"))
+                    continue;
+                Path target = copy.resolve(below);
+                if (Files.isDirectory(file))
+                    Files.createDirectories(target);
+                else
+                    Files.copy(file, target);
+            }
+            Files.writeString(copy.resolve("parity-arrival"), id + ";" + clock);
+        } catch (IOException ex) {
+            throw new UncheckedIOException(ex);
+        }
+        System.out.printf("JAVA_ARRIVAL_SNAPSHOT %d;%s%n", clock, id);
+    }
+
