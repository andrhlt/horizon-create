+package com.simibubi.create.infrastructure.gametest.tests;
+
+import com.simibubi.create.AllDataComponents;
+import com.simibubi.create.AllItems;
+import com.simibubi.create.content.trains.schedule.ScheduleScreen;
+import com.simibubi.create.content.trains.schedule.condition.ScheduledDelay;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.Screenshot;
+import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaScheduleDelayProbe {
+    private static int phase;
+    private static int elapsed;
+    private static boolean supplied;
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post event) throws ReflectiveOperationException {
+        if (!Boolean.getBoolean("parity.scheduleDelay"))
+            return;
+        var mc = Minecraft.getInstance();
+        if (mc.player == null || mc.getOverlay() != null)
+            return;
+        if (!supplied) {
+            var server = mc.getSingleplayerServer();
+            if (server == null)
+                throw new AssertionError("The parity fixture must be played locally.");
+            var playerId = mc.player.getUUID();
+            server.execute(() -> server.getPlayerList().getPlayer(playerId)
+                .setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, AllItems.SCHEDULE.asStack()));
+            supplied = true;
+        }
+        if (!AllItems.SCHEDULE.isIn(mc.player.getMainHandItem()))
+            return;
+        elapsed++;
+        switch (phase) {
+            case 0 -> {
+                if (mc.screen == null && elapsed >= 8) {
+                    var use = Minecraft.class.getDeclaredMethod("startUseItem");
+                    use.setAccessible(true);
+                    use.invoke(mc);
+                    advance();
+                }
+            }
+            case 1 -> {
+                if (mc.screen instanceof ScheduleScreen screen && elapsed >= 7) {
+                    click(screen, 50, 31);
+                    advance();
+                }
+            }
+            case 2 -> {
+                if (mc.screen instanceof ScheduleScreen screen && elapsed >= 5) {
+                    click(screen, 112, 94);
+                    for (char c : "Waiting Station".toCharArray())
+                        screen.charTyped(c, 0);
+                    click(screen, 231, 94);
+                    advance();
+                }
+            }
+            case 3 -> {
+                if (mc.screen instanceof ScheduleScreen screen && elapsed >= 7) {
+                    click(screen, 65, 60);
+                    advance();
+                }
+            }
+            case 4 -> {
+                if (!(mc.screen instanceof ScheduleScreen screen) || elapsed < 5)
+                    return;
+                System.out.println("CREATE_DELAY_DEFAULT " + editing(screen).getData());
+                capture(mc, "schedule-delay-default");
+                for (int i = 0; i < 3; i++)
+                    scroll(screen, 90, 94, 1);
+                scroll(screen, 150, 94, -1);
+                click(screen, 232, 94);
+                advance();
+            }
+            case 5 -> {
+                if (mc.screen instanceof ScheduleScreen screen && elapsed >= 7) {
+                    click(screen, 222, 204);
+                    advance();
+                }
+            }
+            case 6 -> {
+                if (!mc.player.getMainHandItem().has(AllDataComponents.TRAIN_SCHEDULE) || elapsed < 7)
+                    return;
+                System.out.println("CREATE_DELAY_SAVED " + mc.player.getMainHandItem().get(AllDataComponents.TRAIN_SCHEDULE));
+                var use = Minecraft.class.getDeclaredMethod("startUseItem");
+                use.setAccessible(true);
+                use.invoke(mc);
+                advance();
+            }
+            case 7 -> {
+                if (mc.screen instanceof ScheduleScreen screen && elapsed >= 7) {
+                    click(screen, 65, 60);
+                    advance();
+                }
+            }
+            case 8 -> {
+                if (!(mc.screen instanceof ScheduleScreen screen) || elapsed < 5)
+                    return;
+                System.out.println("CREATE_DELAY_REOPEN " + editing(screen).getData());
+                capture(mc, "schedule-delay-eight-minutes");
+                for (int i = 0; i < 135; i++)
+                    scroll(screen, 90, 94, 1);
+                for (int i = 0; i < 3; i++)
+                    scroll(screen, 150, 94, 1);
+                click(screen, 232, 94);
+                click(screen, 222, 204);
+                advance();
+            }
+            case 9 -> {
+                if (elapsed < 10)
+                    return;
+                System.out.println("CREATE_DELAY_FINAL " + mc.player.getMainHandItem().get(AllDataComponents.TRAIN_SCHEDULE));
+                var use = Minecraft.class.getDeclaredMethod("startUseItem");
+                use.setAccessible(true);
+                use.invoke(mc);
+                advance();
+            }
+            case 10 -> {
+                if (mc.screen instanceof ScheduleScreen screen && elapsed >= 7) {
+                    click(screen, 65, 60);
+                    advance();
+                }
+            }
+            case 11 -> {
+                if (!(mc.screen instanceof ScheduleScreen screen) || elapsed < 5)
+                    return;
+                System.out.println("CREATE_DELAY_BOUNDARY_REOPEN " + editing(screen).getData());
+                for (int i = 0; i < 135; i++)
+                    scroll(screen, 90, 94, -1);
+                scroll(screen, 150, 94, -1);
+                click(screen, 232, 94);
+                click(screen, 222, 204);
+                advance();
+            }
+            case 12 -> {
+                if (elapsed < 10)
+                    return;
+                System.out.println("CREATE_DELAY_ZERO " + mc.player.getMainHandItem().get(AllDataComponents.TRAIN_SCHEDULE));
+                System.out.println("CREATE_DELAY_DONE");
+                advance();
+                mc.stop();
+            }
+        }
+    }
+
+    private static ScheduledDelay editing(ScheduleScreen screen) throws ReflectiveOperationException {
+        var field = ScheduleScreen.class.getDeclaredField("editingCondition");
+        field.setAccessible(true);
+        var condition = field.get(screen);
+        if (!(condition instanceof ScheduledDelay delay))
+            throw new AssertionError("Click did not reach Scheduled Delay: " + condition);
+        return delay;
+    }
+
+    private static void click(ScheduleScreen screen, int dx, int dy) throws ReflectiveOperationException {
+        screen.mouseClicked(origin(screen, "leftPos") + dx, origin(screen, "topPos") + dy, 0);
+    }
+
+    private static void scroll(ScheduleScreen screen, int dx, int dy, double delta) throws ReflectiveOperationException {
+        screen.mouseScrolled(origin(screen, "leftPos") + dx, origin(screen, "topPos") + dy, 0, delta);
+    }
+
+    private static int origin(ScheduleScreen screen, String fieldName) throws ReflectiveOperationException {
+        var field = AbstractContainerScreen.class.getDeclaredField(fieldName);
+        field.setAccessible(true);
+        return (int) field.get(screen);
+    }
+
+    private static void capture(Minecraft mc, String name) {
+        Screenshot.grab(mc.gameDirectory, name + ".png", mc.getMainRenderTarget(),
+            message -> System.out.println(message.getString()));
+    }
+
+    private static void advance() {
+        phase++;
+        elapsed = 0;
+    }
+}
