+
+	@GameTest(template = "shearing", timeoutTicks = 45)
+	public static void packageVerticalContact(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var floor = helper.absolutePos(new BlockPos(4, 4, 2));
+		var origin = net.minecraft.world.phys.Vec3.atLowerCornerOf(floor).add(0.5, 1, 0.5);
+		for (int x = -2; x <= 2; x++) {
+			for (int z = -2; z <= 2; z++) {
+				world.setBlockAndUpdate(floor.offset(x, -1, z), Blocks.OBSIDIAN.defaultBlockState());
+				for (int y = 0; y < 4; y++)
+					world.setBlockAndUpdate(floor.offset(x, y, z), Blocks.AIR.defaultBlockState());
+			}
+		}
+		for (String scenario : new String[]{"above", "level", "below", "clear"}) {
+			double dy = switch (scenario) {
+				case "above" -> 0.25;
+				case "below" -> -0.25;
+				case "clear" -> 0.55;
+				default -> 0;
+			};
+			var pig = EntityType.PIG.create(world);
+			pig.setPos(origin.add(0.375, dy, 0));
+			pig.setNoAi(true);
+			pig.setNoGravity(true);
+			world.addFreshEntity(pig);
+			var style = com.simibubi.create.content.logistics.box.PackageStyles.ALL_BOXES.get(2);
+			var box = com.simibubi.create.content.logistics.box.PackageEntity.fromItemStack(world, origin, new ItemStack(style));
+			box.setNoGravity(true);
+			box.setYRot(0);
+			world.addFreshEntity(box);
+			for (int tick = 0; tick < 12; tick++) {
+				if (tick > 0) {
+					world.tickNonPassenger(pig);
+					world.tickNonPassenger(box);
+				}
+				var a = box.position().subtract(origin);
+				var av = box.getDeltaMovement();
+				var b = pig.position().subtract(origin);
+				System.out.printf(java.util.Locale.ROOT,
+					"PACKAGE_CONTACT,%s,%d,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f%n",
+					scenario, tick, a.x, a.y, a.z, av.x, av.y, av.z, b.x, b.y, b.z);
+			}
+			box.discard();
+			pig.discard();
+		}
+		helper.succeed();
+	}
 }
