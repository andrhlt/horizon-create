+        record Trial(String name, net.minecraft.world.item.Item ammo, int split) {}
+        var trials = java.util.List.of(new Trial("sweet",Items.SWEET_BERRIES,3), new Trial("glow",Items.GLOW_BERRIES,2),
+            new Trial("chocolate",com.simibubi.create.AllItems.CHOCOLATE_BERRIES.get(),3));
+        helper.runAtTickTime(3, () -> {
+            for (var trial : trials) {
+                var player = new net.neoforged.neoforge.common.util.FakePlayer(world,
+                    new com.mojang.authlib.GameProfile(java.util.UUID.randomUUID(),"BerryFixture"));
+                player.gameMode.changeGameModeForPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+                player.setPos(origin.getX()+.5,origin.getY(),origin.getZ()+.5);player.setYRot(0);player.setXRot(0);
+                var cannon=com.simibubi.create.AllItems.POTATO_CANNON.asStack();player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND,cannon);
+                player.getInventory().setItem(1,new ItemStack(trial.ammo(),3));
+                world.getRandom().setSeed(1234L);
+                var result=cannon.use(world,player,net.minecraft.world.InteractionHand.MAIN_HAND);
+                var shots=world.getEntitiesOfClass(com.simibubi.create.content.equipment.potatoCannon.PotatoProjectileEntity.class,
+                    new net.minecraft.world.phys.AABB(origin).inflate(6)).stream().filter(shot -> shot.getOwner()==player).toList();
+                helper.assertTrue(shots.size()==trial.split(),"wrong split count");
+                System.out.printf("BERRY_SHOT,%s,%s,%d,%d,%d%n",trial.name(),result.getResult(),player.getInventory().getItem(1).getCount(),cannon.getDamageValue(),shots.size());
+                int index=0;
+                for(var shot:shots) { var p=shot.position();var v=shot.getDeltaMovement();
+                    System.out.printf(java.util.Locale.ROOT,"BERRY_VECTOR,%s,%d,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f%n",trial.name(),index++,p.x-player.getX(),p.y-player.getY(),p.z-player.getZ(),v.x,v.y,v.z); shot.discard(); }
+                for(int tick=0;tick<=11;tick++) {if(tick>0)player.getCooldowns().tick();
+                    boolean cooling = player.getCooldowns().isOnCooldown(cannon.getItem());
+                    if(tick==10 && !cooling) cannon.use(world,player,net.minecraft.world.InteractionHand.MAIN_HAND);
+                    System.out.printf("BERRY_REFIRE,%s,%d,%b,%d,%d%n",trial.name(),tick,cooling,player.getInventory().getItem(1).getCount(),cannon.getDamageValue());}
+            }
+            helper.succeed();
+        });
+    }
