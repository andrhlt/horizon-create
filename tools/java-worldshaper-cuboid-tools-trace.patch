+				var stack = com.simibubi.create.AllItems.WORLDSHAPER.asStack();
+				player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, stack);
+				player.setPos(target.getX() + .5, target.getY(), target.getZ() + 2.5);
+				player.setYRot(180);
+				player.setXRot(25);
+				boolean selected = false;
+				if (tool != com.simibubi.create.content.equipment.zapper.terrainzapper.TerrainTools.Clear) {
+					level.setBlock(target, Blocks.GOLD_BLOCK.defaultBlockState(), 2);
+					selected = com.simibubi.create.content.equipment.zapper.ZapperInteractionHandler.trySelect(stack, player);
+				}
+				level.setBlock(target, Blocks.STONE.defaultBlockState(), 2);
+				level.setBlock(target.offset(1, 0, 0), Blocks.GOLD_BLOCK.defaultBlockState(), 2);
+				level.setBlock(target.offset(1, 0, 1), Blocks.COBBLESTONE.defaultBlockState(), 2);
+				com.simibubi.create.content.equipment.zapper.terrainzapper.WorldshaperItem.configureSettings(stack,
+					com.simibubi.create.content.equipment.zapper.PlacementPatterns.Solid,
+					com.simibubi.create.content.equipment.zapper.terrainzapper.TerrainBrushes.Cuboid,
+					2, 1, 2, tool, com.simibubi.create.content.equipment.zapper.terrainzapper.PlacementOptions.Merged);
+				var eye = player.position().add(0, player.getEyeHeight(), 0);
+				var hit = level.clip(new net.minecraft.world.level.ClipContext(eye, eye.add(player.getLookAngle().scale(128)),
+					net.minecraft.world.level.ClipContext.Block.OUTLINE, net.minecraft.world.level.ClipContext.Fluid.NONE, player));
+				var before = new java.util.LinkedHashMap<String, String>();
+				for (int x = 0; x <= 1; x++) for (int y = 0; y <= 1; y++) for (int z = 0; z <= 1; z++) {
+					var offset = x + ":" + y + ":" + z;
+					before.put(offset, net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(level.getBlockState(target.offset(x,y,z)).getBlock()).toString());
+				}
+				var itemData = (net.minecraft.nbt.CompoundTag) stack.saveOptional(level.registryAccess());
+				System.out.printf("CREATE_WORLDSHAPER_TOOL_COMPONENTS %s %s%n", tool, itemData.getCompound("components"));
+				var result = com.simibubi.create.AllItems.WORLDSHAPER.get().use(level, player, net.minecraft.world.InteractionHand.MAIN_HAND);
+				var changed = new java.util.ArrayList<String>();
+				var after = new java.util.ArrayList<String>();
+				for (int x = 0; x <= 1; x++) for (int y = 0; y <= 1; y++) for (int z = 0; z <= 1; z++) {
