+	@GameTest(template = "shearing", timeoutTicks = 25)
+	public static void packageContainerSlots(CreateGameTestHelper helper) {
+		var boxes = com.simibubi.create.content.logistics.box.PackageStyles.ALL_BOXES;
+		var items = new java.util.ArrayList<ItemStack>();
+		for (var box : boxes) items.add(new ItemStack(box));
+		items.add(new ItemStack(Items.STONE));
+		items.add(new ItemStack(Items.SHULKER_BOX));
+		var shulker = new net.minecraft.world.inventory.ShulkerBoxSlot(new net.minecraft.world.SimpleContainer(27), 0, 0, 0);
+		for (var sample : items) {
+			var bundle = new net.minecraft.world.item.component.BundleContents.Mutable(net.minecraft.world.item.component.BundleContents.EMPTY);
+			boolean nested = bundle.tryInsert(sample.copy()) != 0;
+			System.out.printf("PACKAGE_CONTAINER,%s,%b,%b%n",
+				net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(sample.getItem()), nested, shulker.mayPlace(sample));
+		}
+		helper.succeed();
+	}
