+ @GameTest(template = "threshold_switch_pulley", timeoutTicks = 90)
+ public static void couplingProbe(CreateGameTestHelper helper) {
+  var world = helper.getLevel();
+  world.getEntitiesOfClass(net.minecraft.world.entity.vehicle.AbstractMinecart.class, new net.minecraft.world.phys.AABB(0, 160, 16, 30, 180, 42)).forEach(cart -> cart.discard());
+  var shape = net.minecraft.world.level.block.state.properties.BlockStateProperties.RAIL_SHAPE;
+  for (int x = 4; x <= 24; x++) {
+   world.setBlockAndUpdate(new BlockPos(x, 169, 24), Blocks.STONE.defaultBlockState());
+   world.setBlock(new BlockPos(x, 170, 24), Blocks.RAIL.defaultBlockState().setValue(shape, net.minecraft.world.level.block.state.properties.RailShape.EAST_WEST), 2);
+  }
+  var a = new net.minecraft.world.entity.vehicle.Minecart(EntityType.MINECART, world);
+  var b = new net.minecraft.world.entity.vehicle.Minecart(EntityType.MINECART, world);
+  a.setUUID(java.util.UUID.fromString("00000000-0000-0000-0000-000000000001"));
+  b.setUUID(java.util.UUID.fromString("00000000-0000-0000-0000-000000000002"));
+  a.setPos(8.5, 170.0625, 24.5); b.setPos(11.5, 170.0625, 24.5);
+  world.addFreshEntity(a); world.addFreshEntity(b);
+  var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+  player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, com.simibubi.create.AllItems.MINECART_COUPLING.asStack(2));
+  helper.runAtTickTime(5, () -> {
+   helper.assertTrue(com.simibubi.create.content.contraptions.minecart.CouplingHandler.tryToCoupleCarts(player, world, a.getId(), b.getId()), "coupling failed");
+   a.setDeltaMovement(-0.2, 0, 0);
+   System.out.printf(java.util.Locale.ROOT, "COUPLING_HARD 0,%.9f,%.9f,%.9f,%.9f%n", a.getX(), a.getDeltaMovement().x, b.getX(), b.getDeltaMovement().x);
+  });
+  for (int t=6; t<=35; t++) {
+   final int tick=t;
+   helper.runAtTickTime(t, () -> {
+    System.out.printf(java.util.Locale.ROOT, "COUPLING_HARD %d,%.9f,%.9f,%.9f,%.9f%n", tick-5, a.getX(), a.getDeltaMovement().x, b.getX(), b.getDeltaMovement().x);
+    if (tick == 35) helper.succeed();
+   });
+  }
+ }
