+				level.setBlockAndUpdate(pos.east().above(), Blocks.REDSTONE_BLOCK.defaultBlockState());
+			player.setYRot(yaw[test]);
+			player.setYHeadRot(yaw[test]);
+			player.setYBodyRot(yaw[test]);
+			player.yRotO = yaw[test];
+			player.setShiftKeyDown(test == 6);
+			var stack = new ItemStack(test == 0 ? block.asItem() : vertical);
+			player.setItemInHand(hand, stack);
+			var hit = new net.minecraft.world.phys.BlockHitResult(support.getCenter().relative(face, 0.5), face, support, false);
+			var context = new net.minecraft.world.item.context.BlockPlaceContext(player, hand, stack, hit);
+			var result = ((net.minecraft.world.item.BlockItem) stack.getItem()).place(context);
+			var landed = level.getBlockState(pos);
+			var clone = block.getCloneItemStack(landed, hit, level, pos, player);
+			var loot = net.minecraft.world.level.block.Block.getDrops(landed, level, pos, level.getBlockEntity(pos), player, new ItemStack(Items.IRON_PICKAXE));
+			var items = net.minecraft.core.registries.BuiltInRegistries.ITEM;
+			System.out.printf("CREATE_GEARBOX_PLACE,%d,%s,%s,%s,%s,%d,%s%n", test, result.consumesAction(), landed.getValue(axis),
+				items.getKey(clone.getItem()), items.getKey(loot.getFirst().getItem()), loot.getFirst().getCount(), stack.isEmpty());
+			var wrench = new ItemStack(com.simibubi.create.AllItems.WRENCH.get());
+			player.setItemInHand(hand, wrench);
+			player.setShiftKeyDown(true);
