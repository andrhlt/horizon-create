+			var support = pos.relative(face.getOpposite());
+			level.setBlockAndUpdate(support, Blocks.STONE.defaultBlockState());
+			if (test == 3 || test == 5)
+				level.setBlockAndUpdate(pos.east(), com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, east.getAxis()));
+			if (test == 4 || test == 5 || test == 6)
+				level.setBlockAndUpdate(pos.north(), com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, north.getAxis()));
+			if (test == 7)
+				level.setBlockAndUpdate(pos.below(), com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, up.getAxis()));
+			if (test == 8)
+				level.setBlockAndUpdate(pos.east(), com.simibubi.create.AllBlocks.CLUTCH.getDefaultState().setValue(axis, east.getAxis())
