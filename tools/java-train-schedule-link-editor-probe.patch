+package com.simibubi.create.infrastructure.gametest.tests;
+
+import com.simibubi.create.AllDataComponents;
+import com.simibubi.create.AllItems;
+import com.simibubi.create.content.trains.schedule.ScheduleScreen;
+import com.simibubi.create.content.trains.schedule.condition.RedstoneLinkCondition;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
+import net.minecraft.world.inventory.ClickType;
+import net.minecraft.world.inventory.Slot;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaScheduleLinkEditorProbe {
+    private static boolean supplied;
+    private static int phase;
+    private static int elapsed;
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post event) throws ReflectiveOperationException {
+        if (!Boolean.getBoolean("parity.scheduleLinkEditor"))
+            return;
+        var mc = Minecraft.getInstance();
+        if (mc.player == null || mc.getOverlay() != null)
+            return;
+        if (!supplied) {
+            var server = mc.getSingleplayerServer();
+            var playerId = mc.player.getUUID();
+            server.execute(() -> {
+                var player = server.getPlayerList().getPlayer(playerId);
+                var inventory = player.getInventory();
+                inventory.clearContent();
+                inventory.selected = 0;
+                inventory.setItem(0, AllItems.SCHEDULE.asStack());
+                inventory.setItem(1, new ItemStack(Items.PAPER, 7));
+                inventory.setItem(2, new ItemStack(Items.REDSTONE, 4));
+            });
+            supplied = true;
+        }
+        if (!AllItems.SCHEDULE.isIn(mc.player.getMainHandItem()) || ++elapsed < 12)
+            return;
+        if (mc.screen == null) {
+            switch (phase) {
+                case 0 -> use(mc);
+                case 6 -> {
+                    captureItem(mc, "DEFAULT");
+                    use(mc);
+                }
+                case 11 -> {
+                    captureItem(mc, "INVERTED");
+                    use(mc);
+                }
+                case 16 -> {
+                    captureItem(mc, "CLEARED");
+                    System.out.println("CREATE_LINK_EDITOR_DONE");
+                    mc.stop();
+                }
+                default -> { return; }
+            }
+        } else if (mc.screen instanceof ScheduleScreen screen) {
+            var menu = screen.getMenu();
+            switch (phase) {
+                case 1 -> click(screen, 52, 31);
+                case 2 -> {
+                    click(screen, 111, 94);
+                    for (char c : "Waiting Station".toCharArray())
+                        screen.charTyped(c, 0);
+                    click(screen, 233, 94);
+                }
+                case 3 -> {
+                    click(screen, 65, 60);
+                    for (int i=0; i<4; i++)
+                        scroll(screen, 130, 72, -1);
+                }
+                case 4 -> {
+                    requireCondition(screen);
+                    requireStack(menu.getSlot(36 + 0), Items.AIR, 0);
+                    requireStack(menu.getSlot(36 + 1), Items.AIR, 0);
+                    click(screen, 233, 94);
+                }
+                case 5, 10, 15 -> click(screen, 222, 204);
+                case 7 -> {
+                    click(screen, 65, 60);
+                    requireCondition(screen);
+                    quickMove(screen, 28);
+                }
+                case 8 -> {
+                    requireStack(menu.getSlot(36), Items.PAPER, 1);
+                    quickMove(screen, 29);
+                }
+                case 9 -> {
+                    requireStack(menu.getSlot(37), Items.REDSTONE, 1);
+                    scroll(screen, 151, 94, -1);
+                    click(screen, 233, 94);
+                }
+                case 12 -> {
+                    click(screen, 65, 60);
+                    requireCondition(screen);
+                    requireStack(menu.getSlot(36), Items.PAPER, 1);
+                    requireStack(menu.getSlot(37), Items.REDSTONE, 1);
+                    quickMove(screen, 36);
+                }
+                case 13 -> {
+                    requireStack(menu.getSlot(36), Items.AIR, 0);
+                    requireStack(menu.getSlot(37), Items.REDSTONE, 1);
+                    scroll(screen, 151, 94, 1);
+                }
+                case 14 -> click(screen, 233, 94);
+                default -> { return; }
+            }
+        } else
+            return;
+        phase++;
+        elapsed = 0;
+    }
+
+    private static void requireCondition(ScheduleScreen screen) throws ReflectiveOperationException {
+        var field = ScheduleScreen.class.getDeclaredField("editingCondition");
+        field.setAccessible(true);
+        var actual = field.get(screen);
+        if (!(actual instanceof RedstoneLinkCondition))
+            throw new AssertionError("Expected Redstone Link condition, got " + actual);
+    }
+
+    private static void requireStack(Slot slot, net.minecraft.world.item.Item expected, int count) {
+        var actual = slot.getItem();
+        boolean matches = count == 0 ? actual.isEmpty() : actual.is(expected) && actual.getCount() == count;
+        if (!matches)
+            throw new AssertionError("Expected " + expected + " x" + count + ", got " + actual);
+    }
+
+    private static void captureItem(Minecraft mc, String name) {
+        var inventory = mc.player.getInventory();
+        if (inventory.getItem(1).getCount() != 7 || inventory.getItem(2).getCount() != 4)
+            throw new AssertionError("Ghost clicks changed the source stack count");
+        System.out.println("CREATE_LINK_EDITOR_" + name + " " +
+            mc.player.getMainHandItem().get(AllDataComponents.TRAIN_SCHEDULE));
+    }
+
+    private static void use(Minecraft mc) throws ReflectiveOperationException {
+        var method = Minecraft.class.getDeclaredMethod("startUseItem");
+        method.setAccessible(true);
+        method.invoke(mc);
+    }
+
+    private static void quickMove(ScheduleScreen screen, int index) throws ReflectiveOperationException {
+        var method = AbstractContainerScreen.class.getDeclaredMethod("slotClicked",
+            Slot.class, int.class, int.class, ClickType.class);
+        method.setAccessible(true);
+        method.invoke(screen, screen.getMenu().getSlot(index), index, 0, ClickType.QUICK_MOVE);
+    }
+
+    private static void click(ScheduleScreen screen, int dx, int dy) throws ReflectiveOperationException {
+        screen.mouseClicked(origin(screen, "leftPos") + dx, origin(screen, "topPos") + dy, 0);
+    }
+
+    private static void scroll(ScheduleScreen screen, int dx, int dy, double delta) throws ReflectiveOperationException {
+        screen.mouseScrolled(origin(screen, "leftPos") + dx, origin(screen, "topPos") + dy, 0, delta);
+    }
+
+    private static int origin(ScheduleScreen screen, String fieldName) throws ReflectiveOperationException {
+        var field = AbstractContainerScreen.class.getDeclaredField(fieldName);
+        field.setAccessible(true);
+        return (int) field.get(screen);
+    }
+}
