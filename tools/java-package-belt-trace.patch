+	@GameTest(template = "shearing", timeoutTicks = 45)
+	public static void packageBelt(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var pos = helper.absolutePos(new BlockPos(4, 4, 2));
+		var start = pos.west(3);
+		var end = pos.east(3);
+		var target = net.minecraft.world.phys.Vec3.atCenterOf(pos).add(0, 5 / 16f, 0);
+		var bounds = new net.minecraft.world.phys.AABB(pos).inflate(6);
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var shaft = com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, net.minecraft.core.Direction.Axis.Z);
+		for (String scenario : new String[]{"forward", "reverse", "stoppedForward", "stoppedReverse"}) {
+			for (int x = -4; x <= 4; x++)
+				for (int z = -2; z <= 2; z++) {
+					world.setBlockAndUpdate(pos.offset(x, -1, z), Blocks.OBSIDIAN.defaultBlockState());
+					for (int y = 0; y < 4; y++)
+						world.setBlockAndUpdate(pos.offset(x, y, z), Blocks.AIR.defaultBlockState());
+				}
+			world.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class, bounds)
+				.forEach(net.minecraft.world.entity.Entity::discard);
+			world.setBlockAndUpdate(start, shaft);
+			world.setBlockAndUpdate(end, shaft);
+			com.simibubi.create.content.kinetics.belt.item.BeltConnectorItem.createBelts(world, start, end);
+			com.simibubi.create.content.kinetics.belt.BeltBlock.initBelt(world, start);
+			var controller = (com.simibubi.create.content.kinetics.belt.BeltBlockEntity) world.getBlockEntity(start);
+			int rpm = scenario.toLowerCase(java.util.Locale.ROOT).endsWith("reverse") ? 48 : -48;
+			var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+			world.setBlockAndUpdate(start.north(), com.simibubi.create.AllBlocks.CREATIVE_MOTOR.getDefaultState()
+				.setValue(facing, net.minecraft.core.Direction.SOUTH));
+			var motor = (com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity) world.getBlockEntity(start.north());
+			motor.generatedSpeed.setValue(rpm);
+			motor.tick();
+			controller.tick();
+			if (controller.getSpeed() != rpm)
+				throw new AssertionError("Belt source did not apply the requested speed: " + controller.getSpeed());
+			if (scenario.startsWith("stopped")) {
+				motor.generatedSpeed.setValue(0);
+				motor.tick();
+				controller.tick();
+				if (controller.getSpeed() != 0)
+					throw new AssertionError("Belt source did not stop");
+			}
+			var stack = new ItemStack(com.simibubi.create.content.logistics.box.PackageStyles.ALL_BOXES.get(2));
+			var cargo = net.minecraft.core.NonNullList.withSize(9, ItemStack.EMPTY);
+			cargo.set(6, new ItemStack(Items.CLAY_BALL, 3));
+			stack.set(com.simibubi.create.AllDataComponents.PACKAGE_CONTENTS,
+				net.minecraft.world.item.component.ItemContainerContents.fromItems(cargo));
+			stack.set(com.simibubi.create.AllDataComponents.PACKAGE_ADDRESS, "Belt fixture");
+			var box = com.simibubi.create.content.logistics.box.PackageEntity.fromItemStack(world,
+				target.add(0.22, 1.75, 0.17), stack);
+			box.setYRot(47);
+			box.setDeltaMovement(0, -0.12, 0);
+			world.addFreshEntity(box);
+			for (int tick = 0; tick <= 26; tick++) {
+				if (tick > 0) {
+					if (!box.isRemoved())
+						world.tickNonPassenger(box);
+					controller.tick();
+				}
+				var actual = box.position().subtract(target);
+				var motion = box.getDeltaMovement();
+				var inventory = controller.getInventory().write(world.registryAccess());
+				var held = inventory.getList("Items", net.minecraft.nbt.Tag.TAG_COMPOUND).getCompound(0);
+				var stored = held.getCompound("Item");
+				if (!stored.isEmpty()
+					&& !ItemStack.matches(stack, ItemStack.parseOptional(world.registryAccess(), stored)))
+					throw new AssertionError("The Belt changed the Package's components");
+				var encoded = stored.isEmpty() ? "" : java.util.HexFormat.of().formatHex(
+					stored.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8));
+				System.out.printf(java.util.Locale.ROOT,
+					"PACKAGE_BELT,%s,%d,%b,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%.6f,%.4f,%.6f,%.6f,%d,%d,%b,%s%n",
+					scenario, tick, box.isRemoved(), actual.x, actual.y, actual.z, motion.x, motion.y, motion.z,
+					box.getYRot(), controller.getSpeed(), held.getFloat("Pos"), held.getFloat("PrevPos"),
+					held.getInt("InSegment"), held.getInt("InDirection"), inventory.getBoolean("PositiveOrder"), encoded);
+			}
+			box.discard();
+		}
+		helper.succeed();
+	}
 }
