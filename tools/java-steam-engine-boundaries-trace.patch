+	/**
+	 * Bounded source trace for engine count, water/heat stages and supply recovery.
+	 * Heater states are source-valid heat stages; this does not simulate player fueling.
+	 */
+	@GameTest(template = "steam_engine", timeoutTicks = 240)
+	public static void steamEngineBoundaries(CreateGameTestHelper helper) {
+		BlockPos pumpLever = new BlockPos(4, 3, 3);
+		BlockPos secondEngine = new BlockPos(2, 3, 3);
+		BlockPos heater = new BlockPos(1, 2, 1);
+		BlockPos stressometer = new BlockPos(5, 2, 5);
+		BlockPos speedometer = new BlockPos(4, 2, 5);
+		long[] origin = {-1};
+		helper.pullLever(pumpLever);
+		helper.succeedWhen(() -> {
+			long relativeTick = helper.getTick();
+			if (origin[0] < 0)
+				origin[0] = relativeTick;
+			relativeTick -= origin[0];
+
+			if (relativeTick == 1 || relativeTick == 23)
+				helper.getLevel().setBlock(helper.absolutePos(secondEngine), Blocks.AIR.defaultBlockState(), Block.UPDATE_ALL);
+			if (relativeTick == 8 || relativeTick == 27)
+				helper.getLevel().setBlock(helper.absolutePos(secondEngine),
+					AllBlocks.STEAM_ENGINE.getDefaultState()
+						.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.ATTACH_FACE,
+							net.minecraft.world.level.block.state.properties.AttachFace.WALL)
+						.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING,
+							net.minecraft.core.Direction.SOUTH), Block.UPDATE_ALL);
+
+			if (relativeTick == 20)
+				helper.getLevel().setBlock(helper.absolutePos(heater),
+					AllBlocks.BLAZE_BURNER.getDefaultState()
+						.setValue(BlazeBurnerBlock.HEAT_LEVEL, BlazeBurnerBlock.HeatLevel.KINDLED), Block.UPDATE_ALL);
+			if (relativeTick == 30)
+				helper.getLevel().setBlock(helper.absolutePos(heater),
+					AllBlocks.BLAZE_BURNER.getDefaultState()
+						.setValue(BlazeBurnerBlock.HEAT_LEVEL, BlazeBurnerBlock.HeatLevel.SEETHING), Block.UPDATE_ALL);
+			if (relativeTick == 40)
+				helper.getLevel().setBlock(helper.absolutePos(heater), Blocks.CAMPFIRE.defaultBlockState()
+					.setValue(net.minecraft.world.level.block.CampfireBlock.LIT, true), Block.UPDATE_ALL);
+
+			if (relativeTick == 50 || relativeTick == 165)
+				helper.pullLever(pumpLever);
+
+			var access = helper.getLevel().registryAccess();
+			var boiler = helper.getBlockEntity(new BlockPos(1, 3, 1)).saveWithoutMetadata(access).getCompound("Boiler");
+			var pumpA = helper.getBlockEntity(new BlockPos(3, 3, 1)).saveWithoutMetadata(access);
+			var pumpB = helper.getBlockEntity(new BlockPos(3, 3, 2)).saveWithoutMetadata(access);
+			var shaftA = helper.getBlockEntity(new BlockPos(1, 3, 5)).saveWithoutMetadata(access);
+			var shaftB = helper.getBlockEntity(new BlockPos(2, 3, 5)).saveWithoutMetadata(access);
+			var speed = helper.getBlockEntity(AllBlockEntityTypes.SPEEDOMETER.get(), speedometer);
+			var stress = helper.getBlockEntity(AllBlockEntityTypes.STRESSOMETER.get(), stressometer);
+			System.out.printf(java.util.Locale.ROOT,
+				"CREATE_STEAM_BOUNDARY %d %.4f %.4f %.4f %d %d %b %.4f %.4f %.4f %.4f %.4f %.4f%n",
+				relativeTick, boiler.getFloat("Supply"), pumpA.getFloat("Speed"), pumpB.getFloat("Speed"),
+				boiler.getInt("Engines"), boiler.getInt("ActiveHeat"), boiler.getBoolean("PassiveHeat"),
+				shaftA.getFloat("Speed"), shaftA.getFloat("EnginePower"),
+				shaftB.getFloat("Speed"), shaftB.getFloat("EnginePower"), speed.getSpeed(),
+				stress.getNetworkCapacity());
+			if (relativeTick < 220)
+				helper.fail("Waiting for the 220-tick steam boundary trace");
+		});
+	}
