+					net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(level.getBlockState(front).getBlock()),
+					counts[0], counts[1], counts[2]);
+				if (t == 3)
+					level.setBlockAndUpdate(front, Blocks.STONE.defaultBlockState());
