+		var items = net.minecraft.core.registries.BuiltInRegistries.ITEM;
+		var bread = net.minecraft.world.item.Items.BREAD;
+		var labels = java.util.List.of("furnace_bread", "smoker_bread", "furnace_scoria");
+		var inputs = java.util.List.of(com.simibubi.create.AllItems.DOUGH.get(), com.simibubi.create.AllItems.DOUGH.get(), net.minecraft.world.item.Items.SOUL_SAND);
+		var outputs = java.util.List.of(bread, bread, items.get(net.minecraft.resources.ResourceLocation.parse("create:scoria")));
+		var machines = new java.util.ArrayList<net.minecraft.world.level.block.entity.AbstractFurnaceBlockEntity>();
+		for (int i = 0; i < labels.size(); i++) {
+			var pos = new BlockPos(2, 13, 2 + 2 * i);
+			var type = i == 1 ? net.minecraft.world.level.block.Blocks.SMOKER : net.minecraft.world.level.block.Blocks.FURNACE;
+			helper.setBlock(pos, type.defaultBlockState());
+			machines.add((net.minecraft.world.level.block.entity.AbstractFurnaceBlockEntity) helper.getBlockEntity(pos));
+			System.out.printf(java.util.Locale.ROOT, "CREATE_COOKING_MATERIAL_SETUP %s,%s,%s,%s%n", labels.get(i),
+				net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(type), items.getKey(inputs.get(i)), items.getKey(outputs.get(i)));
+		}
+		helper.onEachTick(() -> {
+			long tick = helper.getTick() - 4;
+			if (tick < 0 || tick > 202)
+				return;
+			for (int i = 0; i < labels.size(); i++) {
+				var machine = machines.get(i);
+				var tag = machine.saveWithoutMetadata(world.registryAccess());
+				var result = machine.getItem(2);
+				System.out.printf(java.util.Locale.ROOT, "CREATE_COOKING_MATERIAL %d,%s,%b,%d,%d,%d,%s,%d%n", tick,
+					labels.get(i), machine.getBlockState().getValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.LIT),
+					tag.getShort("CookTime"), tag.getShort("CookTimeTotal"), machine.getItem(0).getCount(),
+					result.isEmpty() ? "-" : items.getKey(result.getItem()), result.getCount());
+				if (tick == 0) {
+					machine.setItem(0, inputs.get(i).getDefaultInstance());
+					machine.setItem(1, net.minecraft.world.item.Items.COAL.getDefaultInstance());
+				}
+				if (tick == 202)
+					helper.assertTrue(result.is(outputs.get(i)), "Missing cooking result for " + labels.get(i));
+			}
+		});
+		helper.runAtTickTime(207, helper::succeed);
+	}
