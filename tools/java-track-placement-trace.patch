+			{0,0},{0,0},{90,0},{90,0},{-70,0},{20,0},{44.5f,0}};
+		for (var angle : angles) {
+			for (var d : net.minecraft.core.Direction.Plane.HORIZONTAL)
+				level.setBlockAndUpdate(position.relative(d), net.minecraft.world.level.block.Blocks.AIR.defaultBlockState());
+			var step = switch (index) {
+				case 8 -> net.minecraft.core.Direction.SOUTH;
+				case 9 -> net.minecraft.core.Direction.NORTH;
+				case 10 -> net.minecraft.core.Direction.EAST;
+				case 11 -> net.minecraft.core.Direction.WEST;
+				default -> null;
+			};
+			if (step != null)
+				level.setBlockAndUpdate(position.relative(step), net.minecraft.world.level.block.Blocks.STONE.defaultBlockState());
+			player.setYRot(angle[0]);
+			player.setXRot(angle[1]);
+			var context = new net.minecraft.world.item.context.BlockPlaceContext(player, net.minecraft.world.InteractionHand.MAIN_HAND, stack, ray);
+			var state = track.getStateForPlacement(context);
+			var shape = state.getValue(com.simibubi.create.content.trains.track.TrackBlock.SHAPE).getSerializedName();
+			System.out.printf(java.util.Locale.ROOT, "CREATE_TRACK_PLACEMENT %d %.1f %.1f %s %s%n",
+				index++, angle[0], angle[1], step == null ? "-" : step.getSerializedName(), shape);
+		}
