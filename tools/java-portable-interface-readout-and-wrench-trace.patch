+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var wrench = com.simibubi.create.AllItems.WRENCH.asStack();
+		player.setItemInHand(hand, wrench);
+		var at = helper.absolutePos(new BlockPos(2, 3, 1));
+		var facing = net.minecraft.world.level.block.DirectionalBlock.FACING;
+		for (var block : java.util.List.of(com.simibubi.create.AllBlocks.PORTABLE_STORAGE_INTERFACE,
+			com.simibubi.create.AllBlocks.PORTABLE_FLUID_INTERFACE)) {
+			for (Direction before : Direction.values()) {
+				for (Direction hit : Direction.values()) {
+					level.setBlockAndUpdate(at, block.get().defaultBlockState().setValue(facing, before));
+					var target = new net.minecraft.world.phys.BlockHitResult(net.minecraft.world.phys.Vec3.atCenterOf(at), hit, at, false);
+					var result = wrench.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, target));
+					System.out.printf("CREATE_PORT_WRENCH %s;%s;%s;%s;%s%n", block.getId().getPath(), before, hit,
+						level.getBlockState(at).getValue(facing), result);
+				}
+			}
+			player.setShiftKeyDown(true);
+			var target = new net.minecraft.world.phys.BlockHitResult(net.minecraft.world.phys.Vec3.atCenterOf(at), Direction.UP, at, false);
+			var result = wrench.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, target));
+			System.out.printf("CREATE_PORT_WRENCH_PICKUP %s;%b;%b;%s%n", block.getId().getPath(),
+				level.isEmptyBlock(at), player.getInventory().contains(block.asStack()), result);
+			player.setShiftKeyDown(false);
+		}
+		helper.succeed();
+	}
