+	@GameTest(template = "shearing", timeoutTicks = 19)
+	public static void metalGirderNeighborConnections(CreateGameTestHelper helper) {
+		var girder = com.simibubi.create.AllBlocks.METAL_GIRDER;
+		var encased = com.simibubi.create.AllBlocks.METAL_GIRDER_ENCASED_SHAFT;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var horizontalAxis = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_AXIS;
+		var wet = net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED;
+		var xAxis = net.minecraft.core.Direction.Axis.X;
+		var zAxis = net.minecraft.core.Direction.Axis.Z;
+		var x = com.simibubi.create.content.decoration.girder.GirderBlock.X;
+		var z = com.simibubi.create.content.decoration.girder.GirderBlock.Z;
+		var top = com.simibubi.create.content.decoration.girder.GirderBlock.TOP;
+		var bottom = com.simibubi.create.content.decoration.girder.GirderBlock.BOTTOM;
+		var bareX = girder.getDefaultState().setValue(axis, xAxis).setValue(x, true);
+		var bareZ = girder.getDefaultState().setValue(axis, zAxis).setValue(z, true);
+		var encasedX = encased.getDefaultState().setValue(horizontalAxis, xAxis);
+		var post = girder.getDefaultState().setValue(top, true).setValue(bottom, true);
+		for (int index = 0; index < 3; index++) {
+			var origin = new BlockPos(12, 3, 2 + index * 6);
+			helper.setBlock(origin, (index == 2 ? encasedX : bareX).setValue(wet, index > 0));
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int index = 0; index < 3; index++) {
+				var origin = new BlockPos(12, 3, 2 + index * 6);
+				var state = helper.getBlockState(origin);
+				var first = index == 2 ? origin.above() : origin.south();
+				var second = index == 2 ? origin.below() : origin.north();
+				var neighbor = index == 0 ? bareZ : index == 1 ? encasedX : post;
+				System.out.printf(java.util.Locale.ROOT, "CREATE_GIRDER_CONNECTION,%d,%d,%s,%s,%s,%s,%s,%s%n",
+					tick, index, state.getValue(index == 2 ? horizontalAxis : axis).getName(),
+					state.hasProperty(x) && state.getValue(x), state.hasProperty(z) && state.getValue(z),
+					state.getValue(top), state.getValue(bottom), state.getValue(wet));
+				if (tick == 3)
+					helper.setBlock(first, neighbor);
+				if (tick == 6)
+					helper.setBlock(second, neighbor);
+				if (tick == 8)
+					helper.setBlock(first, net.minecraft.world.level.block.Blocks.AIR);
+				if (tick == 11)
+					helper.setBlock(second, net.minecraft.world.level.block.Blocks.AIR);
+			}
+			if (tick < 14)
+				helper.fail("Waiting for the complete girder connection trace");
+		});
+	}
 }
