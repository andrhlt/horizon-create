+				firstNetwork.getFloat("Stress"), firstNetwork.getFloat("Capacity"),
+				secondNetwork.getFloat("Stress"), secondNetwork.getFloat("Capacity"));
+			if (tick == 5 || tick == 12 || tick == 22 || tick == 30) {
