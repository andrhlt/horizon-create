+		var west = net.minecraft.core.Direction.WEST;
+		var south = net.minecraft.core.Direction.SOUTH;
+		var x = net.minecraft.core.Direction.Axis.X;
+		var z = net.minecraft.core.Direction.Axis.Z;
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(helper.getLevel());
+
+		var input = new BlockPos(11, 2, 2);
+		var first = input.east();
+		var firstCog = first.above();
+		var link = firstCog.south();
+		var second = link.south();
+		var secondCog = second.above();
+		var output = secondCog.east();
+		var far = secondCog.west();
+		helper.setBlock(first, controller.getDefaultState().setValue(horizontal, x));
+		helper.setBlock(second, controller.getDefaultState().setValue(horizontal, z));
+		helper.setBlock(firstCog, cog.getDefaultState().setValue(axis, z));
+		helper.setBlock(secondCog, cog.getDefaultState().setValue(axis, x));
+		helper.setBlock(link, shaft.getDefaultState().setValue(axis, z));
+		helper.setBlock(output, shaft.getDefaultState().setValue(axis, x));
+		helper.setBlock(output.east(), fan.getDefaultState().setValue(facing, east));
+		helper.setBlock(second.south(), fan.getDefaultState().setValue(facing, south));
+		helper.setBlock(first.east(), fan.getDefaultState().setValue(facing, east));
+		helper.setBlock(input, motor.getDefaultState().setValue(facing, east));
+		helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), input).generatedSpeed.setValue(24);
+		var firstEntity = helper.getBlockEntity(AllBlockEntityTypes.ROTATION_SPEED_CONTROLLER.get(), first);
+		var secondEntity = helper.getBlockEntity(AllBlockEntityTypes.ROTATION_SPEED_CONTROLLER.get(), second);
+		var firstCogEntity = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), firstCog);
+		var secondCogEntity = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), secondCog);
+		var linkEntity = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), link);
+		var outputEntity = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), output);
+
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			var registry = helper.getLevel().registryAccess();
+			var firstNetwork = firstEntity.saveWithoutMetadata(registry).getCompound("Network");
+			var secondNetwork = secondEntity.saveWithoutMetadata(registry).getCompound("Network");
+			System.out.printf(java.util.Locale.ROOT,
+				"CREATE_SPEED_CONTROLLER_CASCADE %d,%d,%d,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f%n",
