+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 20)
+	public static void potatoCannon(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var origin = helper.absolutePos(new BlockPos(2, 24, 2));
+		var player = new net.neoforged.neoforge.common.util.FakePlayer(world,
+			new com.mojang.authlib.GameProfile(java.util.UUID.randomUUID(), "CannonFixture"));
+		player.gameMode.changeGameModeForPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		player.setPos(origin.getX() + .5, origin.getY(), origin.getZ() + .5);
+		player.setYRot(0); player.setXRot(0);
+		var cannon = com.simibubi.create.AllItems.POTATO_CANNON.asStack();
+		player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, cannon);
+		helper.runAtTickTime(2, () -> {
+			var result = cannon.use(world, player, net.minecraft.world.InteractionHand.MAIN_HAND);
+			System.out.printf("CANNON_EMPTY,%s,%d%n", result.getResult(), cannon.getDamageValue());
+			player.getInventory().setItem(1, new ItemStack(Items.POTATO, 3));
+			result = cannon.use(world, player, net.minecraft.world.InteractionHand.MAIN_HAND);
+			var entities = world.getEntitiesOfClass(com.simibubi.create.content.equipment.potatoCannon.PotatoProjectileEntity.class,
+				new net.minecraft.world.phys.AABB(origin).inflate(10));
+			helper.assertTrue(entities.size() == 1, "Expected one potato projectile");
+			var shot = entities.get(0); var pos = shot.position(); var vel = shot.getDeltaMovement();
+			System.out.printf(java.util.Locale.ROOT, "CANNON_LAUNCH,%s,%d,%d,%b,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%s%n",
+				result.getResult(), player.getInventory().getItem(1).getCount(), cannon.getDamageValue(),
+				player.getCooldowns().isOnCooldown(cannon.getItem()), pos.x - player.getX(), pos.y - player.getY(), pos.z - player.getZ(),
+				vel.x, vel.y, vel.z, shot.getItem().getItem());
+			for (int i = 1; i <= 3; i++) {
+				final int tick = i;
+				helper.runAtTickTime(2 + i, () -> {
+					var at = shot.position(); var motion = shot.getDeltaMovement();
+					System.out.printf(java.util.Locale.ROOT, "CANNON_FLIGHT,%d,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f%n",
+						tick, at.x - player.getX(), at.y - player.getY(), at.z - player.getZ(), motion.x, motion.y, motion.z);
+					if (tick == 3) helper.succeed();
+				});
+			}
+		});
+	}
+
 }
