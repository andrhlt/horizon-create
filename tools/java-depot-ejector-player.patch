+package com.simibubi.create.infrastructure.gametest.tests;
+
+import com.simibubi.create.content.logistics.depot.EjectorBlockEntity;
+import java.util.Locale;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.BlockPos;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaEjectorClientProbe {
+	@SubscribeEvent
+	public static void tick(ClientTickEvent.Post event) {
+		var game = Minecraft.getInstance();
+		var player = game.player;
+		var level = game.level;
+		if (player == null || level == null || !Boolean.getBoolean("parity.ejector.player"))
+			return;
+		var name = player.getGameProfile().getName();
+		int z = name.equals("LaunchOne") ? -11 : -27;
+		var at = new BlockPos(5, 104, z);
+		if (!(level.getBlockEntity(at) instanceof EjectorBlockEntity ejector))
+			return;
+		var pos = player.position();
+		var motion = player.getDeltaMovement();
+		if (Math.abs(pos.z - (z + .5)) > 2 || pos.x < 4 || pos.x > 22 || pos.y < 103 || pos.y > 119)
+			return;
+		System.out.printf(Locale.ROOT, "LIVE_EJECTOR %s,%d,%s,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%b,%.2f,%b,%.4f,%.4f%n",
+			name, player.tickCount, ejector.getState(), pos.x - 5, pos.y - 104, pos.z - z,
+			motion.x, motion.y, motion.z, player.onGround(), player.getHealth(),
+			player.isFallFlying(), player.getYRot(), player.getXRot());
+	}
+}
