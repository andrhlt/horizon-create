+package com.simibubi.create.infrastructure.gametest.tests;
+
+import java.util.UUID;
+
+import com.simibubi.create.Create;
+import com.simibubi.create.content.trains.entity.Train;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.Screenshot;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.screens.BackupConfirmScreen;
+import net.minecraft.client.gui.screens.TitleScreen;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.Blocks;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+import net.neoforged.neoforge.event.tick.ServerTickEvent;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaTrainDepartureProbe {
+    static volatile UUID carriage;
+    private static final BlockPos PORT = new BlockPos(108, 115, -6);
+    private static boolean opened;
+    private static volatile boolean requested;
+    private static int elapsed;
+    private static int deadline;
+
+    private static boolean enabled() {
+        return Boolean.getBoolean("parity.movingDeparture");
+    }
+
+    private static Train train() {
+        return Create.RAILWAYS.trains.values().stream()
+            .filter(train -> train.carriages.stream().anyMatch(carriage -> {
+                var entity = carriage.anyAvailableEntity();
+                return entity != null && entity.getUUID().equals(JavaTrainDepartureProbe.carriage);
+            }))
+            .findFirst().orElse(null);
+    }
+
+    @SubscribeEvent
+    public static void observe(ServerTickEvent.Post event) {
+        if (!enabled() || !requested)
+            return;
+        var server = event.getServer();
+        var level = server.overworld();
+        var train = train();
+        if (train == null)
+            return;
+        var entity = train.carriages.getFirst().anyAvailableEntity();
+        if (entity == null)
+            return;
+        System.out.printf(java.util.Locale.ROOT, "JAVA_TRAIN_DEPART_AUTH %d;%.9f;%.9f;%.9f;%s;%d;%b%n",
+            level.getGameTime(), entity.getX(), entity.getZ(), train.speed,
+            train.runtime.state, train.runtime.currentEntry, train.runtime.paused);
+    }
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post event) {
+        if (!enabled())
+            return;
+        var mc = Minecraft.getInstance();
+        if (mc.getOverlay() == null && mc.screen instanceof TitleScreen && !opened) {
+            opened = true;
+            mc.createWorldOpenFlows().openWorld("MovingPortDepartureReference", mc::stop);
+        }
+        if (mc.screen instanceof BackupConfirmScreen backup)
+            backup.children().stream().filter(Button.class::isInstance).map(Button.class::cast)
+                .filter(button -> button.getMessage().getContents() instanceof net.minecraft.network.chat.contents.TranslatableContents name
+                    && name.getKey().equals("selectWorld.backupJoinSkipButton")).findFirst().ifPresent(Button::onPress);
+        var server = mc.getSingleplayerServer();
+        if (mc.player == null || mc.level == null || server == null || mc.getOverlay() != null)
+            return;
+        if (!requested) {
+            requested = true;
+            var name = mc.player.getGameProfile().getName();
+            server.execute(() -> {
+                var command = server.createCommandSourceStack().withPermission(4);
+                server.getCommands().performPrefixedCommand(command, "gamemode spectator " + name);
+                server.getCommands().performPrefixedCommand(command, "tp " + name + " 104.5 117.2 -5.7 -84 19");
+                var player = server.getPlayerList().getPlayerByName(name);
+                server.getCommands().performPrefixedCommand(
+                    player.createCommandSourceStack().withPermission(4), "test run testmisc.scheduledtrainfixedportlifecycle");
+                System.out.println("JAVA_TRAIN_DEPART_TEST requested");
+            });
+            mc.options.hideGui = true;
+            return;
+        }
+        if (++deadline >= 320) {
+            mc.stop();
+            return;
+        }
+        if (mc.level.getBlockEntity(PORT) == null)
+            return;
+        elapsed++;
+        if (elapsed == 35 || elapsed == 70 || elapsed == 95 || elapsed == 110 || elapsed == 130)
+            Screenshot.grab(mc.gameDirectory, "train-departure-port-" + elapsed + ".png", mc.getMainRenderTarget(), message -> {});
+        if (elapsed == 240)
+            mc.stop();
+    }
+}
