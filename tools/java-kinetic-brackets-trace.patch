+
+	@GameTest(template = "shearing", timeoutTicks = 18)
+	public static void kineticBrackets(CreateGameTestHelper helper) {
+		var wood = com.simibubi.create.AllBlocks.WOODEN_BRACKET;
+		var metal = com.simibubi.create.AllBlocks.METAL_BRACKET;
+		var shaft = com.simibubi.create.AllBlocks.SHAFT;
+		var cog = com.simibubi.create.AllBlocks.COGWHEEL;
+		var wrench = com.simibubi.create.AllItems.WRENCH;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var up = net.minecraft.core.Direction.UP;
+		var south = net.minecraft.core.Direction.SOUTH;
+		var x = net.minecraft.core.Direction.Axis.X;
+		var y = net.minecraft.core.Direction.Axis.Y;
+		var level = helper.getLevel();
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var horizontal = new BlockPos(12, 3, 2);
+		var vertical = new BlockPos(18, 3, 2);
+		var invalid = new BlockPos(22, 3, 2);
+		helper.setBlock(horizontal, shaft.getDefaultState().setValue(axis, x));
+		helper.setBlock(vertical, cog.getDefaultState().setValue(axis, y));
+		helper.setBlock(invalid, Blocks.STONE);
+		player.getInventory().clearContent();
+		player.getInventory().setItem(0, new ItemStack(wood.asItem(), 2));
+		player.getInventory().setItem(1, new ItemStack(metal.asItem(), 2));
+		player.getInventory().setItem(2, wrench.asStack());
+
+		var type = com.simibubi.create.content.decoration.bracket.BracketBlock.TYPE;
+		var along = com.simibubi.create.content.decoration.bracket.BracketBlock.AXIS_ALONG_FIRST_COORDINATE;
+		var decorator = com.simibubi.create.content.decoration.bracket.BracketedBlockEntityBehaviour.TYPE;
+		java.util.function.Function<BlockPos, String> bracketAt = at -> {
+			var behaviour = com.simibubi.create.foundation.blockEntity.behaviour.BlockEntityBehaviour.get(
+				level, helper.absolutePos(at), decorator);
+			var state = behaviour == null ? null : behaviour.getBracket();
+			if (state == null)
+				return "none,none,none,false";
+			return (wood.has(state) ? "wood" : "metal") + "," + state.getValue(type).getSerializedName()
+				+ "," + state.getValue(facing).getSerializedName() + "," + state.getValue(along);
+		};
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			var bounds = new net.minecraft.world.phys.AABB(helper.absolutePos(vertical)).inflate(2);
+			int dropped = level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class,
+				bounds, item -> item.getItem().is(wood.asItem())).stream()
+				.mapToInt(item -> item.getItem().getCount()).sum();
+			System.out.printf("CREATE_BRACKETS,%d,%s,%s,%d,%d,%d%n", tick, bracketAt.apply(horizontal),
+				bracketAt.apply(vertical), player.getInventory().countItem(wood.asItem()),
+				player.getInventory().countItem(metal.asItem()), dropped);
+
+			if (tick == 10)
+				level.destroyBlock(helper.absolutePos(vertical), true);
+
+			int slot = switch ((int) tick) {
+				case 2, 3, 4, 8 -> 0;
+				case 5 -> 1;
+				case 7 -> 2;
+				default -> -1;
+			};
+			if (slot >= 0) {
+				player.getInventory().selected = slot;
+				var at = helper.absolutePos(tick == 2 ? invalid : tick == 8 ? vertical : horizontal);
+				var face = tick == 8 ? south : up;
+				player.setPos(at.getX() - 2, at.getY(), at.getZ());
+				var hit = new net.minecraft.world.phys.BlockHitResult(at.getCenter().relative(face, 0.4), face, at, false);
+				player.getItemInHand(hand).useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+			}
+
+			if (tick < 13)
+				helper.fail("Waiting for complete wooden and metal bracket observations");
+		});
+	}
 }
