+
+	@GameTest(template = "shearing")
+	public static void encasedCogwheelRimAssist(CreateGameTestHelper helper) {
+		var small = com.simibubi.create.AllBlocks.COGWHEEL;
+		var large = com.simibubi.create.AllBlocks.LARGE_COGWHEEL;
+		var encased = com.simibubi.create.AllBlocks.BRASS_ENCASED_COGWHEEL;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var east = net.minecraft.core.Direction.EAST;
+		var up = net.minecraft.core.Direction.UP;
+		var y = net.minecraft.core.Direction.Axis.Y;
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(helper.getLevel());
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		int[][] offsets = {
+			{1, 0, 0}, {1, 0, -1}, {1, 0, 1}, {1, 0, 1}, {0, 1, 0},
+		};
+		for (int index = 0; index < offsets.length; index++) {
+			var pos = new BlockPos(12 + index * 5, 3, 2);
+			var wheel = index >= 1 && index <= 3 ? large : small;
+			helper.setBlock(pos, encased.getDefaultState().setValue(axis, y));
+			if (index == 2)
+				helper.setBlock(pos.east().north(), Blocks.STONE);
+			if (index == 3)
+				helper.setBlock(pos.east().north().east(), large.getDefaultState().setValue(axis, y));
+			var at = helper.absolutePos(pos);
+			player.setPos(at.getX() + 2, at.getY(), at.getZ());
+			player.setShiftKeyDown(false);
+			var face = index == 4 ? up : east;
+			double hitX = index == 4 ? 0.5 : 0.998;
+			double hitY = index == 4 ? 0.999 : 0.5;
+			double hitZ = index >= 1 && index <= 3 ? 0.2 : 0.5;
+			var hit = new net.minecraft.world.phys.BlockHitResult(
+				net.minecraft.world.phys.Vec3.atLowerCornerWithOffset(at, hitX, hitY, hitZ),
+				face, at, false);
+			var held = new ItemStack(wheel.asItem(), 2);
+			player.setItemInHand(hand, held);
+			var context = new net.minecraft.world.item.context.UseOnContext(player, hand, hit);
+			var item = (com.simibubi.create.content.kinetics.simpleRelays.CogwheelBlockItem) wheel.asItem();
+			var assisted = item.onItemUseFirst(held, context);
+			if (assisted == net.minecraft.world.InteractionResult.PASS)
+				held.useOn(context);
+
+			var delta = offsets[index];
+			var placed = helper.getBlockState(pos.offset(delta[0], delta[1], delta[2]));
+			var name = small.has(placed) ? "small" : large.has(placed) ? "large" : "none";
+			System.out.printf("CREATE_ENCASED_COG_ASSIST,%d,%d,%d,%d,%s,%s,%d,%s%n",
+				index, delta[0], delta[1], delta[2], name,
+				name.equals("none") ? "none" : placed.getValue(axis).getName(), held.getCount(), assisted);
+		}
+		helper.succeed();
+	}
 }
