+
+
+
+	@GameTest(template = "shearing", timeoutTicks = 24)
+	public static void metalGirderShaftInsertionAndWrench(CreateGameTestHelper helper) {
+		var girder = com.simibubi.create.AllBlocks.METAL_GIRDER;
+		var encased = com.simibubi.create.AllBlocks.METAL_GIRDER_ENCASED_SHAFT;
+		var shaft = com.simibubi.create.AllBlocks.SHAFT;
+		var xAxis = net.minecraft.core.Direction.Axis.X;
+		var zAxis = net.minecraft.core.Direction.Axis.Z;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var horizontalAxis = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var waterlogged = net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED;
+		var x = com.simibubi.create.content.decoration.girder.GirderBlock.X;
+		var z = com.simibubi.create.content.decoration.girder.GirderBlock.Z;
+		var top = com.simibubi.create.content.decoration.girder.GirderBlock.TOP;
+		var bottom = com.simibubi.create.content.decoration.girder.GirderBlock.BOTTOM;
+		var east = net.minecraft.core.Direction.EAST;
+		var south = net.minecraft.core.Direction.SOUTH;
+		var up = net.minecraft.core.Direction.UP;
+		var lever = new int[] {2, 2};
+		var level = helper.getLevel();
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		java.util.function.Function<BlockPos, Float> speed = pos -> {
+			var entity = level.getBlockEntity(helper.absolutePos(pos));
+			return entity instanceof com.simibubi.create.content.kinetics.base.KineticBlockEntity kinetic
+				? kinetic.getSpeed() : 0.0f;
+		};
+		for (int variant = 0; variant < 2; variant++) {
+			var pos = new BlockPos(12, 3, 2 + 5 * variant);
+			var direction = variant == 0 ? south : east;
+			var beam = variant == 0 ? xAxis : zAxis;
+			var input = pos.relative(direction.getOpposite());
+			var output = pos.relative(direction);
+			helper.setBlock(input, com.simibubi.create.AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, direction));
+			helper.setBlock(output, shaft.getDefaultState().setValue(axis, direction.getAxis()));
+			if (variant == 0) {
+				helper.setBlock(pos.above(), girder.getDefaultState().setValue(top, true).setValue(bottom, true));
+				helper.setBlock(pos.below(), girder.getDefaultState().setValue(top, true).setValue(bottom, true));
+			}
+			helper.setBlock(pos, girder.getDefaultState()
+				.setValue(axis, beam).setValue(x, beam == xAxis).setValue(z, beam == zAxis)
+				.setValue(top, variant == 0).setValue(bottom, variant == 0).setValue(waterlogged, variant == 0));
+			helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), input).generatedSpeed.setValue(32);
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int variant = 0; variant < 2; variant++) {
+				var pos = new BlockPos(12, 3, 2 + 5 * variant);
+				var output = pos.relative(variant == 0 ? south : east);
+				var state = helper.getBlockState(pos);
+				boolean hasShaft = encased.has(state);
+				System.out.printf(java.util.Locale.ROOT,
+					"CREATE_METAL_GIRDER_SHAFT,%d,%d,%s,%s,%s,%s,%s,%s,%s,%d,%.4f,%.4f%n",
+					tick, variant, hasShaft ? "encased" : girder.has(state) ? "girder" : "other",
+					state.getValue(hasShaft ? horizontalAxis : axis).getName(),
+					!hasShaft && state.getValue(x), !hasShaft && state.getValue(z), state.getValue(top), state.getValue(bottom),
+					state.getValue(waterlogged), lever[variant], speed.apply(pos), speed.apply(output));
+				if (tick == 0 || tick == 4) {
+					var at = helper.absolutePos(pos);
+					System.out.printf("CREATE_METAL_GIRDER_SHAPE,%d,%d,%s%n", tick, variant, state.getShape(level, at).toAabbs());
+				}
+				if (tick == 3 || tick == 8) {
+					var at = helper.absolutePos(pos);
+					player.setPos(at.getX(), at.getY(), at.getZ() - 2);
+					player.setShiftKeyDown(false);
+					player.getInventory().clearContent();
+					var face = variant == 0 ? east.getOpposite() : up;
+					var hit = new net.minecraft.world.phys.BlockHitResult(at.getCenter().relative(face, 0.4), face, at, false);
+					if (tick == 3) {
+						var held = new ItemStack(shaft.asItem(), lever[variant]);
+						player.setItemInHand(hand, held);
+						state.useItemOn(held, level, player, hand, hit);
+					} else {
+						var wrench = com.simibubi.create.AllItems.WRENCH.asStack();
+						player.setItemInHand(hand, wrench);
+						player.getInventory().add(new ItemStack(shaft.asItem(), lever[variant]));
+						wrench.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+					}
+					lever[variant] = player.getInventory().countItem(shaft.asItem());
+				}
+			}
+			if (tick < 12)
+				helper.fail("Waiting for the complete metal girder shaft trace");
+		});
+	}
 }
