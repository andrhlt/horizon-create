+	@GameTest(template = "wheat_milling", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
+	public static void stickerBounceOracle(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var pos = helper.absolutePos(new BlockPos(5, 11, 1));
+		var block = AllBlocks.STICKER.get();
+		var facing = com.simibubi.create.content.contraptions.chassis.StickerBlock.FACING;
+		var extended = com.simibubi.create.content.contraptions.chassis.StickerBlock.EXTENDED;
+		for (var dir : new net.minecraft.core.Direction[]{net.minecraft.core.Direction.UP, net.minecraft.core.Direction.NORTH})
+		for (boolean ext : new boolean[]{false, true}) {
+			var state = block.defaultBlockState().setValue(facing, dir).setValue(extended, ext);
+			level.setBlock(pos, state, 3);
+			var pig = net.minecraft.world.entity.EntityType.PIG.create(level);
+			pig.setPos(pos.getX()+0.5, pos.getY()+1, pos.getZ()+0.5);
+			pig.setDeltaMovement(0.5, -0.6, 0.25);
+			block.updateEntityAfterFallOn(level, pig);
+			var v = pig.getDeltaMovement();
+			System.out.printf(java.util.Locale.ROOT, "STICKER_BOUNCE %s,%s,%.3f,%.3f,%.3f%n", dir, ext, v.x, v.y, v.z);
+			pig.setDeltaMovement(0.5, 0, 0.25);
+			block.stepOn(level, pos, state, pig);
+			v = pig.getDeltaMovement();
+			System.out.printf(java.util.Locale.ROOT, "STICKER_DRAG %s,%s,%.3f,%.3f,%.3f%n", dir, ext, v.x, v.y, v.z);
+		}
+		helper.succeed();
+	}
