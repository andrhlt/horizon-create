+	@GameTest(template = "shearing", timeoutTicks = 50)
+	public static void stockpileSwitchTargets(CreateGameTestHelper helper) {
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		var tankSwitch = new BlockPos(12, 7, 4);
+		var ropeSwitch = new BlockPos(12, 7, 8);
+		var tankPos = tankSwitch.south();
+		var ropePos = ropeSwitch.south();
+		helper.setBlock(tankPos, com.simibubi.create.AllBlocks.FLUID_TANK.get());
+		helper.setBlock(ropePos, com.simibubi.create.AllBlocks.ROPE_PULLEY.get());
+		for (var pos : new BlockPos[] {tankSwitch, ropeSwitch})
+			helper.setBlock(pos, com.simibubi.create.AllBlocks.THRESHOLD_SWITCH.getDefaultState()
+				.setValue(facing, net.minecraft.core.Direction.SOUTH));
+		var tank = (com.simibubi.create.content.fluids.tank.FluidTankBlockEntity)
+			helper.getLevel().getBlockEntity(helper.absolutePos(tankPos));
+		var pulley = (com.simibubi.create.content.contraptions.pulley.PulleyBlockEntity)
+			helper.getLevel().getBlockEntity(helper.absolutePos(ropePos));
+		var fluid = net.minecraft.world.level.material.Fluids.WATER;
+		var action = net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE;
+		tank.getTankInventory().fill(new net.neoforged.neoforge.fluids.FluidStack(fluid, 2000), action);
+		var player = new net.minecraft.server.level.ServerPlayer(helper.getLevel().getServer(), helper.getLevel(),
+			new com.mojang.authlib.GameProfile(java.util.UUID.randomUUID(), "StockpileTargets"),
+			net.minecraft.server.level.ClientInformation.createDefault());
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int i = 0; i < 2; i++) {
+				var pos = i == 0 ? tankSwitch : ropeSwitch;
+				var absolute = helper.absolutePos(pos);
+				player.setPos(absolute.getX() + 0.5, absolute.getY(), absolute.getZ() - 2.5);
+				int ymax = helper.absolutePos(ropePos).getY();
+				if (tick == 4 || tick == 25) {
+					int lower = i == 0 ? 1000 : ymax - 8;
+					int upper = i == 0 ? 3000 : ymax - 2;
+					new com.simibubi.create.content.redstone.thresholdSwitch.ConfigureThresholdSwitchPacket(
+						absolute, lower, upper, tick == 25, false).handle(player);
+				}
+				if (tick == 13) {
+					if (i == 0)
+						tank.getTankInventory().fill(new net.neoforged.neoforge.fluids.FluidStack(fluid, 2000), action);
+					else
+						pulley.animateOffset(10);
+				}
+				if (tick == 27) {
+					if (i == 0)
+						tank.getTankInventory().drain(3500, action);
+					else
+						pulley.animateOffset(0);
+				}
+				var be = helper.getBlockEntity(AllBlockEntityTypes.THRESHOLD_SWITCH.get(), pos);
+				System.out.printf("STOCKPILE_TARGETS,%d,%d,%s,%d,%d,%d,%d,%d,%b,%b,%b,%d,%d%n",
+					tick, i, be.getTypeOfCurrentTarget(), be.getMinLevel(), be.getStockLevel(), be.getMaxLevel(),
+					be.offWhenBelow, be.onWhenAbove, be.isInverted(), be.getState(), be.isPowered(),
+					be.getBlockState().getValue(com.simibubi.create.content.redstone.thresholdSwitch.ThresholdSwitchBlock.LEVEL), ymax);
+			}
+			helper.assertTrue(tick == 42, "sampling stockpile target ticks");
+		});
+	}
