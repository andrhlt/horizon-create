+				.setValue(net.minecraft.world.level.block.DirectionalBlock.FACING, net.minecraft.core.Direction.EAST));
+			level.setBlockAndUpdate(bin.east().above(), AllBlocks.STOCK_LINK.getDefaultState());
+			level.getBlockEntity(bin.east().above(), com.simibubi.create.AllBlockEntityTypes.PACKAGER_LINK.get())
+				.orElseThrow().behaviour.freqId = frequency;
+		});
