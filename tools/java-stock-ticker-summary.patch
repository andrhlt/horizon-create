+			final int atTick = tick;
+			helper.runAtTickTime(tick, () -> {
+				var ticker = level.getBlockEntity(at, com.simibubi.create.AllBlockEntityTypes.STOCK_TICKER.get())
+					.orElseThrow();
+				if (atTick == 5)
+					((net.minecraft.world.level.block.entity.BarrelBlockEntity) level.getBlockEntity(bin))
+						.setItem(0, iron.copyWithCount(3));
+				var recent = ticker.getRecentSummary();
+				var accurate = ticker.getAccurateSummary();
+				System.out.printf("CREATE_STOCK_TICKER_SUMMARY %d,%d,%d,%d,%d%n", atTick, recent.getCountOf(iron),
+					recent.contributingLinks, accurate.getCountOf(iron), accurate.contributingLinks);
+				if (atTick == 27)
+					helper.succeed();
+			});
+		}
+	}
