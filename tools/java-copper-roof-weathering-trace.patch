+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 20)
+	public static void copperRoofActions(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var pos = helper.absolutePos(new BlockPos(1, 2, 1)).above(12);
+		var registry = net.minecraft.core.registries.BuiltInRegistries.BLOCK;
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		level.setBlockAndUpdate(pos.below(), Blocks.SMOOTH_STONE.defaultBlockState());
+		player.setPos(pos.getX() + 0.5, pos.getY(), pos.getZ() + 2.5);
+		var hit = new net.minecraft.world.phys.BlockHitResult(
+			net.minecraft.world.phys.Vec3.atCenterOf(pos), net.minecraft.core.Direction.SOUTH, pos, false);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		java.util.function.Supplier<net.minecraft.world.item.context.UseOnContext> context =
+			() -> new net.minecraft.world.item.context.UseOnContext(player, hand, hit);
+		var waterlogged = net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		for (var set : java.util.List.of(com.simibubi.create.AllBlocks.COPPER_SHINGLES,
+			com.simibubi.create.AllBlocks.COPPER_TILES)) {
+			for (var age : net.minecraft.world.level.block.WeatheringCopper.WeatherState.values()) {
+				for (var shape : com.simibubi.create.foundation.block.CopperBlockSet.DEFAULT_VARIANTS) {
+					var state = set.get(shape, age, false).get().defaultBlockState();
+					if (state.hasProperty(waterlogged)) state = state.setValue(waterlogged, true);
+					if (state.hasProperty(facing)) state = state.setValue(facing, net.minecraft.core.Direction.WEST);
+					level.setBlockAndUpdate(pos, state);
+					player.setItemInHand(hand, new ItemStack(Items.HONEYCOMB, 2));
+					var wax = Items.HONEYCOMB.useOn(context.get());
+					var waxed = level.getBlockState(pos);
+					var honeycomb = player.getItemInHand(hand).getCount();
+					player.setItemInHand(hand, Items.IRON_AXE.getDefaultInstance());
+					var strip = Items.IRON_AXE.useOn(context.get());
+					var stripped = level.getBlockState(pos);
+					var afterStrip = player.getItemInHand(hand).getDamageValue();
+					var scratch = Items.IRON_AXE.useOn(context.get());
+					var scratched = level.getBlockState(pos);
+					var afterScratch = player.getItemInHand(hand).getDamageValue();
+					System.out.printf(java.util.Locale.ROOT,
+						"CREATE_COPPER_ACTION %s;%s;%s;%d;%s;%s;%d;%s;%s;%d%n",
+						state, wax, waxed, honeycomb, strip, stripped, afterStrip, scratch, scratched, afterScratch);
+				}
+			}
+		}
+		helper.succeed();
+	}
