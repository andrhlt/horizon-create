+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 20)
+	public static void copperRoofOxidation(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var pos = helper.absolutePos(new BlockPos(1, 2, 1)).above(12);
+		var random = net.minecraft.util.RandomSource.create(589234123149L);
+		var initial = net.minecraft.world.level.block.WeatheringCopper.WeatherState.UNAFFECTED;
+		var waterlogged = net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		var roof = com.simibubi.create.AllBlocks.COPPER_SHINGLES;
+		for (var shape : com.simibubi.create.foundation.block.CopperBlockSet.DEFAULT_VARIANTS) {
+			for (boolean waxed : new boolean[] { false, true }) {
+				var state = roof.get(shape, initial, waxed).get().defaultBlockState();
+				if (state.hasProperty(waterlogged)) state = state.setValue(waterlogged, true);
+				if (state.hasProperty(facing)) state = state.setValue(facing, net.minecraft.core.Direction.WEST);
+				level.setBlockAndUpdate(pos, state);
+				var phases = new java.util.ArrayList<String>();
+				phases.add(state.toString());
+				for (int i = 0; i < 4096; i++) {
+					if (state.isRandomlyTicking()) state.randomTick(level, pos, random);
+					var next = level.getBlockState(pos);
+					if (next != state) {
+						phases.add(next.toString());
+						state = next;
+					}
+				}
+				helper.assertTrue(phases.size() == (waxed ? 1 : 4), "Unexpected copper progression " + phases);
+				System.out.println("CREATE_COPPER_OXIDATION " + String.join(";", phases));
+			}
+		}
+		helper.succeed();
+	}
 }
