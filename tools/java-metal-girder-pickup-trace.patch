+
+
+
+	@GameTest(template = "shearing", timeoutTicks = 18)
+	public static void metalGirderShaftPickupAndDrops(CreateGameTestHelper helper) {
+		var girder = com.simibubi.create.AllBlocks.METAL_GIRDER;
+		var encased = com.simibubi.create.AllBlocks.METAL_GIRDER_ENCASED_SHAFT;
+		var shaft = com.simibubi.create.AllBlocks.SHAFT;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var horizontalAxis = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var waterlogged = net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED;
+		var east = net.minecraft.core.Direction.EAST;
+		var up = net.minecraft.core.Direction.UP;
+		var level = helper.getLevel();
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var heldGirder = new int[3];
+		var heldShaft = new int[3];
+		for (int index = 0; index < 3; index++) {
+			var pos = new BlockPos(12, 3, 2 + 5 * index);
+			var source = pos.west();
+			helper.setBlock(source, com.simibubi.create.AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, east));
+			helper.setBlock(pos.east(), shaft.getDefaultState().setValue(axis, east.getAxis()));
+			helper.setBlock(pos, encased.getDefaultState().setValue(horizontalAxis, east.getAxis()).setValue(waterlogged, index == 1));
+			helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), source).generatedSpeed.setValue(32);
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int index = 0; index < 3; index++) {
+				var pos = new BlockPos(12, 3, 2 + 5 * index);
+				var at = helper.absolutePos(pos);
+				var state = helper.getBlockState(pos);
+				var output = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), pos.east());
+				var items = level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class,
+					new net.minecraft.world.phys.AABB(at).inflate(1.5));
+				int droppedGirder = 0;
+				int droppedShaft = 0;
+				for (var item : items) {
+					var stack = item.getItem();
+					if (stack.is(girder.asItem()))
+						droppedGirder += stack.getCount();
+					if (stack.is(shaft.asItem()))
+						droppedShaft += stack.getCount();
+				}
+				String block = encased.has(state) ? "encased" : state.isAir() ? "air"
+					: state.is(net.minecraft.world.level.block.Blocks.WATER) ? "water" : "unexpected";
+				System.out.printf(java.util.Locale.ROOT,
+					"CREATE_GIRDER_PICKUP,%d,%d,%s,%d,%d,%d,%d,%.4f%n",
+					tick, index, block, heldGirder[index], heldShaft[index],
+					droppedGirder, droppedShaft, output.getSpeed());
+				if (tick == 3) {
+					if (index == 2) {
+						level.destroyBlock(at, true);
+						continue;
+					}
+					player.setPos(at.getX(), at.getY(), at.getZ() - 2);
+					player.setShiftKeyDown(true);
+					player.getInventory().clearContent();
+					var wrench = com.simibubi.create.AllItems.WRENCH.asStack();
+					player.setItemInHand(hand, wrench);
+					var hit = new net.minecraft.world.phys.BlockHitResult(at.getCenter().relative(up, 0.4), up, at, false);
+					wrench.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+					heldGirder[index] = player.getInventory().countItem(girder.asItem());
+					heldShaft[index] = player.getInventory().countItem(shaft.asItem());
+					player.setShiftKeyDown(false);
+				}
+			}
+			if (tick < 8)
+				helper.fail("Waiting for the complete girder pickup and drops trace");
+		});
+	}
 }
