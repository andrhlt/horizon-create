+					var point = wheel.getPosition(train.graph).subtract(origin.getX(), origin.getY(), origin.getZ());
+					output.append(String.format(java.util.Locale.ROOT, " %.9f %.9f %.9f", point.x, point.y, point.z));
+				}
+                var station = (com.simibubi.create.content.trains.station.StationBlockEntity) level.getBlockEntity(arrival);
+                var global = station.getStation();
+                boolean approaching = global != null && train.navigation.destination == global;
+                boolean stopped = global != null && train.getCurrentStation() == global;
+                output.append(String.format(java.util.Locale.ROOT, " %d %d %.9f",
+                    approaching ? 1 : 0, stopped ? 1 : 0, approaching ? train.navigation.distanceToDestination : 0));
+                System.out.println(output);
+				if (t >= 24 && t < 220) {
+					var entity = c.anyAvailableEntity();
+					helper.assertTrue(entity != null, "Assembled carriage entity was not available");
+					var controls = new BlockPos(0, 2, 0);
+					var at = entity.toGlobalVector(net.minecraft.world.phys.Vec3.atCenterOf(controls), 0);
+					player.setPos(at.x, at.y, at.z + 1.5);
+					if (t == 24)
+						helper.assertTrue(entity.startControlling(controls, player), "Player could not take controls");
+					var keys = t < 42 ? java.util.List.of(0) : java.util.List.of(4);
+					helper.assertTrue(entity.control(controls, keys, player), "Train control was refused at " + t);
+				}
+                if (t == 220) {
+                    helper.assertTrue(stopped, "Expected the driver to reach the station beyond the curve");
+                    helper.assertTrue(station.tryDisassembleTrain(null), "Unable to disassemble at the curved destination");
+                    var front = level.getBlockState(arrivalRail.south().above());
+                    var rear = level.getBlockState(arrivalRail.south(4).above());
+                    var rotated = level.getBlockState(arrivalRail.south().above(3));
+                    System.out.println("CREATE_BRANCHED_STATION_BLOCKS " + front + ";" + rear + ";" + rotated);
+                    helper.assertTrue(com.simibubi.create.AllBlocks.SMALL_BOGEY.has(front)
