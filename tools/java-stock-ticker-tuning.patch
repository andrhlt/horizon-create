+		};
+		helper.runAtTickTime(2, () -> {
+			var stone = net.minecraft.world.level.block.Blocks.STONE.defaultBlockState();
+			for (var pos : java.util.List.of(link, target, reversed))
+				level.setBlockAndUpdate(pos.below(), stone);
+			level.setBlockAndUpdate(link, AllBlocks.STOCK_LINK.getDefaultState());
+			level.getBlockEntity(link, com.simibubi.create.AllBlockEntityTypes.PACKAGER_LINK.get()).orElseThrow().behaviour.freqId = frequency;
+			player.setItemInHand(hand, block.asStack());
+		});
+		helper.runAtTickTime(3, () -> {
+			var result = useOn.apply(link);
+			var held = player.getItemInHand(hand);
+			var linked = com.simibubi.create.content.logistics.packagerLink.LogisticallyLinkedBlockItem.networkFromStack(held);
+			var type = held.get(net.minecraft.core.component.DataComponents.BLOCK_ENTITY_DATA).copyTag().getString("id");
+			System.out.printf("CREATE_TICKER_TUNING %d,tune,%b,%d,%b,%b,%s,_%n", helper.getTick(),
+				result.consumesAction(), held.getCount(), held.hasFoil(), frequency.equals(linked), type);
+		});
+		for (int i = 0; i < 2; i++) {
+			boolean sneaking = i == 1;
+			var pos = sneaking ? reversed : target;
+			helper.runAtTickTime(4 + i, () -> {
+				if (sneaking) {
+					player.setItemInHand(hand, block.asStack());
+					player.setShiftKeyDown(true);
+				}
+				var result = useOn.apply(pos.below());
+				var entity = level.getBlockEntity(pos, com.simibubi.create.AllBlockEntityTypes.STOCK_TICKER.get()).orElseThrow();
+				var facing = level.getBlockState(pos).getValue(net.minecraft.world.level.block.HorizontalDirectionalBlock.FACING);
+				System.out.printf("CREATE_TICKER_TUNING %d,%s,%b,%d,%b,%b,create:stock_ticker,%s%n", helper.getTick(),
+					sneaking ? "sneak_place" : "place", result.consumesAction(), player.getItemInHand(hand).getCount(),
+					false, frequency.equals(entity.behaviour.freqId), facing.getSerializedName());
+				if (sneaking)
+					helper.succeed();
+			});
+		}
+	}
