+		var block = AllBlocks.STOCK_TICKER;
+		var useOn = (java.util.function.Function<BlockPos, net.minecraft.world.InteractionResult>) pos -> {
+			player.setPos(pos.getX() + .5, pos.getY(), pos.getZ() + 2.5);
+			player.setYRot(180);
+			var hit = new net.minecraft.world.phys.BlockHitResult(pos.getCenter().relative(side, .5), side, pos, false);
