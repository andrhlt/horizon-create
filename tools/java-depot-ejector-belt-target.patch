+			if (tick == 24) {
+				level.setBlockAndUpdate(start.north(), AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, south));
+				((com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity) level.getBlockEntity(start.north()))
+					.generatedSpeed.setValue(-48);
+			}
+			helper.assertTrue(tick >= 63 && count == 3 && loose == 0,
+				"The starting Belt must receive three ingots without spilling a loose item.");
+			level.setChunkForced(chunk.x, chunk.z, false);
+		});
+	}
