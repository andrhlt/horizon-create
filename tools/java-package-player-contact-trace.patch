+	@GameTest(template = "shearing", timeoutTicks = 45)
+	public static void packagePlayerContactOwner(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var floor = helper.absolutePos(new BlockPos(4, 4, 2));
+		var origin = net.minecraft.world.phys.Vec3.atLowerCornerOf(floor).add(0.3, 0, 0.5);
+		for (int x = -2; x <= 2; x++) {
+			for (int z = -2; z <= 2; z++) {
+				world.setBlockAndUpdate(floor.offset(x, -1, z), Blocks.OBSIDIAN.defaultBlockState());
+				for (int y = 0; y < 4; y++)
+					world.setBlockAndUpdate(floor.offset(x, y, z), Blocks.AIR.defaultBlockState());
+			}
+		}
+		var owner = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		owner.setPos(origin.x, origin.y, origin.z);
+		owner.setYRot(0);
+		owner.setXRot(0);
+		var style = com.simibubi.create.content.logistics.box.PackageStyles.ALL_BOXES.get(2);
+		for (String scenario : new String[]{"above", "level", "clear"}) {
+			double dy = switch (scenario) {
+				case "above" -> 0.25;
+				case "clear" -> 0.55;
+				default -> 0;
+			};
+			for (int y = 0; y < 3; y++)
+				for (int z = -1; z <= 0; z++)
+					world.setBlockAndUpdate(floor.offset(1, y, z), Blocks.OBSIDIAN.defaultBlockState());
+			var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+			double wallContactX = floor.getX() + 1 - (double) player.getBbWidth() / 2;
+			var contactPosition = new net.minecraft.world.phys.Vec3(wallContactX, origin.y + dy, origin.z);
+			player.setPos(contactPosition);
+			player.setNoGravity(true);
+			var contact = player;
+			world.addFreshEntity(contact);
+			var stack = new ItemStack(style);
+			style.releaseUsing(stack, world, owner, style.getUseDuration(stack, owner) - 20);
+			var box = world.getEntitiesOfClass(com.simibubi.create.content.logistics.box.PackageEntity.class,
+				new net.minecraft.world.phys.AABB(floor).inflate(4),
+				candidate -> candidate.tossedBy.get() == owner).stream().findFirst().orElseThrow();
+			box.setPos(origin);
+			box.setDeltaMovement(net.minecraft.world.phys.Vec3.ZERO);
+			box.setNoGravity(true);
+			for (int tick = 0; tick < 8; tick++) {
+				if (tick > 0) {
+					world.tickNonPassenger(contact);
+					world.tickNonPassenger(box);
+				}
+				System.out.printf(java.util.Locale.ROOT, "PACKAGE_PLAYER_CONTACT_OWNER,%s,%d,%b,%.10f,%.10f,%.10f,%.10f%n",
+					scenario, tick, box.tossedBy.get() == owner, box.getX() - origin.x,
+					box.getDeltaMovement().x, player.getX() - contactPosition.x, player.getDeltaMovement().x);
+			}
+			box.discard();
+			contact.discard();
+		}
+		helper.succeed();
+	}
 }
