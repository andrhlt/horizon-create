+	@GameTest(template = "shearing", timeoutTicks = 80)
+	public static void upwardChuteInventoryCapacity(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var cratePos = helper.absolutePos(new BlockPos(2, 2, 2)).above(20);
+		var chutePos = cratePos.below();
+		var fanPos = chutePos.below();
+		helper.runAtTickTime(4, () -> {
+			level.setBlock(cratePos, Blocks.CHEST.defaultBlockState(), 3);
+			var box = (net.minecraft.world.level.block.entity.ChestBlockEntity) level.getBlockEntity(cratePos);
+			for (int slot = 0; slot < box.getContainerSize(); slot++)
+				box.setItem(slot, new ItemStack(Items.COBBLESTONE, 64));
+			level.setBlock(chutePos, com.simibubi.create.AllBlocks.CHUTE.getDefaultState(), 3);
+			level.setBlock(fanPos, com.simibubi.create.AllBlocks.ENCASED_FAN.getDefaultState()
+				.setValue(com.simibubi.create.content.kinetics.fan.EncasedFanBlock.FACING, net.minecraft.core.Direction.UP), 3);
+		});
+		helper.runAtTickTime(6, () -> {
+			var chute = (com.simibubi.create.content.logistics.chute.ChuteBlockEntity) level.getBlockEntity(chutePos);
+			var box = (net.minecraft.world.level.block.entity.ChestBlockEntity) level.getBlockEntity(cratePos);
+			var fan = (com.simibubi.create.content.kinetics.fan.EncasedFanBlockEntity) level.getBlockEntity(fanPos);
+			fan.setSpeed(256);
+			chute.updatePush(1);
+			helper.assertTrue(chute.getItemMotion() == 0.2f, "expected an upward 256 RPM fan");
+			chute.setItem(new ItemStack(Items.GOLD_INGOT, 5), 0);
+			for (int tick=0; tick <= 18; tick++) {
+				if (tick == 8) box.setItem(0, new ItemStack(Items.GOLD_INGOT, 62));
+				if (tick == 12) box.setItem(1, ItemStack.EMPTY);
+				if (tick > 0) chute.tick();
+				System.out.printf("CREATE_UPWARD_CHUTE_CAPACITY,%d,%d,%s,%d,%s,%d,%.9f%n", tick,
+					chute.getItem().getCount(),
+					net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(box.getItem(0).getItem()), box.getItem(0).getCount(),
+					net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(box.getItem(1).getItem()), box.getItem(1).getCount(),
+					chute.saveWithoutMetadata(level.registryAccess()).getFloat("ItemPosition"));
+			}
+			helper.assertTrue(chute.getItem().isEmpty() && box.getItem(0).getCount() == 64
+				&& box.getItem(1).getCount() == 3, "expected partial then full insertion");
+			helper.succeed();
+		});
+	}
+
 }
