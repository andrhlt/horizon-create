+	private static void chainSuspendedSample(ServerLevel world, int tick, String wheel, BlockPos origin,
+			ChainConveyorBlockEntity owner) {
+		for (var box : owner.getLoopingPackages())
+			chainSuspendedPackage(world, tick, wheel, origin, owner, box, null);
+		for (var entry : owner.getTravellingPackages().entrySet())
+			for (var box : entry.getValue())
+				chainSuspendedPackage(world, tick, wheel, origin, owner, box, entry.getKey());
+	}
+
+	private static void chainSuspendedPackage(ServerLevel world, int tick, String wheel, BlockPos origin,
+			ChainConveyorBlockEntity owner, ChainConveyorPackage box, BlockPos edge) {
+		if (!PackageItem.getAddress(box.item).equals("Lab-In"))
+			return;
+		box.worldPosition = owner.getPackagePosition(box.chainPosition, edge);
+		box.yaw = net.minecraft.util.Mth.wrapDegrees(box.chainPosition);
+		if (edge != null) {
+			var stats = owner.connectionStats.get(edge);
+			var diff = stats.end().subtract(stats.start()).normalize();
+			box.yaw = net.minecraft.util.Mth.wrapDegrees((float) net.minecraft.util.Mth.atan2(diff.x, diff.z)
+				* net.minecraft.util.Mth.RAD_TO_DEG - 90);
+		}
+		try {
+			var virtualMode = com.simibubi.create.foundation.blockEntity.SmartBlockEntity.class.getDeclaredField("virtualMode");
+			virtualMode.setAccessible(true);
+			var visualTick = ChainConveyorBlockEntity.class.getDeclaredMethod("tickBoxVisuals", ChainConveyorPackage.class);
+			visualTick.setAccessible(true);
+			boolean previousMode = owner.isVirtual();
+			virtualMode.setBoolean(owner, true);
+			try {
+				visualTick.invoke(owner, box);
+			} finally {
+				virtualMode.setBoolean(owner, previousMode);
+			}
+			var pose = box.physicsData(world);
+			var base = Vec3.atLowerCornerOf(origin);
+			var target = pose.targetPos.subtract(base);
+			var physical = pose.pos.subtract(base);
+			var dangle = net.createmod.catnip.math.VecHelper.rotate(pose.targetPos.add(0, 0.5, 0).subtract(pose.pos),
+				-pose.yaw, Direction.Axis.Y);
+			var roll = net.minecraft.util.Mth.wrapDegrees((float) dangleHeading(-dangle.x, dangle.y)) / 2;
+			var pitch = net.minecraft.util.Mth.wrapDegrees((float) dangleHeading(dangle.z, dangle.y)) / 2;
+			System.out.printf(Locale.ROOT, "CREATE_CHAIN_SUSPENDED %d,%s,%d,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f%n",
+				tick, wheel, box.netId, target.x, target.y, target.z, physical.x, physical.y, physical.z, pose.yaw,
+				net.minecraft.util.Mth.clamp(roll, -25, 25), net.minecraft.util.Mth.clamp(pitch, -25, 25));
+		} catch (ReflectiveOperationException e) {
+			throw new IllegalStateException("Original package visual tick failed", e);
+		}
+	}
+
+	private static double dangleHeading(double x, double y) {
+		return (float) net.minecraft.util.Mth.atan2(x, y) * net.minecraft.util.Mth.RAD_TO_DEG;
+	}
