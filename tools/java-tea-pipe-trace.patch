+	@GameTest(template = "3_pipe_split", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
+	public static void teaPipeSplit(CreateGameTestHelper helper) {
+		BlockPos pump = new BlockPos(2, 2, 2);
+		BlockPos source = new BlockPos(1, 2, 2);
+		BlockPos[] tanks = {new BlockPos(5, 2, 1), new BlockPos(5, 2, 2), new BlockPos(5, 2, 3)};
+		var handler = helper.fluidStorageAt(source);
+		handler.drain(Integer.MAX_VALUE, FluidAction.EXECUTE);
+		var tea = com.simibubi.create.foundation.fluid.FluidHelper.convertToStill(com.simibubi.create.AllFluids.TEA.get());
+		int filled = handler.fill(new FluidStack(tea, 11000), FluidAction.EXECUTE);
+		helper.assertTrue(filled == 11000, "Source must hold 11000 mB tea");
+		helper.flipBlock(pump);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			var sourceContents = helper.getTankContents(source);
+			int total = 0;
+			for (var tank : tanks) {
+				var content = helper.getTankContents(tank);
+				helper.assertTrue(content.isEmpty() || content.is(tea), "Destinations must contain tea");
+				total += content.getAmount();
+			}
+			System.out.printf("CREATE_TEA_PIPE,%d,%d,%d%n", tick, sourceContents.getAmount(), total);
+			helper.assertTrue(tick >= 100, "Waiting for transfer");
+			helper.assertTrue(total > 0, "Tea must transfer");
+		});
+	}
+
