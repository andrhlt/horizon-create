+	private static void traceFixedTrainPortRender(int tick,
+		com.simibubi.create.content.contraptions.actors.psi.PortableStorageInterfaceBlockEntity port, int timer) {
+		if (tick != 57 && (tick < 137 || tick > 142))
+			return;
+		try {
+			var extension = com.simibubi.create.content.contraptions.actors.psi.PortableStorageInterfaceBlockEntity
+				.class.getDeclaredMethod("getExtensionDistance", float.class);
+			extension.setAccessible(true);
+			var facing = port.getBlockState().getValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING);
+			float yaw = net.createmod.catnip.math.AngleHelper.horizontalAngle(facing);
+			int pitch = facing == net.minecraft.core.Direction.UP ? 0
+				: facing == net.minecraft.core.Direction.DOWN ? 180 : 90;
+			System.out.printf(java.util.Locale.ROOT, "CREATE_TRAIN_FIXED_PORT_RENDER %d;%b;%.6f;%.6f;%.0f;%d%n",
+				tick, timer >= 4 && timer <= 64, extension.invoke(port, 0.0f), extension.invoke(port, 1.0f), yaw, pitch);
+		} catch (ReflectiveOperationException error) {
+			throw new IllegalStateException(error);
+		}
+	}
