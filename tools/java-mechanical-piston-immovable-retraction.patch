+                    helper.assertTrue(level.getBlockState(piston).getValue(com.simibubi.create.content.contraptions.piston.MechanicalPistonBlock.STATE)==com.simibubi.create.content.contraptions.piston.MechanicalPistonBlock.PistonState.EXTENDED,"rig did not extend before obstruction");
+                    level.setBlock(piston.east(2),Blocks.BEDROCK.defaultBlockState(),3);
