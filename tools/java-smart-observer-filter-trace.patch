+	@GameTest(template = "shearing", timeoutTicks = 34)
+	public static void smartObserverFilter(CreateGameTestHelper helper) {
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		var mount = com.simibubi.create.content.redstone.DirectedDirectionalBlock.TARGET;
+		var power = com.simibubi.create.content.redstone.smartObserver.SmartObserverBlock.POWERED;
+		var world = helper.getLevel();
+		var observer = com.simibubi.create.AllBlocks.SMART_OBSERVER.get();
+		var type = com.simibubi.create.foundation.blockEntity.behaviour.filtering.FilteringBehaviour.TYPE;
+		var player = new net.minecraft.server.level.ServerPlayer(world.getServer(), world,
+			new com.mojang.authlib.GameProfile(java.util.UUID.randomUUID(), "SmartObserverFilter"),
+			net.minecraft.server.level.ClientInformation.createDefault());
+		var directions = net.minecraft.core.Direction.values();
+		for (int i = 0; i < directions.length; i++) {
+			var direction = directions[i];
+			var attachment = direction == net.minecraft.core.Direction.UP ? net.minecraft.world.level.block.state.properties.AttachFace.CEILING
+				: direction == net.minecraft.core.Direction.DOWN ? net.minecraft.world.level.block.state.properties.AttachFace.FLOOR
+				: net.minecraft.world.level.block.state.properties.AttachFace.WALL;
+			var horizontal = direction.getAxis().isVertical() ? net.minecraft.core.Direction.SOUTH : direction;
+			var local = new BlockPos(9 + 3 * i, 8, 4);
+			var absolute = helper.absolutePos(local);
+			helper.setBlock(local, observer.defaultBlockState().setValue(facing, horizontal).setValue(mount, attachment));
+			var filter = helper.getBlockEntity(AllBlockEntityTypes.SMART_OBSERVER.get(), local).getBehaviour(type);
+			for (var click : directions) {
+				for (boolean center : new boolean[] {true, false}) {
+					filter.setFilter(ItemStack.EMPTY);
+					player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, new ItemStack(Items.IRON_INGOT, 3));
+					boolean claimed = smartObserverFilterClick(player, absolute, click, center);
+					System.out.printf("SMART_OBSERVER_FILTER_POSE,%s,%s,%b,%b,%d,%d%n",
+						direction.getName(), click.getName(), center, claimed, filter.getFilter().getCount(), player.getMainHandItem().getCount());
+				}
+			}
+		}
+		var block = new BlockPos(12, 7, 9);
+		var items = new BlockPos(16, 7, 9);
+		helper.setBlock(block.south(), Blocks.STONE);
+		helper.setBlock(items.south(), Blocks.BARREL);
+		var barrel = (net.minecraft.world.level.block.entity.BarrelBlockEntity) world.getBlockEntity(helper.absolutePos(items.south()));
+		barrel.setItem(0, new ItemStack(Items.STONE, 32));
+		for (var local : new BlockPos[] {block, items})
+			helper.setBlock(local, observer.defaultBlockState().setValue(facing, net.minecraft.core.Direction.SOUTH));
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int index = 0; index < 2; index++) {
+				var local = index == 0 ? block : items;
+				var be = helper.getBlockEntity(AllBlockEntityTypes.SMART_OBSERVER.get(), local);
+				if (tick == 4 || tick == 9 || tick == 13 || tick == 22) {
+					ItemStack selected = tick == 22 ? ItemStack.EMPTY
+						: new ItemStack(tick == 9 ? Items.IRON_INGOT : Items.STONE, 3);
+					player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, selected);
+					if (!smartObserverFilterClick(player, helper.absolutePos(local), net.minecraft.core.Direction.NORTH, true))
+						helper.fail("Original Smart Observer rejected its front filter slot");
+				}
+				var selected = be.getBehaviour(type).getFilter();
+				String item = selected.isEmpty() ? "-" : net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(selected.getItem()).toString();
+				System.out.printf("SMART_OBSERVER_FILTER_TICK,%d,%d,%s,%d,%d,%b%n", tick, index, item,
+					selected.getCount(), be.turnOffTicks, world.getBlockState(helper.absolutePos(local)).getValue(power));
+			}
+			helper.assertTrue(tick == 27, "sampling filter changes");
+		});
+	}
+
+	private static boolean smartObserverFilterClick(net.minecraft.world.entity.player.Player player, BlockPos pos,
+		net.minecraft.core.Direction face, boolean center) {
+		var point = pos.getCenter().relative(face, 0.46);
+		if (!center)
+			point = point.relative(face.getAxis().isVertical() ? net.minecraft.core.Direction.EAST : net.minecraft.core.Direction.UP, 0.31);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var hit = new net.minecraft.world.phys.BlockHitResult(point, face, pos, false);
+		var event = new net.neoforged.neoforge.event.entity.player.PlayerInteractEvent.RightClickBlock(player, hand, pos, hit);
+		com.simibubi.create.foundation.blockEntity.behaviour.ValueSettingsInputHandler.onBlockActivated(event);
+		return event.isCanceled();
+	}
 }
