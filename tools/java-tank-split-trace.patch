+    @GameTest(template = "shearing", timeoutTicks = 50)
+    public static void tankSplitTrace(CreateGameTestHelper helper) {
+        var level = helper.getLevel();
+        var base = helper.absolutePos(new BlockPos(3, 16, 3));
+        var tank = com.simibubi.create.AllBlocks.FLUID_TANK.getDefaultState();
+        helper.runAtTickTime(2, () -> {
+            for (int rig = 0; rig < 2; rig++) {
+                var at = base.east(4 * rig);
+                level.setBlockAndUpdate(at, tank);
+                level.setBlockAndUpdate(at.above(), tank);
+            }
+        });
+        helper.runAtTickTime(8, () -> {
+            for (int rig = 0; rig < 2; rig++) {
+                var at = base.east(4 * rig);
+                var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, at, null);
+                System.out.printf("CREATE_TANK_SPLIT_FILL %d|%d|%d%n", rig, cap.fill(new net.neoforged.neoforge.fluids.FluidStack(net.minecraft.world.level.material.Fluids.WATER, 12000), net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE), cap.getTankCapacity(0));
+            }
+        });
+        helper.runAtTickTime(10, () -> {
+            level.destroyBlock(base.above(), false);
+            level.destroyBlock(base.east(4), false);
+        });
+        for (int tick = 8; tick <= 15; tick++) {
+            final int sample = tick;
+            helper.runAtTickTime(tick, () -> {
+                for (int rig = 0; rig < 2; rig++) for (int y = 0; y < 2; y++) {
+                    var at = base.east(4 * rig).above(y);
+                    var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, at, null);
+                    var be = level.getBlockEntity(at);
+                    System.out.printf("CREATE_TANK_SPLIT %d|%d|%d|%s|%s|%d|%s%n", sample, rig, y, level.getBlockState(at).getBlock(), cap == null ? "-" : cap.getFluidInTank(0), cap == null ? 0 : cap.getTankCapacity(0), be == null ? "-" : be.saveWithFullMetadata(level.registryAccess()));
+                }
+                if (sample == 15) helper.succeed();
+            });
+        }
+    }
 }
