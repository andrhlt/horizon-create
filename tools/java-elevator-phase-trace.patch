+	private static void traceElevator(CreateGameTestHelper helper, BlockPos lower, BlockPos upper, BlockPos lever,
+		BlockPos mirror) {
+		var origin = helper.absolutePos(new BlockPos(0, 1, 0));
+		var level = helper.getLevel();
+		var area = new net.minecraft.world.phys.AABB(origin).expandTowards(10, 16, 8);
+		var cabins = level.getEntitiesOfClass(
+			com.simibubi.create.content.contraptions.ControlledContraptionEntity.class, area);
+		var levels = cabins.stream().map(cabin -> String.format(java.util.Locale.ROOT, "%.9f",
+			cabin.getY() - origin.getY())).sorted().collect(java.util.stream.Collectors.joining("|"));
+		var cows = level.getEntitiesOfClass(net.minecraft.world.entity.animal.Cow.class, area).stream()
+			.map(cow -> String.format(java.util.Locale.ROOT, "%.6f", cow.getY() - origin.getY()))
+			.sorted().collect(java.util.stream.Collectors.joining("|"));
+        var primary = level.getBlockEntity(helper.absolutePos(new BlockPos(5, 12, 3)));
+        var primaryData = primary instanceof ElevatorPulleyBlockEntity main
+            ? main.saveWithoutMetadata(level.registryAccess()) : new net.minecraft.nbt.CompoundTag();
+        var cowVehicles = level.getEntitiesOfClass(net.minecraft.world.entity.animal.Cow.class, area)
+            .stream().map(cow -> cow.getVehicle() == null ? "none" : cow.getVehicle().getType().toString())
+            .collect(java.util.stream.Collectors.joining("|"));
+        var move = cabins.isEmpty() ? net.minecraft.world.phys.Vec3.ZERO : cabins.getFirst().getDeltaMovement();
+        var floors = java.util.stream.Stream.of(new BlockPos(2, 2, 2), new BlockPos(2, 11, 2))
+            .map(pos -> level.getBlockState(helper.absolutePos(pos)).toString()).collect(java.util.stream.Collectors.joining("|"));
+        System.out.printf(java.util.Locale.ROOT, "ELEVATOR_PHASE %d,%.9f,%.9f,%s,%s%n",
+            helper.getTick(), primaryData.getFloat("Offset"), move.y, floors, cowVehicles);
+		var secondary = level.getBlockEntity(helper.absolutePos(mirror));
+		boolean linked = secondary instanceof ElevatorPulleyBlockEntity pulley && pulley.getMirrorParent() != null;
+		System.out.printf("ELEVATOR_TRACE %d,%d,%d:%d:%d,%s,%s,%s,%s,%s,%s%n", helper.getTick(),
+			level.getGameTime() % 20, origin.getX(), origin.getY(), origin.getZ(),
+			helper.getBlockState(lower).getValue(RedstoneLampBlock.LIT),
+			helper.getBlockState(upper).getValue(RedstoneLampBlock.LIT),
+			helper.getBlockState(lever).getValue(LeverBlock.POWERED), linked, levels, cows);
+	}
+
+	private static void traceFuel(CreateGameTestHelper helper, BlockPos barrel, BlockPos vault, BlockPos lever) {
+		var origin = helper.absolutePos(new BlockPos(0, 1, 0));
+		var level = helper.getLevel();
+		var area = new net.minecraft.world.phys.AABB(origin).expandTowards(5, 5, 6);
+		var carts = level.getEntitiesOfClass(net.minecraft.world.entity.vehicle.MinecartFurnace.class, area)
+			.stream().sorted(java.util.Comparator.comparingDouble(cart -> cart.getX()))
+			.map(cart -> String.format(java.util.Locale.ROOT, "%.9f:%d",
+				cart.getZ() - origin.getZ(), cart.saveWithoutId(new net.minecraft.nbt.CompoundTag()).getShort("Fuel")))
+			.collect(java.util.stream.Collectors.joining("|"));
+        for (BlockPos lamp : java.util.List.of(barrel, vault)) {
+            var comparator = helper.absolutePos(lamp.north());
+            var entity = level.getBlockEntity(comparator);
+            var output = entity instanceof net.minecraft.world.level.block.entity.ComparatorBlockEntity ce
+                ? ce.getOutputSignal() : -1;
+            var store = level.getBlockState(comparator.north());
+            System.out.printf("VAULT_SIGNAL %d %d %s %d %s%n", helper.getTick(), lamp.getX(),
+                level.getBlockState(comparator), output, store);
+        }
+		System.out.printf("VAULT_FUEL_TRACE %d,%d,%d:%d:%d,%s,%s,%s,%s%n", helper.getTick(),
+			level.getGameTime() % 20, origin.getX(), origin.getY(), origin.getZ(),
+			helper.getBlockState(barrel).getValue(RedstoneLampBlock.LIT),
+			helper.getBlockState(vault).getValue(RedstoneLampBlock.LIT),
+			helper.getBlockState(lever).getValue(LeverBlock.POWERED), carts);
+	}
+
 }
