@@ -0,0 +1,73 @@
+package com.simibubi.create.infrastructure.gametest.tests;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.Screenshot;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.screens.BackupConfirmScreen;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.gui.screens.TitleScreen;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.Blocks;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaMovingPortClientProbe {
+    private static final BlockPos PORT = new BlockPos(12, 115, -6);
+    private static final boolean ITEM = Boolean.getBoolean("parity.movingItemPortPreview");
+    private static boolean requested;
+    private static Screen seen;
+    private static boolean opened;
+    private static int elapsed;
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post event) {
+        if (!Boolean.getBoolean("parity.movingPortPreview"))
+            return;
+        var mc = Minecraft.getInstance();
+        if (mc.screen != seen) {
+            seen = mc.screen;
+            if (seen != null)
+                System.out.printf("CREATE_MOVING_PORT_CLIENT_SCREEN %s;%s%n", seen.getClass().getSimpleName(), seen.getTitle().getString());
+        }
+        if (mc.getOverlay() == null && mc.screen instanceof TitleScreen && !opened) {
+            opened = true;
+            mc.createWorldOpenFlows().openWorld(ITEM ? "MovingItemPortReference" : "MovingPortReference", mc::stop);
+        }
+        if (mc.screen instanceof BackupConfirmScreen backup)
+            backup.children().stream().filter(child -> child instanceof Button).map(child -> (Button) child)
+                .filter(button -> button.getMessage().getContents() instanceof net.minecraft.network.chat.contents.TranslatableContents name
+                    && name.getKey().equals("selectWorld.backupJoinSkipButton")).findFirst().ifPresent(Button::onPress);
+        var server = mc.getSingleplayerServer();
+        if (mc.player == null || mc.level == null || server == null || mc.getOverlay() != null)
+            return;
+        if (!requested) {
+            requested = true;
+            var name = mc.player.getGameProfile().getName();
+            server.execute(() -> {
+                var source = server.createCommandSourceStack().withPermission(4);
+                server.getCommands().performPrefixedCommand(source, "gamemode spectator " + name);
+                server.getCommands().performPrefixedCommand(source, "tp " + name + " 8.5 117.2 -5.7 -84 19");
+            });
+            mc.options.hideGui = true;
+            return;
+        }
+        if (mc.level.getBlockEntity(PORT) == null)
+            return;
+        elapsed++;
+        if (elapsed == 15 || elapsed == 35 || elapsed == 65)
+            Screenshot.grab(mc.gameDirectory, (ITEM ? "moving-item-port-" : "moving-port-") + elapsed + ".png", mc.getMainRenderTarget(), message -> {});
+        if (elapsed == 20 || elapsed == 45) {
+            boolean unlock = elapsed == 20;
+            server.execute(() -> {
+                var level = server.overworld();
+                level.setBlockAndUpdate(PORT.south(), unlock ? Blocks.AIR.defaultBlockState() : Blocks.REDSTONE_BLOCK.defaultBlockState());
+                System.out.printf("CREATE_MOVING_PORT_CLIENT_POWER %d;%b%n", level.getGameTime(), !unlock);
+            });
+        }
+        if (elapsed == 70)
+            mc.stop();
+    }
+}
