+
+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
+	public static void cardboardGear(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var entries = java.util.List.of(
+			com.simibubi.create.AllItems.CARDBOARD_HELMET,
+			com.simibubi.create.AllItems.CARDBOARD_CHESTPLATE,
+			com.simibubi.create.AllItems.CARDBOARD_LEGGINGS,
+			com.simibubi.create.AllItems.CARDBOARD_BOOTS,
+			com.simibubi.create.AllItems.CARDBOARD_SWORD
+		);
+		var patterns = java.util.List.of("PPP/P P", "P P/PPP/PPP", "PPP/P P/P P", "P P/P P", "P/P/S");
+		for (int i = 0; i < entries.size(); i++) {
+			var stack = entries.get(i).asStack();
+			var rows = patterns.get(i).split("/");
+			var grid = new java.util.ArrayList<ItemStack>();
+			for (String row : rows) {
+				for (char symbol : row.toCharArray()) {
+					grid.add(switch (symbol) {
+						case 'P' -> com.simibubi.create.AllItems.CARDBOARD.asStack();
+						case 'S' -> Items.STICK.getDefaultInstance();
+						default -> ItemStack.EMPTY;
+					});
+				}
+			}
+			var input = net.minecraft.world.item.crafting.CraftingInput.of(rows[0].length(), rows.length, grid);
+			var recipe = level.getRecipeManager()
+				.getRecipeFor(net.minecraft.world.item.crafting.RecipeType.CRAFTING, input, level).orElseThrow();
+			var result = recipe.value().assemble(input, level.registryAccess());
+			helper.assertTrue(ItemStack.matches(stack, result), "Default components should match crafting for " + recipe.id());
+			var id = net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(stack.getItem());
+			var modifiers = stack.get(net.minecraft.core.component.DataComponents.ATTRIBUTE_MODIFIERS);
+			var attributes = modifiers == null ? "" : modifiers.modifiers().stream()
+				.map(m -> m.attribute().getRegisteredName() + ":" + m.modifier().amount() + ":" + m.slot())
+				.collect(java.util.stream.Collectors.joining("|"));
+			int defense = stack.getItem() instanceof net.minecraft.world.item.ArmorItem armor ? armor.getDefense() : 0;
+			int ingredients = (int) grid.stream().filter(item -> !item.isEmpty()).count();
+			System.out.printf(java.util.Locale.ROOT, "CREATE_CARDBOARD_GEAR %s,%s,%s,%d,%d,%d,%d,%d,%s%n",
+				id, recipe.id(), patterns.get(i), ingredients, result.getCount(), stack.getMaxStackSize(),
+				stack.getMaxDamage(), defense, attributes);
+		}
+		helper.succeed();
+	}
 }
