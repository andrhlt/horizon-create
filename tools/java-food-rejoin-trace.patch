+    @GameTest(template = "threshold_switch_pulley", timeoutTicks = 50)
+    public static void foodsUse(CreateGameTestHelper helper) {
+        var world = helper.getLevel();
+        var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+        for (String name : java.util.List.of("sweet_roll", "chocolate_glazed_berries", "honeyed_apple")) {
+            var profile = new com.mojang.authlib.GameProfile(java.util.UUID.randomUUID(), "FoodTester");
+            var player = new net.neoforged.neoforge.common.util.FakePlayer(world, profile);
+            player.setGameMode(net.minecraft.world.level.GameType.SURVIVAL);
+            player.getFoodData().setFoodLevel(10);
+            player.getFoodData().setSaturation(0);
+            var item = net.minecraft.core.registries.BuiltInRegistries.ITEM.get(
+                net.minecraft.resources.ResourceLocation.fromNamespaceAndPath("create", name));
+            player.getInventory().setItem(0, new net.minecraft.world.item.ItemStack(item));
+            player.getInventory().selected = 0;
+            player.getMainHandItem().use(world, player, hand);
+            for (int i = 0; i < 8; i++) player.doTick();
+            System.out.printf("CREATE_FOOD_REJOIN,%s,disconnect,%d,%d,%d,%.9f%n", name,
+                player.getInventory().getItem(0).getCount(), player.getUseItemRemainingTicks(),
+                player.getFoodData().getFoodLevel(), player.getFoodData().getSaturationLevel());
+            world.getServer().getPlayerList().remove(player);
+            var restored = new net.neoforged.neoforge.common.util.FakePlayer(world, profile);
+            helper.assertTrue(world.getServer().getPlayerList().load(restored).isPresent(), "Saved player missing");
+            System.out.printf("CREATE_FOOD_REJOIN,%s,rejoin,%d,%d,%d,%.9f%n", name,
+                restored.getInventory().getItem(0).getCount(), restored.getUseItemRemainingTicks(),
+                restored.getFoodData().getFoodLevel(), restored.getFoodData().getSaturationLevel());
+            restored.getMainHandItem().use(world, restored, hand);
+            for (int tick = 0; tick < 36; tick++) {
+                if (tick > 0) restored.doTick();
+                var held = restored.getInventory().getItem(0);
+                System.out.printf(java.util.Locale.ROOT,
+                    "CREATE_FOOD_REJOIN_TICK,%s,%d,%s,%d,%d,%d,%.9f%n", name, tick,
+                    net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(held.getItem()), held.getCount(),
+                    restored.getUseItemRemainingTicks(), restored.getFoodData().getFoodLevel(),
+                    restored.getFoodData().getSaturationLevel());
+            }
+        }
+        helper.succeed();
+    }
