+	@GameTest(template = "shearing", timeoutTicks = 40)
+	public static void gearboxBearingQuarterTurn(CreateGameTestHelper helper) {
+		BlockPos bearing = new BlockPos(12, 7, 5);
+		BlockPos anchor = bearing.above();
+		helper.setBlock(bearing, AllBlocks.MECHANICAL_BEARING.getDefaultState()
+			.setValue(BlockStateProperties.FACING, Direction.UP));
+		helper.getBlockEntity(AllBlockEntityTypes.MECHANICAL_BEARING.get(), bearing)
+			.getBehaviour(ScrollValueBehaviour.TYPE).setValue(0);
+		helper.setBlock(anchor, AllBlocks.GEARBOX.getDefaultState().setValue(BlockStateProperties.AXIS, Direction.Axis.X));
+		helper.setBlock(anchor.east(), AllBlocks.GEARBOX.getDefaultState().setValue(BlockStateProperties.AXIS, Direction.Axis.Z));
+		var level = helper.getLevel();
+		level.addFreshEntity(new SuperGlueEntity(level, new AABB(helper.absolutePos(anchor)).expandTowards(1, 0, 0)));
+		helper.setBlock(anchor.above(), AllBlocks.CREATIVE_MOTOR.getDefaultState()
+			.setValue(BlockStateProperties.FACING, Direction.DOWN));
+		helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), anchor.above()).generatedSpeed.setValue(32);
+		helper.setBlock(bearing.below(), AllBlocks.CREATIVE_MOTOR.getDefaultState()
+			.setValue(BlockStateProperties.FACING, Direction.UP));
+		var motor = helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), bearing.below());
+		motor.generatedSpeed.setValue(0);
+		var be = helper.getBlockEntity(AllBlockEntityTypes.MECHANICAL_BEARING.get(), bearing);
+		int[] stopTick = {-1};
+		for (int tick = 0; tick <= 20; tick++) {
+			int sample = tick;
+			helper.runAtTickTime(8 + tick, () -> {
+				if (sample == 0) {
+					gearboxBearingSample(helper, anchor, be, "before");
+					motor.generatedSpeed.setValue(60);
+					return;
+				}
+				float angle = be.saveWithoutMetadata(level.registryAccess()).getFloat("Angle");
+				if (stopTick[0] == -1 && be.isRunning() && Math.abs(Math.abs(angle) - 90) < 0.001) {
+					gearboxBearingSample(helper, anchor, be, "quarter_turn");
+					stopTick[0] = sample;
+					motor.generatedSpeed.setValue(0);
+				} else if (stopTick[0] >= 0 && sample == stopTick[0] + 1) {
+					helper.assertTrue(!be.isRunning(), "The bearing must restore the payload at the quarter-turn");
+					gearboxBearingSample(helper, anchor, be, "restored");
+				} else if (stopTick[0] >= 0 && sample == stopTick[0] + 4) {
+					gearboxBearingSample(helper, anchor, be, "settled");
+					helper.succeed();
+				} else if (sample == 20) {
+					helper.fail("The bearing never reached the quarter-turn or restored the payload");
+				}
+			});
+		}
+	}
+
+	private static void gearboxBearingSample(CreateGameTestHelper helper, BlockPos anchor,
+		MechanicalBearingBlockEntity bearing, String phase) {
+		var level = helper.getLevel();
+		var row = new JsonObject();
+		row.addProperty("phase", phase);
+		row.addProperty("running", bearing.isRunning());
+		row.addProperty("angle", bearing.saveWithoutMetadata(level.registryAccess()).getFloat("Angle"));
+		var points = new JsonObject();
+		BlockPos absolute = helper.absolutePos(anchor);
+		points.add("center", gearboxBearingReading(level, absolute));
+		points.add("east", gearboxBearingReading(level, absolute.east()));
+		points.add("north", gearboxBearingReading(level, absolute.north()));
+		points.add("south", gearboxBearingReading(level, absolute.south()));
+		row.add("points", points);
+		System.out.println("CREATE_GEARBOX_BEARING " + row);
+	}
+
+	private static JsonObject gearboxBearingReading(ServerLevel level, BlockPos pos) {
+		var state = level.getBlockState(pos);
+		var reading = new JsonObject();
+		reading.addProperty("block", BuiltInRegistries.BLOCK.getKey(state.getBlock()).toString());
+		if (level.getBlockEntity(pos) instanceof GearboxBlockEntity box) {
+			reading.addProperty("axis", state.getValue(BlockStateProperties.AXIS).getSerializedName());
+			reading.addProperty("rpm", box.getSpeed());
+			reading.addProperty("source", box.hasSource() ? box.getSourceFacing().getSerializedName() : "none");
+		}
+		return reading;
+	}
