+		var rail = track.defaultBlockState().setValue(shape, com.simibubi.create.content.trains.track.TrackShape.XO);
+		var origin = new BlockPos(8, 180, 72);
+		for (int x = -2; x <= 2; x++)
+			for (int z = -4; z <= 1; z++)
+				level.setChunkForced((origin.getX() >> 4) + x, (origin.getZ() >> 4) + z, true);
+		for (int x = -3; x <= 24; x++) {
+			level.setBlockAndUpdate(origin.offset(x,-1,0), Blocks.SMOOTH_STONE.defaultBlockState());
+			level.setBlockAndUpdate(origin.east(x), rail);
+			level.setBlockAndUpdate(origin.east(x).above(), Blocks.AIR.defaultBlockState());
+		}
+		var bendStart = origin.west(3);
+		var bendEnd = origin.offset(-13, 0, -10);
+		for (int z = -10; z >= -45; z--) {
+			var at = origin.offset(-13,0,z);
+			level.setBlockAndUpdate(at.below(), Blocks.SMOOTH_STONE.defaultBlockState());
+			if (z < -10)
+				level.setBlockAndUpdate(at, track.defaultBlockState().setValue(shape,
+					com.simibubi.create.content.trains.track.TrackShape.ZO));
+		}
+		var layout = new ItemStack(track, 64); player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, layout);
+		player.setYRot(90);
+		player.setXRot(20);
+		com.simibubi.create.content.trains.track.TrackBlockItem.select(level, bendStart, player.getLookAngle(), layout);
+		player.setYRot(180);
+		com.simibubi.create.content.trains.track.TrackPlacement.tryConnect(level, player, bendEnd,
+			track.defaultBlockState().setValue(shape, com.simibubi.create.content.trains.track.TrackShape.ZO),
+			layout, false, false);
+		helper.assertTrue(player.getMainHandItem().getCount() < 64, "Java track placement did not lay the 90-degree bend");
+        var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+        var station = com.simibubi.create.AllBlocks.TRACK_STATION;
+        var stationItem = (com.simibubi.create.content.trains.track.TrackTargetingBlockItem) station.asItem();
+        var stationPos = origin.south(2);
+        level.setBlockAndUpdate(stationPos, Blocks.AIR.defaultBlockState());
+        level.setBlockAndUpdate(stationPos.below(), Blocks.SMOOTH_STONE.defaultBlockState());
+        helper.runAfterDelay(7, () -> {
+            player.setItemInHand(hand, new ItemStack(stationItem));
+            player.setYRot(90);
+            player.setXRot(20);
+            clickTrackForAssembly(stationItem, player, origin);
+            clickTrackForAssembly(stationItem, player, stationPos.below());
+            helper.assertTrue(station.has(level.getBlockState(stationPos)), "Expected nearby Track Station");
+        });
+        var signal = com.simibubi.create.AllBlocks.TRACK_SIGNAL;
+        var signalItem = (com.simibubi.create.content.trains.track.TrackTargetingBlockItem) signal.asItem();
+        var signalPlayer = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+        var approaches = java.util.List.of(origin.west(2), origin.west(2),
+            origin.offset(-13, 0, -15), origin.offset(-13, 0, -15));
+        var signalPositions = java.util.List.of(approaches.get(0).north(3), approaches.get(1).south(3),
+            approaches.get(2).east(3), approaches.get(3).west(3));
+        var wrench = com.simibubi.create.AllItems.WRENCH.get();
+        var type = com.simibubi.create.content.trains.signal.SignalBlock.TYPE;
+        for (int t = 1; t <= 105; ++t) {
+            int tick = t;
+            helper.runAtTickTime(tick + 9, () -> {
+                if (tick == 1) {
+                    float[] heading = {90, -90, 0, 180};
+                    for (int i = 0; i < signalPositions.size(); i++) {
+                        var position = signalPositions.get(i);
+                        level.setBlockAndUpdate(position, Blocks.AIR.defaultBlockState());
+                        level.setBlockAndUpdate(position.above(), Blocks.AIR.defaultBlockState());
+                        var support = position.below();
+                        level.setBlockAndUpdate(support, Blocks.SMOOTH_STONE.defaultBlockState());
+                        signalPlayer.setItemInHand(hand, new ItemStack(signalItem));
+                        signalPlayer.setYRot(heading[i]);
+                        signalPlayer.setXRot(20);
