+                if (tick == 40 || tick == 95)
+                    level.setBlockAndUpdate(signalPositions.get(3).above(), Blocks.AIR.defaultBlockState());
+                if (tick == 53)
+                    level.setBlockAndUpdate(signalPositions.get(2).above(), Blocks.REDSTONE_BLOCK.defaultBlockState());
+                if (tick == 64)
+                    level.setBlockAndUpdate(signalPositions.get(2).above(), Blocks.AIR.defaultBlockState());
+                var out = new StringBuilder("CREATE_CURVED_SIGNAL_CHAIN ").append(tick);
+                for (var pos : signalPositions) {
+                    var placed = (com.simibubi.create.content.trains.signal.SignalBlockEntity) level.getBlockEntity(pos);
+                    out.append(';').append(placed.getState().name())
+                        .append(';').append(level.getBlockState(pos).getValue(type).getSerializedName());
+                }
+                System.out.println(out);
+                if (tick == 105)
+                    helper.succeed();
+            });
+        }
+    }
+
+	private static void clickTrackForAssembly(com.simibubi.create.content.trains.track.TrackTargetingBlockItem item,
+			net.minecraft.world.entity.player.Player player, BlockPos pos) {
+		var hit = new net.minecraft.world.phys.BlockHitResult(
+			net.minecraft.world.phys.Vec3.atCenterOf(pos).add(0,.5,0), net.minecraft.core.Direction.UP, pos, false);
+		item.useOn(new net.minecraft.world.item.context.UseOnContext(player,
+			net.minecraft.world.InteractionHand.MAIN_HAND, hit));
+	}
