+	private static void traceBrassTunnel(CreateGameTestHelper helper, String mode, List<BlockPos> outputs,
+		List<BlockPos> tunnels, List<BlockPos> sources) {
+		for (int t = 1; t <= 201; t++) {
+			int tick = t;
+			helper.runAfterDelay(tick, () -> {
+				var result = new java.util.ArrayList<String>();
+				for (var pos : sources)
+					result.add(Long.toString(helper.getTotalItems(pos)));
+				for (var pos : tunnels) {
+					var tunnel = (com.simibubi.create.content.logistics.tunnel.BrassTunnelBlockEntity)
+						helper.getLevel().getBlockEntity(helper.absolutePos(pos));
+					result.add(Integer.toString(tunnel.getStackToDistribute().getCount()));
+				}
+				for (var pos : outputs)
+					result.add(Long.toString(helper.getTotalItems(pos)));
+				System.out.printf("CREATE_BRASS_TUNNEL %s %d %s%n", mode, tick, String.join(" ", result));
+			});
