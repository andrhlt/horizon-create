+		var empty = net.minecraft.world.item.ItemStack.EMPTY;
+		var click = net.minecraft.world.inventory.ClickType.PICKUP;
+		level.setBlockAndUpdate(pos, requester.defaultBlockState());
+		var entity = level.getBlockEntity(pos, type).orElseThrow();
+		var iron = new net.minecraft.world.item.ItemStack(net.minecraft.world.item.Items.IRON_INGOT);
+		var gold = new net.minecraft.world.item.ItemStack(net.minecraft.world.item.Items.GOLD_INGOT);
+		entity.encodedRequest = com.simibubi.create.content.logistics.stockTicker.PackageOrderWithCrafts.simple(
