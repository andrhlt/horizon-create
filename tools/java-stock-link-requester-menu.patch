+		System.out.printf("CREATE_REQUESTER_MENU %d|%s|%s|%d|%s|%s|%b%n", helper.getTick(), action,
+			String.join(",", contents), menu.getCarried().getCount(), String.join(",", order),
+			entity.encodedTargetAdress, entity.allowPartialRequests);
+	}
