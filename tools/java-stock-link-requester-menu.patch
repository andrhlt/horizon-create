+		helper.runAtTickTime(3, () -> {
+			menu.setCarried(copper);
+			menu.clicked(36, 0, click, player);
+			menu.clicked(38, 1, click, player);
+			stockRequesterMenuRow(helper, entity, menu, "sample");
+			menu.setCarried(empty);
+			menu.clicked(37, 0, click, player);
+		});
+		helper.runAtTickTime(4, () -> {
+			menu.removed(player);
+			stockRequesterMenuRow(helper, entity, menu, "close_slots");
+			new com.simibubi.create.content.logistics.redstoneRequester.RedstoneRequesterConfigurationPacket(
+				pos, "Factory A", true, java.util.List.of(12, 2)).handle(player);
