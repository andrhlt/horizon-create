+	@GameTest(template = "shearing")
+	public static void rotationSpeedControllerPlacement(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var controller = com.simibubi.create.AllBlocks.ROTATION_SPEED_CONTROLLER;
+		var cog = com.simibubi.create.AllBlocks.LARGE_COGWHEEL;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var horizontal = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_AXIS;
+		var west = net.minecraft.core.Direction.WEST;
+		var up = net.minecraft.core.Direction.UP;
+		var x = net.minecraft.core.Direction.Axis.X;
+		var y = net.minecraft.core.Direction.Axis.Y;
+		var z = net.minecraft.core.Direction.Axis.Z;
+
+		for (int index = 0; index < 6; index++) {
+			var base = new BlockPos(12 + index * 4, 2, 2);
+			var hit = helper.absolutePos(base);
+			var clicked = new net.minecraft.world.phys.BlockHitResult(
+				net.minecraft.world.phys.Vec3.atLowerCornerWithOffset(hit, 0, 0.25, 0.5),
+				west, hit, false);
+			player.setPos(hit.getX() - 2, hit.getY(), hit.getZ());
+			player.setYRot(0);
+			var held = new ItemStack(cog.asItem(), 2);
+			player.setItemInHand(hand, held);
+
+			if (index < 4) {
+				helper.setBlock(base, controller.getDefaultState().setValue(horizontal, index == 1 ? z : x));
+				if (index == 2)
+					helper.setBlock(base.above(), Blocks.STONE);
+				if (index == 3)
+					helper.setBlock(base.above().east(), com.simibubi.create.AllBlocks.COGWHEEL.getDefaultState().setValue(axis, y));
+
+				var result = level.getBlockState(hit).useItemOn(held, level, player, hand, clicked);
+				if (!result.consumesAction())
+					held.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, clicked));
+			} else {
+				helper.setBlock(base.below(), Blocks.STONE);
+				if (index == 4)
+					helper.setBlock(base.above(), cog.getDefaultState().setValue(axis, x));
+				else {
+					helper.setBlock(base.east(), com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, x));
+					helper.setBlock(base.above(), com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, y));
+					player.setYRot(90);
+				}
+
+				held = new ItemStack(controller.asItem(), 2);
+				player.setItemInHand(hand, held);
+				hit = hit.below();
+				clicked = new net.minecraft.world.phys.BlockHitResult(
+					net.minecraft.world.phys.Vec3.atLowerCornerWithOffset(hit, 0.5, 1, 0.5),
+					up, hit, false);
+				held.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, clicked));
+			}
+			var top = helper.getBlockState(base.above());
+			var side = helper.getBlockState(base.west());
+			var installed = helper.getBlockState(base);
+			String topAxis = cog.has(top) ? top.getValue(axis).getName() : "none";
+			String sideAxis = cog.has(side) ? side.getValue(axis).getName() : "none";
+			String installedAxis = controller.has(installed) ? installed.getValue(horizontal).getName() : "none";
+			System.out.printf("CREATE_SPEED_CONTROLLER_PLACEMENT,%d,%s,%s,%s,%d%n",
+				index, installedAxis, topAxis, sideAxis, held.getCount());
+		}
+		traceEncasedControllerConnections(helper, player, hand);
+	}
+
+	private record EncasedControllerRig(BlockPos base, BlockPos source, BlockPos output,
+		String axis, int remaining) {}
+
+	private static void traceEncasedControllerConnections(CreateGameTestHelper helper,
+		net.minecraft.server.level.ServerPlayer player, net.minecraft.world.InteractionHand hand) {
+		var level = helper.getLevel();
+		var controller = com.simibubi.create.AllBlocks.ROTATION_SPEED_CONTROLLER;
+		var shaft = com.simibubi.create.AllBlocks.SHAFT;
+		var motor = com.simibubi.create.AllBlocks.CREATIVE_MOTOR;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var horizontal = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var x = net.minecraft.core.Direction.Axis.X;
+		var y = net.minecraft.core.Direction.Axis.Y;
+		var z = net.minecraft.core.Direction.Axis.Z;
+		var east = net.minecraft.core.Direction.EAST;
+		var up = net.minecraft.core.Direction.UP;
+		var rigs = new java.util.ArrayList<EncasedControllerRig>();
+		var sourceState = motor.getDefaultState().setValue(facing, east);
+		for (int test = 0; test < 6; test++) {
+			var base = new BlockPos(12 + test * 4, 2, 6);
+			var cog = switch (test) {
+				case 0, 2, 5 -> com.simibubi.create.AllBlocks.BRASS_ENCASED_LARGE_COGWHEEL;
+				case 1, 3 -> com.simibubi.create.AllBlocks.ANDESITE_ENCASED_LARGE_COGWHEEL;
+				default -> com.simibubi.create.AllBlocks.BRASS_ENCASED_COGWHEEL;
+			};
+			var cogAxis = test == 1 ? z : test == 3 ? y : x;
+			boolean shaftDrives = test == 1 || test == 3;
+			var block = cog.getDefaultState().setValue(axis, cogAxis)
+				.setValue(com.simibubi.create.content.kinetics.simpleRelays.encased.EncasedCogwheelBlock.BOTTOM_SHAFT, !shaftDrives)
+				.setValue(com.simibubi.create.content.kinetics.simpleRelays.encased.EncasedCogwheelBlock.TOP_SHAFT, !shaftDrives);
+			helper.setBlock(base.above(), block);
+
+			var shaftAxis = test == 0 || test == 5 ? z : x;
+			int remaining = -1;
+			if (test == 2 || test == 5) {
+				helper.setBlock(base, controller.getDefaultState().setValue(horizontal, shaftAxis));
+			} else {
+				helper.setBlock(base.below(), Blocks.STONE);
+				var clicked = helper.absolutePos(base.below());
+				player.setPos(clicked.getX() - 2, clicked.getY() + 1, clicked.getZ());
+				player.setYRot(test == 1 ? 90 : 0);
+				var held = new ItemStack(controller.asItem(), 2);
+				player.setItemInHand(hand, held);
+				var hit = new net.minecraft.world.phys.BlockHitResult(
+					net.minecraft.world.phys.Vec3.atLowerCornerWithOffset(clicked, 0.5, 1, 0.5),
+					up, clicked, false);
+				held.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+				remaining = held.getCount();
+			}
+			var installed = helper.getBlockState(base).getValue(horizontal);
+			var sourcePos = shaftDrives ? base.west() : base.above().west();
+			var outputPos = shaftAxis == z ? base.south() : base.east();
+			helper.setBlock(outputPos, shaft.getDefaultState().setValue(axis, shaftAxis));
+			rigs.add(new EncasedControllerRig(base, sourcePos, outputPos, installed.getName(), remaining));
+			helper.setBlock(sourcePos, sourceState);
+			helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), sourcePos).generatedSpeed.setValue(24);
+		}
+
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int test = 0; test < rigs.size(); test++) {
+				var rig = rigs.get(test);
+				var controllerEntity = (com.simibubi.create.content.kinetics.base.KineticBlockEntity)
+					level.getBlockEntity(helper.absolutePos(rig.base()));
+				var cogEntity = (com.simibubi.create.content.kinetics.base.KineticBlockEntity)
+					level.getBlockEntity(helper.absolutePos(rig.base().above()));
+				var outputEntity = (com.simibubi.create.content.kinetics.base.KineticBlockEntity)
+					level.getBlockEntity(helper.absolutePos(rig.output()));
+				System.out.printf(java.util.Locale.ROOT,
+					"CREATE_SPEED_CONTROLLER_ENCASED,%d,%d,%s,%d,%.4f,%.4f,%.4f%n",
+					test, tick, rig.axis(), rig.remaining(), controllerEntity.getSpeed(),
+					cogEntity.getSpeed(), outputEntity.getSpeed());
+			}
+			if (tick == 4)
+				for (var rig : rigs)
+					helper.setBlock(rig.source(), Blocks.AIR);
+			if (tick == 8)
+				for (var rig : rigs) {
+					var source = rig.source();
+					helper.setBlock(source, sourceState);
+					helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), source).generatedSpeed.setValue(32);
+				}
+			if (tick < 12)
+				helper.fail("Waiting for final encased controller observation");
+		});
+	}
 }
