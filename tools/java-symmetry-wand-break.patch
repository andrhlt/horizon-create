+				player.getInventory().setItem(1, wand);
+				var tool = scenario == 3 ? ItemStack.EMPTY : new ItemStack(Items.IRON_PICKAXE);
+				player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, tool);
+				var source = scenario == 1 ? base.east(2) : base.south(2);
+				var target = scenario == 1 ? base.west(2) : base.north(2);
+				level.setBlock(source, Blocks.STONE.defaultBlockState(), 2);
+				level.setBlock(target, (scenario == 2 || scenario == 4 ? Blocks.DIRT : Blocks.STONE).defaultBlockState(), 2);
+				var event = new net.neoforged.neoforge.event.level.BlockEvent.BreakEvent(level, source, level.getBlockState(source), player);
+				com.simibubi.create.content.equipment.symmetryWand.SymmetryHandler.onBlockDestroyed(event);
+				var drops = level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class, new net.minecraft.world.phys.AABB(base).inflate(16));
+				String drop = drops.stream().map(e -> net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(e.getItem().getItem()) + ":" + e.getItem().getCount() + "@" + e.blockPosition().subtract(base).toShortString()).sorted().collect(java.util.stream.Collectors.joining("|"));
+				System.out.printf("CREATE_SYMMETRY_BREAK,%s,%s,%s,%s,%d,%d,%s%n", new String[]{"xy","yz","mismatch","empty_hand","creative_mismatch"}[scenario],
+					net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(level.getBlockState(source).getBlock()),
+					net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(level.getBlockState(target).getBlock()),
+					com.simibubi.create.content.equipment.symmetryWand.SymmetryWandItem.isEnabled(wand), tool.getDamageValue(), drops.size(), drop);
+			}
+			helper.succeed();
+		});
