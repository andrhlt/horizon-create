+	@GameTest(template = "shearing", timeoutTicks = 24)
+	public static void clutchCompetingSources(CreateGameTestHelper helper) {
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var powered = net.minecraft.world.level.block.state.properties.BlockStateProperties.POWERED;
+		var east = net.minecraft.core.Direction.EAST;
+		var clutch = new BlockPos(12, 3, 9);
+		var left = clutch.west();
+		var right = clutch.east();
+		var power = clutch.above();
+		var level = helper.getLevel();
+		helper.setBlock(left, com.simibubi.create.AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, east));
+		helper.setBlock(clutch, com.simibubi.create.AllBlocks.CLUTCH.getDefaultState().setValue(axis, east.getAxis()));
+		helper.setBlock(right, com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, east.getAxis()));
+		helper.setBlock(power, Blocks.LEVER.defaultBlockState().setValue(
+			net.minecraft.world.level.block.state.properties.BlockStateProperties.ATTACH_FACE,
+			net.minecraft.world.level.block.state.properties.AttachFace.FLOOR));
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			if (tick == 0)
+				helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), left).generatedSpeed.setValue(32);
+			if (tick == 4)
+				helper.pullLever(power);
+			if (tick == 6) {
+				helper.setBlock(right, com.simibubi.create.AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, east.getOpposite()));
+				helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), right).generatedSpeed.setValue(64);
+			}
+			if (tick == 10)
+				helper.setBlock(left, Blocks.AIR.defaultBlockState());
+			if (tick == 14)
+				helper.pullLever(power);
+			var gear = helper.getBlockEntity(AllBlockEntityTypes.CLUTCH.get(), clutch);
+			var rightEntity = (com.simibubi.create.content.kinetics.base.KineticBlockEntity) level.getBlockEntity(helper.absolutePos(right));
+			var saved = gear.saveWithoutMetadata(level.registryAccess());
+			var leftEntity = level.getBlockEntity(helper.absolutePos(left));
+			float leftSpeed = leftEntity instanceof com.simibubi.create.content.kinetics.base.KineticBlockEntity kinetic ? kinetic.getSpeed() : 0;
+			System.out.printf(java.util.Locale.ROOT, "CREATE_CLUTCH_COMPETING,%d,%s,%.4f,%.4f,%.4f,%s%n", tick,
+				gear.getBlockState().getValue(powered), leftSpeed, gear.getSpeed(), rightEntity.getSpeed(), saved.contains("Source"));
+			if (tick < 18) helper.fail("Waiting for both ordinary clutch sources");
+		});
+	}
 }
