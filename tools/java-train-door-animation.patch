+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 100)
+	public static void trainDoorAnimationOracle(CreateGameTestHelper helper) {
+		var animation = net.createmod.catnip.animation.LerpedFloat.linear().startWithValue(1);
+		for (int i = 0; i < 18; i++) {
+			boolean open = i >= 9;
+			boolean wasSettled = animation.settled();
+			animation.chase(open ? 1 : 0, .15f, net.createmod.catnip.animation.LerpedFloat.Chaser.LINEAR);
+			animation.tickChaser();
+			float value = animation.getValue();
+			float slide = value * value * 13 / 16f;
+			float normal = net.minecraft.util.Mth.clamp(value * 10, 0, 1) / 32f;
+			boolean closeCue = !wasSettled && animation.settled() && !open;
+			System.out.printf(java.util.Locale.ROOT, "CREATE_TRAIN_DOOR_ANIMATION,%d,%b,%.9f,%.9f,%.9f,%b%n", i, open, value, slide, normal, closeCue);
+		}
+		helper.succeed();
+	}
