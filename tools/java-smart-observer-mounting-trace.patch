+	@GameTest(template = "shearing", timeoutTicks = 50)
+	public static void smartObserverPlacement(CreateGameTestHelper helper) {
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		var target = com.simibubi.create.content.redstone.DirectedDirectionalBlock.TARGET;
+		var level = helper.getLevel();
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var observer = com.simibubi.create.AllBlocks.SMART_OBSERVER.get();
+		String[] faces = {"north", "south", "east", "west", "up", "down", "north", "north", "north", "north", "up", "down", "north", "north", "north"};
+		float[] yaws = {0, 180, 90, -90, 0, 180, 0, 0, 0, 0, 0, 180, 90, 90, 90};
+		float[] pitches = {16, 16, 16, 16, 60, -60, 0, 0, 0, 0, 60, -60, 16, 16, 16};
+		for (int test = 0; test < faces.length; test++) {
+			var pos = helper.absolutePos(new BlockPos(10 + 3 * test, 7, 4));
+			var side = net.minecraft.core.Direction.byName(faces[test]);
+			var support = pos.relative(side.getOpposite());
+			String block = test < 6 ? "minecraft:barrel" : switch (test) {
+				case 10 -> "create:fluid_tank";
+				case 12 -> "create:depot";
+				case 13 -> "create:fluid_pipe";
+				case 14 -> "create:andesite_funnel";
+				default -> "minecraft:stone";
+			};
+			var supportBlock = net.minecraft.core.registries.BuiltInRegistries.BLOCK.get(net.minecraft.resources.ResourceLocation.parse(block));
+			level.setBlockAndUpdate(support, supportBlock.defaultBlockState());
+			String neighboring = "-";
+			if (test == 8 || test == 9) {
+				neighboring = test == 8 ? "east" : "east+west";
+				level.setBlockAndUpdate(pos.east(), Blocks.BARREL.defaultBlockState());
+				if (test == 9)
+					level.setBlockAndUpdate(pos.west(), Blocks.BARREL.defaultBlockState());
+			}
+			player.setYRot(yaws[test]);
+			player.setXRot(pitches[test]);
+			player.setYHeadRot(yaws[test]);
+			player.setYBodyRot(yaws[test]);
+			player.yRotO = yaws[test];
+			player.xRotO = pitches[test];
+			boolean sneak = test < 6 || test == 7 || test == 9 || test == 10 || test >= 12;
+			player.setShiftKeyDown(sneak);
+			var stack = new ItemStack(observer.asItem());
+			player.setItemInHand(hand, stack);
+			var hit = new net.minecraft.world.phys.BlockHitResult(support.getCenter().relative(side, 0.5), side, support, false);
+			var context = new net.minecraft.world.item.context.BlockPlaceContext(player, hand, stack, hit);
+			var result = ((net.minecraft.world.item.BlockItem) stack.getItem()).place(context);
+			var placed = level.getBlockState(pos);
+			System.out.printf("SMART_OBSERVER_PLACEMENT,%d,%s,%s,%.0f,%.0f,%b,%s,%s,%s,%b%n",
+				test, block, side.getName(), yaws[test], pitches[test], sneak, neighboring,
+				placed.getValue(facing).getName(), placed.getValue(target).getSerializedName(),
+				result.consumesAction() && stack.isEmpty());
+		}
+		player.setShiftKeyDown(false);
+		helper.succeed();
+	}
+	@GameTest(template = "shearing", timeoutTicks = 30)
+	public static void smartObserverRecovery(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var type = com.simibubi.create.foundation.blockEntity.behaviour.filtering.FilteringBehaviour.TYPE;
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(world);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		for (int lane = 0; lane < 6; lane++) {
+			var pos = helper.absolutePos(new BlockPos(19 + 4 * lane, 7, 14));
+			boolean observer = lane < 4;
+			boolean special = lane != 2 && lane != 3;
+			boolean wrench = lane % 2 != 0;
+			var block = observer ? com.simibubi.create.AllBlocks.SMART_OBSERVER.get() : com.simibubi.create.AllBlocks.THRESHOLD_SWITCH.get();
+			var state = block.defaultBlockState().setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING,
+				net.minecraft.core.Direction.SOUTH);
+			world.setBlockAndUpdate(pos, state);
+			var entity = (com.simibubi.create.foundation.blockEntity.SmartBlockEntity)world.getBlockEntity(pos);
+			var sample = special ? com.simibubi.create.AllItems.FILTER.asStack(2) : new ItemStack(Items.STONE, 2);
+			player.getInventory().clearContent();
+			player.setItemInHand(hand, sample);
+			boolean selected = smartObserverFilterClick(player, pos, net.minecraft.core.Direction.NORTH, true);
+			int count = entity.getBehaviour(type).getFilter().getCount();
+			int held = player.getMainHandItem().getCount();
+			if (wrench) {
+				player.setItemInHand(hand, com.simibubi.create.AllItems.WRENCH.asStack());
+				var hit = new net.minecraft.world.phys.BlockHitResult(pos.getCenter().relative(net.minecraft.core.Direction.NORTH, 0.5), net.minecraft.core.Direction.NORTH, pos, false);
+				block.onSneakWrenched(state, new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+			} else {
+				world.destroyBlock(pos, true, player);
+			}
+			var area = new net.minecraft.world.phys.AABB(pos).inflate(1);
+			int filters = 0;
+			int readyAndCentered = 0;
+			int blocks = 0;
+			for (var loot : world.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class, area)) {
+				var item = loot.getItem();
+				if (com.simibubi.create.AllItems.FILTER.isIn(item)) {
+					filters += item.getCount();
+					if (!loot.hasPickUpDelay() && loot.position().equals(pos.getCenter()))
+						readyAndCentered += item.getCount();
+				}
+				if (item.is(block.asItem())) blocks += item.getCount();
+			}
+			int picked = player.getInventory().countItem(block.asItem());
+			System.out.printf("DETECTOR_RECOVERY,%d,%b,%b,%b,%b,%d,%d,%d,%d,%d,%d,%b%n",
+				lane, observer, special, wrench, selected, count, held, filters, readyAndCentered, blocks, picked, world.getBlockState(pos).isAir());
+		}
+		helper.succeed();
+	}
+
+	private static boolean smartObserverFilterClick(net.minecraft.world.entity.player.Player player, BlockPos pos,
+		net.minecraft.core.Direction face, boolean center) {
+		var point = pos.getCenter().relative(face, 0.46);
+		if (!center)
+			point = point.relative(face.getAxis().isVertical() ? net.minecraft.core.Direction.EAST : net.minecraft.core.Direction.UP, 0.31);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var hit = new net.minecraft.world.phys.BlockHitResult(point, face, pos, false);
+		var event = new net.neoforged.neoforge.event.entity.player.PlayerInteractEvent.RightClickBlock(player, hand, pos, hit);
+		com.simibubi.create.foundation.blockEntity.behaviour.ValueSettingsInputHandler.onBlockActivated(event);
+		return event.isCanceled();
+	}
