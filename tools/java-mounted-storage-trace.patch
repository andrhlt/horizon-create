+	private static String formatCargo(java.util.Map<?, Long> items) {
+		return items.entrySet().stream().map(entry -> {
+			Object item = entry.getKey();
+			String name = item instanceof Item i
+				? net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(i).toString() : item.toString();
+			return name + "=" + entry.getValue();
+		}).sorted().collect(java.util.stream.Collectors.joining("|"));
+	}
+
+	private static void traceMounted(CreateGameTestHelper helper, String name, BlockPos source, BlockPos target) {
+		BlockPos origin = helper.absolutePos(new BlockPos(0, 1, 0));
+		if (helper.getTick() == 0)
+			System.out.printf("MOUNTED_ORIGIN %s %s%n", name, origin.toShortString());
+		var box = new net.minecraft.world.phys.AABB(
+			net.minecraft.world.phys.Vec3.atLowerCornerOf(origin.offset(-1, 0, 0)),
+			net.minecraft.world.phys.Vec3.atLowerCornerOf(origin.offset(9, 9, 9)));
+		var moving = helper.getLevel().getEntitiesOfClass(
+			com.simibubi.create.content.contraptions.ControlledContraptionEntity.class, box);
+		var entity = moving.isEmpty() ? null : moving.getFirst();
+		var store = entity == null ? null : entity.getContraption().getStorage();
+		String amountIn;
+		String amountOut;
+		if (name.equals("mounted_item_extract")) {
+			if (store == null) {
+				amountIn = Long.toString(helper.getTotalItems(source));
+			} else {
+				var info = store.getAllItems();
+				amountIn = Integer.toString(java.util.stream.IntStream.range(0, info.getSlots())
+					.map(i -> info.getStackInSlot(i).getCount()).sum());
+			}
+			amountOut = Long.toString(helper.getTotalItems(target));
+			var sourceItems = new java.util.TreeMap<String, Long>();
+			if (store == null) {
+				helper.getItemContent(source).forEach((item, count) ->
+					sourceItems.put(net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(item).toString(), count));
+			} else {
+				var inventory = store.getAllItems();
+				for (int slot = 0; slot < inventory.getSlots(); slot++) {
+					ItemStack stack = inventory.getStackInSlot(slot);
+					if (!stack.isEmpty()) {
+						String id = net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(stack.getItem()).toString();
+						sourceItems.merge(id, (long) stack.getCount(), Long::sum);
+					}
+				}
+			}
+			var hopper = helper.getItemContent(target.south());
+			var received = helper.getItemContent(target);
+			System.out.printf("MOUNTED_CONTENT %d,%s,%s,%s%n", helper.getTick(),
+				formatCargo(sourceItems), formatCargo(hopper), formatCargo(received));
+		} else {
+			if (store == null) {
+				amountIn = Integer.toString(helper.getTankContents(source).getAmount());
+			} else {
+				var info = store.getFluids();
+				amountIn = Integer.toString(java.util.stream.IntStream.range(0, info.getTanks())
+					.map(i -> info.getFluidInTank(i).getAmount()).sum());
+			}
+			amountOut = Integer.toString(helper.getTankContents(target).getAmount());
+		}
+		String angle = entity == null ? "" : String.format(java.util.Locale.ROOT, "%.6f", entity.getAngle(1.0f));
+		System.out.printf("MOUNTED_TRACE %s,%d,%d,%d,%s,%s,%s%n", name, helper.getTick(),
+			helper.getLevel().getGameTime() % 20, moving.size(), angle, amountIn, amountOut);
+	}
+
 }
