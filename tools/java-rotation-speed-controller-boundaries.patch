+		helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), shaftMotor).generatedSpeed.setValue(24);
+		var fromAbove = helper.getBlockEntity(AllBlockEntityTypes.ROTATION_SPEED_CONTROLLER.get(), drivenFromAbove);
+		var fromShaft = helper.getBlockEntity(AllBlockEntityTypes.ROTATION_SPEED_CONTROLLER.get(), drivenFromShaft);
+		var actualUpperInput = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), cogAbove);
+		var actualUpperOutput = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), cogOutput);
+		var endFromAbove = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), shaftOutput);
+		var endFromShaft = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), topOutput);
+		var endShaftThrough = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), shaftThrough);
+		helper.succeedWhen(() -> {
