+	private static void assembleTwoBogeyTrain(ServerLevel level, net.minecraft.world.entity.player.Player player,
+			BlockPos destination, BlockPos target, net.minecraft.core.Direction direction, net.minecraft.world.item.Item casing,
+			com.simibubi.create.content.trains.track.ITrackBlock track, net.minecraft.world.level.block.state.BlockState rail,
+			net.minecraft.world.InteractionHand hand) {
+		var station = (com.simibubi.create.content.trains.station.StationBlockEntity) level.getBlockEntity(destination);
+		if (station == null)
+			throw new IllegalStateException("Station block entity missing at " + destination);
+		boolean assemblyMode = station.enterAssemblyMode(null);
+		System.out.println("CREATE_TWO_TRAIN_STATION " + destination + " target=" + target + " rail="
+			+ level.getBlockState(target) + " data=" + station.saveWithoutMetadata(level.registryAccess())
+			+ " assembly=" + assemblyMode);
+		if (!assemblyMode)
+			throw new IllegalStateException("Station did not enter assembly mode at " + destination);
+		direction = station.getAssemblyDirection();
+		System.out.println("CREATE_TWO_TRAIN_DIRECTION " + target + " direction=" + direction);
+		player.setItemInHand(hand, new ItemStack(casing, 3));
+		var first = target.relative(direction);
+		var last = target.relative(direction, 4);
+		boolean firstAccepted = station.trackClicked(player, hand, track, rail, first);
+		System.out.println("CREATE_TWO_TRAIN_BOGEY " + target + " first=" + firstAccepted + " at=" + first);
+		boolean lastAccepted = station.trackClicked(player, hand, track, rail, last);
+		System.out.println("CREATE_TWO_TRAIN_BOGEY " + target + " last=" + lastAccepted + " at=" + last);
+		if (!firstAccepted || !lastAccepted)
+			throw new IllegalStateException("Bogeys were rejected at " + target);
+		for (int x = 1; x <= 4; x++)
+			level.setBlockAndUpdate(target.relative(direction, x).above(2), Blocks.OAK_PLANKS.defaultBlockState());
+		var controls = com.simibubi.create.AllBlocks.TRAIN_CONTROLS.get().defaultBlockState()
+			.setValue(com.simibubi.create.content.contraptions.actors.trainControls.ControlsBlock.FACING,
+				direction);
+		level.setBlockAndUpdate(first.above(3), controls);
+		var glue = com.simibubi.create.content.contraptions.glue.SuperGlueEntity.span(first.above(), last.above(3));
+		level.addFreshEntity(new com.simibubi.create.content.contraptions.glue.SuperGlueEntity(level, glue));
+		station.assemble(player.getUUID());
+	}
+
+	private static void clickTrackForAssembly(com.simibubi.create.content.trains.track.TrackTargetingBlockItem item,
+			net.minecraft.world.entity.player.Player player, BlockPos pos) {
+		var hit = new net.minecraft.world.phys.BlockHitResult(
+			net.minecraft.world.phys.Vec3.atCenterOf(pos).add(0,.5,0), net.minecraft.core.Direction.UP, pos, false);
+		var before = player.getMainHandItem().copy();
+		var state = player.level().getBlockState(pos);
+		if (state.getBlock() instanceof com.simibubi.create.content.trains.track.ITrackBlock track)
+			com.simibubi.create.content.trains.track.TrackTargetingBlockItem.withGraphLocation(player.level(), pos, true, null,
+				item.getType(before), (overlap, location) -> System.out.println("CREATE_TWO_TRAIN_GRAPH " + pos + " overlap=" + overlap + " location=" + location));
+		var result = item.useOn(new net.minecraft.world.item.context.UseOnContext(player,
+			net.minecraft.world.InteractionHand.MAIN_HAND, hit));
+		System.out.println("CREATE_TWO_TRAIN_CLICK " + pos + " result=" + result + " held=" + player.getMainHandItem() + " state=" + state + " player=" + player.getUUID());
+	}
