+  helper.runAtTickTime(60, () -> {
+   System.out.printf("COUPLING_SLOPE_RAIL %s,%s,%s,%s,%s,%s%n", world.getBlockState(new BlockPos(13,170,24)), world.getBlockState(new BlockPos(12,170,24)), world.getBlockState(new BlockPos(11,171,24)), world.getBlockState(new BlockPos(13,170,28)), world.getBlockState(new BlockPos(12,170,28)), world.getBlockState(new BlockPos(11,171,28)));
+   for (int z : new int[]{24,28}) {
+    helper.assertTrue(world.getBlockState(new BlockPos(13,170,z)).getValue(shape) == net.minecraft.world.level.block.state.properties.RailShape.EAST_WEST, "wrong approach rail");
+    helper.assertTrue(world.getBlockState(new BlockPos(12,170,z)).getValue(shape) == net.minecraft.world.level.block.state.properties.RailShape.ASCENDING_WEST, "wrong slope rail");
+    helper.assertTrue(world.getBlockState(new BlockPos(11,171,z)).getValue(shape) == net.minecraft.world.level.block.state.properties.RailShape.EAST_WEST, "wrong upper rail");
