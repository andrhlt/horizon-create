+   world.setBlock(new BlockPos(x,y,z), Blocks.AIR.defaultBlockState(), 2);
+  for (int z : new int[]{24, 28}) for (int x = 4; x <= 24; x++) {
+   for (int y=170; y<=173; y++) world.setBlock(new BlockPos(x,y,z), Blocks.AIR.defaultBlockState(), 2);
+   world.setBlock(new BlockPos(x,169,z), Blocks.STONE.defaultBlockState(), 2);
+   if (x <= 11) world.setBlock(new BlockPos(x,170,z), Blocks.STONE.defaultBlockState(), 2);
+  }
+  for (int z : new int[]{24, 28}) for (int x = 4; x <= 24; x++) {
+   int y = x <= 11 ? 171 : 170;
+   var railShape = x == 12 ? net.minecraft.world.level.block.state.properties.RailShape.ASCENDING_WEST : net.minecraft.world.level.block.state.properties.RailShape.EAST_WEST;
+   world.setBlock(new BlockPos(x,y,z), Blocks.RAIL.defaultBlockState().setValue(shape,railShape), 2);
+  }
+  var a = new net.minecraft.world.entity.vehicle.Minecart(EntityType.MINECART, world);
+  var b = new net.minecraft.world.entity.vehicle.Minecart(EntityType.MINECART, world);
+  var base = new net.minecraft.world.entity.vehicle.Minecart(EntityType.MINECART, world);
+  a.setUUID(java.util.UUID.fromString("00000000-0000-0000-0000-000000000001"));
+  b.setUUID(java.util.UUID.fromString("00000000-0000-0000-0000-000000000002"));
+  base.setUUID(java.util.UUID.fromString("00000000-0000-0000-0000-000000000003"));
+  a.setPos(16.5,170.0625,24.5); b.setPos(13.5,170.0625,24.5); base.setPos(13.5,170.0625,28.5);
