+	private static void observeStorage(CreateGameTestHelper helper, boolean filtered) {
+		helper.pullLever(filtered ? new BlockPos(2, 3, 1) : new BlockPos(1, 3, 2));
+		helper.succeedWhen(() -> {
+			int tick = (int) helper.getTick();
+			for (int x : filtered ? new int[] {1, 3} : new int[] {1}) {
+				BlockPos receiver = new BlockPos(x, 2, 1);
+				BlockPos observer = new BlockPos(x, 2, 2);
+				BlockPos chute = receiver.above();
+				var lookup = helper.getLevel().registryAccess();
+				var observerEntity = helper.getBlockEntity(observer).saveWithoutMetadata(lookup);
+				var chuteEntity = helper.getBlockEntity(chute).saveWithoutMetadata(lookup);
+				boolean powered = helper.getBlockState(observer)
+					.getValue(com.simibubi.create.content.redstone.smartObserver.SmartObserverBlock.POWERED);
+				boolean lit = helper.getBlockState(observer.south()).getValue(RedstoneLampBlock.LIT);
+				System.out.printf("CREATE_OBSERVER %s %d %d %d %d %d %d %d %d%n",
+					filtered ? "filtered" : "storage", tick, x, helper.getTotalItems(chute.above()),
+					chuteEntity.getCompound("Item").getInt("count"), helper.getTotalItems(receiver),
+					powered ? 1 : 0, observerEntity.getInt("TurnOff"), lit ? 1 : 0);
+			}
+			int detectedX = filtered ? 3 : 1;
+			BlockPos detectedReceiver = new BlockPos(detectedX, 2, 1);
+			if (tick == 15) {
+				helper.assertBlockProperty(new BlockPos(detectedX, 2, 3), RedstoneLampBlock.LIT, true);
+				if (filtered)
+					helper.assertBlockProperty(new BlockPos(1, 2, 3), RedstoneLampBlock.LIT, false);
+				helper.itemStorageAt(detectedReceiver).extractItem(0, 64, false);
+			}
+			if (tick == 34)
+				ItemHandlerHelper.insertItem(helper.itemStorageAt(detectedReceiver),
+					new ItemStack(Items.GOLD_BLOCK), false);
+			helper.assertTrue(tick >= 45, "Waiting for the observer and lamp to settle");
+			helper.assertBlockProperty(new BlockPos(detectedX, 2, 3), RedstoneLampBlock.LIT, true);
+		});
 	}
 
 	@GameTest(template = "depot_display", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
