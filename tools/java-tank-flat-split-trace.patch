+    @GameTest(template = "shearing", timeoutTicks = 50)
+    public static void tankMergeTrace(CreateGameTestHelper helper) {
+        var level = helper.getLevel();
+        var base = helper.absolutePos(new BlockPos(3, 16, 3));
+        var tank = com.simibubi.create.AllBlocks.FLUID_TANK.getDefaultState();
+        helper.runAtTickTime(2, () -> {
+            for (int rig = 0; rig < 2; rig++) for (int x = 0; x < 2; x++) for (int z = 0; z < 2; z++)
+                level.setBlockAndUpdate(base.east(rig * 6 + x).south(z), tank);
+        });
+        helper.runAtTickTime(8, () -> {
+            for (int rig = 0; rig < 2; rig++) {
+                var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, base.east(rig * 6), null);
+                System.out.printf("CREATE_FLAT_FILL %d|%d|%d%n", rig, cap.fill(new net.neoforged.neoforge.fluids.FluidStack(net.minecraft.world.level.material.Fluids.WATER, 24000), net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE), cap.getTankCapacity(0));
+            }
+        });
+        for (int tick = 9; tick <= 16; tick++) {
+            final int sample = tick;
+            helper.runAtTickTime(tick, () -> {
+                if (sample == 10) {
+                    level.destroyBlock(base, false);
+                    level.destroyBlock(base.east(7).south(), false);
+                }
+                for (int rig = 0; rig < 2; rig++) for (int x = 0; x < 2; x++) for (int z = 0; z < 2; z++) {
+                    var pos = base.east(rig * 6 + x).south(z);
+                    var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, pos, null);
+                    System.out.printf("CREATE_FLAT %d|%d|%d|%d|%s|%s|%d%n", sample, rig, x, z, level.getBlockState(pos).getBlock(), cap == null ? "-" : cap.getFluidInTank(0), cap == null ? 0 : cap.getTankCapacity(0));
+                }
+                if (sample == 16) helper.succeed();
+            });
+        }
+    }
