+	private static void traceActor(CreateGameTestHelper helper, String fixture) {
+		BlockPos origin = helper.absolutePos(new BlockPos(0, 1, 0));
+		int extent = fixture.equals("crop_farming") ? 14 : 7;
+		var bounds = new net.minecraft.world.phys.AABB(origin).expandTowards(6, 7, extent);
+		var level = helper.getLevel();
+		var moving = level.getEntitiesOfClass(
+			com.simibubi.create.content.contraptions.AbstractContraptionEntity.class, bounds);
+		var geometry = moving.stream().map(entity -> String.format(java.util.Locale.ROOT, "%.9f:%.9f:%.9f:%.6f",
+			entity.getX() - origin.getX(), entity.getY() - origin.getY(), entity.getZ() - origin.getZ(),
+			entity instanceof com.simibubi.create.content.contraptions.ControlledContraptionEntity controlled
+				? controlled.getAngle(1.0f) : 0.0f)).sorted().collect(java.util.stream.Collectors.joining("|"));
+		String contents = switch (fixture) {
+			case "ploughing" -> net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(
+				level.getBlockState(helper.absolutePos(new BlockPos(4, 2, 1))).getBlock()).toString();
+			case "crop_farming" -> {
+				var crops = new java.util.ArrayList<String>();
+				for (int x = 1; x <= 3; x++) {
+					for (int z = 5; z <= 11; z++) {
+						var crop = level.getBlockState(helper.absolutePos(new BlockPos(x, 3, z)));
+						if (crop.getBlock() instanceof CropBlock growing)
+							crops.add(net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(growing)
+								+ "=" + growing.getAge(crop));
+						else
+							crops.add(net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(crop.getBlock()).toString());
+					}
+				}
+				yield String.join("|", crops) + "," + helper.getTotalItems(new BlockPos(1, 3, 12));
+			}
+			default -> {
+				var arrows = level.getEntitiesOfClass(Arrow.class, bounds).stream()
+					.map(arrow -> String.format(java.util.Locale.ROOT, "%.6f:%.6f:%.6f:%.6f:%.6f:%.6f",
+						arrow.getX() - origin.getX(), arrow.getY() - origin.getY(), arrow.getZ() - origin.getZ(),
+						arrow.getDeltaMovement().x, arrow.getDeltaMovement().y, arrow.getDeltaMovement().z))
+					.sorted().collect(java.util.stream.Collectors.joining("|"));
+				long count;
+				if (!moving.isEmpty()) {
+					var inventories = moving.getFirst().getContraption().getStorage().getAllItemStorages().values();
+					count = inventories.stream().filter(store -> store instanceof
+						com.simibubi.create.content.contraptions.behaviour.dispenser.storage.DispenserMountedStorage)
+						.mapToLong(store -> java.util.stream.IntStream.range(0, store.getSlots())
+							.map(slot -> store.getStackInSlot(slot).getCount()).sum()).sum();
+				} else {
+					var dispenser = new BlockPos(2, 5, 2);
+					count = level.getBlockEntity(helper.absolutePos(dispenser)) == null
+						? 0 : helper.getTotalItems(dispenser);
+				}
+				yield count + "," + arrows;
+			}
+		};
+		System.out.printf("ACTOR_TRACE %s,%d,%d,%d:%d:%d,%s,%s%n", fixture, helper.getTick(),
+			level.getGameTime() % 20, origin.getX(), origin.getY(), origin.getZ(), geometry, contents);
+	}
+
 }
