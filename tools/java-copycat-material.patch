+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 32)
+	public static void copycatLifecycle(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var pos = new BlockPos(8, 170, 30);
+		world.setChunkForced(0, 1, true);
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var creative = helper.makeMockPlayer(net.minecraft.world.level.GameType.CREATIVE);
+		var off = net.minecraft.world.InteractionHand.OFF_HAND;
+		player.setYRot(90.0f);
+		player.setYHeadRot(90.0f);
+		var wrappers = java.util.List.of(
+			com.simibubi.create.AllBlocks.COPYCAT_PANEL.getDefaultState(),
+			com.simibubi.create.AllBlocks.COPYCAT_STEP.getDefaultState()
+		);
+		helper.runAtTickTime(4, () -> {
+			for (var wrapper : wrappers) {
+				for (var action : java.util.List.of("survival-break", "creative-break")) {
+					world.setBlockAndUpdate(pos, wrapper);
+					player.setItemInHand(off, new ItemStack(Items.OAK_LOG, 3));
+					wrapper.getBlock().setPlacedBy(world, pos, wrapper, player, new ItemStack(wrapper.getBlock()));
+					var blockEntity = (com.simibubi.create.content.decoration.copycat.CopycatBlockEntity) world.getBlockEntity(pos);
+					System.out.printf("COPYCAT_LIFECYCLE %d;%s;%s;placed;%s;%d;%d%n", helper.getTick(), wrapper, action,
+						blockEntity.getMaterial(), blockEntity.getConsumedItem().getCount(), player.getItemInHand(off).getCount());
+					var breaker = action.equals("creative-break") ? creative : player;
+					wrapper.getBlock().playerWillDestroy(world, pos, wrapper, breaker);
+					world.destroyBlock(pos, !breaker.isCreative(), breaker);
+					var dropped = world.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class,
+						new net.minecraft.world.phys.AABB(pos).inflate(3));
+					var contents = dropped.stream().map(entity -> net.minecraft.core.registries.BuiltInRegistries.ITEM
+						.getKey(entity.getItem().getItem()) + "=" + entity.getItem().getCount())
+						.sorted().collect(java.util.stream.Collectors.joining("|"));
+					System.out.printf("COPYCAT_LIFECYCLE %d;%s;%s;removed;%s;%s%n", helper.getTick(), wrapper, action,
+						world.getBlockState(pos), contents);
+					dropped.forEach(net.minecraft.world.entity.item.ItemEntity::discard);
+				}
+			}
+			helper.succeed();
+		});
+	}
 }
