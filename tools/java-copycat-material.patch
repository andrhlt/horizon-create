+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 32)
+	public static void copycatMaterialTrace(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var pos = new BlockPos(8, 170, 23);
+		world.setChunkForced(0, 1, true);
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		player.setYRot(90.0f);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var east = net.minecraft.core.Direction.EAST;
+		var hit = new net.minecraft.world.phys.BlockHitResult(
+			net.minecraft.world.phys.Vec3.atCenterOf(pos), east, pos, false);
+		var wrappers = new net.minecraft.world.level.block.state.BlockState[] {
+			com.simibubi.create.AllBlocks.COPYCAT_PANEL.getDefaultState(),
+			com.simibubi.create.AllBlocks.COPYCAT_STEP.getDefaultState(),
+		};
+		var cases = java.util.List.of(
+			Blocks.STONE, Blocks.OAK_LOG, Blocks.STONE_STAIRS, Blocks.BARREL,
+			Blocks.GLASS_PANE, Blocks.IRON_BARS, Blocks.OAK_TRAPDOOR,
+			com.simibubi.create.content.decoration.palettes.AllPaletteBlocks.OAK_WINDOW.get(),
+			com.simibubi.create.content.decoration.palettes.AllPaletteBlocks.OAK_WINDOW_PANE.get()
+		);
+		helper.runAtTickTime(3, () -> {
+			for (var wrapper : wrappers) {
+				for (var material : cases) {
+					world.setBlockAndUpdate(pos, Blocks.AIR.defaultBlockState());
+					world.setBlockAndUpdate(pos, wrapper);
+					player.getInventory().clearContent();
+					player.setItemInHand(hand, new ItemStack(material, 4));
+					var key = net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(material);
+					for (String action : java.util.List.of("apply", "repeat", "different", "wrench", "sneak-wrench")) {
+						if (action.equals("different"))
+							player.setItemInHand(hand, new ItemStack(Blocks.DIRT, 3));
+						var stack = player.getItemInHand(hand);
+						Object result;
+						if (action.endsWith("wrench")) {
+							var wrench = com.simibubi.create.AllItems.WRENCH.asStack();
+							player.setItemInHand(hand, wrench);
+							player.setShiftKeyDown(action.equals("sneak-wrench"));
+							result = wrench.getItem().useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+							player.setShiftKeyDown(false);
+						} else {
+							result = world.getBlockState(pos).useItemOn(stack, world, player, hand, hit);
+						}
+						var entity = world.getBlockEntity(pos);
+						String appearance = "-";
+						int consumed = 0;
+						if (entity instanceof com.simibubi.create.content.decoration.copycat.CopycatBlockEntity copycat) {
+							appearance = copycat.getMaterial().toString();
+							consumed = copycat.getConsumedItem().getCount();
+						}
+						String inventory = player.getInventory().items.stream()
+							.filter(item -> !item.isEmpty())
+							.map(item -> net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(item.getItem()) + "=" + item.getCount())
+							.sorted().collect(java.util.stream.Collectors.joining("|"));
+						System.out.printf("COPYCAT_TRACE %d;%s;%s;%s;%s;%s;%s;%d;%s%n",
+							helper.getTick(), wrapper, key, action, result, world.getBlockState(pos), appearance, consumed, inventory);
+					}
+				}
+			}
+			helper.succeed();
+		});
+	}
