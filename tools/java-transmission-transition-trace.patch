+	@GameTest(template = "shearing", batch = "consecutive_transmission", timeoutTicks = 18)
+	public static void transmissionConsecutivePower(CreateGameTestHelper helper) {
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var powered = net.minecraft.world.level.block.state.properties.BlockStateProperties.POWERED;
+		var directions = new net.minecraft.core.Direction[] {
+			net.minecraft.core.Direction.EAST, net.minecraft.core.Direction.UP, net.minecraft.core.Direction.SOUTH
+		};
+		var blocks = java.util.List.of(AllBlocks.CLUTCH.getDefaultState(), AllBlocks.GEARSHIFT.getDefaultState());
+		var rigs = new java.util.ArrayList<BlockPos>();
+		for (int kind = 0; kind < blocks.size(); kind++) {
+			for (int axisIndex = 0; axisIndex < directions.length; axisIndex++) {
+				var direction = directions[axisIndex];
+				var pos = new BlockPos(8 + axisIndex * 5, 5, 8 + kind * 5);
+				rigs.add(pos);
+				helper.setBlock(pos.relative(direction.getOpposite()), AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, direction));
+				helper.setBlock(pos, blocks.get(kind).setValue(axis, direction.getAxis()));
+				helper.setBlock(pos.relative(direction), AllBlocks.SHAFT.getDefaultState().setValue(axis, direction.getAxis()));
+			}
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int rig = 0; rig < rigs.size(); rig++) {
+				var pos = rigs.get(rig);
+				var direction = directions[rig % directions.length];
+				var input = pos.relative(direction.getOpposite());
+				var output = pos.relative(direction);
+				var signal = pos.relative(direction.getAxis() == net.minecraft.core.Direction.Axis.X
+					? net.minecraft.core.Direction.NORTH : net.minecraft.core.Direction.EAST);
+				if (tick == 0)
+					helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), input).generatedSpeed.setValue(32);
+				for (int phase = 0; phase < 2; phase++) {
+					if (phase == 1) {
+						if (tick < 3 || tick > 6) continue;
+						helper.setBlock(signal, tick % 2 == 1 ? Blocks.REDSTONE_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState());
+					}
+					var state = helper.getBlockState(pos);
+					System.out.printf(java.util.Locale.ROOT, "CREATE_TRANSMISSION_PULSE,%d,%s,%d,%d,%s,%.0f,%.0f%n",
+						rig / directions.length, direction.getAxis(), tick, phase, state.getValue(powered),
+						transitionSpeed(helper, pos), transitionSpeed(helper, output));
+				}
+			}
+			if (tick < 9) helper.fail("Waiting for six transmission pulse rigs");
+		});
+	}
