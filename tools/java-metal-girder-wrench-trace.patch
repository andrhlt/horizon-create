+	@GameTest(template = "shearing", timeoutTicks = 16)
+	public static void metalGirderWrenchConnections(CreateGameTestHelper helper) {
+		var girder = com.simibubi.create.AllBlocks.METAL_GIRDER;
+		var wrench = com.simibubi.create.AllItems.WRENCH;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var xAxis = net.minecraft.core.Direction.Axis.X;
+		var x = com.simibubi.create.content.decoration.girder.GirderBlock.X;
+		var z = com.simibubi.create.content.decoration.girder.GirderBlock.Z;
+		var top = com.simibubi.create.content.decoration.girder.GirderBlock.TOP;
+		var bottom = com.simibubi.create.content.decoration.girder.GirderBlock.BOTTOM;
+		var level = helper.getLevel();
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var beam = girder.getDefaultState().setValue(axis, xAxis).setValue(x, true);
+		for (int index = 0; index < 4; index++) {
+			var pos = new BlockPos(12, 3, 2 + index * 5);
+			var initial = index == 2 ? beam.setValue(z, true)
+				: index == 3 ? beam.setValue(axis, net.minecraft.core.Direction.Axis.Y).setValue(top, true).setValue(bottom, true)
+				: beam;
+			level.setBlock(helper.absolutePos(pos), initial, 2 | 16);
+			if (index == 1) {
+				level.setBlock(helper.absolutePos(pos), initial.setValue(top, true), 2 | 16);
+				level.setBlock(helper.absolutePos(pos.above()), beam.setValue(bottom, true), 2 | 16);
+			}
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int index = 0; index < 4; index++) {
+				var pos = new BlockPos(12, 3, 2 + index * 5);
+				var state = helper.getBlockState(pos);
+				var other = helper.getBlockState(pos.above());
+				System.out.printf(java.util.Locale.ROOT, "CREATE_GIRDER_WRENCH,%d,%d,%s,%s,%s,%s,%s,%s%n",
+					tick, index, state.getValue(axis).getName(), state.getValue(x), state.getValue(z),
+					state.getValue(top), state.getValue(bottom), girder.has(other) && other.getValue(bottom));
+				if (tick == 3 || (tick == 5 && index == 0) || (tick == 7 && index < 2)) {
+					var at = helper.absolutePos(pos);
+					player.setPos(at.getX(), at.getY(), at.getZ() - 2);
+					player.setShiftKeyDown(false);
+					var tool = wrench.asStack();
+					player.setItemInHand(hand, tool);
+					var hitPoint = at.getCenter().add(0, tick == 5 ? -0.33 : 0.30, -0.25);
+					var hit = new net.minecraft.world.phys.BlockHitResult(hitPoint, net.minecraft.core.Direction.NORTH, at, false);
+					state.useItemOn(tool, level, player, hand, hit);
+				}
+			}
+			if (tick < 9)
+				helper.fail("Waiting for the complete girder wrench connection trace");
+		});
+	}
 }
