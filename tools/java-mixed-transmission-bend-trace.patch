+
+	@GameTest(template = "shearing", timeoutTicks = 24)
+	public static void mixedTransmissionBend(CreateGameTestHelper helper) {
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var powered = net.minecraft.world.level.block.state.properties.BlockStateProperties.POWERED;
+		var east = net.minecraft.core.Direction.EAST;
+		var clutch = AllBlocks.CLUTCH.getDefaultState().setValue(axis, east.getAxis());
+		var gearshift = AllBlocks.GEARSHIFT.getDefaultState().setValue(axis, east.getAxis());
+		var shaft = AllBlocks.SHAFT.getDefaultState().setValue(axis, east.getAxis());
+		var rigs = java.util.List.of(new BlockPos(8, 5, 8), new BlockPos(8, 5, 13),
+			new BlockPos(8, 9, 8), new BlockPos(8, 9, 13));
+		for (int rig = 0; rig < rigs.size(); rig++) {
+			var left = rigs.get(rig);
+			var right = left.east().above();
+			helper.setBlock(left.north(), Blocks.AIR.defaultBlockState());
+			helper.setBlock(right.south(), Blocks.AIR.defaultBlockState());
+			helper.setBlock(left.west(), AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, east));
+			helper.setBlock(left, rig < 2 ? clutch : gearshift);
+			helper.setBlock(left.east(), AllBlocks.GEARBOX.getDefaultState().setValue(axis, net.minecraft.core.Direction.Axis.Z));
+			helper.setBlock(right, (rig < 2 ? gearshift : clutch).setValue(axis, net.minecraft.core.Direction.Axis.Y));
+			helper.setBlock(right.above(), shaft.setValue(axis, net.minecraft.core.Direction.Axis.Y));
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int rig = 0; rig < rigs.size(); rig++) {
+				var left = rigs.get(rig);
+				var right = left.east().above();
+				if (tick == 0)
+					helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), left.west()).generatedSpeed.setValue(32);
+				boolean changes = tick == 3 || tick == 6;
+				for (int phase = 0; phase < (changes ? 3 : 1); phase++) {
+					if (phase != 0) {
+						var first = rig % 2 == 0 ? left : right;
+						var second = rig % 2 == 0 ? right : left;
+						var changed = phase == 1 ? first : second;
+						helper.setBlock(changed.equals(left) ? left.north() : right.south(),
+							tick == 3 ? Blocks.REDSTONE_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState());
+					}
+					System.out.printf(java.util.Locale.ROOT, "CREATE_MIXED_TRANSMISSION_BEND,%d,%d,%d,%s,%s,%.0f,%.0f,%.0f,%.0f%n",
+						rig, tick, phase, helper.getBlockState(left).getValue(powered), helper.getBlockState(right).getValue(powered),
+						mixedSpeed(helper, left), mixedSpeed(helper, left.east()), mixedSpeed(helper, right), mixedSpeed(helper, right.above()));
+				}
+			}
+			if (tick < 10) helper.fail("Waiting for both mixed transmission callbacks");
+		});
+	}
+
+	private static float mixedSpeed(CreateGameTestHelper helper, BlockPos pos) {
+		var entity = helper.getLevel().getBlockEntity(helper.absolutePos(pos));
+		return entity instanceof com.simibubi.create.content.kinetics.base.KineticBlockEntity kinetic
+			? kinetic.getTheoreticalSpeed() : 0;
+	}
 }
