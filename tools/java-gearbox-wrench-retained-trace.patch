+	private static void gearboxWrenchRetained(CreateGameTestHelper helper, Direction.Axis initial,
+		Direction input, int motorSetting, Direction noopFace, Direction turnFace) {
+		BlockPos pos = new BlockPos(12, 6, 5);
+		helper.setBlock(pos.relative(input), AllBlocks.CREATIVE_MOTOR.getDefaultState()
+			.setValue(BlockStateProperties.FACING, input.getOpposite()));
+		helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), pos.relative(input)).generatedSpeed.setValue(motorSetting);
+		for (Direction face : Direction.values()) {
+			if (face != input)
+				helper.setBlock(pos.relative(face), AllBlocks.SHAFT.getDefaultState()
+					.setValue(BlockStateProperties.AXIS, face.getAxis()));
+		}
+		helper.setBlock(pos, AllBlocks.GEARBOX.getDefaultState().setValue(BlockStateProperties.AXIS, initial));
+		var player = helper.makeMockPlayer(GameType.SURVIVAL);
+		player.setItemInHand(InteractionHand.MAIN_HAND, AllItems.WRENCH.asStack());
+		for (int tick = 0; tick < 6; tick++) {
+			int sample = tick;
+			helper.runAtTickTime(8 + tick, () -> {
+				gearboxWrenchRetainedSample(helper, pos, initial, sample, "end_tick");
+				Direction click = sample == 0 ? noopFace : sample == 2 ? turnFace : null;
+				if (click != null) {
+					var absolute = helper.absolutePos(pos);
+					var hit = new BlockHitResult(Vec3.atCenterOf(absolute), click, absolute, false);
+					var result = player.getMainHandItem().getItem().useOn(new UseOnContext(player, InteractionHand.MAIN_HAND, hit));
+					helper.assertTrue(result.consumesAction(), "Expected Wrench action to be accepted");
+					gearboxWrenchRetainedSample(helper, pos, initial, sample, "after_use");
+				}
+				if (sample == 5)
+					helper.succeed();
+			});
+		}
+	}
+
+	private static void gearboxWrenchRetainedSample(CreateGameTestHelper helper, BlockPos pos,
+		Direction.Axis initial, int tick, String phase) {
+		var level = helper.getLevel();
+		var absolute = helper.absolutePos(pos);
+		JsonObject row = new JsonObject();
+		row.addProperty("case", initial.getSerializedName());
+		row.addProperty("tick", tick);
+		row.addProperty("phase", phase);
+		JsonObject points = new JsonObject();
+		for (Direction face : Direction.values())
+			points.add(face.getSerializedName(), gearboxWrenchReading(level, absolute.relative(face)));
+		points.add("gearbox", gearboxWrenchReading(level, absolute));
+		row.add("points", points);
+		System.out.println("CREATE_GEARBOX_WRENCH_RETAINED " + row);
+	}
+
+	private static JsonObject gearboxWrenchReading(ServerLevel level, BlockPos pos) {
+		var state = level.getBlockState(pos);
+		var entity = (KineticBlockEntity) level.getBlockEntity(pos);
+		JsonObject reading = new JsonObject();
+		reading.addProperty("block", BuiltInRegistries.BLOCK.getKey(state.getBlock()).toString());
+		reading.addProperty("rpm", entity.getSpeed());
+		if (entity instanceof GearboxBlockEntity gearbox) {
+			reading.addProperty("axis", state.getValue(BlockStateProperties.AXIS).getSerializedName());
+			reading.addProperty("source", gearbox.hasSource() ? gearbox.getSourceFacing().getSerializedName() : "none");
+		}
+		return reading;
+	}
