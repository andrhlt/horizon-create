+package com.simibubi.create.infrastructure.gametest.tests;
+
+import com.simibubi.create.AllSpriteShifts;
+import com.simibubi.create.Create;
+import com.simibubi.create.foundation.model.BakedQuadHelper;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.RenderType;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.level.BlockAndTintGetter;
+import net.minecraft.world.level.ColorResolver;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.CrossCollisionBlock;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.lighting.LevelLightEngine;
+import net.minecraft.world.level.material.FluidState;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+import net.neoforged.neoforge.client.model.data.ModelData;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaWeatheredWindowProbe {
+    private static boolean done;
+
+    private static final class Scene implements BlockAndTintGetter {
+        final Map<BlockPos, BlockState> blocks = new HashMap<>();
+        public BlockState getBlockState(BlockPos position) { return blocks.getOrDefault(position, Blocks.AIR.defaultBlockState()); }
+        public BlockEntity getBlockEntity(BlockPos position) { return null; }
+        public FluidState getFluidState(BlockPos position) { return getBlockState(position).getFluidState(); }
+        public int getHeight() { return 384; }
+        public int getMinBuildHeight() { return -64; }
+        public float getShade(Direction direction, boolean shaded) { return 1; }
+        public LevelLightEngine getLightEngine() { return null; }
+        public int getBlockTint(BlockPos position, ColorResolver resolver) { return -1; }
+    }
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post event) {
+        if (!Boolean.getBoolean("parity.weatheredWindow") || done)
+            return;
+        var minecraft = Minecraft.getInstance();
+        if (minecraft.screen == null || minecraft.getOverlay() != null)
+            return;
+        done = true;
+        try {
+            probe(minecraft);
+        } finally {
+            minecraft.stop();
+        }
+    }
+
+    private static void probe(Minecraft minecraft) {
+        var shifts = List.of(AllSpriteShifts.OLD_FACTORY_WINDOW_1, AllSpriteShifts.OLD_FACTORY_WINDOW_2,
+            AllSpriteShifts.OLD_FACTORY_WINDOW_3, AllSpriteShifts.OLD_FACTORY_WINDOW_4);
+        var solid = BuiltInRegistries.BLOCK.get(Create.asResource("weathered_iron_window")).defaultBlockState();
+        var pane = BuiltInRegistries.BLOCK.get(Create.asResource("weathered_iron_window_pane")).defaultBlockState();
+        var states = List.of(solid, pane, pane.setValue(CrossCollisionBlock.EAST, true).setValue(CrossCollisionBlock.WEST, true),
+            pane.setValue(CrossCollisionBlock.NORTH, true).setValue(CrossCollisionBlock.SOUTH, true),
+            pane.setValue(CrossCollisionBlock.NORTH, true).setValue(CrossCollisionBlock.EAST, true),
+            pane.setValue(CrossCollisionBlock.NORTH, true).setValue(CrossCollisionBlock.EAST, true)
+                .setValue(CrossCollisionBlock.SOUTH, true).setValue(CrossCollisionBlock.WEST, true));
+        var faceQueries = new Direction[] {null, Direction.DOWN, Direction.UP, Direction.NORTH,
+            Direction.SOUTH, Direction.WEST, Direction.EAST};
+        var scene = new Scene();
+        for (int sample = 0; sample < 12; sample++) {
+            var at = new BlockPos(sample * 7 - 17, 80 + sample, sample * -13 + 23);
+            for (int shape = 0; shape < states.size(); shape++) {
+                var state = states.get(shape);
+                var model = minecraft.getBlockRenderer().getBlockModel(state);
+                for (int mask : new int[] {0, 1, 4, 16, 64, 85}) {
+                    scene.blocks.clear();
+                    scene.blocks.put(at, state);
+                    if ((mask & 1) != 0) scene.blocks.put(at.above(), shape == 0 ? solid : pane);
+                    if ((mask & 16) != 0) scene.blocks.put(at.below(), shape == 0 ? solid : pane);
+                    if ((mask & 4) != 0) scene.blocks.put(at.east(), shape == 0 ? solid : pane);
+                    if ((mask & 64) != 0) scene.blocks.put(at.west(), shape == 0 ? solid : pane);
+                    var modelData = model.getModelData(scene, at, state, ModelData.EMPTY);
+                    for (Direction query : faceQueries) {
+                        var random = RandomSource.create(state.getSeed(at));
+                        var quads = model.getQuads(state, query, random, modelData, RenderType.translucent());
+                        for (int ordinal = 0; ordinal < quads.size(); ordinal++) {
+                            var quad = quads.get(ordinal);
+                            float u = 0;
+                            float v = 0;
+                            var center = net.minecraft.world.phys.Vec3.ZERO;
+                            for (int i = 0; i < 4; i++) {
+                                center = center.add(BakedQuadHelper.getXYZ(quad.getVertices(), i).scale(.25));
+                                u += BakedQuadHelper.getU(quad.getVertices(), i) / 4;
+                                v += BakedQuadHelper.getV(quad.getVertices(), i) / 4;
+                            }
+                            int variant = -1;
+                            int tile = -1;
+                            for (int i = 0; i < shifts.size(); i++) {
+                                var target = shifts.get(i).getTarget();
+                                if (u > target.getU0() && u < target.getU1() && v > target.getV0() && v < target.getV1()) {
+                                    variant = i;
+                                    tile = ((int) (4 * (u - target.getU0()) / (target.getU1() - target.getU0()))) +
+                                        4 * ((int) (4 * (v - target.getV0()) / (target.getV1() - target.getV0())));
+                                    break;
+                                }
+                            }
+                            System.out.printf(java.util.Locale.ROOT, "CREATE_WEATHERED_QUAD %d,%d,%d,%d,%d,%s,%d,%s,%d,%d,%s,%.5f,%.5f,%.5f%n",
+                                at.getX(), at.getY(), at.getZ(), shape, mask, query == null ? "unculled" : query.getName(),
+                                ordinal, quad.getDirection().getName(), variant, tile, quad.getSprite().contents().name(), center.x, center.y, center.z);
+                        }
+                    }
+                }
+            }
+        }
+        System.out.println("CREATE_WEATHERED_QUADS_DONE");
+    }
+}
