+				for (BlockPos d : BlockPos.betweenClosed(-8, -8, -8, 8, 8, 8))
+					level.setBlock(origin.offset(d), Blocks.AIR.defaultBlockState(), 2);
+				for (int a = -3; a <= 3; a++) for (int b = -3; b <= 3; b++) for (int h = -3; h <= 0; h++) {
+					var d = scenario == 0 ? new BlockPos(a, h, b) : new BlockPos(-h, a, b);
+					level.setBlock(origin.offset(d), Blocks.STONE.defaultBlockState(), 2);
+				}
+				for (int a = -1; a <= 1; a++) for (int b = -1; b <= 1; b++) {
+					var d = scenario == 0 ? new BlockPos(a, 1, b) : new BlockPos(-1, a, b);
+					level.setBlock(origin.offset(d), Blocks.STONE.defaultBlockState(), 2);
+				}
+				var summit = origin.offset(scenario == 0 ? new BlockPos(0, 2, 0) : new BlockPos(-2, 0, 0));
+				level.setBlock(summit, Blocks.STONE.defaultBlockState(), 2);
+				var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+				var stack = com.simibubi.create.AllItems.WORLDSHAPER.asStack();
+				player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, stack);
+				if (scenario == 0) {
+					player.setPos(summit.getX() + .5, summit.getY() + 2, summit.getZ() + .5);
+					player.setYRot(0); player.setXRot(90);
+				} else {
+					player.setPos(summit.getX() - 2, summit.getY() - 1.12, summit.getZ() + .5);
+					player.setYRot(-90); player.setXRot(0);
+				}
+				com.simibubi.create.content.equipment.zapper.terrainzapper.WorldshaperItem.configureSettings(stack,
+					com.simibubi.create.content.equipment.zapper.PlacementPatterns.Solid,
+					com.simibubi.create.content.equipment.zapper.terrainzapper.TerrainBrushes.Cuboid,
+					7, 7, 7, com.simibubi.create.content.equipment.zapper.terrainzapper.TerrainTools.Flatten,
+					com.simibubi.create.content.equipment.zapper.terrainzapper.PlacementOptions.Merged);
+				var eye = player.position().add(0, player.getEyeHeight(), 0);
+				var hit = level.clip(new net.minecraft.world.level.ClipContext(eye, eye.add(player.getLookAngle().scale(128)),
+					net.minecraft.world.level.ClipContext.Block.OUTLINE, net.minecraft.world.level.ClipContext.Fluid.NONE, player));
+				var before = new java.util.HashMap<BlockPos, net.minecraft.world.level.block.state.BlockState>();
+				for (BlockPos d : BlockPos.betweenClosed(-6, -6, -6, 6, 6, 6)) { var p = origin.offset(d); before.put(p, level.getBlockState(p)); }
+				var components = ((net.minecraft.nbt.CompoundTag) stack.saveOptional(level.registryAccess())).getCompound("components");
+				var result = com.simibubi.create.AllItems.WORLDSHAPER.get().use(level, player, net.minecraft.world.InteractionHand.MAIN_HAND);
+				var changed = new java.util.ArrayList<String>();
+				for (int x = -6; x <= 6; x++) for (int y = -6; y <= 6; y++) for (int z = -6; z <= 6; z++) {
+					var p = origin.offset(x, y, z); var old = before.get(p); var now = level.getBlockState(p);
+					if (old != now) changed.add(x + ":" + y + ":" + z + ":" + net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(old.getBlock()) + ">" + net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(now.getBlock()));
+				}
+				System.out.printf("CREATE_WORLDSHAPER_FLATTEN,%s,%s,%s,%s,%s,%d,%s,%s%n", scenario == 0 ? "up" : "west", hit.getDirection(), hit.getBlockPos().subtract(origin), result.getResult(), stack.has(com.simibubi.create.AllDataComponents.SHAPER_BLOCK_USED), changed.size(), String.join("|", changed), components);
+				if (!hit.getBlockPos().equals(summit) || hit.getDirection() != (scenario == 0 ? net.minecraft.core.Direction.UP : net.minecraft.core.Direction.WEST) || result.getResult() != net.minecraft.world.InteractionResult.SUCCESS || changed.isEmpty())
+					throw new IllegalStateException("Unexpected Flatten result " + hit + " " + changed);
+			}
+			helper.succeed();
+		});
+	}
