+	@GameTest(template = "shearing", timeoutTicks = 40)
+	public static void gearboxWrenchTransforms(CreateGameTestHelper helper) {
+		var player = helper.makeMockPlayer(GameType.SURVIVAL);
+		BlockPos relative = new BlockPos(12, 6, 5);
+		BlockPos pos = helper.absolutePos(relative);
+		var level = helper.getLevel();
+		for (Direction.Axis axis : Direction.Axis.values()) {
+			for (Direction face : Direction.values()) {
+				helper.setBlock(relative, AllBlocks.GEARBOX.getDefaultState().setValue(BlockStateProperties.AXIS, axis));
+				player.getInventory().clearContent();
+				player.setItemInHand(InteractionHand.MAIN_HAND, AllItems.WRENCH.asStack());
+				var hit = new BlockHitResult(Vec3.atCenterOf(pos), face, pos, false);
+				player.setShiftKeyDown(false);
+				helper.assertTrue(gearboxWrenchUse(player, hit).consumesAction(), "Gearbox rotation was not accepted");
+				var row = new JsonObject();
+				row.addProperty("initial_axis", axis.getSerializedName());
+				row.addProperty("face", face.getSerializedName());
+				row.addProperty("axis", level.getBlockState(pos).getValue(BlockStateProperties.AXIS).getSerializedName());
+				player.setShiftKeyDown(true);
+				var pickupHit = new BlockHitResult(Vec3.atCenterOf(pos), Direction.WEST, pos, false);
+				helper.assertTrue(gearboxWrenchUse(player, pickupHit).consumesAction(), "Gearbox pickup was not accepted");
+				row.addProperty("block_after_pickup", BuiltInRegistries.BLOCK.getKey(level.getBlockState(pos).getBlock()).toString());
+				var items = new JsonObject();
+				for (var stack : player.getInventory().items)
+					if (!stack.isEmpty())
+						items.addProperty(BuiltInRegistries.ITEM.getKey(stack.getItem()).toString(), stack.getCount());
+				row.add("inventory", items);
+				System.out.println("CREATE_GEARBOX_WRENCH " + row);
+			}
+		}
+		helper.succeed();
+	}
+
+	@GameTest(template = "shearing", timeoutTicks = 40)
+	public static void gearboxWrenchPowered(CreateGameTestHelper helper) {
+		BlockPos relative = new BlockPos(12, 6, 5);
+		BlockPos pos = helper.absolutePos(relative);
+		var player = helper.makeMockPlayer(GameType.SURVIVAL);
+		player.setItemInHand(InteractionHand.MAIN_HAND, AllItems.WRENCH.asStack());
+		helper.setBlock(relative.north(), AllBlocks.CREATIVE_MOTOR.getDefaultState()
+			.setValue(BlockStateProperties.FACING, Direction.SOUTH));
+		helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), relative.north()).generatedSpeed.setValue(32);
+		helper.setBlock(relative.south(), AllBlocks.SHAFT.getDefaultState().setValue(BlockStateProperties.AXIS, Direction.Axis.Z));
+		helper.setBlock(relative.east(), AllBlocks.SHAFT.getDefaultState().setValue(BlockStateProperties.AXIS, Direction.Axis.X));
+		helper.setBlock(relative.above(), AllBlocks.SHAFT.getDefaultState().setValue(BlockStateProperties.AXIS, Direction.Axis.Y));
+		helper.setBlock(relative, AllBlocks.GEARBOX.getDefaultState());
+		var hit = new BlockHitResult(Vec3.atCenterOf(pos), Direction.WEST, pos, false);
+
+		for (int tick = 0; tick < 9; tick++) {
+			int sample = tick;
+			helper.runAtTickTime(8 + tick, () -> {
+				gearboxWrenchPowerSample(helper, pos, sample, "end_tick");
+				if (sample == 0 || sample == 4) {
+					helper.assertTrue(gearboxWrenchUse(player, hit).consumesAction(), "Powered wrench use was not accepted");
+					gearboxWrenchPowerSample(helper, pos, sample, "after_use");
+				}
+				if (sample == 8)
+					helper.succeed();
+			});
+		}
+	}
+
+	private static InteractionResult gearboxWrenchUse(Player player, BlockHitResult hit) {
+		return player.getMainHandItem().getItem().useOn(new UseOnContext(player, InteractionHand.MAIN_HAND, hit));
+	}
+
+	private static void gearboxWrenchPowerSample(CreateGameTestHelper helper, BlockPos pos, int tick, String phase) {
+		var level = helper.getLevel();
+		var be = (GearboxBlockEntity) level.getBlockEntity(pos);
+		var row = new JsonObject();
+		row.addProperty("tick", tick);
+		row.addProperty("phase", phase);
+		row.addProperty("axis", level.getBlockState(pos).getValue(BlockStateProperties.AXIS).getSerializedName());
+		row.addProperty("input", be.hasSource() ? be.getSourceFacing().getSerializedName() : "none");
+		row.addProperty("gearbox_rpm", be.getSpeed());
+		row.addProperty("south_rpm", ((KineticBlockEntity) level.getBlockEntity(pos.south())).getSpeed());
+		row.addProperty("east_rpm", ((KineticBlockEntity) level.getBlockEntity(pos.east())).getSpeed());
+		row.addProperty("up_rpm", ((KineticBlockEntity) level.getBlockEntity(pos.above())).getSpeed());
+		System.out.println("CREATE_GEARBOX_WRENCH_POWER " + row);
+	}
