+	@GameTest(template = "shearing", timeoutTicks = 18)
+	public static void shaftCasing(CreateGameTestHelper helper) {
+		var shaft = com.simibubi.create.AllBlocks.SHAFT;
+		var motor = com.simibubi.create.AllBlocks.CREATIVE_MOTOR;
+		var wrench = com.simibubi.create.AllItems.WRENCH;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var wet = net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var east = net.minecraft.core.Direction.EAST;
+		var south = net.minecraft.core.Direction.SOUTH;
+		var up = net.minecraft.core.Direction.UP;
+		var level = helper.getLevel();
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var lanes = java.util.List.of(new BlockPos(12, 3, 2), new BlockPos(20, 3, 2));
+		var shafts = java.util.List.of(east, south);
+		var materials = java.util.List.of(com.simibubi.create.AllBlocks.ANDESITE_CASING,
+			com.simibubi.create.AllBlocks.BRASS_CASING);
+		var variants = java.util.List.of(com.simibubi.create.AllBlocks.ANDESITE_ENCASED_SHAFT,
+			com.simibubi.create.AllBlocks.BRASS_ENCASED_SHAFT);
+		var heldCasings = new java.util.ArrayList<ItemStack>();
+		for (int caseIndex = 0; caseIndex < lanes.size(); caseIndex++) {
+			var pos = lanes.get(caseIndex);
+			var direction = shafts.get(caseIndex);
+			var begin = pos.relative(direction.getOpposite());
+			var end = pos.relative(direction);
+			helper.setBlock(pos, shaft.getDefaultState().setValue(axis, direction.getAxis()).setValue(wet, caseIndex == 0));
+			helper.setBlock(end, shaft.getDefaultState().setValue(axis, direction.getAxis()));
+			helper.setBlock(begin, motor.getDefaultState().setValue(facing, direction));
+			helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), begin).generatedSpeed
+				.setValue(caseIndex == 0 ? 24 : 40);
+			heldCasings.add(new ItemStack(materials.get(caseIndex).asItem(), 2));
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int caseIndex = 0; caseIndex < lanes.size(); caseIndex++) {
+				var pos = lanes.get(caseIndex);
+				var end = pos.relative(shafts.get(caseIndex));
+				var placed = helper.getBlockState(pos);
+				var state = shaft.has(placed) ? "shaft" : variants.get(caseIndex).has(placed) ? "encased" : "other";
+				var network = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), end);
+				System.out.printf(java.util.Locale.ROOT, "CREATE_SHAFT_CASING,%d,%d,%s,%s,%s,%d,%.4f%n",
+					tick, caseIndex, state, placed.getValue(axis), placed.hasProperty(wet) && placed.getValue(wet),
+					heldCasings.get(caseIndex).getCount(), network.getSpeed());
+				var at = helper.absolutePos(pos);
+				player.setPos(at.getX() - 2, at.getY(), at.getZ());
+				var hit = new net.minecraft.world.phys.BlockHitResult(at.getCenter().relative(up, 0.1875), up, at, false);
+				if (tick == 3) {
+					player.setShiftKeyDown(false);
+					var held = heldCasings.get(caseIndex);
+					player.setItemInHand(hand, held);
+					placed.useItemOn(held, level, player, hand, hit);
+				}
+				if (tick == 7) {
+					player.setShiftKeyDown(true);
+					var held = wrench.asStack();
+					player.setItemInHand(hand, held);
+					held.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+					player.setShiftKeyDown(false);
+				}
+			}
+			if (tick < 12)
+				helper.fail("Waiting for complete shaft casing observations");
+		});
+	}
 }
