+	@GameTest(template = "wheat_milling", timeoutTicks = 70)
+	public static void basinCompacting(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var horizontal = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var east = net.minecraft.core.Direction.EAST;
+		var motorState = AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, east);
+		var pressState = AllBlocks.MECHANICAL_PRESS.getDefaultState().setValue(horizontal, east);
+		var basinState = AllBlocks.BASIN.getDefaultState();
+		var lava = net.minecraft.world.level.material.Fluids.LAVA;
+		var materials = new net.minecraft.world.item.Item[] { Items.SNOW_BLOCK, Items.IRON_INGOT, Items.FLINT, Items.HONEY_BOTTLE };
+		var results = new net.minecraft.world.item.Item[] { Items.ICE, Items.IRON_BLOCK, Items.ANDESITE, Items.HONEY_BLOCK };
+		var presses = new com.simibubi.create.content.kinetics.press.MechanicalPressBlockEntity[4];
+		var basins = new com.simibubi.create.content.processing.basin.BasinBlockEntity[4];
+		for (int index = 0; index < presses.length; index++) {
+			BlockPos motorPos = new BlockPos(1, 11, 1 + index * 2);
+			BlockPos pressPos = motorPos.east();
+			BlockPos basinPos = pressPos.below(2);
+			helper.setBlock(motorPos, motorState);
+			helper.setBlock(pressPos, pressState);
+			helper.setBlock(basinPos, basinState);
+			var motor = (com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity)
+				helper.getBlockEntity(motorPos);
+			motor.generatedSpeed.setValue(256);
+			presses[index] = (com.simibubi.create.content.kinetics.press.MechanicalPressBlockEntity) helper.getBlockEntity(pressPos);
+			basins[index] = (com.simibubi.create.content.processing.basin.BasinBlockEntity) helper.getBlockEntity(basinPos);
+		}
+
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int index = 0; index < presses.length; index++) {
+				var press = presses[index];
+				var behavior = press.getPressingBehaviour();
+				var basin = basins[index];
+				int amount = basin.inputTank.getCapability().getFluidInTank(0).getAmount();
+				System.out.printf(java.util.Locale.ROOT,
+					"CREATE_COMPACTING %d,%d,%d,%d,%d,%d,%d,%d,%d,%.6f%n",
+					tick, index, (int) press.getSpeed(), behavior.running ? 1 : 0,
+					behavior.finished ? 1 : 0, behavior.mode.ordinal(), behavior.runningTicks,
+					countItems(basin.getInputInventory(), materials[index]),
+					countItems(basin.getOutputInventory(), results[index]),
+					behavior.getRenderedHeadOffset(0) * behavior.mode.headOffset);
+				if (index == 2)
+					System.out.printf("CREATE_COMPACTING_LAVA %d,%d%n", tick, amount);
+				if (index == 3)
+					System.out.printf("CREATE_COMPACTING_BOTTLES %d,%d%n", tick, countItems(basin.getOutputInventory(), Items.GLASS_BOTTLE));
+
+				if (tick == 4) {
+					int count = index == 3 ? 8 : index == 2 ? 4 : 18;
+					basin.getInputInventory().insertItem(0, new ItemStack(materials[index], count), false);
+					if (index == 2) {
+						basin.getInputInventory().insertItem(1, new ItemStack(Items.GRAVEL, 2), false);
+						basin.inputTank.getCapability().fill(new net.neoforged.neoforge.fluids.FluidStack(lava, 200),
+							net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE);
+					}
+				}
+			}
+			helper.assertTrue(tick >= 33, "Waiting for both compacting cycles");
+			for (int index = 0; index < presses.length; index++)
+				helper.assertTrue(countItems(basins[index].getOutputInventory(), results[index]) == 2,
+					"Expected two compacted results in basin " + index);
+		});
+	}
+
+	private static int countItems(net.neoforged.neoforge.items.IItemHandler inventory,
+		net.minecraft.world.item.Item item) {
+		int count = 0;
+		for (int slot = 0; slot < inventory.getSlots(); slot++) {
+			var stack = inventory.getStackInSlot(slot);
+			if (stack.is(item))
+				count += stack.getCount();
+		}
+		return count;
+	}
+
 }
