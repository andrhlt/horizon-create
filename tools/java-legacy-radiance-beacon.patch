+	@GameTest(template = "shearing", timeoutTicks = 40)
+	public static void legacyMaterialLightCollection(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var test = helper.absolutePos(new BlockPos(1, 16, 1));
+		var origin = new BlockPos((test.getX() & -16) + 3, test.getY(), (test.getZ() & -16) + 5);
+		var item = com.simibubi.create.AllItems.CHROMATIC_COMPOUND.get();
+		var component = com.simibubi.create.AllDataComponents.CHROMATIC_COMPOUND_COLLECTING_LIGHT;
+		for (int i = 0; i < 3; i++) {
+			var drop = origin.south(i * 4);
+			var at = net.minecraft.world.phys.Vec3.atCenterOf(drop);
+			var seed = new net.minecraft.world.level.levelgen.LegacyRandomSource(4100);
+			helper.assertTrue(seed.nextFloat() <= .5f, "expected selected light lookup");
+			var target = BlockPos.containing(net.createmod.catnip.math.VecHelper.offsetRandomly(at, seed, 3));
+			System.out.printf("CREATE_RADIANCE_TARGET,%d,%d,%d%n",
+				target.getX() - drop.getX(), target.getY() - drop.getY(), target.getZ() - drop.getZ());
+			helper.assertTrue(target.getX() >= drop.getX() + 2, "need clearance for a blocker");
+			var luminous = i != 2;
+			level.setBlockAndUpdate(target, (luminous ? Blocks.GLOWSTONE : Blocks.STONE).defaultBlockState());
+			if (i == 1)
+				level.setBlockAndUpdate(drop.east(), Blocks.STONE.defaultBlockState());
+			var source = new net.minecraft.world.entity.item.ItemEntity(level, at.x, at.y, at.z, new ItemStack(item, 2), 0, 0, 0);
+			source.setPickUpDelay(32767);
+			level.addFreshEntity(source);
+			level.random.setSeed(4100);
+			item.onEntityItemUpdate(source.getItem(), source);
+			var area = new net.minecraft.world.phys.AABB(drop).inflate(.25);
+			int plain = 0, charged = 0, charge = 0;
+			for (var nearby : level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class, area)) {
+				int light = nearby.getItem().getOrDefault(component, 0);
+				if (light == 0)
+					plain += nearby.getItem().getCount();
+				else {
+					charged += nearby.getItem().getCount();
+					charge = light;
+				}
+			}
+			var block = net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(level.getBlockState(target).getBlock());
+			System.out.printf("CREATE_RADIANCE_COLLECTION,%d,%s,%d,%d,%d%n", i, block, plain, charged, charge);
+			helper.assertTrue((i == 0 && charged == 1 && charge == 1 && plain == 1 && level.isEmptyBlock(target))
+				|| (i != 0 && charged == 0 && plain == 2 && !level.isEmptyBlock(target)), "wrong light collection branch");
+		}
+		helper.succeed();
+	}
 }
