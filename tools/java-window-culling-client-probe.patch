+package com.simibubi.create.infrastructure.gametest.tests;
+
+import com.simibubi.create.Create;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.level.BlockAndTintGetter;
+import net.minecraft.world.level.ColorResolver;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.CrossCollisionBlock;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.lighting.LevelLightEngine;
+import net.minecraft.world.level.material.FluidState;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ClientTickEvent;
+import net.neoforged.neoforge.client.model.data.ModelData;
+
+@EventBusSubscriber(value = Dist.CLIENT)
+public class JavaWindowCullingProbe {
+    private static boolean done;
+
+    private static final class Scene implements BlockAndTintGetter {
+        final Map<BlockPos, BlockState> blocks = new HashMap<>();
+        public BlockState getBlockState(BlockPos position) { return blocks.getOrDefault(position, Blocks.AIR.defaultBlockState()); }
+        public BlockEntity getBlockEntity(BlockPos position) { return null; }
+        public FluidState getFluidState(BlockPos position) { return getBlockState(position).getFluidState(); }
+        public int getHeight() { return 384; }
+        public int getMinBuildHeight() { return -64; }
+        public float getShade(Direction direction, boolean shaded) { return 1; }
+        public LevelLightEngine getLightEngine() { return null; }
+        public int getBlockTint(BlockPos position, ColorResolver resolver) { return -1; }
+    }
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post event) {
+        if (!Boolean.getBoolean("parity.windowCulling") || done)
+            return;
+        var minecraft = Minecraft.getInstance();
+        if (minecraft.screen == null || minecraft.getOverlay() != null)
+            return;
+        done = true;
+        try {
+            probe(minecraft);
+        } finally {
+            minecraft.stop();
+        }
+    }
+
+
+    private static final String[] WINDOWS = {"tiled_glass", "framed_glass", "horizontal_framed_glass",
+        "vertical_framed_glass", "oak_window", "spruce_window", "birch_window", "jungle_window",
+        "acacia_window", "dark_oak_window", "mangrove_window", "crimson_window", "warped_window",
+        "cherry_window", "bamboo_window", "ornate_iron_window", "industrial_iron_window",
+        "weathered_iron_window"};
+
+    private static BlockState state(String id, String shape) {
+        var block = BuiltInRegistries.BLOCK.get(net.minecraft.resources.ResourceLocation.parse(id));
+        var state = block.defaultBlockState();
+        if (!shape.isEmpty()) {
+            for (var property : shape.split("\\+")) {
+                var prop = switch (property) {
+                    case "n" -> CrossCollisionBlock.NORTH;
+                    case "s" -> CrossCollisionBlock.SOUTH;
+                    case "e" -> CrossCollisionBlock.EAST;
+                    case "w" -> CrossCollisionBlock.WEST;
+                    default -> CrossCollisionBlock.WATERLOGGED;
+                };
+                state = state.setValue(prop, true);
+            }
+        }
+        return state;
+    }
+
+    private static void measure(Minecraft minecraft, String ownId, String ownShape, String otherId,
+                                String otherShape, Direction face) {
+        var pos = new BlockPos(8, 190, 8);
+        var own = state(ownId, ownShape);
+        var other = state(otherId, otherShape);
+        var scene = new Scene();
+        scene.blocks.put(pos, own);
+        scene.blocks.put(pos.relative(face), other);
+        boolean visible = Block.shouldRenderFace(own, scene, pos, face, pos.relative(face));
+        var model = minecraft.getBlockRenderer().getBlockModel(own);
+        var modelData = model.getModelData(scene, pos, own, ModelData.EMPTY);
+        var quads = model.getQuads(own, face, RandomSource.create(own.getSeed(pos)), modelData, null);
+        int covered = 0;
+        for (var quad : quads) {
+            double left = 0;
+            double z = 0;
+            for (int vertex = 0; vertex < 4; vertex++) {
+                var point = com.simibubi.create.foundation.model.BakedQuadHelper.getXYZ(quad.getVertices(), vertex);
+                left += point.x * .25;
+                z += point.z * .25;
+            }
+            if (Math.abs(z - .5) < .065 && (face.getAxis().isHorizontal() || Math.abs(left - .5) < .065))
+                covered++;
+        }
+        System.out.printf(java.util.Locale.ROOT, "CREATE_WINDOW_CULL %s,%s,%s,%s,%s,%s,%d,%d%n",
+            ownId, ownShape, otherId, otherShape, face.getName(), visible, quads.size(), covered);
+    }
+
+    private static void probe(Minecraft minecraft) {
+        var front = Direction.EAST;
+        var top = Direction.UP;
+        var fullNeighbors = List.of("minecraft:air", "minecraft:stone", "minecraft:glass",
+            "minecraft:glass_pane", "create:framed_glass_pane");
+        var paneNeighbors = List.of("minecraft:air", "minecraft:stone", "minecraft:glass",
+            "minecraft:glass_pane", "minecraft:iron_bars", "create:oak_window");
+        for (String own : WINDOWS) {
+            String id = "create:" + own;
+            for (Direction face : List.of(front, top)) {
+                for (String other : WINDOWS)
+                    measure(minecraft, id, "", "create:" + other, "", face);
+                for (String other : fullNeighbors)
+                    measure(minecraft, id, "", other, "", face);
+            }
+            String pane = id + "_pane";
+            for (String other : WINDOWS) {
+                String neighbor = "create:" + other + "_pane";
+                measure(minecraft, pane, "e", neighbor, "w", front);
+                measure(minecraft, pane, "e+w", neighbor, "e+w", top);
+                measure(minecraft, pane, "e+w", neighbor, "e", top);
+                measure(minecraft, pane, "e+w", neighbor, "e+w+water", top);
+            }
+            for (String other : paneNeighbors) {
+                String connected = other.endsWith("_pane") || other.endsWith("iron_bars") ? "w" : "";
+                measure(minecraft, pane, "e", other, connected, front);
+                measure(minecraft, pane, "e+w", other, connected, top);
+            }
+            measure(minecraft, pane, "", pane, "", top);
+            measure(minecraft, pane, "", pane, "water", top);
+            measure(minecraft, pane, "e", pane, "", front);
+        }
+        System.out.println("CREATE_WINDOW_CULL_DONE");
+    }
+}
