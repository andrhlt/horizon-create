+			level.setBlockAndUpdate(origin.offset(x,-1,0), Blocks.SMOOTH_STONE.defaultBlockState());
+			level.setBlockAndUpdate(origin.east(x), rail);
+			level.setBlockAndUpdate(origin.east(x).above(), Blocks.AIR.defaultBlockState());
+		}
+		var destination = origin.south(2);
+		level.setBlockAndUpdate(destination, Blocks.AIR.defaultBlockState());
+		level.setBlockAndUpdate(destination.below(), Blocks.SMOOTH_STONE.defaultBlockState());
+		var item = (com.simibubi.create.content.trains.track.TrackTargetingBlockItem) com.simibubi.create.AllBlocks.TRACK_STATION.asItem();
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		helper.runAfterDelay(7, () -> {
+			player.setItemInHand(hand, new ItemStack(item));
+			player.setYRot(90);
+			player.setXRot(20);
+			clickTrackForAssembly(item, player, origin);
+			clickTrackForAssembly(item, player, destination.below());
+		});
+		helper.runAfterDelay(12, () -> {
+			var station = (com.simibubi.create.content.trains.station.StationBlockEntity) level.getBlockEntity(destination);
+			helper.assertTrue(station != null && station.enterAssemblyMode(null), "Station must enter assembly mode");
+			player.setItemInHand(hand, new ItemStack(casing, 3));
+			helper.assertTrue(station.trackClicked(player, hand, track, rail, origin.east()), "Expected first bogey");
+			helper.assertTrue(station.trackClicked(player, hand, track, rail, origin.east(4)), "Expected rear bogey");
+			for (int x = 1; x <= 4; x++)
+				level.setBlockAndUpdate(origin.east(x).above(2), Blocks.OAK_PLANKS.defaultBlockState());
+			var controls = com.simibubi.create.AllBlocks.TRAIN_CONTROLS.get().defaultBlockState()
+				.setValue(com.simibubi.create.content.contraptions.actors.trainControls.ControlsBlock.FACING,
+					net.minecraft.core.Direction.EAST);
+			level.setBlockAndUpdate(origin.east().above(3), controls);
+            var seat = com.simibubi.create.AllBlocks.SEATS.get(net.minecraft.world.item.DyeColor.WHITE).get().defaultBlockState();
+            level.setBlockAndUpdate(origin.east(2).above(3), seat);
+            level.setBlockAndUpdate(origin.east(4).above(3), seat);
+			var area = com.simibubi.create.content.contraptions.glue.SuperGlueEntity.span(origin.east().above(), origin.east(4).above(3));
+			level.addFreshEntity(new com.simibubi.create.content.contraptions.glue.SuperGlueEntity(level, area));
+			station.assemble(player.getUUID());
+		});
+
+        helper.runAfterDelay(23, () -> {
+            var train = com.simibubi.create.Create.RAILWAYS.trains.values().stream()
+                .filter(candidate -> candidate.owner.equals(player.getUUID())).findFirst().orElseThrow();
+            var carriage = train.carriages.getFirst().anyAvailableEntity();
+            helper.assertTrue(carriage != null, "Train has no entity");
