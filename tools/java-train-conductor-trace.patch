+            helper.assertTrue(directions != null && !contraption.conductorSeats.containsKey(otherPosition), "Expected one controlling seat: " + contraption.conductorSeats);
+            System.out.printf("CREATE_CONDUCTOR_SEATS %d,%d,%s,%s%n", seats.indexOf(controllingPosition),
+                seats.indexOf(otherPosition), directions.getFirst(), directions.getSecond());
+
+            var driver = EntityType.VILLAGER.create(level);
+            var passenger = EntityType.VILLAGER.create(level);
+            for (var mob : java.util.List.of(driver, passenger)) {
+                mob.setNoAi(true);
+                var at = carriage.position();
+                mob.setPos(at.x, at.y + 2, at.z);
