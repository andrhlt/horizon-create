+
+            java.util.function.BiConsumer<String, net.minecraft.world.entity.Entity> click = (label, target) -> {
+                int ticks = label.equals("remove_early") ? 4 : label.equals("remove") ? 1 : 5;
+                for (int i = 0; i < ticks; i++)
+                    player.getCooldowns().tick();
+                var at = target.position();
+                player.setPos(at.x + 1, at.y + 1, at.z);
+                sounds.clear();
+                var event = new net.neoforged.neoforge.event.entity.player.PlayerInteractEvent.EntityInteractSpecific(
