+                int inventoryCount = player.getInventory().items.stream()
+                    .filter(com.simibubi.create.AllItems.SCHEDULE::isIn).mapToInt(ItemStack::getCount).sum();
+                System.out.printf("CREATE_CONDUCTOR %s,%s,%d,%s,%s,%d,%s,%s%n",
+                    label, event.isCanceled(), held.getCount(), train.runtime.getSchedule() != null,
+                    train.runtime.paused, inventoryCount,
+                    player.getCooldowns().isOnCooldown(com.simibubi.create.AllItems.SCHEDULE.get()),
+                    String.join("|", sounds));
+            };
+            player.setItemInHand(hand, programmed.copy());
+            click.accept("ordinary_seat", passenger);
+            player.setItemInHand(hand, com.simibubi.create.AllItems.SCHEDULE.asStack());
+            click.accept("blank", driver);
+            player.setItemInHand(hand, emptySchedule);
+            click.accept("empty_entries", driver);
+            player.setItemInHand(hand, programmed.copy());
+            click.accept("assign", driver);
+            helper.assertTrue(train.runtime.getSchedule() != null, "Program must attach");
+            click.accept("again", driver);
+            player.setItemInHand(hand, ItemStack.EMPTY);
+            click.accept("ordinary_empty", passenger);
+            player.setItemInHand(hand, new ItemStack(net.minecraft.world.item.Items.PAPER));
