+            click.accept("resume", driver);
+            click.accept("remove_early", driver);
+            click.accept("remove", driver);
+            var returned = player.getInventory().items.stream()
+                .filter(com.simibubi.create.AllItems.SCHEDULE::isIn).findFirst().orElseThrow();
+            System.out.printf("CREATE_CONDUCTOR_RETURN %d,%s,%s,%s%n", returned.getCount(),
+                returned.get(type).equals(programmed.get(type)), returned.has(net.minecraft.core.component.DataComponents.CUSTOM_NAME),
+                returned.get(type));
+            helper.assertTrue(train.runtime.getSchedule() == null, "Schedule must detach");
+            helper.succeed();
+        });
+    }
