+	@GameTest(template = "shearing", timeoutTicks = 58)
+	public static void handCrankWithMotor(CreateGameTestHelper helper) {
+		var stress = new BlockPos(2, 2, 0);
+		var motor = new BlockPos(2, 2, -1);
+		var rear = new BlockPos(2, 2, 1);
+		var crank = new BlockPos(2, 2, 2);
+		var front = new BlockPos(2, 2, 3);
+		var shaft = AllBlocks.SHAFT.getDefaultState()
+			.setValue(BlockStateProperties.AXIS, Direction.Axis.Z);
+		helper.setBlock(stress, AllBlocks.STRESSOMETER.getDefaultState()
+			.setValue(BlockStateProperties.FACING, Direction.UP)
+			.setValue(DirectionalAxisKineticBlock.AXIS_ALONG_FIRST_COORDINATE, false));
+		helper.setBlock(rear, shaft);
+		helper.setBlock(front, shaft);
+		helper.setBlock(crank, AllBlocks.HAND_CRANK.getDefaultState()
+			.setValue(BlockStateProperties.FACING, Direction.SOUTH));
+
+		helper.setBlock(motor, AllBlocks.CREATIVE_MOTOR.getDefaultState()
+			.setValue(BlockStateProperties.FACING, Direction.SOUTH));
+		var generator = helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), motor);
+		generator.generatedSpeed.setValue(64);
+		var player = helper.makeMockPlayer(GameType.SURVIVAL);
+		var source = helper.getBlockEntity(AllBlockEntityTypes.HAND_CRANK.get(), crank);
+		var gauge = helper.getBlockEntity(AllBlockEntityTypes.STRESSOMETER.get(), stress);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			var a = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), rear);
+			var b = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), front);
+			System.out.printf(java.util.Locale.ROOT,
+				"CREATE_HAND_CRANK_MOTOR %d,%b,%d,%b,%.1f,%.1f,%.1f,%.1f,%.1f,%.9f,%.9f,%.9f%n",
+				tick, helper.getBlockState(crank).isAir(), source.inUse, source.backwards, source.getSpeed(), a.getSpeed(), b.getSpeed(),
+				gauge.getSpeed(), gauge.getNetworkCapacity(), source.independentAngle,
+				source.chasingAngularVelocity, player.getFoodData().getExhaustionLevel());
+			if (tick == 4 || tick == 9 || tick == 16) {
+				player.setShiftKeyDown(tick == 16);
+				helper.useBlock(crank, player);
+			}
+			if (tick < 24)
+				helper.fail("Waiting for the final crank observation");
+		});
+	}
