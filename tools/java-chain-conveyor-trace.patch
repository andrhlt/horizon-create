+	private static void runChainConveyor(CreateGameTestHelper helper, String scenario, BlockPos edge, boolean reverse) {
+		var world = helper.getLevel();
+		var start = helper.absolutePos(new BlockPos(2, 2, 2)).above(12);
+		var end = start.offset(edge);
+		var portPos = end.east(2).below(2);
+		var motorPos = start.below();
+		int startTick = 8;
+		int last = reverse ? 66 : 79;
+		helper.runAtTickTime(2, () -> {
+			world.setBlockAndUpdate(start, AllBlocks.CHAIN_CONVEYOR.getDefaultState());
+			world.setBlockAndUpdate(end, AllBlocks.CHAIN_CONVEYOR.getDefaultState());
+			world.setBlockAndUpdate(motorPos, AllBlocks.CREATIVE_MOTOR.getDefaultState()
+				.setValue(CreativeMotorBlock.FACING, Direction.UP));
+			if (!reverse)
+				world.setBlockAndUpdate(portPos, AllBlocks.PACKAGE_FROGPORT.getDefaultState());
+		});
+		helper.runAtTickTime(5, () -> {
+			var motor = (CreativeMotorBlockEntity) world.getBlockEntity(motorPos);
+			motor.generatedSpeed.setValue(128);
+		});
+		helper.runAtTickTime(startTick, () -> {
+			var source = (ChainConveyorBlockEntity) world.getBlockEntity(start);
+			var dest = (ChainConveyorBlockEntity) world.getBlockEntity(end);
+			var player = chainPlayer(world, start, 1);
+			var chain = new ItemStack(Items.CHAIN);
+			new ChainConveyorConnectionPacket(start, end, chain, true).handle(player);
+			chainConnectionLine(scenario, "insufficient", source, dest, player, edge);
+			if (!source.connections.isEmpty() || !dest.connections.isEmpty() || player.getInventory().countItem(Items.CHAIN) != 1)
+				throw new IllegalStateException("Insufficient chains created a connection or changed inventory");
+			player.getInventory().setItem(0, new ItemStack(Items.CHAIN, 16));
+			new ChainConveyorConnectionPacket(start, end, chain, true).handle(player);
+			chainConnectionLine(scenario, "connected", source, dest, player, edge);
+			if (!source.connections.contains(edge) || !dest.connections.contains(edge.multiply(-1)))
+				throw new IllegalStateException("Connection packet did not link both conveyors");
+		});
+		for (int t = 0; t <= last; t++) {
+			final int tick = t;
+			helper.runAtTickTime(startTick + 1 + t, () -> {
+				var source = (ChainConveyorBlockEntity) world.getBlockEntity(start);
+				var dest = (ChainConveyorBlockEntity) world.getBlockEntity(end);
+				var port = reverse ? null : (FrogportBlockEntity) world.getBlockEntity(portPos);
+				if (tick == 0 && port != null) {
+					port.target = new ChainConveyorFrogportTarget(end.subtract(portPos), 150, (BlockPos) null, false);
+					port.addressFilter = "Lab-In";
+					port.target.setup(port, world, portPos);
+					port.target.register(port, world, portPos);
+				}
+				if (tick == 2) {
+					var box = chainPackage("Lab-In", Items.PAPER, 3);
+					if (reverse) {
+						var inject = new ChainConveyorFrogportTarget(BlockPos.ZERO, 0, edge, false);
+						if (!inject.export(world, start, box, true) || !inject.export(world, start, box, false))
+							throw new IllegalStateException("Travel package ingress was rejected");
+					} else {
+						source.addLoopingPackage(new ChainConveyorPackage(40, box));
+						source.addLoopingPackage(new ChainConveyorPackage(40, chainPackage("Other", Items.STRING, 2)));
+					}
+				}
+				if (reverse && tick == 11) {
+					var motor = (CreativeMotorBlockEntity) world.getBlockEntity(motorPos);
+					motor.generatedSpeed.setValue(-128);
+				}
+				if (reverse && tick == 31)
+					world.setBlockAndUpdate(motorPos, Blocks.AIR.defaultBlockState());
+				if (reverse && tick == 39) {
+					world.setBlockAndUpdate(motorPos, AllBlocks.CREATIVE_MOTOR.getDefaultState()
+						.setValue(CreativeMotorBlock.FACING, Direction.UP));
+				}
+				if (reverse && tick == 41)
+					((CreativeMotorBlockEntity) world.getBlockEntity(motorPos)).generatedSpeed.setValue(128);
+				if (tick == last - 3) {
+					var player = chainPlayer(world, start, 8);
+					new ChainConveyorConnectionPacket(start, end, new ItemStack(Items.CHAIN), false).handle(player);
+					chainConnectionLine(scenario, "disconnected", source, dest, player, edge);
+					if (!source.connections.isEmpty() || !dest.connections.isEmpty())
+						throw new IllegalStateException("Disconnect packet left a unilateral edge");
+				}
+				String receipt = port == null ? "-" : chainReceipt(port);
+				System.out.printf(Locale.ROOT, "CREATE_CHAIN_WORLD %s,%d,%.8f,%.8f,%b,%b,%b,%b,%s,%.8f,%s%n",
+					scenario, tick, source.getSpeed(), dest.getSpeed(), source.connections.contains(edge),
+					dest.connections.contains(edge.multiply(-1)), source.reversed, dest.reversed, chainOffset(source.routingTable.getExitFor(chainPackage("Lab-In", Items.PAPER, 3))),
+					port == null ? 0 : port.animationProgress.getValue(), receipt);
+				chainPackages(world, scenario, tick, "A", source, start);
+				chainPackages(world, scenario, tick, "B", dest, start);
+				if (tick == last) {
+					if (!reverse && !receipt.equals("inventory:Lab-In:paper:3"))
+						throw new IllegalStateException("Matching box failed to arrive at receiving Frogport: " + receipt);
+					helper.succeed();
+				}
+			});
+		}
+	}
