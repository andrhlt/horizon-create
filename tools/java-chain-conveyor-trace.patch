+	private static ServerPlayer chainPlayer(ServerLevel world, BlockPos at, int chains) {
+		var player = FakePlayerFactory.getMinecraft(world);
+		player.setPos(Vec3.atBottomCenterOf(at.above()));
+		player.getInventory().clearContent();
+		player.getInventory().setItem(0, new ItemStack(Items.CHAIN, chains));
+		return player;
+	}
+
+	private static ItemStack chainPackage(String address, net.minecraft.world.item.Item item, int count) {
+		var box = new ItemStack(PackageStyles.ALL_BOXES.get(0));
+		PackageItem.addAddress(box, address);
+		box.set(AllDataComponents.PACKAGE_CONTENTS, ItemContainerContents.fromItems(java.util.List.of(new ItemStack(item, count))));
+		return box;
+	}
+
+	private static String chainPayload(ItemStack box) {
+		var stack = box.getOrDefault(AllDataComponents.PACKAGE_CONTENTS, ItemContainerContents.EMPTY).getStackInSlot(0);
+		return PackageItem.getAddress(box) + ":" + net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(stack.getItem()).getPath()
+			+ ":" + stack.getCount();
+	}
+
+	private static String chainReceipt(FrogportBlockEntity port) {
+		if (port.animatedPackage != null && !port.animatedPackage.isEmpty())
+			return "animation:" + chainPayload(port.animatedPackage);
+		for (int i = 0; i < port.inventory.getSlots(); i++) {
+			var box = port.inventory.getStackInSlot(i);
+			if (!box.isEmpty())
+				return "inventory:" + chainPayload(box);
+		}
+		return "-";
+	}
+
+	private static String chainOffset(BlockPos offset) {
+		return offset.getX() + ":" + offset.getY() + ":" + offset.getZ();
+	}
+
+	private static void chainConnectionLine(String scenario, String action, ChainConveyorBlockEntity source,
+			ChainConveyorBlockEntity dest, ServerPlayer player, BlockPos edge) {
+		var stats = source.connectionStats.get(edge);
+		var start = stats == null ? Vec3.ZERO : stats.start().subtract(Vec3.atLowerCornerOf(source.getBlockPos()));
+		var end = stats == null ? Vec3.ZERO : stats.end().subtract(Vec3.atLowerCornerOf(source.getBlockPos()));
+		System.out.printf(Locale.ROOT, "CREATE_CHAIN_CONNECTION %s,%s,%s,%d,%d,%b,%b,%.8f,%.8f,%.8f,%.8f,%.8f,%.8f,%.8f,%.8f%n",
+			scenario, action, chainOffset(edge), ChainConveyorBlockEntity.getChainCost(edge), player.getInventory().countItem(Items.CHAIN),
+			source.connections.contains(edge), dest.connections.contains(edge.multiply(-1)),
+			stats == null ? 0 : stats.tangentAngle(), stats == null ? 0 : stats.chainLength(),
+			start.x, start.y, start.z, end.x, end.y, end.z);
+	}
+
+	private static void chainPackages(ServerLevel world, String scenario, int tick, String owner, ChainConveyorBlockEntity conveyor, BlockPos origin) {
+		var registries = world.registryAccess();
+		var root = conveyor.saveWithoutMetadata(registries);
+		var loops = root.getList("LoopingPackages", Tag.TAG_COMPOUND);
+		for (int i = 0; i < loops.size(); i++)
+			chainPackageLine(world, scenario, tick, owner, conveyor, origin, "loop", null, loops.getCompound(i));
+		var spans = root.getList("TravellingPackages", Tag.TAG_COMPOUND);
+		for (int i = 0; i < spans.size(); i++) {
+			var span = spans.getCompound(i);
+			var offset = net.minecraft.nbt.NbtUtils.readBlockPos(span, "Target").orElseThrow();
+			var boxes = span.getList("Packages", Tag.TAG_COMPOUND);
+			for (int b = 0; b < boxes.size(); b++)
+				chainPackageLine(world, scenario, tick, owner, conveyor, origin, "travel", offset, boxes.getCompound(b));
+		}
+	}
+
+	private static void chainPackageLine(ServerLevel world, String scenario, int tick, String owner,
+			ChainConveyorBlockEntity conveyor, BlockPos origin, String lane, BlockPos offset, net.minecraft.nbt.CompoundTag entry) {
+		float position = entry.getFloat("Position");
+		var box = ItemStack.parseOptional(world.registryAccess(), entry.getCompound("Item"));
+		// The public getPackagePosition method refreshes connection stats and can
+		// consume the polarity transition before the original block-entity tick.
+		var point = offset == null
+			? Vec3.atBottomCenterOf(conveyor.getBlockPos())
+				.add(net.createmod.catnip.math.VecHelper.rotate(new Vec3(0, 6 / 16f, 0.875), position, Direction.Axis.Y))
+			: chainSpanPosition(conveyor.connectionStats.get(offset), position);
+		point = point.subtract(Vec3.atLowerCornerOf(origin));
+		System.out.printf(Locale.ROOT, "CREATE_CHAIN_PACKAGE %s,%d,%s,%s,%s,%s,%.9f,%.9f,%.9f,%.9f%n",
+			scenario, tick, owner, lane, offset == null ? "-" : chainOffset(offset), chainPayload(box),
+			position, point.x, point.y, point.z);
+	}
+
+	private static Vec3 chainSpanPosition(ChainConveyorBlockEntity.ConnectionStats stats, float position) {
+		return stats.start().add(stats.end().subtract(stats.start()).normalize().scale(Math.min(stats.chainLength(), position)));
+	}
