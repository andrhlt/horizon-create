+		helper.setBlock(horizontal.south(), shaft.getDefaultState().setValue(axis, south.getAxis()));
+		helper.setBlock(vertical, motor.getDefaultState().setValue(facing, up));
+		helper.setBlock(vertical.above(), shaft.getDefaultState().setValue(axis, up.getAxis()));
+		var first = helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), horizontal);
+		var second = helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), vertical);
+		var firstShaft = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), horizontal.south());
+		var secondShaft = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), vertical.above());
+		var board = first.generatedSpeed.createBoard(player, null);
+		System.out.printf("CREATE_MOTOR_BOARD,%s,%d,%d,%d%n", board.title().getString(),
+			board.maxValue(), board.milestoneInterval(), board.rows().size());
+
+		for (var instance : java.util.List.of(first, second)) {
+			var state = instance.getBlockState();
+			var pos = instance.getBlockPos();
+			var slot = (com.simibubi.create.foundation.blockEntity.behaviour.ValueBoxTransform.Sided)
+				instance.generatedSpeed.getSlotPositioning();
+			for (var side : net.minecraft.core.Direction.values()) {
+				slot.fromSide(side);
+				var center = slot.getLocalOffset(helper.getLevel(), pos, state);
+				boolean active = slot.testHit(helper.getLevel(), pos, state, center);
+				System.out.printf(java.util.Locale.ROOT, "CREATE_MOTOR_HIT,%s,%s,%s,%.5f,%.5f,%.5f%n",
+					state.getValue(facing), side, active, center.x, center.y, center.z);
+			}
+		}
+		helper.succeedWhen(() -> {
