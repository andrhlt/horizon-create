+			System.out.printf(java.util.Locale.ROOT, "CREATE_CREATIVE_MOTOR,%d,%d,%d,%.4f,%.4f,%.4f,%.4f%n",
+				tick, first.generatedSpeed.getValue(), second.generatedSpeed.getValue(),
+				first.getSpeed(), firstShaft.getSpeed(), second.getSpeed(), secondShaft.getSpeed());
+			if (tick == 4 || tick == 11 || tick == 20 || tick == 28 || tick == 36) {
+				int row = tick == 11 || tick == 36 ? 0 : 1;
+				int value = tick == 4 ? 64 : tick == 11 ? 24 : tick == 20 ? 0 : tick == 28 ? 700 : 11;
+				for (var instance : java.util.List.of(first, second)) {
