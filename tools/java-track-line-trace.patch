+	@GameTest(template = "track_crafting")
+	public static void trackStraightConnection(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var origin = helper.absolutePos(new BlockPos(1,8,1));
+		var track = AllBlocks.TRACK.get();
