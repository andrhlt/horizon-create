+
+
+	@GameTest(template = "shearing", timeoutTicks = 14)
+	public static void metalGirderPlacementFacesAndWater(CreateGameTestHelper helper) {
+		var girder = com.simibubi.create.AllBlocks.METAL_GIRDER;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var waterlogged = net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED;
+		var x = com.simibubi.create.content.decoration.girder.GirderBlock.X;
+		var z = com.simibubi.create.content.decoration.girder.GirderBlock.Z;
+		var top = com.simibubi.create.content.decoration.girder.GirderBlock.TOP;
+		var bottom = com.simibubi.create.content.decoration.girder.GirderBlock.BOTTOM;
+		var east = net.minecraft.core.Direction.EAST;
+		var south = net.minecraft.core.Direction.SOUTH;
+		var up = net.minecraft.core.Direction.UP;
+		var faces = new net.minecraft.core.Direction[] {up, east, south, south, south};
+		var level = helper.getLevel();
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var placed = new int[faces.length];
+		java.util.Arrays.fill(placed, 2);
+		for (int index = 0; index < faces.length; index++) {
+			var target = new BlockPos(12, 3, 2 + index * 5);
+			var support = target.relative(faces[index].getOpposite());
+			helper.setBlock(support, net.minecraft.world.level.block.Blocks.STONE);
+			var initial = net.minecraft.world.level.block.Blocks.AIR.defaultBlockState();
+			if (index >= 3)
+				initial = net.minecraft.world.level.block.Blocks.WATER.defaultBlockState().setValue(
+					net.minecraft.world.level.block.LiquidBlock.LEVEL, index == 3 ? 0 : 4);
+			helper.setBlock(target, initial);
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int index = 0; index < faces.length; index++) {
+				var target = new BlockPos(12, 3, 2 + index * 5);
+				var state = helper.getBlockState(target);
+				boolean isGirder = girder.has(state);
+				System.out.printf(java.util.Locale.ROOT,
+					"CREATE_GIRDER_PLACEMENT,%d,%d,%s,%s,%s,%s,%s,%s,%s,%d%n",
+					tick, index, isGirder ? "girder" : state.isAir() ? "air" : "water",
+					isGirder ? state.getValue(axis).getName() : "none", isGirder && state.getValue(x), isGirder && state.getValue(z),
+					isGirder && state.getValue(top), isGirder && state.getValue(bottom), isGirder && state.getValue(waterlogged),
+					placed[index]);
+				if (tick == 3) {
+					var at = helper.absolutePos(target.relative(faces[index].getOpposite()));
+					player.setPos(at.getX(), at.getY(), at.getZ() - 2);
+					player.setShiftKeyDown(false);
+					var held = new ItemStack(girder.asItem(), placed[index]);
+					player.setItemInHand(hand, held);
+					var hit = new net.minecraft.world.phys.BlockHitResult(at.getCenter().relative(faces[index], 0.49), faces[index], at, false);
+					var context = new net.minecraft.world.item.context.UseOnContext(player, hand, hit);
+					held.getItem().useOn(context);
+					placed[index] = held.getCount();
+				}
+			}
+			if (tick < 8)
+				helper.fail("Waiting for the complete girder placement trace");
+		});
+	}
 }
