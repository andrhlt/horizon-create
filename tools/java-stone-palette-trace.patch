+	@GameTest(template = "wheat_milling", timeoutTicks = 20)
+	public static void stonePalette(CreateGameTestHelper helper) {
+		var registry = net.minecraft.core.registries.BuiltInRegistries.BLOCK;
+		var level = helper.getLevel();
+		var at = helper.absolutePos(new BlockPos(2, 9, 1));
+		int found = 0;
+		for (var id : registry.keySet().stream().sorted().toList()) {
+			if (!id.getNamespace().equals("create") || !id.getPath().matches(".*(asurine|crimsite|limestone|ochrum|scoria|scorchia|veridium).*"))
+				continue;
+			var block = registry.get(id);
+			var state = block.defaultBlockState();
+			var shape = state.getCollisionShape(level, at);
+			var bounds = shape.bounds();
+			var properties = new java.util.TreeMap<String, String>();
+			for (var property : state.getProperties())
+				properties.put(property.getName(), String.valueOf(state.getValue(property)));
+			System.out.printf(java.util.Locale.ROOT,
+				"CREATE_STONE_PALETTE %s,%.2f,%.2f,%d,%b,%d,%s,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f%n",
+				id, state.getDestroySpeed(level, at), block.getExplosionResistance(),
+				state.getMapColor(level, at).id, state.requiresCorrectToolForDrops(),
+				block.getStateDefinition().getPossibleStates().size(), String.join(";", properties.entrySet().stream()
+					.map(property -> property.getKey() + "=" + property.getValue()).toList()),
+				bounds.minX, bounds.minY, bounds.minZ, bounds.maxX, bounds.maxY, bounds.maxZ);
+			helper.assertTrue(block.asItem() != Items.AIR, "Every palette block has its original item ID");
+			found++;
+		}
+		helper.assertTrue(found == 133, "Expected seven complete 19-block stone families");
+		helper.succeed();
+	}
+
 }
