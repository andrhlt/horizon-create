+
+	@GameTest(template = "shearing")
+	public static void creativeMotorPlacement(CreateGameTestHelper helper) {
+		var motor = com.simibubi.create.AllBlocks.CREATIVE_MOTOR;
+		var shaft = com.simibubi.create.AllBlocks.SHAFT;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var x = net.minecraft.core.Direction.Axis.X;
+		var z = net.minecraft.core.Direction.Axis.Z;
+		var up = net.minecraft.core.Direction.UP;
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(helper.getLevel());
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		for (int index = 0; index < 7; index++) {
+			var target = new BlockPos(12 + index * 4, 3, 2);
+			var support = target.below();
+			helper.setBlock(support, Blocks.STONE);
+			if (index >= 3)
+				helper.setBlock(target.east(), shaft.getDefaultState().setValue(axis, x));
+			if (index == 5)
+				helper.setBlock(target.north(), shaft.getDefaultState().setValue(axis, z));
+			if (index == 6)
+				helper.setBlock(target.west(), shaft.getDefaultState().setValue(axis, x));
+			player.setYRot(index == 1 ? 90 : 0);
+			player.setYHeadRot(index == 1 ? 90 : 0);
+			player.setXRot(index == 2 || index == 5 ? 71 : 18);
+			player.setShiftKeyDown(index == 4);
+			var at = helper.absolutePos(support);
+			player.setPos(at.getX() - 2, at.getY(), at.getZ());
+			var held = new ItemStack(motor.asItem(), 2);
+			player.setItemInHand(hand, held);
+			var hit = new net.minecraft.world.phys.BlockHitResult(at.getCenter().relative(up, 0.5), up, at, false);
+			held.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+			var state = helper.getBlockState(target);
+			System.out.printf("CREATE_MOTOR_PLACEMENT,%d,%s,%d%n", index,
+				motor.has(state) ? state.getValue(facing) : "none", held.getCount());
+		}
+		player.setShiftKeyDown(false);
+		helper.succeed();
+	}
 }
