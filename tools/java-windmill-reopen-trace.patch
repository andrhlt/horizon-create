+    @GameTest(template = "threshold_switch_pulley", timeoutTicks = 400)
+    public static void windmillReopen(CreateGameTestHelper helper) {
+        var level = helper.getLevel();
+        var outer = helper.absolutePos(new BlockPos(1, 2, 1));
+        int sectionX = (outer.getX() >> 4) + 36, sectionZ = outer.getZ() >> 4;
+        var mill = new BlockPos(sectionX * 16 + 4, outer.getY() + 20, sectionZ * 16 + 3);
+        var east = net.minecraft.core.Direction.EAST;
+        var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+        var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+        var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+        var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+        java.util.function.Supplier<com.simibubi.create.content.contraptions.bearing.WindmillBearingBlockEntity> entity =
+            () -> (com.simibubi.create.content.contraptions.bearing.WindmillBearingBlockEntity) level.getBlockEntity(mill);
+        Runnable click = () -> {
+            var hit = new net.minecraft.world.phys.BlockHitResult(
+                net.minecraft.world.phys.Vec3.atCenterOf(mill), east, mill, false);
+            level.getBlockState(mill).useItemOn(net.minecraft.world.item.ItemStack.EMPTY, level, player, hand, hit);
+        };
+        java.util.function.Consumer<String> observe = phase -> {
+            var be = entity.get();
+            var moved = be.getMovedContraption();
+            var data = be.saveWithoutMetadata(level.registryAccess());
+            var network = data.getCompound("Network");
+            var shaft = (com.simibubi.create.content.kinetics.base.KineticBlockEntity)level.getBlockEntity(mill.west());
+            int sails = moved == null ? 0 :
+                ((com.simibubi.create.content.contraptions.bearing.BearingContraption) moved.getContraption()).getSailBlocks();
+            int present = 0;
+            for (int i = 0; i < 8; i++)
+                if (com.simibubi.create.AllBlocks.SAIL.has(level.getBlockState(mill.east().south(i))))
+                    present++;
+            System.out.printf(java.util.Locale.ROOT,
+                "CREATE_WINDMILL_REOPEN %s;%s;%.8f;%.8f;%.1f;%.1f;%d;%d;%s%n",
+                phase, data.getBoolean("Running"), data.getFloat("Angle"), shaft.getSpeed(),
+                network.getFloat("Stress"), network.getFloat("Capacity"), sails, present,
+                moved != null ? moved.getUUID().toString() : "-");
+        };
+        level.setChunkForced(sectionX, sectionZ, true);
+        helper.runAtTickTime(4, () -> {
+            level.setBlockAndUpdate(mill,
+                com.simibubi.create.AllBlocks.WINDMILL_BEARING.getDefaultState().setValue(facing, east));
+            level.setBlockAndUpdate(mill.west(),
+                com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, east.getAxis()));
+            for (int i = 0; i < 8; i++)
+                level.setBlockAndUpdate(mill.east().south(i),
+                    com.simibubi.create.AllBlocks.SAIL.getDefaultState().setValue(facing, east));
+            click.run();
+        });
+        var uuid = new java.util.concurrent.atomic.AtomicReference<java.util.UUID>();
+        var state = new java.util.concurrent.atomic.AtomicInteger();
+        helper.succeedWhen(() -> {
+            long tick = helper.getTick();
+            if (state.get() == 0) {
+                helper.assertTrue(tick >= 12 && entity.get() != null && entity.get().getMovedContraption() != null,
+                    "Wait for assembly to settle");
+                observe.accept("before");
+                uuid.set(entity.get().getMovedContraption().getUUID());
+                level.getChunkSource().save(true);
+                level.setChunkForced(sectionX, sectionZ, false);
+                state.set(1);
+            }
+            if (state.get() == 1) {
+                helper.assertTrue(level.getChunkSource().getChunkNow(sectionX, sectionZ) == null,
+                    "Wait for the Windmill chunk to unload");
+                level.setChunkForced(sectionX, sectionZ, true);
+                state.set(2);
+                helper.assertTrue(false, "Wait for the Windmill chunk to reload");
+            }
+            helper.assertTrue(level.getChunkSource().getChunkNow(sectionX, sectionZ) != null && entity.get() != null
+                && entity.get().getMovedContraption() != null, "Wait for the saved assembly to reattach");
+            helper.assertTrue(uuid.get().equals(entity.get().getMovedContraption().getUUID()),
+                "The reloaded Windmill must still own its original contraption");
+            observe.accept("reopened");
+            click.run();
+            observe.accept("stopped");
+            var restored = level.getBlockState(mill.east().south(7));
+            helper.assertTrue(com.simibubi.create.AllBlocks.SAIL.has(restored), "Stopped blades did not restore");
+        });
+    }
 }
