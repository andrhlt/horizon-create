+			var cell = origin.east(x);
+			level.setChunkForced(cell.getX() >> 4, cell.getZ() >> 4, true);
+			level.setBlockAndUpdate(origin.offset(x,-1,0), Blocks.SMOOTH_STONE.defaultBlockState());
+			level.setBlockAndUpdate(origin.east(x), rail);
+			level.setBlockAndUpdate(origin.east(x).above(), Blocks.AIR.defaultBlockState());
+		}
+		var destination = origin.south(2);
+		level.setBlockAndUpdate(destination, Blocks.AIR.defaultBlockState());
+		level.setBlockAndUpdate(destination.below(), Blocks.SMOOTH_STONE.defaultBlockState());
+		var item = (com.simibubi.create.content.trains.track.TrackTargetingBlockItem) com.simibubi.create.AllBlocks.TRACK_STATION.asItem();
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+        var stationType = com.simibubi.create.AllBlocks.TRACK_STATION;
+        var arrivalRail = origin.west(13);
+        var wrongWayRail = origin.west(6);
+        var arrivalStation = arrivalRail.south(2);
+        var wrongWayStation = wrongWayRail.south(2);
+        helper.runAfterDelay(10, () -> {
+            var locations = java.util.List.of(arrivalStation, wrongWayStation);
+            var targets = java.util.List.of(arrivalRail, wrongWayRail);
+            for (int index = 0; index < 2; index++) {
+                var target = targets.get(index);
+                var at = locations.get(index);
+                var support = at.below();
+                level.setChunkForced(at.getX() >> 4, at.getZ() >> 4, true);
+                level.setBlockAndUpdate(at, Blocks.AIR.defaultBlockState());
+                level.setBlockAndUpdate(at.above(), Blocks.AIR.defaultBlockState());
+                level.setBlockAndUpdate(support, Blocks.SMOOTH_STONE.defaultBlockState());
+                player.setItemInHand(hand, new ItemStack(item));
+                player.setYRot(index == 0 ? 90 : -90);
+                player.setXRot(20);
+                player.setPos(target.getX() + .5, target.getY() + 1, target.getZ() + .5);
+                clickTrackForAssembly(item, player, target);
+                player.setPos(support.getX() + .5, support.getY() + 1, support.getZ() + .5);
+                clickTrackForAssembly(item, player, support);
+                helper.assertTrue(stationType.has(level.getBlockState(at)), "Station placement failed at " + at);
+            }
+        });
+		helper.runAfterDelay(7, () -> {
+
+			player.setItemInHand(hand, new ItemStack(item));
+			player.setYRot(90);
+			player.setXRot(20);
+			clickTrackForAssembly(item, player, origin);
+			clickTrackForAssembly(item, player, destination.below());
+		});
+		helper.runAfterDelay(12, () -> {
+			var station = (com.simibubi.create.content.trains.station.StationBlockEntity) level.getBlockEntity(destination);
+			helper.assertTrue(station != null && station.enterAssemblyMode(null), "Station must enter assembly mode");
+			player.setItemInHand(hand, new ItemStack(casing, 3));
+			helper.assertTrue(station.trackClicked(player, hand, track, rail, origin.east()), "Expected first bogey");
+			helper.assertTrue(station.trackClicked(player, hand, track, rail, origin.east(4)), "Expected rear bogey");
+			for (int x = 1; x <= 4; x++)
+				level.setBlockAndUpdate(origin.east(x).above(2), Blocks.OAK_PLANKS.defaultBlockState());
+			var controls = com.simibubi.create.AllBlocks.TRAIN_CONTROLS.get().defaultBlockState()
+				.setValue(com.simibubi.create.content.contraptions.actors.trainControls.ControlsBlock.FACING,
+					net.minecraft.core.Direction.EAST);
+			level.setBlockAndUpdate(origin.east().above(3), controls);
+			var area = com.simibubi.create.content.contraptions.glue.SuperGlueEntity.span(origin.east().above(), origin.east(4).above(3));
+			level.addFreshEntity(new com.simibubi.create.content.contraptions.glue.SuperGlueEntity(level, area));
+			station.assemble(player.getUUID());
+		});
+		for (int tick = 13; tick <= 210; tick++) {
+			int t = tick;
+			helper.runAfterDelay(t, () -> {
+				var railway = com.simibubi.create.Create.RAILWAYS;
+				var train = railway.trains.values().stream().filter(candidate -> candidate.owner.equals(player.getUUID()))
+					.findFirst().orElse(null);
+				helper.assertTrue(train != null, "Station failed assembly: " + level.getBlockEntity(destination).saveWithoutMetadata(level.registryAccess()));
+				var c = train.carriages.getFirst();
+				double a = c.leadingBogey().leading().getPosition(train.graph).x - origin.getX();
+				double b = c.leadingBogey().trailing().getPosition(train.graph).x - origin.getX();
+				double d = c.trailingBogey().leading().getPosition(train.graph).x - origin.getX();
+				double e = c.trailingBogey().trailing().getPosition(train.graph).x - origin.getX();
+                var approach = (com.simibubi.create.content.trains.station.StationBlockEntity) level.getBlockEntity(arrivalStation);
+                var global = approach.getStation();
+                var stopped = global != null && train.getCurrentStation() == global;
+                var approaching = global != null && train.navigation.destination == global;
+                System.out.printf(java.util.Locale.ROOT, "CREATE_CANCEL_STATION %d;%.9f;%.9f;%.9f;%.9f;%.9f;%d;%d;%.9f%n",
+                    t, train.speed, a, b, d, e, approaching ? 1 : 0, stopped ? 1 : 0,
+                    approaching ? train.navigation.distanceToDestination : 0);
+				if (t >= 24 && t < 210) {
+					var entity = c.anyAvailableEntity();
+					helper.assertTrue(entity != null, "Assembled carriage entity was not available");
+					var controls = new BlockPos(0, 2, 0);
+					var at = entity.toGlobalVector(net.minecraft.world.phys.Vec3.atCenterOf(controls), 0);
+					player.setPos(at.x, at.y, at.z + 1.5);
+					if (t == 24)
+						helper.assertTrue(entity.startControlling(controls, player), "Player could not take controls");
+					var keys = t < 42 ? java.util.List.of(0) : t < 68 ? java.util.List.of(4) : java.util.List.<Integer>of();
+					helper.assertTrue(entity.control(controls, keys, player), "Train control was refused at " + t);
+				}
+                if (t == 210) {
+                    helper.assertTrue(!stopped && !approaching && train.speed == 0,
+                        "Releasing Space should cancel approach and let the train coast");
+                    helper.succeed();
+                }
+			});
+		}
+	}
+
+	private static void clickTrackForAssembly(com.simibubi.create.content.trains.track.TrackTargetingBlockItem item,
+			net.minecraft.world.entity.player.Player player, BlockPos pos) {
+		var hit = new net.minecraft.world.phys.BlockHitResult(
+			net.minecraft.world.phys.Vec3.atCenterOf(pos).add(0,.5,0), net.minecraft.core.Direction.UP, pos, false);
+		item.useOn(new net.minecraft.world.item.context.UseOnContext(player,
