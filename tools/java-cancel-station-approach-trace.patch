+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 250)
+	public static void cancelStationApproach(CreateGameTestHelper helper) {
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
