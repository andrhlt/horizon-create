+	@GameTest(template = "shearing", timeoutTicks = 25)
+	public static void initializedGearshiftReversal(CreateGameTestHelper helper) {
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var powered = net.minecraft.world.level.block.state.properties.BlockStateProperties.POWERED;
+		var directions = new net.minecraft.core.Direction[] {
+			net.minecraft.core.Direction.EAST, net.minecraft.core.Direction.UP, net.minecraft.core.Direction.SOUTH
+		};
+		var leftMotor = AllBlocks.CREATIVE_MOTOR.getDefaultState();
+		var gearshift = AllBlocks.GEARSHIFT.getDefaultState();
+		var rigs = new java.util.ArrayList<BlockPos>();
+		for (int lane = 0; lane < 2; lane++) {
+			for (int index = 0; index < directions.length; index++) {
+				var direction = directions[index];
+				var pos = new BlockPos(8 + index * 5, 5, 8 + lane * 5);
+				rigs.add(pos);
+				var signal = pos.relative(index == 0 ? net.minecraft.core.Direction.NORTH : net.minecraft.core.Direction.EAST);
+				boolean power = lane != 0;
+				helper.setBlock(signal, power ? Blocks.REDSTONE_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState());
+				helper.setBlock(pos, gearshift.setValue(axis, direction.getAxis()).setValue(powered, power));
+				helper.setBlock(pos.relative(direction.getOpposite()), leftMotor.setValue(facing, direction));
+			}
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int rig = 0; rig < rigs.size(); rig++) {
+				var pos = rigs.get(rig);
+				int lane = rig / directions.length;
+				int index = rig % directions.length;
+				var direction = directions[index];
+				var left = pos.relative(direction.getOpposite());
+				var right = pos.relative(direction);
+				var signal = pos.relative(index == 0 ? net.minecraft.core.Direction.NORTH : net.minecraft.core.Direction.EAST);
+				if (tick == 0)
+					helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), left).generatedSpeed.setValue(32);
+				if (tick == 3) {
+					helper.setBlock(right, leftMotor.setValue(facing, direction.getOpposite()));
+					helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), right).generatedSpeed.setValue(lane == 0 ? -64 : 64);
+				}
+				for (int phase = 0; phase < ((tick == 7 || tick == 10) ? 2 : 1); phase++) {
+					if (phase != 0) {
+						boolean on = tick == 7 ? lane == 0 : lane != 0;
+						helper.setBlock(signal, on ? Blocks.REDSTONE_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState());
+					}
+					var gate = helper.getBlockState(pos);
+					var entity = helper.getLevel().getBlockEntity(helper.absolutePos(pos));
+					String source = entity instanceof com.simibubi.create.content.kinetics.base.DirectionalShaftHalvesBlockEntity drive && drive.hasSource()
+						? drive.getSourceFacing().getSerializedName() : "-";
+					System.out.printf(java.util.Locale.ROOT, "CREATE_INITIALIZED_GEARSHIFT,%d,%s,%d,%d,%s,%s,%.0f,%s,%.0f,%s,%.0f%n",
+						lane, direction.getAxis(), tick, phase, gate.isAir() ? "missing" : gate.getValue(powered).toString(),
+						source, initializedSpeed(helper, pos),
+						!helper.getBlockState(left).isAir(), initializedSpeed(helper, left),
+						!helper.getBlockState(right).isAir(), initializedSpeed(helper, right));
+				}
+			}
+			if (tick < 12) helper.fail("Waiting for initialized Gearshift reversals");
+		});
+	}
+
+	private static float initializedSpeed(CreateGameTestHelper helper, BlockPos pos) {
+		var entity = helper.getLevel().getBlockEntity(helper.absolutePos(pos));
+		return entity instanceof com.simibubi.create.content.kinetics.base.KineticBlockEntity kinetic
+			? kinetic.getTheoreticalSpeed() : 0;
+	}
 }
