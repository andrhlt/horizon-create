+    @GameTest(template = "shearing", timeoutTicks = 40)
+    public static void tankBucketTrace(CreateGameTestHelper helper) {
+        var level = helper.getLevel();
+        var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+        helper.runAtTickTime(2, () -> {
+            for (boolean creativeTank : new boolean[]{false, true}) {
+                for (var mode : new net.minecraft.world.level.GameType[]{net.minecraft.world.level.GameType.SURVIVAL, net.minecraft.world.level.GameType.CREATIVE}) {
+                    var pos = helper.absolutePos(new BlockPos(3 + (creativeTank ? 4 : 0), 16, 3 + (mode == net.minecraft.world.level.GameType.CREATIVE ? 4 : 0)));
+                    level.setBlockAndUpdate(pos, (creativeTank ? com.simibubi.create.AllBlocks.CREATIVE_FLUID_TANK : com.simibubi.create.AllBlocks.FLUID_TANK).getDefaultState());
+                    var player = helper.makeMockPlayer(mode);
+                    var hit = new net.minecraft.world.phys.BlockHitResult(net.minecraft.world.phys.Vec3.atCenterOf(pos), net.minecraft.core.Direction.UP, pos, false);
+                    for (var item : new net.minecraft.world.item.Item[]{net.minecraft.world.item.Items.WATER_BUCKET, net.minecraft.world.item.Items.BUCKET}) {
+                        player.setItemInHand(hand, new net.minecraft.world.item.ItemStack(item));
+                        var result = level.getBlockState(pos).useItemOn(player.getItemInHand(hand), level, player, hand, hit);
+                        var fluid = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, pos, null).getFluidInTank(0);
+                        System.out.printf("CREATE_TANK_BUCKET %s|%s|%s|%s|%s|%s%n", creativeTank, mode, item, result, player.getItemInHand(hand), fluid);
+                    }
+                }
+            }
+            helper.succeed();
+        });
+    }
 }
