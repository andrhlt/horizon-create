+	@GameTest(template = "small_waterwheel", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
+	public static void loadedStressometer(CreateGameTestHelper helper) {
+		// Build a separate vertical-axle wheel beside the original structure.
+		for (int z = -1; z <= 4; z++) {
+			helper.setBlock(new BlockPos(13, 1, z), Blocks.SMOOTH_STONE);
+			helper.setBlock(new BlockPos(12, 2, z), Blocks.SMOOTH_STONE);
+			helper.setBlock(new BlockPos(14, 2, z), Blocks.SMOOTH_STONE);
+		}
+		helper.setBlock(new BlockPos(13, 2, -1), Blocks.SMOOTH_STONE);
+		helper.setBlock(new BlockPos(13, 2, 4), Blocks.SMOOTH_STONE);
+		helper.setBlock(new BlockPos(12, 2, 2), AllBlocks.WATER_WHEEL.getDefaultState()
+			.setValue(WaterWheelBlock.FACING, Direction.UP));
+		helper.setBlock(new BlockPos(12, 3, 2), AllBlocks.COGWHEEL.getDefaultState()
+			.setValue(BlockStateProperties.AXIS, Direction.Axis.Y));
+		var gaugePos = new BlockPos(12, 4, 2);
+		helper.setBlock(gaugePos, AllBlocks.STRESSOMETER.getDefaultState()
+			.setValue(DirectionalAxisKineticBlock.FACING, Direction.EAST)
+			.setValue(DirectionalAxisKineticBlock.AXIS_ALONG_FIRST_COORDINATE, true));
+		helper.getBlockEntity(AllBlockEntityTypes.STRESSOMETER.get(), gaugePos).loadedStressFixtureRandom =
+			net.minecraft.util.RandomSource.create(2L);
+		helper.setBlock(new BlockPos(13, 2, 3), Blocks.WATER);
+
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick() - 70;
+			helper.assertTrue(tick >= 0, "Waiting for the unloaded wheel to settle");
+
+			var gauge = helper.getBlockEntity(AllBlockEntityTypes.STRESSOMETER.get(), gaugePos);
+			helper.assertCloseEnoughTo(gauge.getNetworkCapacity(), 256);
+			float expectedStress = tick > 0 && tick <= 12 ? 128 : tick > 24 && tick <= 36 ? 64
+				: tick > 48 && tick <= 96 ? 288 : 0;
+			helper.assertCloseEnoughTo(gauge.getNetworkStress(), expectedStress);
+			helper.assertTrue(gauge.isOverStressed() == (expectedStress > 256), "Unexpected overload state");
+			System.out.printf(java.util.Locale.ROOT,
+				"CREATE_LOADED_DIAL %d %.1f %.1f %.9f %.9f %.9f %.9f%n",
+				tick, gauge.getNetworkCapacity(), gauge.getNetworkStress(), gauge.dialTarget,
+				gauge.prevDialState, gauge.dialState,
+				-90f * Mth.lerp(.5f, gauge.prevDialState, gauge.dialState));
+			if (tick == 0 || tick == 12 || tick == 24 || tick == 36 || tick == 48 || tick == 96) {
+				boolean adding = tick == 0 || tick == 24 || tick == 48;
+				int lastMill = tick < 24 ? 6 : tick < 48 ? 4 : 11;
+				for (int z = 3; z <= lastMill; z++)
+					helper.setBlock(new BlockPos(12, 3, z), adding ? AllBlocks.MILLSTONE.get() : Blocks.AIR);
+			}
+			helper.assertTrue(tick >= 104, "Sampling the needle");
+		});
+	}
