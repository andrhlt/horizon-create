+		player.setXRot(25);
+		helper.runAtTickTime(4, () -> {
+			for (BlockPos delta : BlockPos.betweenClosed(-2, -1, -3, 2, 4, 3))
+				level.setBlock(target.offset(delta), Blocks.AIR.defaultBlockState(), 2);
+			var props = net.minecraft.world.level.block.state.properties.BlockStateProperties.class;
+			var stairs = Blocks.OAK_STAIRS.defaultBlockState()
+				.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING, net.minecraft.core.Direction.EAST)
+				.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.HALF, net.minecraft.world.level.block.state.properties.Half.TOP)
+				.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.STAIRS_SHAPE, net.minecraft.world.level.block.state.properties.StairsShape.INNER_LEFT)
+				.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED, true);
+			var inputs = new net.minecraft.world.level.block.state.BlockState[] {Blocks.STONE.defaultBlockState(), stairs};
+			for (int index = 0; index < inputs.length; index++) {
+				level.setBlock(target, inputs[index], 2);
+				var before = level.getBlockState(target);
+				boolean selected = com.simibubi.create.content.equipment.zapper.ZapperInteractionHandler.trySelect(stack, player);
+				var serialized = (net.minecraft.nbt.CompoundTag) stack.saveOptional(level.registryAccess());
+				var chosen = serialized.getCompound("components").getCompound(componentId);
+				var properties = chosen.getCompound("Properties");
+				boolean repeat = com.simibubi.create.content.equipment.zapper.ZapperInteractionHandler.trySelect(stack, player);
+				System.out.printf("CREATE_WORLDSHAPER_SELECT,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s%n",
+					index == 0 ? "stone" : "stairs", selected, repeat, componentId, chosen.getString("Name"),
+					properties.getString("facing"), properties.getString("half"), properties.getString("shape"),
+					properties.getString("waterlogged"), before == inputs[index], stack.getCount(), stack.has(component));
+			}
+			// Separate actual use: select stone, configure a one-block Attached Fill,
+			// and measure the block adjacent to the face hit by the ordinary view ray.
+			level.setBlock(target, Blocks.STONE.defaultBlockState(), 2);
+			level.setBlock(target.south(), Blocks.AIR.defaultBlockState(), 2);
+			boolean selectedStone = com.simibubi.create.content.equipment.zapper.ZapperInteractionHandler.trySelect(stack, player);
+			com.simibubi.create.content.equipment.zapper.terrainzapper.WorldshaperItem.configureSettings(stack,
+				com.simibubi.create.content.equipment.zapper.PlacementPatterns.Solid,
+				com.simibubi.create.content.equipment.zapper.terrainzapper.TerrainBrushes.Cuboid,
+				1, 1, 1,
+				com.simibubi.create.content.equipment.zapper.terrainzapper.TerrainTools.Fill,
+				com.simibubi.create.content.equipment.zapper.terrainzapper.PlacementOptions.Attached);
+			var eye = player.position().add(0, player.getEyeHeight(), 0);
+			var hit = level.clip(new net.minecraft.world.level.ClipContext(eye, eye.add(player.getLookAngle().scale(128)),
+				net.minecraft.world.level.ClipContext.Block.OUTLINE, net.minecraft.world.level.ClipContext.Fluid.NONE, player));
+			var attached = hit.getBlockPos().relative(hit.getDirection());
+			var beforeFill = net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(level.getBlockState(attached).getBlock());
+			var configured = (net.minecraft.nbt.CompoundTag) stack.saveOptional(level.registryAccess());
