+	private static void trace(SpeedControllerBlockEntity entity, BlockPos pos, Axis axis, float partial,
+		float angle, RenderProbe shaft, RenderProbe bracket) {
+		var mc = net.minecraft.client.Minecraft.getInstance();
+		if (org.lwjgl.glfw.GLFW.glfwGetWindowAttrib(mc.getWindow().getWindow(), org.lwjgl.glfw.GLFW.GLFW_VISIBLE)
+			!= org.lwjgl.glfw.GLFW.GLFW_FALSE)
+			throw new IllegalStateException("The controller reference client must be hidden");
+		if (shaft.vertices == 0)
+			throw new IllegalStateException("The fallback shaft renderer must submit geometry");
+		var level = entity.getLevel();
+		var abovePos = pos.above();
+		var above = level.getBlockState(abovePos);
+		var aboveBlock = net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(above.getBlock());
+		var property = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var time = net.createmod.catnip.animation.AnimationTickHolder.getRenderTime(level);
+		System.out.printf(java.util.Locale.ROOT,
+			"JAVA_CONTROLLER_FRAME %d,%s,%s,%s,%d,%.8f,%.8f,%.6f,%.6f,%d,%d,%s,%s%n",
+			pos.getX(), axis.getName(), aboveBlock, above.hasProperty(property) ? above.getValue(property).getName() : "-",
+			level.getGameTime(), partial, time, entity.getSpeed(), Math.toDegrees(angle),
+			net.minecraft.client.renderer.LightTexture.block(LevelRenderer.getLightColor(level, pos)),
+			net.minecraft.client.renderer.LightTexture.block(LevelRenderer.getLightColor(level, abovePos)),
+			shaft.row(), bracket.row());
+	}
+
+	private static final class RenderProbe implements VertexConsumer {
+		private final org.joml.Matrix4f inversePose;
+		private final org.joml.Quaternionf inverseTurn;
+		private final org.joml.Vector3f min = new org.joml.Vector3f(Float.POSITIVE_INFINITY);
+		private final org.joml.Vector3f max = new org.joml.Vector3f(Float.NEGATIVE_INFINITY);
+		private int vertices;
+		private int blockLight = -1;
+		private int skyLight = -1;
+
+		RenderProbe(PoseStack pose, Axis axis, float angle) {
+			inversePose = new org.joml.Matrix4f(pose.last().pose()).invert();
+			inverseTurn = new org.joml.Quaternionf().rotationAxis(-angle, axis == Axis.X ? 1 : 0, 0, axis == Axis.Z ? 1 : 0);
+		}
+
+		@Override
+		public VertexConsumer addVertex(float x, float y, float z) {
+			var point = inversePose.transformPosition(x, y, z, new org.joml.Vector3f()).sub(.5f, .5f, .5f);
+			inverseTurn.transform(point).add(.5f, .5f, .5f);
+			min.min(point);
+			max.max(point);
+			vertices++;
+			return this;
+		}
+
+		@Override
+		public VertexConsumer setUv2(int u, int v) {
+			blockLight = u / 16;
+			skyLight = v / 16;
+			return this;
+		}
+
+		@Override public VertexConsumer setColor(int r, int g, int b, int a) { return this; }
+		@Override public VertexConsumer setUv(float u, float v) { return this; }
+		@Override public VertexConsumer setUv1(int u, int v) { return this; }
+		@Override public VertexConsumer setNormal(float x, float y, float z) { return this; }
+
+		String row() {
+			if (vertices == 0)
+				return "0,-1,-1,0,0,0,0,0,0";
+			return String.format(java.util.Locale.ROOT, "%d,%d,%d,%.7f,%.7f,%.7f,%.7f,%.7f,%.7f",
+				vertices, blockLight, skyLight, min.x, min.y, min.z, max.x, max.y, max.z);
+		}
 	}
 
