diff --git a/src/main/java/com/simibubi/create/infrastructure/gametest/tests/JavaSchedulePassengerCountProbe.java b/src/main/java/com/simibubi/create/infrastructure/gametest/tests/JavaSchedulePassengerCountProbe.java
