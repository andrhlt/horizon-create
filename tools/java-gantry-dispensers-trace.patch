+	private static void traceGantryDispenser(CreateGameTestHelper helper, String test) {
+		var origin = helper.absolutePos(new BlockPos(0, 1, 0));
+		var level = helper.getLevel();
+		var box = new net.minecraft.world.phys.AABB(origin).expandTowards(9, 7, 3);
+		var moving = level.getEntitiesOfClass(
+			com.simibubi.create.content.contraptions.AbstractContraptionEntity.class, box);
+		String carriage = "";
+		int topAmmo = 0;
+		int bottomAmmo = 0;
+		int barrelAmmo = 0;
+		if (!moving.isEmpty()) {
+			var entity = moving.getFirst();
+			carriage = String.format(java.util.Locale.ROOT, "%.9f:%.9f:%.9f",
+				entity.getX() - origin.getX(), entity.getY() - origin.getY(), entity.getZ() - origin.getZ());
+			var inventories = entity.getContraption().getStorage().getAllItemStorages();
+			for (var entry : inventories.entrySet()) {
+				var inventory = entry.getValue();
+				int count = java.util.stream.IntStream.range(0, inventory.getSlots())
+					.map(slot -> inventory.getStackInSlot(slot).getCount()).sum();
+				if (inventory instanceof com.simibubi.create.content.contraptions.behaviour.dispenser.storage.DispenserMountedStorage) {
+					if (entry.getKey().getY() <= 1)
+						bottomAmmo += count;
+					else
+						topAmmo += count;
+				} else
+					barrelAmmo += count;
+			}
+		} else {
+			for (int x = 0; x < 9; x++) {
+				for (int y : new int[] {4, 6}) {
+					var pos = new BlockPos(x, y, 1);
+					var state = level.getBlockState(helper.absolutePos(pos));
+					if (state.is(Blocks.DISPENSER)) {
+						if (y == 4)
+							bottomAmmo += helper.getTotalItems(pos);
+						else
+							topAmmo += helper.getTotalItems(pos);
+					} else if (state.is(Blocks.BARREL))
+						barrelAmmo += helper.getTotalItems(pos);
+				}
+			}
+		}
+		var arrows = level.getEntitiesOfClass(net.minecraft.world.entity.projectile.AbstractArrow.class, box);
+		long lowerArrows = arrows.stream().filter(arrow -> arrow.getY() - origin.getY() < 4.5).count();
+		System.out.printf("GANTRY_DISPENSER %s,%d,%d,%d:%d:%d,%s,%d,%d,%d,%d,%d%n",
+			test, helper.getTick(), level.getGameTime() % 20, origin.getX(), origin.getY(), origin.getZ(),
+			carriage, bottomAmmo, topAmmo, barrelAmmo, lowerArrows, arrows.size() - lowerArrows);
+	}
+
 }
