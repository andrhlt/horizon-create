+  var b = new net.minecraft.world.entity.vehicle.Minecart(EntityType.MINECART, world);
+  var c = new net.minecraft.world.entity.vehicle.Minecart(EntityType.MINECART, world);
+  var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+  var held = com.simibubi.create.AllItems.MINECART_COUPLING.asStack(3);
+  player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, held);
+  a.setPos(8.5, 170.0625, 24.5); b.setPos(11.5, 170.0625, 24.5); c.setPos(14.5, 170.0625, 24.5);
+  world.addFreshEntity(a); world.addFreshEntity(b); world.addFreshEntity(c);
+  helper.runAtTickTime(5, () -> {
+   var handler = com.simibubi.create.content.contraptions.minecart.CouplingHandler.class;
+   boolean first = com.simibubi.create.content.contraptions.minecart.CouplingHandler.tryToCoupleCarts(player, world, a.getId(), b.getId());
+   boolean second = com.simibubi.create.content.contraptions.minecart.CouplingHandler.tryToCoupleCarts(player, world, b.getId(), c.getId());
+   boolean loop = com.simibubi.create.content.contraptions.minecart.CouplingHandler.tryToCoupleCarts(player, world, c.getId(), a.getId());
+   var mid = b.getData(com.simibubi.create.AllAttachmentTypes.MINECART_CONTROLLER);
