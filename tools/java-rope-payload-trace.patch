+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 80)
+	public static void ropePayload(CreateGameTestHelper helper) {
+		traceRopePayload(helper, false);
+	}
+
+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 80)
+	public static void ropePayloadDetach(CreateGameTestHelper helper) {
+		traceRopePayload(helper, true);
+	}
+
+	private static void traceRopePayload(CreateGameTestHelper helper, boolean detach) {
+		var level = helper.getLevel();
+		var pos = helper.absolutePos(new BlockPos(2, 10, 0));
+		var motorPos = pos.east();
+		var initial = pos.below();
+		var payload = com.simibubi.create.AllBlocks.ANDESITE_CASING.get();
+		level.setBlockAndUpdate(pos, com.simibubi.create.AllBlocks.ROPE_PULLEY.get().defaultBlockState()
+			.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_AXIS,
+				net.minecraft.core.Direction.Axis.X));
+		level.setBlockAndUpdate(motorPos, com.simibubi.create.AllBlocks.CREATIVE_MOTOR.get().defaultBlockState()
+			.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING,
+				net.minecraft.core.Direction.WEST));
+		var motor = (com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity) level.getBlockEntity(motorPos);
+		motor.generatedSpeed.setValue(0);
+		var pulley = (com.simibubi.create.content.contraptions.pulley.PulleyBlockEntity) level.getBlockEntity(pos);
+		level.setBlockAndUpdate(initial, payload.defaultBlockState());
+		level.setBlockAndUpdate(initial.east(), Blocks.OAK_PLANKS.defaultBlockState());
+		level.setBlockAndUpdate(initial.east(2), Blocks.CHEST.defaultBlockState());
+		var cargo = (net.minecraft.world.Container) level.getBlockEntity(initial.east(2));
+		cargo.setItem(0, new ItemStack(Items.COPPER_INGOT, 7));
+		var area = com.simibubi.create.content.contraptions.glue.SuperGlueEntity.span(initial, initial.east(2));
+		level.addFreshEntity(new com.simibubi.create.content.contraptions.glue.SuperGlueEntity(level, area));
+		for (int tick = 0; tick <= 65; tick++) {
+			int t = tick;
+			Runnable sample = () -> {
+				var moving = pulley.getAttachedContraption();
+				var state = pulley.saveWithoutMetadata(level.registryAccess());
+				float extension = state.getFloat("Offset");
+				var resting = pos.below(Math.round(extension) + 1);
+				int placed = level.getBlockState(resting).is(payload) ? 1 : 0;
+				int planks = level.getBlockState(resting.east()).is(Blocks.OAK_PLANKS) ? 1 : 0;
+				int chest = level.getBlockEntity(resting.east(2)) instanceof net.minecraft.world.Container items
+					? items.getItem(0).getCount() : 0;
+				double relativeY = moving == null ? 999 : moving.getY() - pos.getY();
+				if (!detach)
+					System.out.printf(java.util.Locale.ROOT,
+						"CREATE_ROPE_PAYLOAD %d %.6f %b %.6f %.6f %d %d %d%n",
+						t, extension, state.getBoolean("Running"), relativeY, pulley.getSpeed(), placed, planks, chest);
+				if (detach && extension == 1.5f && relativeY == -2.5) {
+					level.destroyBlock(pos, false);
+					var landed = pos.below(3);
+					helper.runAfterDelay(1, () -> {
+						helper.assertTrue(level.getBlockState(landed).is(payload), "Detached platform landed at the wrong depth");
+						helper.assertTrue(level.getBlockState(landed.east()).is(Blocks.OAK_PLANKS), "Missing platform planks");
+						helper.assertTrue(level.getBlockEntity(landed.east(2)) instanceof net.minecraft.world.Container items
+							&& items.getItem(0).is(Items.COPPER_INGOT) && items.getItem(0).getCount() == 7, "Detached platform lost its cargo");
+						System.out.printf("CREATE_ROPE_DETACH %.1f %d %d%n", extension, 3, 7);
+						helper.succeed();
+					});
+				}
+				if (t == 3)
+					motor.generatedSpeed.setValue(-128);
+				if (t == 24)
+					motor.generatedSpeed.setValue(0);
+				if (t == 32)
+					motor.generatedSpeed.setValue(128);
+				if (t == 56)
+					motor.generatedSpeed.setValue(0);
+				if (t == 65) {
+					helper.assertTrue(placed == 1 && planks == 1 && chest == 7, "Payload must land with its cargo");
+					helper.assertTrue(level.getBlockState(initial).is(payload), "Pulley must return payload to the original height");
+					helper.succeed();
+				}
+			};
+			if (t == 0)
+				sample.run();
+			else
+				helper.runAfterDelay(t, sample);
+		}
+	}
 }
