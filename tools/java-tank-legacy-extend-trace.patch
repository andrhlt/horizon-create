+    @GameTest(template = "shearing", timeoutTicks = 50)
+    public static void tankMergeTrace(CreateGameTestHelper helper) {
+        var level = helper.getLevel();
+        var base = helper.absolutePos(new BlockPos(3, 16, 3));
+        var tank = com.simibubi.create.AllBlocks.FLUID_TANK.getDefaultState();
+        helper.runAtTickTime(2, () -> {
+            for (int rig = 0; rig < 2; rig++) for (int y : new int[]{0, 2})
+                level.setBlockAndUpdate(base.east(rig * 6).above(y), tank);
+        });
+        helper.runAtTickTime(8, () -> {
+            for (int rig = 0; rig < 2; rig++) for (int y : new int[]{0, 2}) {
+                var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, base.east(rig * 6).above(y), null);
+                var fluid = (rig == 0) == (y == 0) ? net.minecraft.world.level.material.Fluids.WATER : net.minecraft.world.level.material.Fluids.LAVA;
+                System.out.printf("CREATE_EXTEND_FILL %d|%d|%d%n", rig, y, cap.fill(new net.neoforged.neoforge.fluids.FluidStack(fluid, y == 0 ? 4000 : 5000), net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE));
+            }
+        });
+        for (int tick = 9; tick <= 16; tick++) {
+            final int sample = tick;
+            helper.runAtTickTime(tick, () -> {
+                if (sample == 10 || sample == 12) for (int rig = 0; rig < 2; rig++)
+                    level.setBlockAndUpdate(base.east(rig * 6).above(sample == 10 ? 1 : 3), tank);
+                for (int rig = 0; rig < 2; rig++) for (int y = 0; y < 4; y++) {
+                    var pos = base.east(rig * 6).above(y);
+                    var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, pos, null);
+                    System.out.printf("CREATE_EXTEND %d|%d|%d|%s|%s|%d%n", sample, rig, y, level.getBlockState(pos).getBlock(), cap == null ? "-" : cap.getFluidInTank(0), cap == null ? 0 : cap.getTankCapacity(0));
+                }
+                if (sample == 16) helper.succeed();
+            });
+        }
+    }
 }
