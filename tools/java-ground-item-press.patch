+	@GameTest(template = "wheat_milling", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
+	public static void groundItemPressing(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var horizontal = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		var south = net.minecraft.core.Direction.SOUTH;
+		BlockPos pressPos = new BlockPos(3, 11, 2);
+		BlockPos pressMotor = pressPos.north();
+		level.setBlockAndUpdate(helper.absolutePos(pressPos.below(2)),
+			net.minecraft.world.level.block.Blocks.STONE.defaultBlockState());
+		level.setBlockAndUpdate(helper.absolutePos(pressMotor),
+			AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(facing, south));
+		level.setBlockAndUpdate(helper.absolutePos(pressPos),
+			AllBlocks.MECHANICAL_PRESS.getDefaultState().setValue(horizontal, south));
+		((com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity) helper.getBlockEntity(pressMotor))
+			.generatedSpeed.setValue(128);
+		var press = (com.simibubi.create.content.kinetics.press.MechanicalPressBlockEntity) helper.getBlockEntity(pressPos);
+		var pressBehavior = press.getPressingBehaviour();
+		var sounds = new java.util.ArrayList<String>();
+		var output = new java.util.concurrent.atomic.AtomicInteger();
+		var box = new net.minecraft.world.phys.AABB(helper.absolutePos(pressPos.below())).inflate(.25);
+		var absolute = helper.absolutePos(pressPos);
+		java.util.function.Consumer<net.neoforged.neoforge.event.PlayLevelSoundEvent.AtPosition> listen = event -> {
+			if (event.getLevel() != level || event.getSound() == null)
+				return;
+			var name = event.getSound().value().getLocation();
+			if (name.getPath().startsWith("mechanical_press_activation"))
+				sounds.add(String.format(java.util.Locale.ROOT, "%s/%.6f/%.6f",
+					name, event.getNewVolume(), event.getNewPitch()));
+		};
+		net.neoforged.neoforge.common.NeoForge.EVENT_BUS.addListener(listen);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick() - 5;
+			helper.assertTrue(tick >= 0, "Waiting for the press to initialize");
+			if (tick == 0) {
+				var stack = new net.minecraft.world.entity.item.ItemEntity(level,
+					absolute.getX() + .5, absolute.getY() - .125, absolute.getZ() + .5,
+					new ItemStack(Items.IRON_INGOT, 3));
+				stack.setDeltaMovement(net.minecraft.world.phys.Vec3.ZERO);
+				stack.setNeverPickUp();
+				level.addFreshEntity(stack);
+			}
+			int input = 0;
+			int grounded = 0;
+			for (var item : level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class, box)) {
+				if (item.getItem().is(Items.IRON_INGOT)) {
+					input += item.getItem().getCount();
+					grounded = item.onGround() ? 1 : 0;
+				}
+				if (item.getItem().is(AllItems.IRON_SHEET.get())) {
+					output.addAndGet(item.getItem().getCount());
+					item.discard();
+				}
+			}
+			System.out.printf(java.util.Locale.ROOT, "CREATE_GROUND_ITEM_PRESS %d,%d,%d,%d,%d,%d,%.6f,%d,%d,%d,%s%n",
+				tick, (int) press.getSpeed(), pressBehavior.running ? 1 : 0, pressBehavior.finished ? 1 : 0,
+				pressBehavior.mode.ordinal(), pressBehavior.runningTicks,
+				pressBehavior.getRenderedHeadOffset(.5f) * pressBehavior.mode.headOffset,
+				input, grounded, output.get(), sounds.isEmpty() ? "-" : String.join(";", sounds));
+			sounds.clear();
+			helper.assertTrue(tick >= 80, "Waiting for three pressing cycles");
+			helper.assertTrue(output.get() == 3, "All three iron ingots must be pressed");
+			net.neoforged.neoforge.common.NeoForge.EVENT_BUS.unregister(listen);
+		});
+	}
