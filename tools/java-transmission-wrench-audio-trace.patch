+	private static net.minecraft.world.InteractionResult traceTransmissionWrenchSound(
+		net.minecraft.server.level.ServerLevel level, BlockPos at, String action,
+		java.util.function.Supplier<net.minecraft.world.InteractionResult> useWrench) {
+		var sounds = new java.util.ArrayList<String>();
+		java.util.function.Consumer<net.neoforged.neoforge.event.PlayLevelSoundEvent.AtPosition> listener = event -> {
+			var sound = event.getSound();
+			if (event.getLevel() != level || sound == null || !BlockPos.containing(event.getPosition()).equals(at))
+				return;
+			var id = sound.unwrapKey().map(key -> key.location().toString())
+				.orElseGet(() -> sound.value().getLocation().toString());
+			if (id.startsWith("create:wrench_"))
+				sounds.add(id + "|" + event.getSource() + "|" + event.getNewVolume() + "|" + event.getNewPitch());
+		};
+		var bus = net.neoforged.neoforge.common.NeoForge.EVENT_BUS;
+		bus.addListener(net.neoforged.neoforge.event.PlayLevelSoundEvent.AtPosition.class, listener);
+		try {
+			return useWrench.get();
+		} finally {
+			bus.unregister(listener);
+			System.out.printf("CREATE_TRANSMISSION_WRENCH_SOUND,%s,%s%n", action, String.join(";", sounds));
+		}
+	}
+
