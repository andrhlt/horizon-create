+
+	@GameTest(template = "shearing", timeoutTicks = 29)
+	public static void competingRotationSpeedControllerMotors(CreateGameTestHelper helper) {
+		var controller = com.simibubi.create.AllBlocks.ROTATION_SPEED_CONTROLLER;
+		var cog = com.simibubi.create.AllBlocks.LARGE_COGWHEEL;
+		var motor = com.simibubi.create.AllBlocks.CREATIVE_MOTOR;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var horizontal = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var east = net.minecraft.core.Direction.EAST;
+		var south = net.minecraft.core.Direction.SOUTH;
+		var x = net.minecraft.core.Direction.Axis.X;
+		var z = net.minecraft.core.Direction.Axis.Z;
+		var same = new BlockPos(12, 2, 2);
+		var opposite = new BlockPos(18, 2, 2);
+		var setups = java.util.List.of(same, opposite);
+		for (var pos : setups) {
+			helper.setBlock(pos, controller.getDefaultState().setValue(horizontal, x));
+			helper.setBlock(pos.above(), cog.getDefaultState().setValue(axis, z));
+			helper.setBlock(pos.west(), motor.getDefaultState().setValue(facing, east));
+			helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), pos.west()).generatedSpeed.setValue(24);
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int i = 0; i < setups.size(); i++) {
+				var pos = setups.get(i);
+				var above = pos.above();
+				var belowSource = pos.west();
+				var upperSource = above.north();
+				java.util.function.Function<BlockPos, com.simibubi.create.content.kinetics.base.KineticBlockEntity> kineticAt =
+					at -> helper.getLevel().getBlockEntity(helper.absolutePos(at)) instanceof
+						com.simibubi.create.content.kinetics.base.KineticBlockEntity entity ? entity : null;
+				var a = kineticAt.apply(pos);
+				var b = kineticAt.apply(above);
+				var low = kineticAt.apply(belowSource);
+				var high = kineticAt.apply(upperSource);
+				System.out.printf(java.util.Locale.ROOT,
+					"CREATE_SPEED_CONTROLLER_COMPETING %d,%d,%d,%d,%d,%d,%.4f,%.4f,%.4f,%.4f%n",
+					tick, i, a != null ? 1 : 0, b != null ? 1 : 0, low != null ? 1 : 0, high != null ? 1 : 0,
+					a != null ? a.getSpeed() : 0f, b != null ? b.getSpeed() : 0f,
+					low != null ? low.getSpeed() : 0f, high != null ? high.getSpeed() : 0f);
+				if (tick == 5) {
+					helper.setBlock(upperSource, motor.getDefaultState().setValue(facing, south));
+					if (helper.getLevel().getBlockEntity(helper.absolutePos(upperSource)) instanceof
+						com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity added)
+						added.generatedSpeed.setValue(i == 0 ? 40 : -40);
+				}
+				if (tick == 15)
+					helper.setBlock(upperSource, Blocks.AIR);
+			}
+			if (tick < 24)
+				helper.fail("Waiting for final competing-controller observation");
+		});
+	}
 }
