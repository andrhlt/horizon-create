+	private record GearboxPlaceCase(String name, Direction face, Direction player, String target, String support,
+		boolean regular, boolean sneaking, boolean removeSupport, String... neighbors) {}
+
+	@GameTest(template = "shearing", timeoutTicks = 100)
+	public static void verticalGearboxPlacementMatrix(CreateGameTestHelper helper) {
+		Direction n = Direction.NORTH, s = Direction.SOUTH, w = Direction.WEST, e = Direction.EAST;
+		Direction u = Direction.UP, d = Direction.DOWN;
+		var cases = List.of(
+			new GearboxPlaceCase("north_wall", n,s,"air","stone",false,false,true),
+			new GearboxPlaceCase("south_wall", s,n,"air","stone",false,false,false),
+			new GearboxPlaceCase("east_wall", e,w,"air","stone",false,false,false),
+			new GearboxPlaceCase("west_wall", w,e,"air","stone",false,false,false),
+			new GearboxPlaceCase("floor", u,w,"air","stone",false,false,true),
+			new GearboxPlaceCase("ceiling", d,e,"air","stone",false,false,true),
+			new GearboxPlaceCase("regular_near_shaft", n,s,"air","stone",true,false,false,"east:shaft:x"),
+			new GearboxPlaceCase("x_neighbor", n,s,"air","stone",false,false,false,"east:shaft:x"),
+			new GearboxPlaceCase("z_neighbor", e,w,"air","stone",false,false,false,"north:shaft:z"),
+			new GearboxPlaceCase("opposite_x_neighbors", n,s,"air","stone",false,false,false,"east:shaft:x","west:shaft:x"),
+			new GearboxPlaceCase("axis_conflict", n,s,"air","stone",false,false,false,"east:shaft:x","north:shaft:z"),
+			new GearboxPlaceCase("sneaking_z_neighbor", e,w,"air","stone",false,true,false,"north:shaft:z"),
+			new GearboxPlaceCase("blocked_and_vertical_shafts", n,s,"air","stone",false,false,false,"east:shaft:z","up:shaft:y"),
+			new GearboxPlaceCase("powered_x_clutch", n,s,"air","stone",false,false,false,"east:powered_clutch:x"),
+			new GearboxPlaceCase("unpowered_z_clutch", e,w,"air","stone",false,false,false,"north:clutch:z"),
+			new GearboxPlaceCase("wrong_axis_clutch", e,w,"air","stone",false,false,false,"north:clutch:x"),
+			new GearboxPlaceCase("clicked_x_shaft", e,s,"air","shaft_x",false,false,false),
+			new GearboxPlaceCase("replace_clicked_grass", u,w,"grass","stone",false,false,false),
+			new GearboxPlaceCase("replace_target_water", u,w,"water","stone",false,false,false),
+			new GearboxPlaceCase("blocked_target_fence", u,w,"fence","stone",false,false,false)
+		);
+		for (int index = 0; index < cases.size(); index++) {
+			GearboxPlaceCase test = cases.get(index);
+			int tick = 1 + index * 3;
+			helper.runAtTickTime(tick, () -> runGearboxPlacementCase(helper, test, tick));
+		}
+		helper.runAtTickTime(cases.size() * 3 + 1, helper::succeed);
+	}
+
+	private static void runGearboxPlacementCase(CreateGameTestHelper helper, GearboxPlaceCase test, int tick) {
+		var level = helper.getLevel();
+		BlockPos pos = helper.absolutePos(new BlockPos(12, 5, 5));
+		for (BlockPos cell : BlockPos.betweenClosed(pos.offset(-1,-1,-1), pos.offset(1,2,1)))
+			level.setBlockAndUpdate(cell, Blocks.AIR.defaultBlockState());
+		boolean clickedTarget = test.target().equals("grass");
+		BlockPos support = pos.relative(test.face().getOpposite());
+		BlockPos clicked = clickedTarget ? pos : support;
+		BlockState supportState = test.support().equals("shaft_x")
+			? AllBlocks.SHAFT.getDefaultState().setValue(BlockStateProperties.AXIS, Direction.Axis.X)
+			: Blocks.STONE.defaultBlockState();
+		level.setBlockAndUpdate(support, supportState);
+		BlockState target = switch (test.target()) {
+			case "grass" -> Blocks.SHORT_GRASS.defaultBlockState();
+			case "water" -> Blocks.WATER.defaultBlockState();
+			case "fence" -> Blocks.OAK_FENCE.defaultBlockState();
+			default -> Blocks.AIR.defaultBlockState();
+		};
+		level.setBlockAndUpdate(pos, target);
+		var neighbors = new JsonArray();
+		for (String neighbor : test.neighbors()) {
+			neighbors.add(neighbor);
+			String[] fields = neighbor.split(":");
+			BlockPos at = pos.relative(Direction.byName(fields[0]));
+			var shaftAxis = Direction.Axis.byName(fields[2]);
+			if (fields[1].equals("shaft")) {
+				level.setBlockAndUpdate(at, AllBlocks.SHAFT.getDefaultState().setValue(BlockStateProperties.AXIS, shaftAxis));
+			} else {
+				level.setBlockAndUpdate(at, AllBlocks.CLUTCH.getDefaultState()
+					.setValue(BlockStateProperties.AXIS, shaftAxis)
+					.setValue(BlockStateProperties.POWERED, fields[1].equals("powered_clutch")));
+				if (fields[1].equals("powered_clutch"))
+					level.setBlockAndUpdate(at.above(), Blocks.REDSTONE_BLOCK.defaultBlockState());
+			}
+		}
+		var player = FakePlayerFactory.getMinecraft(level);
+		float yaw = test.player().toYRot();
+		player.setYRot(yaw);
+		player.setYHeadRot(yaw);
+		player.setYBodyRot(yaw);
+		player.yRotO = yaw;
+		player.setShiftKeyDown(test.sneaking());
+		var stack = new ItemStack(test.regular() ? AllBlocks.GEARBOX.asItem() : AllItems.VERTICAL_GEARBOX.get());
+		player.setItemInHand(InteractionHand.MAIN_HAND, stack);
+		var hit = new BlockHitResult(clicked.getCenter().relative(test.face(), 0.5), test.face(), clicked, false);
+		var context = new BlockPlaceContext(player, InteractionHand.MAIN_HAND, stack, hit);
+		var result = ((BlockItem) stack.getItem()).place(context);
+		JsonObject row = new JsonObject();
+		row.addProperty("case", test.name());
+		row.addProperty("face", test.face().getSerializedName());
+		row.addProperty("player", player.getDirection().getSerializedName());
+		row.addProperty("target", test.target());
+		row.addProperty("support", test.support());
+		row.addProperty("item", test.regular() ? "create:gearbox" : "create:vertical_gearbox");
+		row.addProperty("sneaking", test.sneaking());
+		row.addProperty("remove_support", test.removeSupport());
+		row.add("neighbors", neighbors);
+		row.addProperty("placed", result.consumesAction());
+		row.addProperty("remaining", stack.getCount());
+		row.add("landed", gearboxPlacedBlock(level.getBlockState(pos)));
+		if (test.removeSupport()) {
+			level.setBlockAndUpdate(support, Blocks.AIR.defaultBlockState());
+			helper.runAtTickTime(tick + 1, () -> {
+				row.add("unsupported", gearboxPlacedBlock(level.getBlockState(pos)));
+				System.out.println("CREATE_VERTICAL_GEARBOX_MATRIX " + row);
+			});
+		} else {
+			System.out.println("CREATE_VERTICAL_GEARBOX_MATRIX " + row);
+		}
+		player.setShiftKeyDown(false);
+	}
+
+	private static JsonObject gearboxPlacedBlock(BlockState state) {
+		JsonObject reading = new JsonObject();
+		reading.addProperty("block", BuiltInRegistries.BLOCK.getKey(state.getBlock()).toString());
+		if (AllBlocks.GEARBOX.has(state))
+			reading.addProperty("axis", state.getValue(BlockStateProperties.AXIS).getSerializedName());
+		return reading;
+	}
 }
