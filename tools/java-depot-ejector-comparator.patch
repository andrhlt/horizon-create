+			helper.assertTrue(tick >= 62 && depot.getHeldItem().getCount() == 4 && comparator == 0 && wire == 0,
+				"The Comparator must reflect the held stack and turn off after its launch.");
+			level.setChunkForced(chunk.x, chunk.z, false);
+		});
+	}
