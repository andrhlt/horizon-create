+    @GameTest(template = "shearing", timeoutTicks = 50)
+    public static void tankMergeTrace(CreateGameTestHelper helper) {
+        var level = helper.getLevel();
+        var base = helper.absolutePos(new BlockPos(3, 16, 3));
+        var tank = com.simibubi.create.AllBlocks.FLUID_TANK.getDefaultState();
+        helper.runAtTickTime(2, () -> {
+            for (int rig = 0; rig < 2; rig++) for (int corner = 0; corner < 2; corner++)
+                level.setBlockAndUpdate(base.east(rig * 6 + corner * 2).south(corner * 2), tank);
+        });
+        helper.runAtTickTime(8, () -> {
+            for (int rig = 0; rig < 2; rig++) for (int corner = 0; corner < 2; corner++) {
+                var pos = base.east(rig * 6 + corner * 2).south(corner * 2);
+                var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, pos, null);
+                var fluid = (rig == 0) == (corner == 0) ? net.minecraft.world.level.material.Fluids.WATER : net.minecraft.world.level.material.Fluids.LAVA;
+                System.out.printf("CREATE_HORIZONTAL_FILL %d|%d|%d%n", rig, corner, cap.fill(new net.neoforged.neoforge.fluids.FluidStack(fluid, corner == 0 ? 4000 : 5000), net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE));
+            }
+        });
+        for (int tick = 9; tick <= 16; tick++) {
+            final int sample = tick;
+            helper.runAtTickTime(tick, () -> {
+                if (sample == 10) for (int rig = 0; rig < 2; rig++) for (int x = 0; x < 3; x++) for (int z = 0; z < 3; z++) {
+                    if ((x == 0 && z == 0) || (x == 2 && z == 2)) continue;
+                    level.setBlockAndUpdate(base.east(rig * 6 + x).south(z), tank);
+                }
+                for (int rig = 0; rig < 2; rig++) for (int x = 0; x < 3; x++) for (int z = 0; z < 3; z++) {
+                    var pos = base.east(rig * 6 + x).south(z);
+                    var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, pos, null);
+                    System.out.printf("CREATE_HORIZONTAL %d|%d|%d|%d|%s|%s|%d%n", sample, rig, x, z, level.getBlockState(pos).getBlock(), cap == null ? "-" : cap.getFluidInTank(0), cap == null ? 0 : cap.getTankCapacity(0));
+                }
+                if (sample == 16) helper.succeed();
+            });
+        }
+    }
