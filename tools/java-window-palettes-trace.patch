+    @GameTest(template = "threshold_switch_pulley", timeoutTicks = 72)
+    public static void paletteWindowsRecycling(CreateGameTestHelper helper) {
+        var world = helper.getLevel();
+        var center = helper.absolutePos(new BlockPos(1, 2, 1)).above(12);
+        var registry = net.minecraft.core.registries.BuiltInRegistries.BLOCK;
+        var items = net.minecraft.core.registries.BuiltInRegistries.ITEM;
+        var families = java.util.List.of("tiled_glass", "framed_glass", "horizontal_framed_glass",
+            "vertical_framed_glass");
+        var positions = new java.util.LinkedHashMap<String, BlockPos>();
+        for (var family : families)
+            for (var suffix : java.util.List.of("", "_pane"))
+                positions.put(family + suffix, center.offset((positions.size() % 4) * 2, 0, (positions.size() / 4) * 2));
+        var silk = world.registryAccess()
+            .registryOrThrow(net.minecraft.core.registries.Registries.ENCHANTMENT)
+            .getHolderOrThrow(net.minecraft.world.item.enchantment.Enchantments.SILK_TOUCH);
+        var plainPick = new net.minecraft.world.item.ItemStack(net.minecraft.world.item.Items.DIAMOND_PICKAXE);
+        var silkPick = plainPick.copy();
+        silkPick.enchant(silk, 1);
+        java.util.function.IntConsumer capture = tick -> {
+            for (var entry : positions.entrySet()) {
+                var at = entry.getValue();
+                var furnace = (net.minecraft.world.level.block.entity.FurnaceBlockEntity) world.getBlockEntity(at);
+                var nbt = furnace.saveWithoutMetadata(world.registryAccess());
+                var input = furnace.getItem(0);
+                var output = furnace.getItem(2);
+                System.out.printf("CREATE_WINDOW_FURNACE %d;%s;%d;%d;%d;%s;%d;%s;%d%n", tick,
+                    entry.getKey(), nbt.getShort("CookTime"), nbt.getShort("CookTimeTotal"),
+                    nbt.getShort("BurnTime"),
+                    world.getBlockState(at).getValue(net.minecraft.world.level.block.AbstractFurnaceBlock.LIT),
+                    input.getCount(), items.getKey(output.getItem()), output.getCount());
+            }
+        };
+        helper.runAtTickTime(4, () -> {
+            var lootNames = new java.util.ArrayList<>(positions.keySet());
+            lootNames.addAll(java.util.List.of("oak_window", "oak_window_pane", "weathered_iron_window",
+                "weathered_iron_window_pane"));
+            var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+            for (var name : lootNames) {
+                var state = registry.get(com.simibubi.create.Create.asResource(name)).defaultBlockState();
+                for (var tool : java.util.List.of(plainPick, silkPick)) {
+                    var drops = net.minecraft.world.level.block.Block.getDrops(state, world, center, null, player, tool);
+                    var contents = drops.stream().map(stack -> items.getKey(stack.getItem()) + "=" + stack.getCount())
+                        .sorted().collect(java.util.stream.Collectors.joining("|"));
+                    System.out.printf("CREATE_WINDOW_LOOT %s;%s;%s%n", name, tool == silkPick, contents);
+                }
+            }
+            for (var entry : positions.entrySet()) {
+                var at = entry.getValue();
+                world.setBlockAndUpdate(at, Blocks.FURNACE.defaultBlockState());
+                var furnace = (net.minecraft.world.level.block.entity.FurnaceBlockEntity) world.getBlockEntity(at);
+                furnace.setItem(0, new net.minecraft.world.item.ItemStack(items.get(com.simibubi.create.Create.asResource(entry.getKey()))));
+                furnace.setItem(1, new net.minecraft.world.item.ItemStack(net.minecraft.world.item.Items.COAL));
+            }
+            capture.accept(0);
+        });
+        for (int index = 1; index <= 52; index++) {
+            int tick = index;
+            helper.runAtTickTime(4 + index, () -> {
+                capture.accept(tick);
+                if (tick == 52) helper.succeed();
+            });
+        }
+    }
 }
