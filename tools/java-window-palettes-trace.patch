+    @GameTest(template = "threshold_switch_pulley", timeoutTicks = 32)
+    public static void paletteWindows(CreateGameTestHelper helper) {
+        var world = helper.getLevel();
+        var pos = helper.absolutePos(new BlockPos(1, 2, 1)).above(8);
+        var registry = net.minecraft.core.registries.BuiltInRegistries.BLOCK;
+        var names = java.util.List.of("tiled_glass", "framed_glass", "horizontal_framed_glass",
+            "vertical_framed_glass", "oak_window", "spruce_window", "birch_window", "jungle_window",
+            "acacia_window", "dark_oak_window", "mangrove_window", "crimson_window", "warped_window",
+            "cherry_window", "bamboo_window", "ornate_iron_window", "industrial_iron_window",
+            "weathered_iron_window");
+        helper.runAtTickTime(4, () -> {
+            for (var family : names) {
+                for (var id : java.util.List.of(family, family + "_pane")) {
+                    var block = registry.get(com.simibubi.create.Create.asResource(id));
+                    var state = block.defaultBlockState();
+                    helper.assertTrue(block != Blocks.AIR, "Unknown window " + id);
+                    world.setBlockAndUpdate(pos, state);
+                    System.out.printf("CREATE_WINDOW %s;%s;%.3f;%.3f;%d;%d;%s;%s%n", id,
+                        state, state.getDestroySpeed(world, pos), block.getExplosionResistance(),
+                        state.getMapColor(world, pos).id, state.getLightBlock(world, pos),
+                        state.propagatesSkylightDown(world, pos), state.canOcclude());
+                    world.setBlockAndUpdate(pos, Blocks.AIR.defaultBlockState());
+                }
+            }
+            var primary = registry.get(com.simibubi.create.Create.asResource("oak_window_pane"));
+            var adjacent = new net.minecraft.world.level.block.Block[] {Blocks.AIR, Blocks.GLASS_PANE,
+                primary, registry.get(com.simibubi.create.Create.asResource("framed_glass_pane")),
+                Blocks.IRON_BARS, Blocks.STONE, Blocks.GLASS, Blocks.OAK_FENCE};
+            for (var other : adjacent) {
+                world.setBlockAndUpdate(pos.east(), Blocks.AIR.defaultBlockState());
+                world.setBlockAndUpdate(pos, primary.defaultBlockState());
+                world.setBlockAndUpdate(pos.east(), other.defaultBlockState());
+                System.out.printf("CREATE_WINDOW_NEIGHBOR %s;%s%n",
+                    registry.getKey(other), world.getBlockState(pos));
+            }
+            world.setBlockAndUpdate(pos.east(), Blocks.AIR.defaultBlockState());
+            world.setBlockAndUpdate(pos, primary.defaultBlockState());
+            var paneState = world.getBlockState(pos);
+            var water = net.minecraft.world.level.material.Fluids.WATER.getSource(false);
+            var liquid = (net.minecraft.world.level.block.LiquidBlockContainer) primary;
+            helper.assertTrue(liquid.placeLiquid(world, pos, paneState, water), "Pane refused water");
+            System.out.printf("CREATE_WINDOW_WATER %s;%s%n",
+                world.getBlockState(pos), world.getFluidState(pos).isSource());
+            helper.succeed();
+        });
+    }
