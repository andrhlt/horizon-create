+	@GameTest(template = "shearing")
+	public static void toolboxAnimation(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var pos = helper.absolutePos(new BlockPos(1, 16, 1));
+		var brown = AllBlocks.TOOLBOXES.get(DyeColor.BROWN).get();
+		level.setBlockAndUpdate(pos, brown.defaultBlockState());
+		var box = (ToolboxBlockEntity) level.getBlockEntity(pos);
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var guest = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var tracker = box.getBehaviour(AnimatedContainerBehaviour.TYPE);
+		box.tick();
+		ToolboxMenu hostMenu = null;
+		ToolboxMenu guestMenu = null;
+		for (int tick = 0; tick <= 18; tick++) {
+			if (tick == 1 || tick == 11) {
+				hostMenu = ToolboxMenu.create(40, player.getInventory(), box);
+				player.containerMenu = hostMenu;
+			}
+			if (tick == 2) {
+				guestMenu = ToolboxMenu.create(41, guest.getInventory(), box);
+				guest.containerMenu = guestMenu;
+			}
+			if (tick == 8 || tick == 12) {
+				hostMenu.removed(player);
+				player.containerMenu = player.inventoryMenu;
+			}
+			if (tick == 6) {
+				guestMenu.removed(guest);
+				guest.containerMenu = guest.inventoryMenu;
+			}
+			int viewers = tracker.openCount;
+			box.tick();
+			System.out.printf(Locale.ROOT, "CREATE_TOOLBOX_ANIMATION %d,%d,%d,%.9f,%.9f,%.9f,%.9f,%.9f,%.9f%n",
