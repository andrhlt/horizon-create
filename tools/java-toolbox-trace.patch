+			return stack.isEmpty() ? "_" : BuiltInRegistries.ITEM.getKey(stack.getItem()) + "=" + stack.getCount();
+		}).collect(Collectors.joining("|"));
+		System.out.printf("CREATE_TOOLBOX_STORAGE %s,%d,%d,%d,%s%n", action, movedOrRemainder,
+			inventory.getSlots(), ItemHelper.calcRedstoneFromInventory(inventory), slots);
+	}
+}
