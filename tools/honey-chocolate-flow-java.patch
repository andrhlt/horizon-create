+	private static void runFluidFlowPhase(CreateGameTestHelper helper, FlowOracleFluid fluid, int start, int[] sampleTicks) {
+		var level = helper.getLevel();
+		var source = new BlockPos(1, 2, 2);
+		for (int x = 0; x < 5; x++)
+			level.setBlock(source.east(x), Blocks.AIR.defaultBlockState(), 3);
+		for (int x = 0; x < 5; x++)
+			level.setBlock(source.offset(x, -1, 0), Blocks.STONE.defaultBlockState(), 3);
+		for (int x = 0; x < 5; x++) {
+			level.setBlock(source.offset(x, 0, -1), Blocks.STONE.defaultBlockState(), 3);
+			level.setBlock(source.offset(x, 0, 1), Blocks.STONE.defaultBlockState(), 3);
+		}
+		level.setBlock(source.west(), Blocks.STONE.defaultBlockState(), 3);
+		level.setBlock(source, fluid.source().defaultFluidState().createLegacyBlock(), 3);
+		for (int tick : sampleTicks) {
+			Runnable sample = () -> {
+				for (int x = 0; x < 5; x++) {
+					var pos = source.east(x);
+					var state = level.getBlockState(pos);
+					var fluidState = state.getFluidState();
+					System.out.printf(java.util.Locale.ROOT,
+						"CREATE_FLUID_FLOW,%s,%d,%d,%s,%s,%s,%d,%b%n",
+						fluid.name(), tick, x, BuiltInRegistries.BLOCK.getKey(state.getBlock()), state,
+						BuiltInRegistries.FLUID.getKey(fluidState.getType()), fluidState.getAmount(), fluidState.isSource());
+				}
+			};
+			if (tick == 0)
+				sample.run();
+			else
+				helper.runAtTickTime(start + tick, sample);
+		}
+	}
