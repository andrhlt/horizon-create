+	@GameTest(template = "shearing", timeoutTicks = 80)
+	public static void creativeCrateChute(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var cratePos = helper.absolutePos(new BlockPos(2, 2, 2)).above(20);
+		var chutePos = cratePos.above();
+		helper.runAtTickTime(4, () -> {
+			level.setBlock(cratePos, com.simibubi.create.AllBlocks.CREATIVE_CRATE.getDefaultState(), 3);
+			var crate = (com.simibubi.create.content.logistics.crate.CreativeCrateBlockEntity) level.getBlockEntity(cratePos);
+			crate.getBehaviour(com.simibubi.create.foundation.blockEntity.behaviour.filtering.FilteringBehaviour.TYPE).setFilter(new ItemStack(Items.IRON_INGOT, 7));
+			level.setBlock(chutePos, com.simibubi.create.AllBlocks.CHUTE.getDefaultState(), 3);
+		});
+		helper.runAtTickTime(6, () -> {
+			var chute = (com.simibubi.create.content.logistics.chute.ChuteBlockEntity) level.getBlockEntity(chutePos);
+			var crate = (com.simibubi.create.content.logistics.crate.CreativeCrateBlockEntity) level.getBlockEntity(cratePos);
+			var filter = crate.getBehaviour(com.simibubi.create.foundation.blockEntity.behaviour.filtering.FilteringBehaviour.TYPE);
+			chute.setItem(new ItemStack(Items.GOLD_INGOT, 5), 1);
+			for (int tick=0; tick <= 12; tick++) {
+				if (tick > 0) chute.tick();
+				System.out.printf("CREATE_CRATE_CHUTE,%d,%d,%s,%d%n", tick, chute.getItem().getCount(), net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(filter.getFilter().getItem()), filter.getFilter().getCount());
+			}
+			if (!chute.getItem().isEmpty() || !filter.getFilter().is(Items.IRON_INGOT)) throw new IllegalStateException("Chute did not empty into crate");
+			helper.succeed();
+		});
+	}
+
 }
