+		var receiver = (com.simibubi.create.content.logistics.depot.EjectorBlockEntity) level.getBlockEntity(next);
+		var depot = (com.simibubi.create.content.logistics.depot.DepotBlockEntity) level.getBlockEntity(end);
+		source.setTarget(4, 0);
+		receiver.setTarget(4, 0);
+		var sourceInput = source.getBehaviour(com.simibubi.create.content.logistics.depot.DepotBehaviour.TYPE);
+		var receiverInput = receiver.getBehaviour(com.simibubi.create.content.logistics.depot.DepotBehaviour.TYPE);
+		var region = new net.minecraft.world.phys.AABB(at).inflate(12);
+		level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class, region)
