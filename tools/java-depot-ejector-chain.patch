+			long tick = helper.getTick();
+			helper.assertTrue(tick >= 1, "Waiting for the measured ticks");
+			if (tick == 12)
+				sourceInput.setCenteredHeldItem(new com.simibubi.create.content.kinetics.belt.transport.TransportedItemStack(
+					new ItemStack(Items.IRON_INGOT)));
+			var a = source.saveWithoutMetadata(level.registryAccess());
+			var b = receiver.saveWithoutMetadata(level.registryAccess());
+			var flightA = a.getList("LaunchedItems", net.minecraft.nbt.Tag.TAG_COMPOUND);
+			var flightB = b.getList("LaunchedItems", net.minecraft.nbt.Tag.TAG_COMPOUND);
+			int ageA = flightA.isEmpty() ? -1 : flightA.getCompound(0).getInt("Location");
+			int ageB = flightB.isEmpty() ? -1 : flightB.getCompound(0).getInt("Location");
+			int heldA = sourceInput.getHeldItemStack().getCount();
+			int heldB = receiverInput.getHeldItemStack().getCount();
+			int spill = level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class, region,
