diff --git a/src/main/java/com/simibubi/create/infrastructure/gametest/tests/JavaEjectorHeldPreviewProbe.java b/src/main/java/com/simibubi/create/infrastructure/gametest/tests/JavaEjectorHeldPreviewProbe.java
