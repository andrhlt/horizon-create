+
+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
+	public static void paletteMining(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var at = helper.absolutePos(new BlockPos(1, 11, 1));
+		var blocks = net.minecraft.core.registries.BuiltInRegistries.BLOCK;
+		var items = net.minecraft.core.registries.BuiltInRegistries.ITEM;
+		var pick = net.minecraft.world.item.Items.WOODEN_PICKAXE.getDefaultInstance();
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		player.setPos(at.getX() + .5, at.getY(), at.getZ() - 2.0);
+		for (String example : java.util.List.of(
+		    "andesite_alloy_block", "industrial_iron_block", "weathered_iron_block",
+		    "cut_andesite", "cut_andesite_slab/bottom", "cut_andesite_slab/double",
+		    "polished_cut_granite", "cut_calcite_brick_stairs", "cut_diorite_wall", "dripstone_pillar",
+		    "layered_deepslate", "small_tuff_bricks", "cut_asurine_bricks", "cut_crimsite_wall",
+		    "cut_limestone_slab/bottom", "cut_limestone_slab/double", "polished_cut_ochrum",
+		    "small_scoria_brick_stairs", "scorchia", "veridium_pillar"
+		)) {
+			var split = example.split("/");
+			var id = com.simibubi.create.Create.asResource(split[0]);
+			var state = blocks.get(id).defaultBlockState();
+			if (split.length > 1) {
+				var type = split[1].equals("bottom") ? net.minecraft.world.level.block.state.properties.SlabType.BOTTOM
+				    : net.minecraft.world.level.block.state.properties.SlabType.DOUBLE;
+				state = state.setValue(net.minecraft.world.level.block.SlabBlock.TYPE, type);
+			}
+			level.setBlockAndUpdate(at, state);
+			for (var tool : java.util.List.of(pick, net.minecraft.world.item.ItemStack.EMPTY)) {
+				boolean harvest = !state.requiresCorrectToolForDrops() || tool.isCorrectToolForDrops(state);
+				var drops = harvest ? net.minecraft.world.level.block.Block.getDrops(
+				    state, level, at, level.getBlockEntity(at), player, tool) : java.util.List.<net.minecraft.world.item.ItemStack>of();
+				var drop = drops.stream().filter(stack -> items.getKey(stack.getItem()).equals(id))
+				    .mapToInt(net.minecraft.world.item.ItemStack::getCount).sum();
+				helper.assertTrue(drop == drops.stream().mapToInt(net.minecraft.world.item.ItemStack::getCount).sum(),
+				    "Unexpected other drops from " + example);
+				System.out.printf("CREATE_PALETTE_MINING %s,%s,%s,%d%n", id,
+				    split.length > 1 ? split[1] : "_", items.getKey(tool.getItem()), drop);
+			}
+		}
+		helper.succeed();
+	}
+
 }
