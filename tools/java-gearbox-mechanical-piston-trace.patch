+	private static void mechanicalGearbox(CreateGameTestHelper helper, String scenario, Direction.Axis axis,
+		boolean sticky) {
+		var level = helper.getLevel();
+		var piston = helper.absolutePos(new BlockPos(2, 3, 1));
+		var pistonState = level.getBlockState(piston);
+		helper.assertTrue(AllBlocks.STICKY_MECHANICAL_PISTON.has(pistonState), "Expected original sticky piston");
+		if (!sticky) {
+			level.setBlock(piston, AllBlocks.MECHANICAL_PISTON.getDefaultState()
+				.setValue(MechanicalPistonBlock.FACING, Direction.EAST)
+				.setValue(MechanicalPistonBlock.AXIS_ALONG_FIRST_COORDINATE,
+					pistonState.getValue(MechanicalPistonBlock.AXIS_ALONG_FIRST_COORDINATE)), 3);
+		}
+
+		level.setBlock(piston.east(), axis == null ? Blocks.STONE.defaultBlockState()
+			: AllBlocks.GEARBOX.getDefaultState().setValue(BlockStateProperties.AXIS, axis), 3);
+		for (int distance = 2; distance <= 4; distance++)
+			level.setBlock(piston.east(distance), Blocks.AIR.defaultBlockState(), 3);
+		// The template keeps its sticky assembly mounted. Force endpoint placement before reversal.
+		var pistonBe = (LinearActuatorBlockEntity) level.getBlockEntity(piston);
+		pistonBe.getBehaviour(ScrollValueBehaviour.TYPE).setValue(0);
+		helper.pullLever(new BlockPos(3, 3, 2));
+
+		for (int tick = 0; tick < 24; tick++) {
+			int sample = tick;
+			helper.runAtTickTime(tick + 2, () -> {
+				if (sample == 10) {
+					helper.assertTrue(level.getBlockState(piston).getValue(MechanicalPistonBlock.STATE)
+						== MechanicalPistonBlock.PistonState.EXTENDED, "Expected disassembly before reversal");
+					var motor = (SmartBlockEntity) level.getBlockEntity(helper.absolutePos(new BlockPos(4, 2, 2)));
+					motor.getBehaviour(ScrollValueBehaviour.TYPE).setValue(-64);
+				}
+
+				var be = (LinearActuatorBlockEntity) level.getBlockEntity(piston);
+				String state = level.getBlockState(piston).getValue(MechanicalPistonBlock.STATE).getSerializedName();
+				var cells = new JsonArray();
+				for (int distance = -2; distance <= 4; distance++)
+					cells.add(mechanicalGearboxBlock(level.getBlockState(piston.east(distance))));
+				var payload = new JsonArray();
+				if (be.movedContraption != null) {
+					be.movedContraption.getContraption().getBlocks().values().stream()
+						.map(info -> mechanicalGearboxBlock(info.state())).sorted().forEach(payload::add);
+				}
+				var row = new JsonObject();
+				row.addProperty("case", scenario);
+				row.addProperty("tick", sample);
+				row.addProperty("offset", be.offset);
+				row.addProperty("speed", be.getSpeed());
+				row.addProperty("state", state);
+				row.add("cells", cells);
+				row.add("payload", payload);
+				System.out.println("CREATE_MECHANICAL_GEARBOX " + row);
+				if (sample == 23)
+					helper.succeed();
+			});
+		}
+	}
+
+	private static String mechanicalGearboxBlock(BlockState state) {
+		String id = BuiltInRegistries.BLOCK.getKey(state.getBlock()).toString();
+		if (AllBlocks.GEARBOX.has(state))
+			return id + "[axis=" + state.getValue(BlockStateProperties.AXIS).getSerializedName() + "]";
+		return id;
+	}
