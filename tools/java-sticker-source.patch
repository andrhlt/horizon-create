+    // The original client algorithm factored without its platform callbacks;
+    // both production tick() and the dedicated-server source oracle call it.
+    public int advanceAnimation(boolean extended, boolean attached) {
+        piston.tickChaser();
+        int events = 0;
+        if (attached && piston.getValue(0) != piston.getValue() && piston.getValue() == 1) events |= 1;
+        if (!update) return events;
+        update = false;
+        int target = extended ? 1 : 0;
+        if (attached && target == 0 && piston.getChaseTarget() == 1) events |= 2;
+        piston.chase(target, .4f, Chaser.LINEAR);
+        return events | 4;
+    }
 
