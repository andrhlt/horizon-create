+					NeoForge.EVENT_BUS.unregister(listen);
+					helper.getLevel().removePlayerImmediately(host, Entity.RemovalReason.DISCARDED);
+					helper.getLevel().removePlayerImmediately(guest, Entity.RemovalReason.DISCARDED);
+					return;
+				}
+			}
+			helper.fail("Waiting for the elevator service trace");
+		});
 	}
 
+	private static void placeElevatorDoor(CreateGameTestHelper helper, BlockPos pos, Block door) {
+		var state = door.defaultBlockState().setValue(DoorBlock.FACING, Direction.SOUTH);
+		helper.getLevel().setBlock(helper.absolutePos(pos), state, Block.UPDATE_CLIENTS);
+		helper.getLevel().setBlock(helper.absolutePos(pos.above()),
+			state.setValue(DoorBlock.HALF, DoubleBlockHalf.UPPER), Block.UPDATE_CLIENTS);
+	}
+
+	private static String elevatorDoorMode(CreateGameTestHelper helper, BlockPos at) {
+		if (!(helper.getLevel().getBlockEntity(helper.absolutePos(at)) instanceof ElevatorContactBlockEntity contact))
+			return "";
+		var controls = BlockEntityBehaviour.get(contact, DoorControlBehaviour.TYPE);
+		return controls == null ? "" : controls.mode.name();
+	}
+
+	private static String elevatorOpen(BlockState state) {
+		return state.hasProperty(DoorBlock.OPEN) ? Boolean.toString(state.getValue(DoorBlock.OPEN)) : "";
+	}
