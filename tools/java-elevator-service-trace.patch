+		helper.setBlock(upperDoor.below(), Blocks.IRON_BLOCK);
+		placeElevatorDoor(helper, lowerDoor, Blocks.IRON_DOOR);
+		placeElevatorDoor(helper, upperDoor, Blocks.IRON_DOOR);
+		helper.getLevel().addFreshEntity(new SuperGlueEntity(helper.getLevel(),
+			new AABB(Vec3.atLowerCornerOf(helper.absolutePos(cabinDoor.below())),
+				Vec3.atLowerCornerOf(helper.absolutePos(cabinDoor.above().offset(1, 1, 1))))));
+		ServerPlayer host = createElevatorPlayer(helper, "ParityHost");
+		ServerPlayer guest = createElevatorPlayer(helper, "ParityGuest");
+		List<String> soundEvents = new ArrayList<>();
+		Consumer<PlayLevelSoundEvent.AtPosition> listen = event -> {
+			if (event.getLevel() != helper.getLevel() || event.getSound() == null)
+				return;
+			var sound = event.getSound().value().getLocation();
+			if (Set.of("block.iron_door.open", "block.iron_door.close", "controller_click",
+				"contraption_assemble", "contraption_assemble_compounded_1", "contraption_disassemble").contains(sound.getPath()))
+				soundEvents.add(sound.toString());
+		};
+		NeoForge.EVENT_BUS.addListener(listen);
+
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			var main = helper.getBlockEntity(AllBlockEntityTypes.ELEVATOR_PULLEY.get(), pulley);
+			var cabin = main.getAttachedContraption();
+			var elevator = cabin == null ? null : (ElevatorContraption) cabin.getContraption();
+			var target = elevator == null ? null : elevator.getCurrentTargetY(helper.getLevel());
+			BlockPos localDoor = elevator == null ? null : helper.absolutePos(cabinDoor).subtract(elevator.anchor);
+			var moving = elevator == null ? null : elevator.getBlocks().get(localDoor);
+			var movingUpper = elevator == null ? null : elevator.getBlocks().get(localDoor.above());
+			System.out.printf(Locale.ROOT, "ELEVATOR_SERVICE %d,%s,%s,%b,%b,%s,%s,%s,%s,%s,%s,%s,%s,%s%n",
+				tick, cabin == null ? "" : String.format(Locale.ROOT, "%.9f", cabin.getY() - origin.getY()),
+				target == null ? "" : Integer.toString(target - origin.getY()),
+				helper.getBlockState(bottom.above()).getValue(RedstoneLampBlock.LIT),
+				helper.getBlockState(top.above()).getValue(RedstoneLampBlock.LIT),
+				elevatorDoorMode(helper, bottom), elevatorDoorMode(helper, top),
+				moving == null ? "" : elevatorOpen(moving.state()),
+				movingUpper == null ? "" : elevatorOpen(movingUpper.state()),
+				elevatorOpen(helper.getBlockState(lowerDoor)), elevatorOpen(helper.getBlockState(lowerDoor.above())),
+				elevatorOpen(helper.getBlockState(upperDoor)), elevatorOpen(helper.getBlockState(upperDoor.above())),
+				String.join("|", soundEvents));
+			soundEvents.clear();
+
+			switch ((int) tick) {
+				case 15 -> main.clicked();
+				case 18 -> {
+					helper.assertTrue(cabin != null, "Assembly: " + main.getLastAssemblyException());
+					placeElevatorPlayer(helper, host, 0.5, 3.0, 2.5);
+					new ElevatorContactEditPacket(helper.absolutePos(bottom), "G", "Ground", DoorControl.SOUTH).handle(host);
+					placeElevatorPlayer(helper, guest, 0.5, 12.0, 2.5);
+					new ElevatorContactEditPacket(helper.absolutePos(top), "U", "Upper", DoorControl.NONE).handle(guest);
+				}
+				case 25 -> {
+					helper.assertTrue(cabin != null, "Assembly: " + main.getLastAssemblyException());
+					placeElevatorPlayer(helper, guest, 4.5, 3.0, 2.5);
+					new ElevatorTargetFloorPacket(cabin, helper.absolutePos(top).getY()).handle(guest);
+					new ContraptionInteractionPacket(cabin, InteractionHand.MAIN_HAND,
+						helper.absolutePos(controls).subtract(elevator.anchor), Direction.EAST).handle(guest);
+				}
+				case 88 -> {
+					helper.assertTrue(!moving.state().getValue(DoorBlock.OPEN)
+						&& !helper.getBlockState(upperDoor).getValue(DoorBlock.OPEN), "Upper floor is set to keep doors shut");
+					placeElevatorPlayer(helper, guest, 0.5, 12.0, 2.5);
+					new ElevatorContactEditPacket(helper.absolutePos(top), "U", "Upper", DoorControl.SOUTH).handle(guest);
+				}
+				case 100 -> {
+					helper.assertTrue(moving.state().getValue(DoorBlock.OPEN) && movingUpper.state().getValue(DoorBlock.OPEN)
