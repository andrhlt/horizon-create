+            var result = mirror.process(source, state);
+            for (var entry : result.entrySet()) {
+                var pos = entry.getKey();
+                System.out.println("CREATE_SYMMETRY_MODE " + i + "," + (pos.getX()-10) + "," + (pos.getY()-169) + "," + (pos.getZ()-22) + "," + entry.getValue().getValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING).getSerializedName() + "," + entry.getValue().getValue(net.minecraft.world.level.block.StairBlock.SHAPE));
