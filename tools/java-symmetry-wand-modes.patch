+    @GameTest(template = "shearing", timeoutTicks = 80)
+    public static void symmetryModes(CreateGameTestHelper helper) {
+        var origin = new net.minecraft.world.phys.Vec3(10, 169, 22);
+        var source = new BlockPos(12, 170, 25);
+        var state = Blocks.OAK_STAIRS.defaultBlockState().setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING, net.minecraft.core.Direction.NORTH);
