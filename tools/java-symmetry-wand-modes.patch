+            new com.simibubi.create.content.equipment.symmetryWand.mirror.CrossPlaneMirror(origin),
+            new com.simibubi.create.content.equipment.symmetryWand.mirror.TriplePlaneMirror(origin));
+        for (int i = 0; i < mirrors.size(); i++) {
+            var mirror = mirrors.get(i);
