+	@GameTest(template = "shearing", timeoutTicks = 22)
+	public static void adjustableChainSpeedLimit(CreateGameTestHelper helper) {
+		for (int x : new int[] {12, 18}) {
+			var shift = new BlockPos(x, 3, 3);
+			var drive = shift.east();
+			var small = shift.below();
+			var large = small.west().north();
+			helper.setBlock(shift, AllBlocks.ADJUSTABLE_CHAIN_GEARSHIFT.getDefaultState()
+				.setValue(BlockStateProperties.AXIS, Direction.Axis.Y)
+				.setValue(ChainDriveBlock.CONNECTED_ALONG_FIRST_COORDINATE, true)
+				.setValue(ChainDriveBlock.PART, ChainDriveBlock.Part.START));
+			helper.setBlock(drive, AllBlocks.ENCASED_CHAIN_DRIVE.getDefaultState()
+				.setValue(BlockStateProperties.AXIS, Direction.Axis.Y)
+				.setValue(ChainDriveBlock.CONNECTED_ALONG_FIRST_COORDINATE, true)
+				.setValue(ChainDriveBlock.PART, ChainDriveBlock.Part.END));
+			helper.setBlock(small, AllBlocks.COGWHEEL.getDefaultState()
+				.setValue(BlockStateProperties.AXIS, Direction.Axis.Y));
+			helper.setBlock(large, AllBlocks.LARGE_COGWHEEL.getDefaultState()
+				.setValue(BlockStateProperties.AXIS, Direction.Axis.Y));
+			helper.setBlock(drive.below(), AllBlocks.SHAFT.getDefaultState()
+				.setValue(BlockStateProperties.AXIS, Direction.Axis.Y));
+			chainSpeedMotor(helper, large.below(), Direction.UP, x == 12 ? 64 : 96);
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int x : new int[] {12, 18}) {
+				var shift = new BlockPos(x, 3, 3);
+				var drive = shift.east();
+				var small = shift.below();
+				var large = small.west().north();
+				var shiftEntity = helper.getLevel().getBlockEntity(helper.absolutePos(shift));
+				System.out.printf(java.util.Locale.ROOT,
+					"CREATE_CHAIN_SPEED_LIMIT %d,%d,%b,%.1f,%.1f,%.1f,%.1f,%.1f%n",
+					tick, x == 12 ? 64 : 96, shiftEntity instanceof ChainGearshiftBlockEntity,
+					shiftEntity instanceof ChainGearshiftBlockEntity gearshift ? gearshift.getModifier() : 0f,
+					chainSpeed(helper, large), chainSpeed(helper, small),
+					chainSpeed(helper, shift), chainSpeed(helper, drive.below()));
+				if (tick == 3)
+					chainSpeedMotor(helper, drive.above(), Direction.DOWN, 32);
+				if (tick == 6)
+					helper.setBlock(shift.south(), Blocks.REDSTONE_BLOCK);
+				if (tick == 11)
+					helper.setBlock(large.below(), Blocks.AIR);
+				if (tick == 15)
+					helper.setBlock(shift.south(), Blocks.AIR);
+			}
+			if (tick < 19)
+				helper.fail("Waiting for the final chain speed sample");
+		});
+	}
+
+	private static void chainSpeedMotor(CreateGameTestHelper helper, BlockPos pos, Direction facing, int rpm) {
+		helper.setBlock(pos, AllBlocks.CREATIVE_MOTOR.getDefaultState()
+			.setValue(BlockStateProperties.FACING, facing));
+		helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), pos).generatedSpeed.setValue(rpm);
+	}
+
+	private static float chainSpeed(CreateGameTestHelper helper, BlockPos pos) {
+		var entity = helper.getLevel().getBlockEntity(helper.absolutePos(pos));
+		return entity instanceof KineticBlockEntity kinetic ? kinetic.getSpeed() : 0;
+	}
 }
