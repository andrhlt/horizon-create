+    @GameTest(template = "shearing", timeoutTicks = 50)
+    public static void tankMergeTrace(CreateGameTestHelper helper) {
+        var level = helper.getLevel();
+        var base = helper.absolutePos(new BlockPos(3, 16, 3));
+        var tank = com.simibubi.create.AllBlocks.FLUID_TANK.getDefaultState();
+        helper.runAtTickTime(2, () -> {
+            for (int y = 1; y >= 0; y--) for (int x = 1; x >= 0; x--) for (int z = 1; z >= 0; z--)
+                level.setBlockAndUpdate(base.east(x).above(y).south(z), tank);
+        });
+        helper.runAtTickTime(8, () -> {
+            var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, base, null);
+            System.out.printf("CREATE_FULL_SPLIT_FILL %d|%d%n", cap.fill(new net.neoforged.neoforge.fluids.FluidStack(net.minecraft.world.level.material.Fluids.WATER, Integer.parseInt(System.getenv().getOrDefault("TANK_AMOUNT", "48000"))), net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE), cap.getTankCapacity(0));
+        });
+        for (int tick = 9; tick <= 16; tick++) {
+            final int sample = tick;
+            helper.runAtTickTime(tick, () -> {
+                if (sample == 10) level.destroyBlock(base, false);
+                for (int y = 0; y < 2; y++) for (int x = 0; x < 2; x++) for (int z = 0; z < 2; z++) {
+                    var pos = base.east(x).above(y).south(z);
+                    var cap = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.FluidHandler.BLOCK, pos, null);
+                    System.out.printf("CREATE_FULL_SPLIT %d|%d|%d|%d|%s|%s|%d%n", sample, y, x, z, level.getBlockState(pos).getBlock(), cap == null ? "-" : cap.getFluidInTank(0), cap == null ? 0 : cap.getTankCapacity(0));
+                    if (sample == 10 || sample == 11) {
+                        var entity = level.getBlockEntity(pos);
+                        System.out.printf("CREATE_FULL_SPLIT_NBT %d|%d|%d|%d|%s%n", sample, y, x, z, entity == null ? "-" : entity.saveWithFullMetadata(level.registryAccess()));
+                    }
+                }
+                if (sample == 16) helper.succeed();
+            });
+        }
+    }
