+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 30)
+	public static void controllerRailCartAssemblerDirection(CreateGameTestHelper helper) {
+		var world = helper.getLevel();
+		var fixture = helper.absolutePos(new BlockPos(0, 9, 0));
+		var origin = new BlockPos(Math.floorDiv(fixture.getX(), 16) * 16 + 1, fixture.getY(),
+			Math.floorDiv(fixture.getZ(), 16) * 16 + 4);
+		var chunk = new net.minecraft.world.level.ChunkPos(origin);
+		world.setChunkForced(chunk.x, chunk.z, true);
+		var controller = com.simibubi.create.AllBlocks.CONTROLLER_RAIL;
+		var assembler = com.simibubi.create.AllBlocks.CART_ASSEMBLER;
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var railShape = net.minecraft.world.level.block.state.properties.BlockStateProperties.RAIL_SHAPE;
+		var eastWest = net.minecraft.world.level.block.state.properties.RailShape.EAST_WEST;
+		var regularRail = Blocks.RAIL.defaultBlockState().setValue(railShape, eastWest);
+		var cargo = Blocks.POLISHED_ANDESITE.defaultBlockState();
+		var carts = new java.util.ArrayList<net.minecraft.world.entity.vehicle.AbstractMinecart>();
+		var registry = net.minecraft.core.registries.BuiltInRegistries.BLOCK;
+		helper.runAtTickTime(1, () -> {
+			for (int rig = 0; rig < 2; rig++) {
+				var line = origin.south(rig * 5);
+				for (int x = 0; x <= 12; x++) {
+					var at = line.east(x);
+					world.setBlockAndUpdate(at, Blocks.AIR.defaultBlockState());
+					world.setBlockAndUpdate(at.below(), Blocks.STONE.defaultBlockState());
+				}
+				for (int x = 0; x <= 12; x++)
+					world.setBlockAndUpdate(line.east(x), regularRail);
+				var center = line.east(6);
+				world.setBlockAndUpdate(center.north(), Blocks.AIR.defaultBlockState());
+				world.setBlockAndUpdate(center.above(), Blocks.AIR.defaultBlockState());
+				var rail = controller.getDefaultState()
+					.setValue(com.simibubi.create.content.redstone.rail.ControllerRailBlock.SHAPE, eastWest)
+					.setValue(com.simibubi.create.content.redstone.rail.ControllerRailBlock.BACKWARDS, rig == 1);
+				world.setBlockAndUpdate(center, rail);
+				world.setBlock(center, rail, 2);
+				var held = assembler.asStack();
+				player.setItemInHand(hand, held);
+				var hit = new net.minecraft.world.phys.BlockHitResult(
+					net.minecraft.world.phys.Vec3.atCenterOf(center), net.minecraft.core.Direction.UP, center, false);
+				helper.assertTrue(held.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit)).consumesAction(),
+					"could not place a directional assembler");
+				world.setBlockAndUpdate(center.above(), cargo);
+				world.setBlockAndUpdate(center.north(), Blocks.REDSTONE_BLOCK.defaultBlockState());
+			}
+		});
+		helper.runAtTickTime(5, () -> {
+			for (int rig = 0; rig < 2; rig++) {
+				var cart = net.minecraft.world.entity.EntityType.MINECART.create(world);
+				helper.assertTrue(cart != null, "could not create minecart");
+				cart.moveTo(origin.getX() + 6.5, origin.getY() + .0625, origin.getZ() + .5 + rig * 5, 0, 0);
+				world.addFreshEntity(cart);
+				carts.add(cart);
+			}
+		});
+		helper.succeedWhen(() -> {
+			var tick = helper.getTick() - 5;
+			if (tick < 0)
+				helper.fail("waiting for minecarts");
+			for (int rig = 0; rig < 2; rig++) {
+				var cart = carts.get(rig);
+				var center = origin.south(rig * 5).east(6);
+				var waiting = world.getBlockState(center.above());
+				System.out.printf(java.util.Locale.ROOT, "CONTROLLER_CART_DIRECTION %d,%d,%.12f,%.12f,%.12f,%s,%d%n",
+					tick, rig, cart.getX() - origin.getX(), cart.getZ() - origin.getZ(), cart.getDeltaMovement().x,
+					registry.getKey(waiting.getBlock()), cart.tickCount);
+			}
+			if (tick < 8)
+				helper.fail("waiting for directional assembler departure");
+		});
+	}
