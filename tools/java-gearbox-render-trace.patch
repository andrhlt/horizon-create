+	@GameTest(template = "shearing", timeoutTicks = 22)
+	public static void gearboxShaftVisuals(CreateGameTestHelper helper) {
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var directions = net.minecraft.core.Direction.values();
+		var axes = net.minecraft.core.Direction.Axis.values();
+		var positions = new java.util.ArrayList<BlockPos>();
+		var inputs = new java.util.ArrayList<net.minecraft.core.Direction>();
+		for (int index = 0; index < axes.length; index++) {
+			var boxAxis = axes[index];
+			int along = 0;
+			for (var direction : directions) {
+				if (direction.getAxis() == boxAxis)
+					continue;
+				var pos = new BlockPos(12 + 4 * along++, 6 + 4 * index, 5);
+				positions.add(pos);
+				inputs.add(direction);
+				helper.setBlock(pos, com.simibubi.create.AllBlocks.GEARBOX.getDefaultState().setValue(axis, boxAxis));
+				helper.setBlock(pos.relative(direction), com.simibubi.create.AllBlocks.CREATIVE_MOTOR.getDefaultState()
+					.setValue(facing, direction.getOpposite()));
+				for (var side : directions) {
+					if (side != direction && side.getAxis() != boxAxis)
+						helper.setBlock(pos.relative(side), com.simibubi.create.AllBlocks.SHAFT.getDefaultState().setValue(axis, side.getAxis()));
+				}
+			}
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			var world = helper.getLevel();
+			for (int index = 0; index < positions.size(); index++) {
+				var pos = positions.get(index);
+				var input = inputs.get(index);
+				var be = helper.getBlockEntity(AllBlockEntityTypes.GEARBOX.get(), pos);
+				if (tick == 0 || tick == 4 || tick == 8)
+					helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), pos.relative(input)).generatedSpeed.setValue(tick == 0 ? 32 : tick == 4 ? -48 : 16);
+				var boxAxis = be.getBlockState().getValue(axis);
+				var absolute = helper.absolutePos(pos);
+				var source = be.getSourceFacing();
+				for (var direction : directions) {
+					var sideAxis = direction.getAxis();
+					if (sideAxis == boxAxis)
+						continue;
+					float speed = be.getSpeed();
+					if (speed != 0 && be.hasSource()) {
+						if (source.getAxis() == sideAxis)
+							speed *= source == direction ? 1 : -1;
+						else if (source.getAxisDirection() == direction.getAxisDirection())
+							speed *= -1;
+					}
+					var near = (com.simibubi.create.content.kinetics.base.KineticBlockEntity) world.getBlockEntity(absolute.relative(direction));
+					int phaseParity = (sideAxis == net.minecraft.core.Direction.Axis.X ? 0 : absolute.getX())
+						+ (sideAxis == net.minecraft.core.Direction.Axis.Y ? 0 : absolute.getY())
+						+ (sideAxis == net.minecraft.core.Direction.Axis.Z ? 0 : absolute.getZ());
+					float phase = phaseParity % 2 == 0 ? 22.5f : 0;
+					var gameTime = world.getGameTime();
+					System.out.printf(java.util.Locale.ROOT, "CREATE_GEARBOX_VISUAL,%d,%d,%s,%s,%s,%.4f,%.4f,%d,%.1f,%.8f%n",
+						index, tick, boxAxis, source, direction, speed, near.getSpeed(), gameTime, phase,
+						((gameTime + .5f) * speed * 3f / 10) % 360 + phase);
+				}
+			}
+			if (tick < 11) helper.fail("Waiting for all four Gearbox inserts in each orientation");
+		});
+	}
