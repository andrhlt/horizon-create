+	@GameTest(template = "shearing", timeoutTicks = 72)
+	public static void pendingGearshiftReopen(CreateGameTestHelper helper) {
+		var mode = System.getenv("CREATE_PENDING_GEARSHIFT");
+		var level = helper.getLevel();
+		if ("off".equals(System.getenv("CREATE_PENDING_GEARSHIFT_DROPS"))) {
+			level.getGameRules().getRule(net.minecraft.world.level.GameRules.RULE_DOBLOCKDROPS)
+				.set(false, level.getServer());
+		}
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var powered = net.minecraft.world.level.block.state.properties.BlockStateProperties.POWERED;
+		var east = net.minecraft.core.Direction.EAST;
+		var motor = AllBlocks.CREATIVE_MOTOR.getDefaultState();
+		var clutch = AllBlocks.GEARSHIFT.getDefaultState().setValue(axis, east.getAxis());
+		var rigs = java.util.List.of(new BlockPos(-38, 101, -46), new BlockPos(-38, 101, -38));
+		level.setChunkForced(-3, -3, true);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int lane = 0; lane < rigs.size(); lane++) {
+				var center = rigs.get(lane);
+				if (mode.equals("write")) {
+					if (tick == 0) {
+						for (int x = -2; x <= 3; x++)
+							for (int z = -1; z <= 1; z++)
+								level.setBlockAndUpdate(center.offset(x, -1, z), Blocks.STONE.defaultBlockState());
+						level.setBlockAndUpdate(center.above(), Blocks.AIR.defaultBlockState());
+						level.setBlockAndUpdate(center.east().above(), Blocks.AIR.defaultBlockState());
+						level.setBlockAndUpdate(center.east(), Blocks.AIR.defaultBlockState());
+						level.setBlockAndUpdate(center.east(2), Blocks.AIR.defaultBlockState());
+						if (lane == 1)
+							level.setBlockAndUpdate(center.above(), Blocks.REDSTONE_BLOCK.defaultBlockState());
+						level.setBlockAndUpdate(center, clutch.setValue(powered, lane == 1));
+						level.setBlockAndUpdate(center.west(), motor.setValue(facing, east));
+						var left = (com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity) level.getBlockEntity(center.west());
+						left.generatedSpeed.setValue(32);
+					}
+					if (tick == 5) {
+						level.setBlockAndUpdate(center.east(), motor.setValue(facing, east.getOpposite()));
+						var right = (com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity) level.getBlockEntity(center.east());
+						right.generatedSpeed.setValue(lane == 0 ? -64 : 64);
+					}
+					if (tick == 8)
+						level.setBlockAndUpdate(center.above(), lane == 0 ? Blocks.REDSTONE_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState());
+				}
+				var state = level.getBlockState(center);
+				String power = state.hasProperty(powered) ? state.getValue(powered).toString() : "missing";
+				int items = level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class,
+					new net.minecraft.world.phys.AABB(center).inflate(2.0), item -> item.getItem().is(clutch.getBlock().asItem()))
+					.stream().mapToInt(item -> item.getItem().getCount()).sum();
+				boolean scheduled = level.getBlockTicks().hasScheduledTick(center, clutch.getBlock());
+				boolean leftPresent = level.getBlockState(center.west()).is(motor.getBlock());
+				boolean rightPresent = level.getBlockState(center.east()).is(motor.getBlock());
+				int motorDrops = level.getEntitiesOfClass(net.minecraft.world.entity.item.ItemEntity.class,
+					new net.minecraft.world.phys.AABB(center).inflate(3.0), item -> item.getItem().is(motor.getBlock().asItem()))
+					.stream().mapToInt(item -> item.getItem().getCount()).sum();
+				System.out.printf(java.util.Locale.ROOT, "CREATE_PENDING_GEARSHIFT,%s,%d,%d,%d,%s,%.0f,%.0f,%.0f,%d,%s,%s,%s,%d%n",
+					mode, lane, tick, level.getGameTime(), power, pendingSpeed(level, center.west()), pendingSpeed(level, center),
+					pendingSpeed(level, center.east()), items, scheduled, leftPresent, rightPresent, motorDrops);
+			}
+			if (tick < (mode.equals("write") ? 8 : 48)) helper.fail("Waiting for pending Clutch schedules");
+		});
+	}
+
+	private static float pendingSpeed(ServerLevel level, BlockPos pos) {
+		var entity = level.getBlockEntity(pos);
+		return entity instanceof com.simibubi.create.content.kinetics.base.KineticBlockEntity kinetic
+			? kinetic.getTheoreticalSpeed() : 0;
+	}
 }
