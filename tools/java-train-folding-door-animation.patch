+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 100)
+	public static void trainDoorAnimationOracle(CreateGameTestHelper helper) {
+		var animation = net.createmod.catnip.animation.LerpedFloat.linear().startWithValue(1);
+		for (int i = 0; i < 18; i++) {
+			boolean open = i >= 9;
+			boolean wasSettled = animation.settled();
+			animation.chase(open ? 1 : 0, .15f, net.createmod.catnip.animation.LerpedFloat.Chaser.LINEAR);
+			animation.tickChaser();
+			float value = animation.getValue();
+			float slide = value * value * 13 / 16f;
+			float normal = net.minecraft.util.Mth.clamp(value * 10, 0, 1) / 32f;
+			boolean closeCue = !wasSettled && animation.settled() && !open;
+			System.out.printf(java.util.Locale.ROOT, "CREATE_TRAIN_DOOR_ANIMATION,%d,%b,%.9f,%.9f,%.9f,%b%n", i, open, value, slide, normal, closeCue);
+			for (var facing : net.minecraft.core.Direction.Plane.HORIZONTAL) {
+				var normalDirection = facing.getNormal();
+				float radians = net.minecraft.util.Mth.DEG_TO_RAD
+					* net.createmod.catnip.math.AngleHelper.horizontalAngle(facing.getClockWise());
+				for (boolean flip : new boolean[] {false, true}) {
+					float f = flip ? -1 : 1;
+					for (boolean left : new boolean[] {true, false}) {
+						// Compose the same local transforms as SlidingDoorRenderer's
+						// folding path. No block atlas or GPU is needed.
+						var transform = new org.joml.Matrix4f()
+							.translate(0, -1 / 512f, 0)
+							.translate(normalDirection.getX() * normal, 0, normalDirection.getZ() * normal)
+							.translate(.5f, .5f, .5f).rotateY(radians).translate(-.5f, -.5f, -.5f);
+						if (flip)
+							transform.translate(0, 0, 1);
+						transform.rotateY(91 * f * value * value * net.minecraft.util.Mth.DEG_TO_RAD);
+						if (!left)
+							transform.translate(0, 0, f / 2).rotateY(-181 * f * value * value * net.minecraft.util.Mth.DEG_TO_RAD);
+						if (flip)
+							transform.translate(0, 0, -.5f);
+						var shift = transform.getTranslation(new org.joml.Vector3f());
+						var rotation = transform.getUnnormalizedRotation(new org.joml.Quaternionf());
+						System.out.printf(java.util.Locale.ROOT,
+							"CREATE_TRAIN_FOLDING_DOOR,%d,%s,%s,%s,%.9f,%s,%.9f,%.9f,%.9f,%.9f,%.9f%n",
+							i, facing.getName(), flip ? "right" : "left", left ? "lower" : "upper", value,
+							left ^ flip ? "left" : "right", shift.x, shift.y, shift.z, rotation.y, rotation.w);
+					}
+				}
+			}
+		}
+		try {
+			var animationField = com.simibubi.create.content.decoration.slidingDoor.SlidingDoorBlockEntity.class.getDeclaredField("animation");
+			animationField.setAccessible(true);
+			for (var door : java.util.List.of(com.simibubi.create.AllBlocks.ANDESITE_DOOR, com.simibubi.create.AllBlocks.COPPER_DOOR)) {
+				for (boolean open : new boolean[] {false, true}) {
+					var state = door.get().defaultBlockState().setValue(net.minecraft.world.level.block.DoorBlock.OPEN, open);
+					var blockEntity = new com.simibubi.create.content.decoration.slidingDoor.SlidingDoorBlockEntity(
+						com.simibubi.create.AllBlockEntityTypes.SLIDING_DOOR.get(), BlockPos.ZERO, state);
+					var fresh = (net.createmod.catnip.animation.LerpedFloat) animationField.get(blockEntity);
+					System.out.printf(java.util.Locale.ROOT, "CREATE_TRAIN_FOLDING_FRESH,%s,%b,%.9f%n",
+						net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(door.get()), open, fresh.getValue());
+				}
+			}
+		} catch (ReflectiveOperationException error) {
+			throw new AssertionError(error);
+		}
+		helper.succeed();
+	}
