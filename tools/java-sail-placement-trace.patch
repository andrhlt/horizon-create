+        var east = net.minecraft.core.Direction.EAST;
+        var north = net.minecraft.core.Direction.NORTH;
+        var up = net.minecraft.core.Direction.UP;
+        var down = net.minecraft.core.Direction.DOWN;
+        var white = com.simibubi.create.AllBlocks.SAIL;
+        var frame = com.simibubi.create.AllBlocks.SAIL_FRAME;
+        var red = com.simibubi.create.AllBlocks.DYED_SAILS.get(net.minecraft.world.item.DyeColor.RED);
+        for (int id = 0; id < 8; id++) {
+            var origin = helper.absolutePos(new BlockPos(2 + 4 * id, 16, 2));
+            for (var side : net.minecraft.core.Direction.values())
+                level.setBlockAndUpdate(origin.relative(side), Blocks.AIR.defaultBlockState());
+            var side = id == 6 ? north : id == 7 ? up : east;
+            var host = id == 4 ? red.getDefaultState() : id == 5 ? frame.getDefaultState() : white.getDefaultState();
+            level.setBlockAndUpdate(origin, host.setValue(facing, side));
+            if (id == 1) level.setBlockAndUpdate(origin.above(), Blocks.STONE.defaultBlockState());
+            if (id == 2) for (var direction : net.minecraft.core.Direction.values()) {
+                if (direction.getAxis() != side.getAxis())
+                    level.setBlockAndUpdate(origin.relative(direction), Blocks.STONE.defaultBlockState());
+            }
+            if (id == 5) level.setBlockAndUpdate(origin.above(), Blocks.WATER.defaultBlockState());
+            var out = side == north ? north : side == up ? up : east.getOpposite();
+            var stack = new ItemStack(id == 4 ? frame.asItem() : white.asItem(), 2);
+            player.setItemInHand(hand, stack);
+            var eye = origin.getCenter().relative(out, 2.5).add(0, -1.62, 0);
+            player.setPos(eye.x, eye.y, eye.z);
+            player.setYRot(out == north ? 0 : -90);
+            player.setYHeadRot(out == north ? 0 : -90);
+            player.setXRot(side == up ? 80 : 0);
+            player.setShiftKeyDown(id == 3);
+            var point = id == 6 ? net.minecraft.world.phys.Vec3.atLowerCornerWithOffset(origin, .82, .69, .375)
+                : id == 7 ? net.minecraft.world.phys.Vec3.atLowerCornerWithOffset(origin, .27, .625, .63)
+                : net.minecraft.world.phys.Vec3.atLowerCornerWithOffset(origin, .375, .82, .69);
+            var hit = new net.minecraft.world.phys.BlockHitResult(point, out, origin, false);
+            boolean consumed = false;
+            if (!player.isShiftKeyDown())
+                consumed = level.getBlockState(origin).useItemOn(stack, level, player, hand, hit).consumesAction();
+            if (!consumed)
+                stack.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+            var cells = new java.util.ArrayList<String>();
+            for (var direction : net.minecraft.core.Direction.values()) {
+                var state = level.getBlockState(origin.relative(direction));
+                if (state.hasProperty(facing) && state.getBlock() instanceof
+                    com.simibubi.create.content.contraptions.bearing.SailBlock)
+                    cells.add(direction.getName() + "="
+                        + net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(state.getBlock())
+                        + "[" + state.getValue(facing).getName() + "]");
+            }
+            System.out.printf("CREATE_SAIL_PLACEMENT %d;%d;%s%n", id, stack.getCount(), String.join("|", cells));
+        }
+        player.setShiftKeyDown(false);
+        helper.succeed();
+    }
