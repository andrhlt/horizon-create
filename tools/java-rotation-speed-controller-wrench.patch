+
+	@GameTest(template = "shearing", timeoutTicks = 15)
+	public static void rotationSpeedControllerWrench(CreateGameTestHelper helper) {
+		var controller = com.simibubi.create.AllBlocks.ROTATION_SPEED_CONTROLLER;
+		var motor = com.simibubi.create.AllBlocks.CREATIVE_MOTOR;
+		var shaft = com.simibubi.create.AllBlocks.SHAFT;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var horizontal = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_AXIS;
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var z = net.minecraft.core.Direction.Axis.Z;
+		var south = net.minecraft.core.Direction.SOUTH;
+		var pos = new BlockPos(12, 2, 2);
+		helper.setBlock(pos, controller.getDefaultState().setValue(horizontal, z));
+		var regulator = helper.getBlockEntity(AllBlockEntityTypes.ROTATION_SPEED_CONTROLLER.get(), pos);
+		regulator.targetSpeed.setValue(-73);
+		helper.setBlock(pos.north(), motor.getDefaultState().setValue(facing, south));
+		var source = helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), pos.north());
+		source.generatedSpeed.setValue(24);
+		helper.setBlock(pos.south(), shaft.getDefaultState().setValue(axis, z));
+		var output = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), pos.south());
+		var level = helper.getLevel();
+		var worldPos = helper.absolutePos(pos);
+		var player = net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+		player.setGameMode(net.minecraft.world.level.GameType.SURVIVAL);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var wrench = new ItemStack(com.simibubi.create.AllItems.WRENCH.get());
+		player.setItemInHand(hand, wrench);
+		int count = player.getInventory().countItem(controller.asItem());
+
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			var state = level.getBlockState(worldPos);
+			boolean present = controller.has(state);
+			var current = present ? helper.getBlockEntity(AllBlockEntityTypes.ROTATION_SPEED_CONTROLLER.get(), pos) : null;
+			System.out.printf(java.util.Locale.ROOT, "CREATE_CONTROLLER_WRENCH %d,%s,%d,%.4f,%.4f,%.4f,%d%n",
+				tick, present ? state.getValue(horizontal).getName() : "air",
+				present ? current.targetSpeed.getValue() : 0, present ? current.getSpeed() : 0.0,
+				source.getSpeed(), output.getSpeed(), player.getInventory().countItem(controller.asItem()) - count);
+			var face = switch ((int) tick) {
+				case 3 -> net.minecraft.core.Direction.UP;
+				case 5, 9 -> net.minecraft.core.Direction.WEST;
+				case 7 -> net.minecraft.core.Direction.DOWN;
+				default -> null;
+			};
+			if (face != null) {
+				player.setShiftKeyDown(tick == 9);
+				var hit = new net.minecraft.world.phys.BlockHitResult(worldPos.getCenter().relative(face, 0.5),
+					face, worldPos, false);
+				wrench.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+				player.setShiftKeyDown(false);
+			}
+			if (tick < 11)
+				helper.fail("Waiting for final speed controller Wrench sample");
+		});
+	}
 }
