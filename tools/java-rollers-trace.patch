+	private static void traceRoller(CreateGameTestHelper helper, String fixture) {
+		var origin = helper.absolutePos(new BlockPos(0, 1, 0));
+		var level = helper.getLevel();
+		var box = new net.minecraft.world.phys.AABB(origin).expandTowards(9, 9, 4);
+		var entities = level.getEntitiesOfClass(
+			com.simibubi.create.content.contraptions.AbstractContraptionEntity.class, box);
+		var motion = entities.stream().map(entity -> String.format(java.util.Locale.ROOT, "%.9f:%.9f:%.9f",
+			entity.getX() - origin.getX(), entity.getY() - origin.getY(), entity.getZ() - origin.getZ()))
+			.sorted().collect(java.util.stream.Collectors.joining("|"));
+		long cargo = 0;
+		if (!entities.isEmpty()) {
+			var items = entities.getFirst().getContraption().getStorage().getAllItems();
+			cargo = java.util.stream.IntStream.range(0, items.getSlots())
+				.map(slot -> items.getStackInSlot(slot).is(AllBlocks.ANDESITE_CASING.asItem())
+					? items.getStackInSlot(slot).getCount() : 0).sum();
+		} else {
+			for (int x = 0; x <= 8; x++)
+				for (int y = 2; y <= 5; y++)
+					for (int z = 1; z <= 3; z++) {
+						var at = origin.offset(x, y, z);
+						if (level.getBlockState(at).is(Blocks.BARREL))
+							cargo += helper.getItemContent(new BlockPos(x, y + 1, z))
+								.getLong(AllBlocks.ANDESITE_CASING.asItem());
+					}
+		}
+		var blocks = new java.util.ArrayList<String>();
+		for (int x = 1; x <= 4; x++)
+			for (int y = 1; y <= 4; y++)
+				for (int z = 1; z <= 3; z++) {
+					var block = level.getBlockState(origin.offset(x, y, z)).getBlock();
+					blocks.add(net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(block).toString());
+				}
+		System.out.printf("ROLLER_TRACE %s,%d,%d,%d:%d:%d,%s,%d,%s%n", fixture, helper.getTick(),
+			level.getGameTime() % 20, origin.getX(), origin.getY(), origin.getZ(), motion, cargo, String.join("|", blocks));
+	}
+
 }
