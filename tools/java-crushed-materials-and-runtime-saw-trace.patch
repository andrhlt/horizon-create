+	@GameTest(template = "threshold_switch_pulley", timeoutTicks = 40)
+	public static void crushedMaterials(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var items = net.minecraft.core.registries.BuiltInRegistries.ITEM;
+		var types = net.minecraft.core.registries.BuiltInRegistries.RECIPE_TYPE;
+		var recipes = level.getRecipeManager();
+		for (String metal : java.util.List.of("iron", "gold", "copper")) {
+			var id = net.minecraft.resources.ResourceLocation.fromNamespaceAndPath("create", "crushed_raw_" + metal);
+			var input = new net.minecraft.world.item.crafting.SingleRecipeInput(new ItemStack(items.get(id)));
+			for (var match : java.util.List.of(
+					recipes.getRecipeFor(net.minecraft.world.item.crafting.RecipeType.SMELTING, input, level).orElseThrow(),
+					recipes.getRecipeFor(net.minecraft.world.item.crafting.RecipeType.BLASTING, input, level).orElseThrow())) {
+				var recipe = match.value();
+				var product = recipe.assemble(input, level.registryAccess());
+				System.out.printf(java.util.Locale.ROOT, "CREATE_CRUSHED_HEATING %s,%s,%s,%d,%.2f,%s,%d%n",
+					id.getPath(), types.getKey(recipe.getType()), match.id(), recipe.getCookingTime(),
+					recipe.getExperience(), items.getKey(product.getItem()), product.getCount());
+			}
+		}
+		for (var spec : java.util.List.of("minecraft:copper_ingot;1;materials/copper_nugget",
+				"create:copper_nugget;3;materials/copper_ingot")) {
+			var fields = spec.split(";");
+			int side = Integer.parseInt(fields[1]);
+			var id = net.minecraft.resources.ResourceLocation.parse(fields[0]);
+			var stack = new ItemStack(items.get(id));
+			var input = net.minecraft.world.item.crafting.CraftingInput.of(side, side,
+				java.util.Collections.nCopies(side * side, stack));
+			var match = recipes.getRecipeFor(net.minecraft.world.item.crafting.RecipeType.CRAFTING, input, level).orElseThrow();
+			helper.assertTrue(match.id().toString().equals("create:crafting/" + fields[2]), "Unexpected copper recipe");
+			var product = match.value().assemble(input, level.registryAccess());
+			System.out.printf(java.util.Locale.ROOT, "CREATE_CRUSHED_CRAFT crafting/%s;%d;%d;%s;%s;%d;%n",
+				fields[2], side, side, String.join(",", java.util.Collections.nCopies(side * side, fields[0])),
+				items.getKey(product.getItem()), product.getCount());
+		}
+		helper.succeed();
+	}
