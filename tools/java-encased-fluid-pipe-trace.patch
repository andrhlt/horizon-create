+	private static void captureEncasedPipeState(CreateGameTestHelper helper, String name, String action, BlockPos pos,
+			net.minecraft.world.item.ItemStack held, String result) {
+		var level = helper.getLevel();
+		var state = level.getBlockState(pos);
+		var block = state.getBlock();
+		var id = net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(block);
+		var be = level.getBlockEntity(pos);
+		var type = be == null ? "-" : net.minecraft.core.registries.BuiltInRegistries.BLOCK_ENTITY_TYPE.getKey(be.getType());
+		var hit = new net.minecraft.world.phys.BlockHitResult(pos.getCenter(), net.minecraft.core.Direction.UP, pos, false);
+		var clone = block.getCloneItemStack(state, hit, level, pos, helper.makeMockPlayer(net.minecraft.world.level.GameType.CREATIVE));
+		var item = net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(clone.getItem());
+		System.out.printf(java.util.Locale.ROOT, "CREATE_ENCASED_PIPE_STATE %s,%s,%s,%s,%s,%s,%s,%d,%s%n",
+			name, action, id, encasedPipeFaces(state),
+			state.hasProperty(net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED)
+				? state.getValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED) : "-",
+			type, item, held.getCount(), result);
+	}
+
+	private static String encasedPipeFaces(net.minecraft.world.level.block.state.BlockState state) {
+		var properties = net.minecraft.world.level.block.PipeBlock.PROPERTY_BY_DIRECTION;
+		if (state.hasProperty(net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS)) {
+			var axis = state.getValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS);
+			return axis.getName();
+		}
+		return java.util.Arrays.stream(net.minecraft.core.Direction.values())
+			.map(face -> state.hasProperty(properties.get(face)) && state.getValue(properties.get(face)) ? "1" : "0")
+			.collect(java.util.stream.Collectors.joining());
+	}
+
+	private static String encasedPipeBoxes(net.minecraft.world.phys.shapes.VoxelShape shape) {
+		return shape.toAabbs().stream().map(box -> String.format(java.util.Locale.ROOT,
+			"%.4f:%.4f:%.4f:%.4f:%.4f:%.4f", box.minX, box.minY, box.minZ, box.maxX, box.maxY, box.maxZ))
+			.collect(java.util.stream.Collectors.joining("|"));
+	}
