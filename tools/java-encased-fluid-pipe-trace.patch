+						net.minecraft.core.Direction.Axis.Y)
+				: pipe.defaultBlockState();
+			if (i != 4)
+				for (int j = 0; j < dirs.length; j++)
+					base = base.setValue(net.minecraft.world.level.block.PipeBlock.PROPERTY_BY_DIRECTION.get(dirs[j]),
+						(masks[i] & 1 << j) != 0);
+			if (i == 3)
+				base = base.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED, true);
+			level.setBlock(pos, base, 18);
+			player.setPos(pos.getX() + .5, pos.getY(), pos.getZ() - 2);
+			var hit = new net.minecraft.world.phys.BlockHitResult(pos.getCenter(), net.minecraft.core.Direction.UP, pos, false);
+			var wrong = com.simibubi.create.AllBlocks.ANDESITE_CASING.asStack();
+			var rejected = base.useItemOn(wrong, level, player, hand, hit);
+			captureEncasedPipeState(helper, cases[i], "wrong_casing", pos, wrong, rejected.toString());
+			var casing = new net.minecraft.world.item.ItemStack(com.simibubi.create.AllBlocks.COPPER_CASING.get().asItem(), 5);
+			player.setItemInHand(hand, casing);
+			var result = base.useItemOn(casing, level, player, hand, hit);
+			helper.assertTrue(level.getBlockState(pos).is(variant), "Copper Casing did not encase " + cases[i]);
+			captureEncasedPipeState(helper, cases[i], "encase", pos, casing, result.toString());
+			if (i == 0) {
+				level.setBlockAndUpdate(pos.north(), pipe.getAxisState(net.minecraft.core.Direction.Axis.Z));
+				captureEncasedPipeState(helper, cases[i], "add_north_pipe", pos, casing, "-");
