+			System.out.printf(java.util.Locale.ROOT, "CREATE_ENCASED_PIPE_DEFAULT %s,%s,%s,%.4f,%.4f,%d,%b,%b,%s,%s,%b%n",
+			blockRegistry.getKey(variant), encasedPipeFaces(original), itemRegistry.getKey(variant.asItem()),
+			original.getDestroySpeed(level, anchor), variant.getExplosionResistance(), original.getMapColor(level, anchor).id,
+			original.isCollisionShapeFullBlock(level, anchor), original.getOcclusionShape(level, anchor).isEmpty(),
