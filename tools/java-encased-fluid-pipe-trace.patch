+			helper.assertTrue(level.getBlockState(pos).is(pipe), "Wrench did not remove casing " + cases[i]);
+			captureEncasedPipeState(helper, cases[i], "uncase", pos, wrencher, wrenchResult.toString());
+			level.setBlock(pos, base, 18);
+			base.useItemOn(casing, level, player, hand, hit);
