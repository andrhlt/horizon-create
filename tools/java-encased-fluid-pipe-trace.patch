+	private static void captureEncasedPipeTransfer(CreateGameTestHelper helper, BlockPos pipe, BlockPos pump, int tick, String phase) {
+		var level = helper.getLevel();
+		var state = level.getBlockState(pipe);
+		var entity = level.getBlockEntity(pipe);
+		var data = entity.saveWithoutMetadata(level.registryAccess());
+		var interfaces = java.util.Arrays.stream(net.minecraft.core.Direction.values()).map(face -> {
+			var nbt = data.getCompound(face.getName());
+			var pressure = nbt.getList("Pressure", net.minecraft.nbt.Tag.TAG_FLOAT);
+			var flow = nbt.getCompound("Flow");
+			var fluid = flow.getCompound("Fluid");
+			if (nbt.isEmpty())
+				return face.getName() + ":_";
+			return String.format(java.util.Locale.ROOT, "%s:%.4f:%.4f:%s:%s:%s",
+				face.getName(), pressure.getFloat(0), pressure.getFloat(1), fluid.getString("id"),
+				flow.contains("In") ? Boolean.toString(flow.getBoolean("In")) : "_",
+				flow.contains("Progress") ? "partial" : "complete");
+		}).collect(java.util.stream.Collectors.joining("|"));
+		var rpm = ((com.simibubi.create.content.kinetics.base.KineticBlockEntity) helper.getBlockEntity(pump)).getSpeed();
+		System.out.printf(java.util.Locale.ROOT, "CREATE_ENCASED_PIPE_TRANSFER %d,%s,%s,%s,%.4f,%d,%d,%d,%d,%s%n",
+			tick, phase, net.minecraft.core.registries.BuiltInRegistries.BLOCK.getKey(state.getBlock()),
+			encasedPipeFaces(state), rpm,
+			helper.getTankContents(new BlockPos(1, 2, 2)).getAmount(),
+			helper.getTankContents(new BlockPos(5, 2, 1)).getAmount(),
+			helper.getTankContents(new BlockPos(5, 2, 2)).getAmount(),
+			helper.getTankContents(new BlockPos(5, 2, 3)).getAmount(), interfaces);
+	}
