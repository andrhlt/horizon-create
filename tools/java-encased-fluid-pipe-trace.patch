+						net.minecraft.core.Direction.UP, pipe, false);
+					var tool = at == 24 ? com.simibubi.create.AllBlocks.COPPER_CASING.asStack() : com.simibubi.create.AllItems.WRENCH.asStack();
+					player.setPos(pipe.getX() + .5, pipe.getY(), pipe.getZ() - 2);
+					player.setItemInHand(hand, tool);
+					var result = at == 24
+						? level.getBlockState(pipe).useItemOn(tool, level, player, hand, hit).toString()
+						: tool.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit)).toString();
+					String kind = at == 24 ? "encase" : "uncase";
+					var expected = at == 24 ? com.simibubi.create.AllBlocks.ENCASED_FLUID_PIPE.get() : com.simibubi.create.AllBlocks.FLUID_PIPE.get();
+					helper.assertTrue(level.getBlockState(pipe).is(expected), "Live " + kind + " failed: " + result);
+					captureEncasedPipeTransfer(helper, pipe, pump, at, kind);
+				}
