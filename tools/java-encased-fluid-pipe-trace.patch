+			player.setShiftKeyDown(true);
+			var picked = wrencher.useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+			player.setShiftKeyDown(false);
+			int after = player.getInventory().countItem(pipe.asItem());
+			System.out.printf(java.util.Locale.ROOT, "CREATE_ENCASED_PIPE_PICKUP %s,%s,%s,%d,%d%n", cases[i], picked,
+				blockRegistry.getKey(level.getBlockState(pos).getBlock()), after - before, casing.getCount());
+		}
+		helper.succeed();
+	}
