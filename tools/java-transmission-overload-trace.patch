+	@GameTest(template = "shearing", timeoutTicks = 22)
+	public static void transmissionOverload(CreateGameTestHelper helper) {
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var horizontal = net.minecraft.world.level.block.state.properties.BlockStateProperties.HORIZONTAL_FACING;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var powered = net.minecraft.world.level.block.state.properties.BlockStateProperties.POWERED;
+		var east = net.minecraft.core.Direction.EAST;
+		var west = east.getOpposite();
+		var press = AllBlocks.MECHANICAL_PRESS.getDefaultState().setValue(horizontal, east);
+		var rigs = java.util.List.of(new BlockPos(8, 5, 8), new BlockPos(8, 5, 13));
+		for (int rig = 0; rig < rigs.size(); rig++) {
+			var gate = rigs.get(rig);
+			boolean clutch = rig == 0;
+			helper.setBlock(gate.above(), clutch ? Blocks.REDSTONE_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState());
+			helper.setBlock(gate, (clutch ? AllBlocks.CLUTCH.getDefaultState() : AllBlocks.GEARSHIFT.getDefaultState())
+				.setValue(axis, east.getAxis()).setValue(powered, clutch));
+			helper.setBlock(gate.east(), press);
+			helper.setBlock(gate.east(2), press);
+			helper.setBlock(gate.west(), AllBlocks.HAND_CRANK.getDefaultState().setValue(facing, west));
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int rig = 0; rig < rigs.size(); rig++) {
+				var gate = rigs.get(rig);
+				var level = helper.getLevel();
+				boolean clutch = rig == 0;
+				for (int phase = 0; phase < ((tick == 2 || tick == 4 || tick == 7) ? 2 : 1); phase++) {
+					if (phase == 1) {
+						if (tick == 2) {
+							var crank = (com.simibubi.create.content.kinetics.crank.HandCrankBlockEntity) level.getBlockEntity(helper.absolutePos(gate.west()));
+							crank.turn(false);
+						} else {
+							boolean on = tick == 4 ? !clutch : clutch;
+							helper.setBlock(gate.above(), on ? Blocks.REDSTONE_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState());
+						}
+					}
+					var drive = (com.simibubi.create.content.kinetics.base.KineticBlockEntity) level.getBlockEntity(helper.absolutePos(gate));
+					var output = (com.simibubi.create.content.kinetics.base.KineticBlockEntity) level.getBlockEntity(helper.absolutePos(gate.east()));
+					System.out.printf(java.util.Locale.ROOT, "CREATE_TRANSMISSION_OVERLOAD,%d,%d,%d,%s,%.0f,%.0f,%.0f,%.0f%n",
+						rig, tick, phase, helper.getBlockState(gate).getValue(powered),
+						drive.getTheoreticalSpeed(), drive.getSpeed(), output.getTheoreticalSpeed(), output.getSpeed());
+				}
+			}
+			if (tick < 13) helper.fail("Waiting for the throttled transmission networks to coast");
+		});
+	}
 }
