+package com.simibubi.create.infrastructure.gametest;
+
+import com.simibubi.create.content.kinetics.waterwheel.WaterWheelBlockEntity;
+import com.simibubi.create.foundation.blockEntity.SmartBlockEntity;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.block.LeverBlock;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.event.tick.ServerTickEvent;
+
+@EventBusSubscriber
+public class LargeWheelRestartProbe {
+    private static final BlockPos HUB = new BlockPos(7, 98, -10);
+    private static final BlockPos OPEN = new BlockPos(6, 103, -11);
+    private static final BlockPos LEFT = new BlockPos(8, 102, -11);
+    private static long start = -1;
+    private static long previous = -1;
+    private static boolean done;
+
+    @SubscribeEvent
+    public static void tick(ServerTickEvent.Post event) throws ReflectiveOperationException {
+        Integer warmup = Integer.getInteger("parity.largeWheel.restartWarmup");
+        if (warmup == null || done)
+            return;
+        var level = event.getServer().overworld();
+        if (!level.hasChunkAt(HUB) || !(level.getBlockEntity(HUB) instanceof WaterWheelBlockEntity wheel))
+            return;
+        var time = level.getGameTime();
+        if (time == previous)
+            return;
+        previous = time;
+        if (start < 0) {
+            var countdown = SmartBlockEntity.class.getDeclaredField("lazyTickCounter");
+            countdown.setAccessible(true);
+            int counter = countdown.getInt(wheel);
+            System.out.printf("JAVA_RESTART_WHEEL_BOOT %d;%d%n", time, counter);
+            if (counter > 60 - warmup)
+                return;
+            if (counter != 60 - warmup)
+                throw new IllegalStateException("Missed the expected startup phase");
+            flip(level, OPEN);
+            start = time;
+        }
+        long tick = time - start;
+        System.out.printf("JAVA_RESTART_WHEEL %d;%d%n", tick, wheel.flowScore);
+        if (tick == 40)
+            flip(level, LEFT);
+        if (tick == 61)
+            done = true;
+    }
+
+    private static void flip(ServerLevel level, BlockPos pos) {
+        var state = level.getBlockState(pos);
+        if (!(state.getBlock() instanceof LeverBlock lever))
+            throw new IllegalStateException("Missing original wheel lever at " + pos);
+        lever.pull(state, level, pos, null);
+    }
+}
