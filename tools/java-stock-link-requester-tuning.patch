+	@GameTest(template = "shearing", timeoutTicks = CreateGameTestHelper.TEN_SECONDS)
+	public static void stockLinkRequesterTune(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var link = helper.absolutePos(new BlockPos(3, 14, 2));
+		var target = link.east(4);
+		var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+		var hand = net.minecraft.world.InteractionHand.MAIN_HAND;
+		var side = net.minecraft.core.Direction.UP;
+		var frequency = new java.util.UUID(115, 80);
+		var block = com.simibubi.create.AllBlocks.REDSTONE_REQUESTER;
+		var useOn = (java.util.function.Function<BlockPos, net.minecraft.world.InteractionResult>) pos -> {
+			player.setPos(pos.getX() + .5, pos.getY(), pos.getZ() - 2.5);
+			var hit = new net.minecraft.world.phys.BlockHitResult(pos.getCenter().relative(side, .5), side, pos, false);
+			return player.getItemInHand(hand).useOn(new net.minecraft.world.item.context.UseOnContext(player, hand, hit));
+		};
+		helper.runAtTickTime(2, () -> {
+			var stone = net.minecraft.world.level.block.Blocks.STONE.defaultBlockState();
+			level.setBlockAndUpdate(link.below(), stone);
+			level.setBlockAndUpdate(target.below(), stone);
+			level.setBlockAndUpdate(link, com.simibubi.create.AllBlocks.STOCK_LINK.getDefaultState());
+			level.getBlockEntity(link, com.simibubi.create.AllBlockEntityTypes.PACKAGER_LINK.get()).orElseThrow().behaviour.freqId = frequency;
+			player.setItemInHand(hand, block.asStack());
+		});
+		helper.runAtTickTime(3, () -> {
+			var result = useOn.apply(link);
+			var held = player.getItemInHand(hand);
+			var linked = com.simibubi.create.content.logistics.packagerLink.LogisticallyLinkedBlockItem.networkFromStack(held);
+			var type = held.get(net.minecraft.core.component.DataComponents.BLOCK_ENTITY_DATA).copyTag().getString("id");
+			System.out.printf("CREATE_REQUESTER_TUNING %d,tune,%b,%d,%b,%b,%s%n", helper.getTick(),
+				result.consumesAction(), held.getCount(), held.hasFoil(), frequency.equals(linked), type);
+		});
+		helper.runAtTickTime(4, () -> {
+			var result = useOn.apply(target.below());
+			var entity = level.getBlockEntity(target, com.simibubi.create.AllBlockEntityTypes.REDSTONE_REQUESTER.get()).orElseThrow();
+			System.out.printf("CREATE_REQUESTER_TUNING %d,place,%b,%d,%b,%b,%s%n", helper.getTick(),
+				result.consumesAction(), player.getItemInHand(hand).getCount(), false, frequency.equals(entity.behaviour.freqId),
+				"create:redstone_requester");
+			helper.succeed();
+		});
+	}
