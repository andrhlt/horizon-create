+			var attachment = direction == net.minecraft.core.Direction.UP ? net.minecraft.world.level.block.state.properties.AttachFace.CEILING
+				: direction == net.minecraft.core.Direction.DOWN ? net.minecraft.world.level.block.state.properties.AttachFace.FLOOR
+				: net.minecraft.world.level.block.state.properties.AttachFace.WALL;
+			var horizontal = direction.getAxis().isVertical() ? net.minecraft.core.Direction.SOUTH : direction;
+			var local = new BlockPos(9 + 3 * i, 8, 4);
+			var absolute = helper.absolutePos(local);
+			helper.setBlock(local, stockpile.defaultBlockState().setValue(facing, horizontal).setValue(mount, attachment));
+			var filter = helper.getBlockEntity(AllBlockEntityTypes.THRESHOLD_SWITCH.get(), local).getBehaviour(type);
+			for (var click : directions) {
+				for (boolean center : new boolean[] {true, false}) {
+					filter.setFilter(ItemStack.EMPTY);
+					player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, new ItemStack(Items.STONE, 3));
+					boolean claimed = stockpileFilterClick(player, absolute, click, center);
+					if (center && claimed) {
+						var box = (com.simibubi.create.foundation.blockEntity.behaviour.ValueBoxTransform.Sided) filter.getSlotPositioning();
+						var offset = box.fromSide(click).getLocalOffset(world, absolute, world.getBlockState(absolute));
+						float yaw = net.createmod.catnip.math.AngleHelper.horizontalAngle(click) + 180;
+						float pitch = click == net.minecraft.core.Direction.UP ? 90 : click == net.minecraft.core.Direction.DOWN ? 270 : 0;
+						float roll = click == net.minecraft.core.Direction.UP
+							? -net.createmod.catnip.math.AngleHelper.horizontalAngle(horizontal) + 180 : 0;
+						System.out.printf("STOCKPILE_FILTER_TRANSFORM,%s,%s,%.6f,%.6f,%.6f,%.1f,%.1f,%.1f,%.5f%n",
+							direction.getName(), click.getName(), offset.x, offset.y, offset.z, yaw, pitch, roll, box.getScale());
+					}
+					System.out.printf("STOCKPILE_FILTER_POSE,%s,%s,%b,%b,%d,%d%n",
+						direction.getName(), click.getName(), center, claimed, filter.getFilter().getCount(), player.getMainHandItem().getCount());
+				}
+			}
+		}
+		var items = new BlockPos(12, 7, 9);
+		var fluids = new BlockPos(16, 7, 9);
+		helper.setBlock(items.south(), Blocks.BARREL);
+		var barrel = (net.minecraft.world.level.block.entity.BarrelBlockEntity) world.getBlockEntity(helper.absolutePos(items.south()));
+		barrel.setItem(0, new ItemStack(Items.STONE, 32));
+		barrel.setItem(1, new ItemStack(Items.OAK_PLANKS, 32));
+		helper.setBlock(fluids.south(), com.simibubi.create.AllBlocks.FLUID_TANK.get());
+		var tank = (com.simibubi.create.content.fluids.tank.FluidTankBlockEntity) world.getBlockEntity(helper.absolutePos(fluids.south()));
+		tank.getTankInventory().fill(new net.neoforged.neoforge.fluids.FluidStack(net.minecraft.world.level.material.Fluids.WATER, 2000),
+			net.neoforged.neoforge.fluids.capability.IFluidHandler.FluidAction.EXECUTE);
+		for (var local : new BlockPos[] {items, fluids}) {
+			helper.setBlock(local, stockpile.defaultBlockState().setValue(facing, net.minecraft.core.Direction.SOUTH));
+			var be = helper.getBlockEntity(AllBlockEntityTypes.THRESHOLD_SWITCH.get(), local);
+			be.offWhenBelow = local == items ? 16 : 500;
+			be.onWhenAbove = local == items ? 48 : 1500;
+		}
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int index = 0; index < 2; index++) {
+				var local = index == 0 ? items : fluids;
