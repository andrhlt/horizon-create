+				if (tick == 4 || tick == 8 || tick == 13 || tick == 17) {
+					ItemStack selected = tick == 13 ? ItemStack.EMPTY : index == 0
+						? new ItemStack(tick == 8 ? Items.IRON_INGOT : Items.STONE, 3)
+						: new ItemStack(tick == 8 ? Items.WATER_BUCKET : Items.LAVA_BUCKET);
