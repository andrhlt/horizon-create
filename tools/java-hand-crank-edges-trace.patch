+	@GameTest(template = "shearing", timeoutTicks = 46)
+	public static void handCrankGrip(CreateGameTestHelper helper) {
+		var crank = new BlockPos(2, 2, 2);
+		helper.setBlock(crank.north(), Blocks.STONE);
+		helper.setBlock(crank, AllBlocks.HAND_CRANK.getDefaultState().setValue(FACING, Direction.SOUTH));
+		var player = helper.makeMockPlayer(GameType.SURVIVAL);
+		var level = helper.getLevel();
+		var at = helper.absolutePos(crank);
+		var hit = new BlockHitResult(at.getCenter().relative(Direction.SOUTH, .5), Direction.SOUTH, at, false);
+		var source = helper.getBlockEntity(AllBlockEntityTypes.HAND_CRANK.get(), crank);
+		for (int index = 0; index < 3; index++) {
+			int sample = index;
+			int tick = 4 + 12 * index;
+			helper.runAtTickTime(tick, () -> {
+				var main = sample == 1 ? AllItems.EXTENDO_GRIP.asStack() : ItemStack.EMPTY;
+				var off = sample == 2 ? AllItems.EXTENDO_GRIP.asStack() : ItemStack.EMPTY;
+				player.setItemInHand(InteractionHand.MAIN_HAND, main);
+				player.setItemInHand(InteractionHand.OFF_HAND, off);
+				float before = player.getFoodData().getExhaustionLevel();
+				var result = level.getBlockState(at).useItemOn(main, level, player, InteractionHand.MAIN_HAND, hit);
+				helper.assertTrue(result.consumesAction(), "Crank did not consume the main-hand click");
+				System.out.printf(java.util.Locale.ROOT, "CREATE_HAND_CRANK_EDGE_GRIP %s,%d,%.1f,%.9f,%d,%d%n",
+					switch (sample) { case 1 -> "main"; case 2 -> "off"; default -> "empty"; },
+					source.inUse, source.getSpeed(), player.getFoodData().getExhaustionLevel() - before,
+					main.getDamageValue(), off.getDamageValue());
+				if (sample == 2)
+					helper.succeed();
+			});
+		}
+	}
