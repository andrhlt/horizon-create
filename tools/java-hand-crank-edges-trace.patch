+	@GameTest(template = "shearing", timeoutTicks = 12)
+	public static void handCrankShaftFaces(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var player = helper.makeMockPlayer(GameType.SURVIVAL);
+		var target = helper.absolutePos(new BlockPos(2, 4, 2));
+		var support = target.below();
+		level.setBlockAndUpdate(support, Blocks.STONE.defaultBlockState());
+		var hit = new BlockHitResult(support.getCenter().relative(Direction.UP, .5), Direction.UP, support, false);
+		var cased = AllBlocks.BRASS_ENCASED_COGWHEEL.getDefaultState().setValue(AXIS, Direction.Axis.X);
+		var gauge = AllBlocks.STRESSOMETER.getDefaultState().setValue(FACING, Direction.UP);
+		var names = List.of("encased_east_open", "encased_east_closed", "encased_west_open",
+			"encased_west_closed", "gauge_x", "gauge_z", "gauge_sneak", "axes_conflict");
+		var states = List.of(cased.setValue(BOTTOM_SHAFT, true), cased.setValue(TOP_SHAFT, true),
+			cased.setValue(TOP_SHAFT, true), cased.setValue(BOTTOM_SHAFT, true),
+			gauge.setValue(AXIS_ALONG_FIRST_COORDINATE, true), gauge.setValue(AXIS_ALONG_FIRST_COORDINATE, false),
+			gauge.setValue(AXIS_ALONG_FIRST_COORDINATE, true), cased.setValue(BOTTOM_SHAFT, true));
+		for (int i = 0; i < names.size(); i++) {
+			boolean west = i == 2 || i == 3;
+			level.setBlockAndUpdate(target, Blocks.AIR.defaultBlockState());
+			level.setBlockAndUpdate(target.relative(west ? Direction.EAST : Direction.WEST), Blocks.AIR.defaultBlockState());
+			level.setBlockAndUpdate(target.relative(west ? Direction.WEST : Direction.EAST), states.get(i));
+			level.setBlockAndUpdate(target.north(), i == 7
+				? AllBlocks.SHAFT.getDefaultState().setValue(AXIS, Direction.Axis.Z) : Blocks.AIR.defaultBlockState());
+			player.setShiftKeyDown(i == 6);
+			var stack = AllBlocks.HAND_CRANK.asStack();
+			player.setItemInHand(InteractionHand.MAIN_HAND, stack);
+			var context = new BlockPlaceContext(player, InteractionHand.MAIN_HAND, stack, hit);
+			var result = stack.useOn(context);
+			helper.assertTrue(result.consumesAction(), "Crank did not place in " + names.get(i));
+			var placed = level.getBlockState(target);
+			helper.assertTrue(AllBlocks.HAND_CRANK.has(placed), "Missing crank in " + names.get(i));
+			System.out.printf("CREATE_HAND_CRANK_EDGE_PLACEMENT %s,%s,%b%n",
+				names.get(i), placed.getValue(FACING), placed.getValue(WATERLOGGED));
+		}
+		helper.succeed();
+	}
