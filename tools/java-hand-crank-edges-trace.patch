+	private static void handCrankMotorMatrix(CreateGameTestHelper helper, String scenario,
+		Direction facing, int motorSpeed, int changeTick, int changedSpeed, boolean reverseFirst,
+		boolean repeatNormalAt9, boolean useWrench) {
+		var crank = new BlockPos(2, 2, 2);
+		var rear = crank.relative(facing.getOpposite());
+		var gaugePos = rear.relative(facing.getOpposite());
+		var motorPos = gaugePos.relative(facing.getOpposite());
+		var axis = facing.getAxis();
+		helper.setBlock(rear, AllBlocks.SHAFT.getDefaultState().setValue(AXIS, axis));
+		var gaugeFacing = axis == Direction.Axis.Y ? Direction.NORTH : Direction.UP;
+		boolean first = axis == Direction.Axis.X;
+		helper.setBlock(gaugePos, AllBlocks.STRESSOMETER.getDefaultState()
+			.setValue(FACING, gaugeFacing).setValue(AXIS_ALONG_FIRST_COORDINATE, first));
+		helper.setBlock(crank, AllBlocks.HAND_CRANK.getDefaultState().setValue(FACING, facing));
+		helper.setBlock(motorPos, AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(FACING, facing));
+		var motor = helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), motorPos);
+		motor.generatedSpeed.setValue(motorSpeed);
+		var player = helper.makeMockPlayer(GameType.SURVIVAL);
+		if (useWrench)
+			player.setItemInHand(InteractionHand.MAIN_HAND, AllItems.WRENCH.asStack());
+		var source = helper.getBlockEntity(AllBlockEntityTypes.HAND_CRANK.get(), crank);
+		var shaft = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), rear);
+		var gauge = helper.getBlockEntity(AllBlockEntityTypes.STRESSOMETER.get(), gaugePos);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			boolean mounted = AllBlocks.HAND_CRANK.has(helper.getBlockState(crank));
+			boolean motorMounted = AllBlocks.CREATIVE_MOTOR.has(helper.getBlockState(motorPos));
+			int drops = helper.getLevel().getEntitiesOfClass(ItemEntity.class,
+				new AABB(helper.absolutePos(crank)).inflate(2),
+				item -> item.getItem().is(AllBlocks.HAND_CRANK.asItem()))
+				.stream().mapToInt(item -> item.getItem().getCount()).sum();
+			int motorDrops = helper.getLevel().getEntitiesOfClass(ItemEntity.class,
+				new AABB(helper.absolutePos(motorPos)).inflate(2),
+				item -> item.getItem().is(AllBlocks.CREATIVE_MOTOR.asItem()))
+				.stream().mapToInt(item -> item.getItem().getCount()).sum();
+			System.out.printf(java.util.Locale.ROOT,
+				"CREATE_HAND_CRANK_MATRIX %s,%d,%d,%.1f,%b,%d,%b,%.1f,%.1f,%.1f,%.1f,%.1f,%b,%d,%b,%d%n",
+				scenario, tick, motor.generatedSpeed.getValue(), motor.getGeneratedSpeed(), mounted,
+				mounted ? source.inUse : 0, mounted && source.backwards, mounted ? source.getSpeed() : 0,
+				shaft.getSpeed(), shaft.getTheoreticalSpeed(), gauge.getNetworkCapacity(),
+				gauge.getNetworkStress(), shaft.isOverStressed(), drops, motorMounted, motorDrops);
+			if (changeTick == tick)
+				motor.generatedSpeed.setValue(changedSpeed);
+			if (tick == 4 || tick == 9 || tick == 16) {
+				boolean backwards = tick == 4 ? reverseFirst
+					: tick == 9 ? !repeatNormalAt9 && !reverseFirst : true;
+				player.setShiftKeyDown(backwards);
+				helper.useBlock(crank, player);
+			}
+			if (tick < 28)
+				helper.fail("Waiting for the matrix crank to stop");
+		});
+	}
