+	private static void handCrankMotorSpeed(CreateGameTestHelper helper, int motorSpeed) {
+		var crank = new BlockPos(2, 2, 2);
+		var rear = crank.north();
+		var motor = rear.north().north();
+		var gauge = rear.north();
+		helper.setBlock(rear, AllBlocks.SHAFT.getDefaultState().setValue(AXIS, Direction.Axis.Z));
+		helper.setBlock(gauge, AllBlocks.STRESSOMETER.getDefaultState()
+			.setValue(FACING, Direction.UP).setValue(AXIS_ALONG_FIRST_COORDINATE, false));
+		helper.setBlock(crank, AllBlocks.HAND_CRANK.getDefaultState().setValue(FACING, Direction.SOUTH));
+		helper.setBlock(motor, AllBlocks.CREATIVE_MOTOR.getDefaultState().setValue(FACING, Direction.SOUTH));
+		helper.getBlockEntity(AllBlockEntityTypes.MOTOR.get(), motor).generatedSpeed.setValue(motorSpeed);
+		var player = helper.makeMockPlayer(GameType.SURVIVAL);
+		var source = helper.getBlockEntity(AllBlockEntityTypes.HAND_CRANK.get(), crank);
+		var shaft = helper.getBlockEntity(AllBlockEntityTypes.BRACKETED_KINETIC.get(), rear);
+		var stressometer = helper.getBlockEntity(AllBlockEntityTypes.STRESSOMETER.get(), gauge);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			boolean mounted = AllBlocks.HAND_CRANK.has(helper.getBlockState(crank));
+			int drops = helper.getLevel().getEntitiesOfClass(ItemEntity.class,
+				new AABB(helper.absolutePos(crank)).inflate(2),
+				item -> item.getItem().is(AllBlocks.HAND_CRANK.asItem())).size();
+			System.out.printf(java.util.Locale.ROOT,
+				"CREATE_HAND_CRANK_EDGE_MOTOR %d,%d,%b,%d,%.1f,%.1f,%.1f,%d%n",
+				motorSpeed, tick, mounted, mounted ? source.inUse : 0, mounted ? source.getSpeed() : 0,
+				shaft.getSpeed(), stressometer.getNetworkCapacity(), drops);
+			if (tick == 4 || tick == 9 || tick == 16) {
+				player.setShiftKeyDown(tick == 16);
+				helper.useBlock(crank, player);
+			}
+			if (tick < 28)
+				helper.fail("Waiting for the crank to stop");
+		});
+	}
