+	@GameTest(template = "shearing", timeoutTicks = 8)
+	public static void handCrankAdvancement(CreateGameTestHelper helper) {
+		var crank = new BlockPos(2, 2, 2);
+		helper.setBlock(crank.north(), Blocks.STONE);
+		helper.setBlock(crank, AllBlocks.HAND_CRANK.getDefaultState().setValue(FACING, Direction.SOUTH));
