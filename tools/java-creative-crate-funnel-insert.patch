+	@GameTest(template = "shearing", timeoutTicks = 80)
+	public static void creativeCrateFunnelInsert(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var cratePos = helper.absolutePos(new BlockPos(2, 2, 2)).above(20);
+		var funnelPos = cratePos.east();
+		helper.runAtTickTime(4, () -> {
+			level.setBlock(cratePos, com.simibubi.create.AllBlocks.CREATIVE_CRATE.getDefaultState(), 3);
+			var crate = (com.simibubi.create.content.logistics.crate.CreativeCrateBlockEntity) level.getBlockEntity(cratePos);
+			var filter = crate.getBehaviour(com.simibubi.create.foundation.blockEntity.behaviour.filtering.FilteringBehaviour.TYPE);
+			filter.setFilter(new ItemStack(Items.IRON_INGOT, 7));
+			var state = com.simibubi.create.AllBlocks.ANDESITE_FUNNEL.getDefaultState()
+				.setValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING, net.minecraft.core.Direction.EAST)
+				.setValue(com.simibubi.create.content.logistics.funnel.FunnelBlock.EXTRACTING, false);
+			level.setBlock(funnelPos, state, 3);
+		});
+		helper.runAtTickTime(6, () -> {
+			var crate = (com.simibubi.create.content.logistics.crate.CreativeCrateBlockEntity) level.getBlockEntity(cratePos);
+			var filter = crate.getBehaviour(com.simibubi.create.foundation.blockEntity.behaviour.filtering.FilteringBehaviour.TYPE);
+			var player = helper.makeMockPlayer(net.minecraft.world.level.GameType.SURVIVAL);
+			var state = level.getBlockState(funnelPos);
+			var hit = new net.minecraft.world.phys.BlockHitResult(net.minecraft.world.phys.Vec3.atCenterOf(funnelPos), net.minecraft.core.Direction.EAST, funnelPos, false);
+			for (int i = 1; i <= 2; i++) {
+				player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND, new ItemStack(Items.GOLD_INGOT, 5));
+				var result = state.useItemOn(player.getMainHandItem(), level, player, net.minecraft.world.InteractionHand.MAIN_HAND, hit);
+				var supply = level.getCapability(net.neoforged.neoforge.capabilities.Capabilities.ItemHandler.BLOCK, cratePos, net.minecraft.core.Direction.EAST).extractItem(0, 3, false);
+				System.out.printf("CREATE_CRATE_FUNNEL,%d,%s,%d,%s,%d,%s,%d%n", i, result, player.getMainHandItem().getCount(), net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(filter.getFilter().getItem()), filter.getFilter().getCount(), net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(supply.getItem()), supply.getCount());
+				if (result != net.minecraft.world.ItemInteractionResult.SUCCESS || !player.getMainHandItem().isEmpty() || !filter.getFilter().is(Items.IRON_INGOT) || supply.getCount() != 3)
+					throw new IllegalStateException("Unexpected Crate Funnel insertion");
+			}
+			helper.succeed();
+		});
+	}
+
