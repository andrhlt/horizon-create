+	@GameTest(template = "shearing", timeoutTicks = 20)
+	public static void transmissionColdReopen(CreateGameTestHelper helper) {
+		var mode = System.getenv("CREATE_TRANSMISSION_REOPEN");
+		var level = helper.getLevel();
+		var facing = net.minecraft.world.level.block.state.properties.BlockStateProperties.FACING;
+		var axis = net.minecraft.world.level.block.state.properties.BlockStateProperties.AXIS;
+		var powered = net.minecraft.world.level.block.state.properties.BlockStateProperties.POWERED;
+		var east = net.minecraft.core.Direction.EAST;
+		var motor = AllBlocks.CREATIVE_MOTOR.getDefaultState();
+		var shaft = AllBlocks.SHAFT.getDefaultState().setValue(axis, east.getAxis());
+		var gates = java.util.List.of(AllBlocks.CLUTCH.getDefaultState(), AllBlocks.GEARSHIFT.getDefaultState());
+		var rigs = java.util.List.of(new BlockPos(98, 101, 98), new BlockPos(98, 101, 102),
+			new BlockPos(98, 101, 106), new BlockPos(98, 101, 110),
+			new BlockPos(103, 101, 98), new BlockPos(103, 101, 102));
+		level.setChunkForced(6, 6, true);
+		helper.succeedWhen(() -> {
+			long tick = helper.getTick();
+			for (int rig = 0; rig < rigs.size(); rig++) {
+				var pos = rigs.get(rig);
+				if (mode.equals("write") && tick == 0) {
+					boolean driven = rig < 4;
+					boolean on = driven && rig % 2 == 1;
+					level.setBlockAndUpdate(pos.above(), on ? Blocks.REDSTONE_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState());
+					level.setBlockAndUpdate(pos, gates.get(driven ? rig / 2 : rig - 4).setValue(axis, east.getAxis()).setValue(powered, on));
+					level.setBlockAndUpdate(pos.east(), shaft);
+					level.setBlockAndUpdate(pos.west(), driven ? motor.setValue(facing, east) : Blocks.AIR.defaultBlockState());
+					if (level.getBlockEntity(pos.west()) instanceof com.simibubi.create.content.kinetics.motor.CreativeMotorBlockEntity drive)
+						drive.generatedSpeed.setValue(32);
+				}
+				var block = level.getBlockState(pos);
+				var gate = level.getBlockEntity(pos);
+				String voltage = block.hasProperty(powered) ? block.getValue(powered).toString() : "missing";
+				String source = "-";
+				if (gate instanceof com.simibubi.create.content.kinetics.base.DirectionalShaftHalvesBlockEntity drive && drive.hasSource())
+					source = drive.getSourceFacing().getSerializedName();
+				System.out.printf(java.util.Locale.ROOT, "CREATE_TRANSMISSION_REOPEN,%s,%d,%d,%d,%s,%s,%.0f,%.0f,%s%n",
+					mode, rig, tick, level.getGameTime(), block.getBlock().builtInRegistryHolder().key().location(),
+					voltage, reopenSpeed(level, pos), reopenSpeed(level, pos.east()), source);
+			}
+			if (tick < 7) helper.fail("Waiting for the reopened transmission rigs");
+		});
+	}
+
+	private static float reopenSpeed(ServerLevel level, BlockPos pos) {
+		var entity = level.getBlockEntity(pos);
+		return entity instanceof com.simibubi.create.content.kinetics.base.KineticBlockEntity kinetic
+			? kinetic.getTheoreticalSpeed() : 0;
+	}
 }
