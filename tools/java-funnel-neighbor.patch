diff --git a/src/main/java/com/simibubi/create/infrastructure/gametest/tests/TestProcessing.java b/src/main/java/com/simibubi/create/infrastructure/gametest/tests/TestProcessing.java
--- a/src/main/java/com/simibubi/create/infrastructure/gametest/tests/TestProcessing.java
