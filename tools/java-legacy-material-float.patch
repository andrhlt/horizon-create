+	@GameTest(template = "shearing", timeoutTicks = 40)
+	public static void legacyMaterialFloat(CreateGameTestHelper helper) {
+		var level = helper.getLevel();
+		var types = new net.minecraft.world.item.Item[] {com.simibubi.create.AllItems.SHADOW_STEEL.get(),
+			com.simibubi.create.AllItems.REFINED_RADIANCE.get(), net.minecraft.world.item.Items.IRON_INGOT};
+		var start = helper.absolutePos(new BlockPos(1, 12, 1));
+		var drops = new net.minecraft.world.entity.item.ItemEntity[types.length];
+		double y = start.getY() + .5;
+		for (int i = 0; i < types.length; i++) {
+			var drop = new net.minecraft.world.entity.item.ItemEntity(level, start.getX() + .5 + i * 2, y,
+				start.getZ() + .5, new net.minecraft.world.item.ItemStack(types[i]), 0, 0, 0);
+			drop.setPickUpDelay(32767);
+			level.addFreshEntity(drop);
+			drops[i] = drop;
+		}
+		for (int tick = 0; tick <= 8; tick++) {
+			helper.runAtTickTime(tick, () -> {
+				for (var drop : drops) {
+					var id = net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(drop.getItem().getItem());
+					System.out.printf(java.util.Locale.ROOT, "CREATE_LEGACY_FLOAT,%d,%s,%.11f,%.11f,%s%n",
+						drop.tickCount, id, drop.getY() - y, drop.getDeltaMovement().y, drop.isNoGravity());
+				}
+			});
+		}
+		helper.succeedWhen(() -> {
+			helper.assertTrue(drops[0].tickCount > 8, "wait for 8 samples");
+			helper.assertTrue(drops[0].isNoGravity() && drops[1].isNoGravity(), "both magical materials float");
+			helper.assertTrue(drops[2].getY() < y, "iron control falls");
+		});
+	}
+
 }
