+    fn schedule_copy_source<'a>(stacks: &[&'a ItemStack]) -> Option<&'a ItemStack> {
+        if stacks.len() < 2 {
+            return None;
+        }
+        let mut source = None;
+        for &stack in stacks {
+            if stack.item.as_ref() != "create:schedule" {
+                return None;
+            }
+            if stack.data().is_some_and(|data| data.other("create:train_schedule").is_some())
+                && source.replace(stack).is_some()
+            {
+                return None;
+            }
+        }
+        source
     }
