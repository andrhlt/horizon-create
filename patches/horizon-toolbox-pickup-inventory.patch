+// Other live players' main inventories during an admitted block attack.
+// The hub is borrowed by packet dispatch while the acting player's state is
+// swapped in. Move the inventories here for the duration of the attack so a
+// native block can synchronously update them before creating its drop.
+struct AttackInventory {
+    player: horizon_client::mod_api::NativeServerPlayer,
+    items: Vec<Option<ItemStack>>,
+    changed: bool,
+}
+
+thread_local! {
+    static ATTACK_INVENTORIES: std::cell::RefCell<Vec<AttackInventory>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+impl Game<'_> {
+    pub(super) fn native_attack_players(&self) -> Vec<horizon_client::mod_api::NativeServerPlayer> {
+        ATTACK_INVENTORIES
+            .with_borrow(|entries| entries.iter().map(|entry| entry.player.clone()).collect())
+    }
+
+    pub(super) fn native_attack_stack(&self, player: u128, slot: usize) -> Option<ItemStack> {
+        ATTACK_INVENTORIES.with_borrow(|entries| {
+            entries
+                .iter()
+                .find(|entry| entry.player.uuid == player)?
+                .items
+                .get(slot)?
+                .clone()
+        })
+    }
+
+    pub(super) fn native_attack_set_stack(
+        &mut self,
+        player: u128,
+        slot: usize,
+        expected: Option<&ItemStack>,
+        new: Option<ItemStack>,
+    ) -> bool {
+        ATTACK_INVENTORIES.with_borrow_mut(|entries| {
+            let Some(entry) = entries.iter_mut().find(|entry| entry.player.uuid == player) else {
+                return false;
+            };
+            let Some(current) = entry.items.get_mut(slot) else {
+                return false;
+            };
+            if current.as_ref() != expected {
+                return false;
+            }
+            *current = new;
+            entry.changed = true;
+            true
+        })
+    }
+}
