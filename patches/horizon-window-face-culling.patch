+
+/// Face culling for connected decorative glass and pane models.
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum FaceCulling {
+    ConnectedGlass,
+    CutoutWindow,
+    TranslucentWindow,
+    ConnectedPane,
+}
+
+impl FaceCulling {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::ConnectedGlass => "connected_glass",
+            Self::CutoutWindow => "cutout_window",
+            Self::TranslucentWindow => "translucent_window",
+            Self::ConnectedPane => "connected_pane",
+        }
+    }
 }
 
