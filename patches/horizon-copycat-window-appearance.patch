+    /// Publish a Copycat material change to the worker snapshot and remesh bordering sections.
+    pub fn set_copycat_panel_material(&mut self, pos: (i32, i32, i32), material: Option<BlockStateId>) {
+        let (x, y, z) = pos;
+        let Some(chunk) = self.chunks.get_mut(&(x >> 4, z >> 4)) else {
+            return;
+        };
+        let Some(sy) = chunk.section_index(y).map(|sy| sy as i32) else {
+            return;
+        };
+        let sections = chunk.sections.len() as i32;
+        if chunk.copycat_panels.as_ref().and_then(|panels| panels.get(&pos)).copied() == material {
+            return;
+        }
+        let panels = &mut Arc::make_mut(chunk).copycat_panels;
+        if let Some(material) = material {
+            Arc::make_mut(panels.get_or_insert_with(Default::default)).insert(pos, material);
+        } else if let Some(entries) = panels {
+            Arc::make_mut(entries).remove(&pos);
+            if entries.is_empty() {
+                *panels = None;
+            }
+        }
+        for cz in ((z - 1) >> 4)..=((z + 1) >> 4) {
+            for cx in ((x - 1) >> 4)..=((x + 1) >> 4) {
+                let first = (sy - i32::from(y & 15 == 0)).max(0);
+                let last = (sy + i32::from(y & 15 == 15)).min(sections - 1);
+                for section in first..=last {
+                    self.dirty_sections.insert((cx, section, cz));
+                }
+            }
+        }
+    }
