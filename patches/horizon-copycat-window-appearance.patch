+        return None;
+    }
+    let tag = copycat.nbt.get(&"Material".into())?;
+    // Create stores legacy block-state names even in a modern chunk.
+    let material = if let Some(name) = tag.get("Name") {
+        let mut state = Compound::from([("id".into(), name.clone())]);
+        if let Some(properties) = tag.get("Properties") {
+            state.insert("properties".into(), properties.clone());
+        }
+        registry.saved_state_id(&Tag::Compound(state))?
+    } else {
