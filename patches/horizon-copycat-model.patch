+impl StateModels {
+    /// Collects a Java 1.21.1 WeightedBakedModel for a displayed native block.
+    pub fn collect_seeded_with_legacy_weighted(
+        &self,
+        state: BlockStateId,
+        seed: i64,
+    ) -> Result<Vec<(&Variant, &BakedModel)>> {
+        let mut models = Vec::new();
+        self.each_seeded(state, seed, true, |(variant, model)| {
+            models.push((variant, model))
+        })?;
+        Ok(models)
+    }
+}
