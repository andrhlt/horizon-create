+/// Measured Create 1.21.1 cannon ammunition whose ordinary flight and
+/// living-entity impact are implemented by this bridge.
+#[derive(Clone, Copy)]
+pub struct CreateCannonAmmo {
+    pub velocity: f32,
+    pub reload: i32,
+    pub damage: f32,
+    pub knockback: f32,
+}
+
+pub fn create_cannon_ammo(item: &str) -> Option<CreateCannonAmmo> {
+    let (velocity, reload, damage, knockback) = match item {
+        "minecraft:potato" => (1.25, 15, 5.0, 1.5),
+        "minecraft:carrot" => (1.45, 12, 4.0, 0.3),
+        "minecraft:apple" => (1.45, 10, 5.0, 0.5),
+        "minecraft:beetroot" => (1.6, 5, 2.0, 0.1),
+        "minecraft:melon_slice" => (1.45, 8, 3.0, 0.1),
+        "minecraft:golden_carrot" => (1.45, 15, 12.0, 0.5),
+        _ => return None,
+    };
+    Some(CreateCannonAmmo {
+        velocity,
+        reload,
+        damage,
+        knockback,
+    })
 }
 
