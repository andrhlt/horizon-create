+fn copper_roof_path(name: &str) -> Option<&str> {
+    let path = name.strip_prefix("create:")?;
+    let unwaxed = path.strip_prefix("waxed_").unwrap_or(path);
+    let family = ["exposed_", "weathered_", "oxidized_"]
+        .iter()
+        .find_map(|prefix| unwaxed.strip_prefix(*prefix))
+        .unwrap_or(unwaxed);
+    matches!(
+        family,
+        "copper_shingles" | "copper_shingle_slab" | "copper_shingle_stairs" |
+        "copper_tiles" | "copper_tile_slab" | "copper_tile_stairs"
+    ).then_some(path)
+}
+
+fn copper_roof_state(registry: &BlockRegistry, old: &BlockState, path: &str) -> Option<BlockState> {
+    let target = registry.default_state(&format!("create:{path}"))?;
+    with_properties_of(registry, registry.state(target)?.clone(), old)
