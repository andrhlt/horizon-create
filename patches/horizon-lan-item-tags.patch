 impl SyncData {
+    /// Replace wire item tags with the resolved world table, including content
+    /// mods and data packs. Unregistered items cannot be represented on the wire.
+    pub fn set_world_item_tags(&mut self, tags: &HashMap<String, HashSet<String>>) {
+        let Some(registry) = self.builtin.get("minecraft:item") else {
+            return;
+        };
+        let mut entries: Vec<_> = tags
+            .iter()
+            .map(|(name, members)| {
+                let mut ids: Vec<_> = members
+                    .iter()
+                    .filter_map(|item| registry.id(item))
+                    .collect();
+                ids.sort_unstable();
+                TagEntry {
+                    name: name.clone(),
+                    ids,
+                }
+            })
+            .collect();
+        entries.sort_by(|a, b| a.name.cmp(&b.name));
+        self.tags
+            .registries
+            .retain(|r| r.registry != "minecraft:item");
+        self.tags.registries.push(RegistryTags {
+            registry: "minecraft:item".into(),
+            tags: entries,
+        });
+    }
+
