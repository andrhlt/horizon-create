+/// `Item.canFitInsideContainerItems`: shulker boxes and content items with the
+/// non-nesting tag cannot go into a bundle or shulker slot.
+pub fn fits_inside_container_items(items: &Items, stack: &ItemStack) -> bool {
+    !stack.item.ends_with("shulker_box")
+        && !items
+            .item_tags
+            .get("c:cannot_fit_inside_container_items")
+            .is_some_and(|group| group.contains(stack.item.as_ref()))
+}
+
+/// `BundleContents.canItemBeInBundle`.
+pub fn can_be_in_bundle(items: &Items, stack: &ItemStack) -> bool {
+    stack.count > 0 && fits_inside_container_items(items, stack)
