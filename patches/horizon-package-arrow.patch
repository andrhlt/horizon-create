+/// Finish the remainder of this tick's segment after an accepted piercing hit.
+/// A second entity hit suspends the tick again so the game can apply its damage.
+pub fn continue_piercing_hit(
+    p: &mut Projectile,
+    scene: &ArrowScene,
+    targets: &[(Who, Aabb)],
+) -> (bool, Hit) {
+    let Some(mut st) = p.arrow.take() else {
+        return (false, Hit::None);
+    };
+    let from = p.position;
+    let end = p.previous.add_vector(p.velocity);
+    let mut ticker = Ticker {
+        p,
+        st: &mut st,
+        scene,
+        client: false,
+    };
+    ticker.hit_sound();
+    let hit = ticker.step_move_and_hit(from, end, targets, true);
+    if !matches!(hit, Hit::Entity { .. }) {
+        ticker.finish();
+    }
+    p.stuck = st.in_ground;
+    let keep = !st.removed;
+    p.arrow = Some(st);
+    (keep, hit)
+}
