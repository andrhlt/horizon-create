+/// NeoForge DyeColor.getColor prefers vanilla DyeItems. The fallback's
+/// tag iteration stops before the last color (black).
+pub fn toolbox_dye_color(item: &str, mut tagged: impl FnMut(&str) -> bool) -> Option<&'static str> {
+    use crate::block_entity_render::DYES;
+
+    let material = item
+        .strip_prefix("minecraft:")
+        .and_then(|id| id.strip_suffix("_dye"));
+    if let Some((color, _)) = DYES.iter().find(|(color, _)| Some(*color) == material) {
+        return Some(*color);
     }
+    DYES.iter()
+        .take_while(|(color, _)| *color != "black")
+        .find_map(|(color, _)| tagged(color).then_some(*color))
 }
