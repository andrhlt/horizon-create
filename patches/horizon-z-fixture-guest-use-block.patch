+    /// Send one ordinary main-hand block use without the air-use fallback.
+    /// For opt-in fixture control only; the bool is client prediction, not server acceptance.
+    pub(super) fn fixture_use_block(&mut self) -> Result<(super::Hit, bool)> {
+        if self.remote.is_none() {
+            return Err("fixture-use-block requires a connected client".into());
+        }
+        if self.screen != Screen::Playing {
+            return Err("fixture-use-block requires the playing screen".into());
+        }
+        let hit = self.pick().ok_or("fixture-use-block requires a targeted block")?;
+        Ok((hit, self.remote_use_item_on(Hand::Main)))
+    }
