             "creative-inventory.json" => self.creative_tabs(doc)?,
             "block-behaviours.json" => {
                 states(doc, "states", false, false)?;
+                let Some(J::Arr(rows)) = doc.at("states") else {
+                    return Err("no block behaviour states".into());
+                };
