+                            horizon_world::fluid::FluidKind::Water
+                        } else {
+                            horizon_world::fluid::FluidKind::Empty
+                        };
+                        // Exported state rows keep fluid kind, amount, and falling after flags.
+                        row[2] = J::Num((fluid.index() as i64).into());
+                        row[3] = J::Num((if value == "true" { 8_i64 } else { 0 }).into());
+                        row[4] = J::Bool(false);
+                    }
