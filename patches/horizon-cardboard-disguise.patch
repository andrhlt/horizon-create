+    pub fn sync_cardboard_armor(&mut self, armor: &[Option<crate::items::ItemStack>; 4]) -> Result<()> {
+        let full_set = armor.iter().all(|slot| {
+            slot.as_ref().is_some_and(|stack| {
+                stack.count > 0 && matches!(
+                    stack.item.as_ref(),
+                    "create:cardboard_helmet" | "create:cardboard_chestplate" |
+                    "create:cardboard_leggings" | "create:cardboard_boots"
+                )
+            })
+        });
+        if self.has_cardboard_armor != full_set {
+            self.has_cardboard_armor = full_set;
+            self.refresh_dimensions()?;
+        }
+        Ok(())
+    }
+    pub fn cardboard_disguised(&self) -> bool {
+        self.pose == Pose::Crouching && self.can_disguise_as_cardboard()
+    }
+    fn can_disguise_as_cardboard(&self) -> bool {
+        self.has_cardboard_armor && !self.flying
+    }
+    fn body_dimensions(&self, pose: Pose, scale: f32) -> Dimensions {
+        if pose == Pose::Crouching && self.can_disguise_as_cardboard() {
+            return Dimensions {
+                width: 0.6 * scale,
+                height: 0.8 * scale,
+                eye_height: 0.6 * scale,
+            };
+        }
+        pose.dimensions(scale)
+    }
     pub fn dimensions_for_pose(&mut self, pose: Pose) -> Result<Dimensions> {
-        Ok(pose.dimensions(self.attribute("minecraft:scale")? as f32))
+        let scale = self.attribute("minecraft:scale")? as f32;
+        Ok(self.body_dimensions(pose, scale))
     }
     pub fn refresh_dimensions(&mut self) -> Result<()> {
         self.scale = self.attribute("minecraft:scale")? as f32;
-        self.dimensions = self.pose.dimensions(self.scale);
+        self.dimensions = self.body_dimensions(self.pose, self.scale);
         Ok(())
     }
