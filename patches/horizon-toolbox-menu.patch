+    /// The mod's own handling may route a visible click to an internal slot.
+    /// The slot keeps its visual role for every ordinary incoming click.
+    pub fn click_hidden_mod_slot(&mut self, env: &Env, slot: usize, button: i32) {
+        if !matches!(self.kind, Kind::Mod(_))
+            || self.slots.get(slot).is_none_or(|slot| slot.role != Role::Hidden)
+        {
+            return;
+        }
+        self.slots[slot].role = Role::Mod;
+        let _ = self.click(env, slot as i32, button, Input::Pickup);
+        self.slots[slot].role = Role::Hidden;
+    }
