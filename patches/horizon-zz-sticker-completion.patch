+//! Create 6.0.10 StickerBlock callbacks; no game or renderer dependencies.
+pub fn step(mut velocity: [f64;3], upright: bool, careful: bool) -> [f64;3] {
+    let dy=velocity[1].abs();
+    if upright && !careful && dy < 0.1 {
+        let scale=0.4+dy*0.2;
+        velocity[0]*=scale; velocity[2]*=scale;
+    }
+    velocity
+}
+pub fn bounce(mut velocity: [f64;3], upright: bool, living: bool, suppressed: bool) -> [f64;3] {
+    if !upright || suppressed { velocity[1]*=0.0; }
+    else if velocity[1]<0.0 { velocity[1] = -velocity[1] * if living {1.0} else {0.8}; }
+    velocity
+}
+pub fn fall_calls(upright: bool, suppressed: bool) -> usize { if !upright || suppressed {2} else {1} }
