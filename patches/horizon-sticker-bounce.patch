+#[test]
+fn upright_sticker_bounces_without_changing_other_states() {
+    let sticker = |facing: &str, extended: &str| Tag::compound([
+        ("id", Tag::String("create:sticker".into())),
+        ("properties", Tag::compound([
+            ("facing", Tag::String(facing.into())),
+            ("extended", Tag::String(extended.into())),
+        ])),
+    ]);
+    let states = Tag::List(vec![Tag::String("minecraft:stone".into()),
+        Tag::String("minecraft:slime_block".into()), sticker("up", "false"),
+        sticker("up", "true"), sticker("north", "false")]);
+    let registry = Tag::compound([
+        ("DataVersion", Tag::Int(DATA_VERSION)), ("states", states.clone()),
+        ("defaults", Tag::compound([
+            ("minecraft:stone", Tag::Int(0)), ("minecraft:slime_block", Tag::Int(1)),
+            ("create:sticker", Tag::Int(2)),
+        ])),
+    ]);
+    let definition = |bounce: f32| Tag::compound([
+        ("friction", Tag::Float(0.6f32.to_bits())),
+        ("speedFactor", Tag::Float(1f32.to_bits())),
+        ("jumpFactor", Tag::Float(1f32.to_bits())),
+        ("bounceRestitution", Tag::Float(bounce.to_bits())),
+        ("fallDistanceReduction", Tag::Float(0)), ("fenceGate", Tag::Byte(0)),
+    ]);
+    let movement = Tag::compound([
+        ("DataVersion", Tag::Int(DATA_VERSION)), ("states", states),
+        ("blocks", Tag::compound([
+            ("minecraft:stone", definition(0.0)), ("minecraft:slime_block", definition(1.0)),
+            ("create:sticker", {
+                let mut value = definition(0.0);
+                let Tag::Compound(ref mut fields) = value else { unreachable!() };
+                fields.insert("legacyBounceRestitution".into(), Tag::Float(1f32.to_bits()));
+                fields.insert("legacyBounceFacing".into(), Tag::String("up".into()));
+                value
+            }),
+        ])),
+    ]);
+    let registry = BlockRegistry::from_nbt(&registry).unwrap();
+    let blocks = MovementProperties::from_nbt(&movement, &registry).unwrap()
+        .bind(&MovementTags::default()).unwrap();
+    let bounce = |id| blocks.get(BlockStateId(id)).unwrap().coefficients.legacy_bounce_restitution;
+    assert_eq!((bounce(0), bounce(1), bounce(2), bounce(3), bounce(4)), (None, None, Some(1.0), Some(1.0), None));
+}
