+
+#[test]
+fn creative_search_honors_explicit_membership_per_mod() {
+    let tabs = [
+        CreativeTab {
+            id: "create:base".into(),
+            title: "Base".into(),
+            icon: "create:shown".into(),
+            items: vec!["create:shown".into()],
+            search_items: Some(vec!["create:shown".into(), "create:search_only".into()]),
+        },
+        CreativeTab {
+            id: "other:tab".into(),
+            title: "Other".into(),
+            icon: "other:item".into(),
+            items: vec![],
+            search_items: None,
+        },
+    ];
+    let item = |id: &str| NewItem {
+        rename: Rename::new("minecraft:stick", id),
+        max_stack_size: None,
+        rarity: None,
+        components: vec![],
+        crafting_remainder: None,
+        wall_block: None,
+        place_block: None,
+    };
+    let plan = Plan {
+        blocks: vec![],
+        items: [
+            "create:shown",
+            "create:search_only",
+            "create:hidden",
+            "other:item",
+        ]
+        .map(item)
+        .into(),
+        vanilla_items: BTreeSet::new(),
+        effects: vec![],
+        fluids: vec![],
+        entity_types: vec![],
+        menu_types: vec![],
+        states: 0,
+        defaults: BTreeMap::new(),
+        sounds: BTreeMap::new(),
+        tabs: tabs.iter().collect(),
+        names: BTreeMap::new(),
+    };
+    let mut doc: J =
+        serde_json::from_str(r#"{"tabs":[{"type":"SEARCH","items":[],"lines":[],"tags":[]}]}"#)
+            .unwrap();
+    plan.creative_tabs(&mut doc).unwrap();
+    let doc: serde_json::Value = serde_json::to_value(doc).unwrap();
+    assert_eq!(
+        doc["tabs"][0]["items"],
+        serde_json::json!([
+            "{count:1,id:\"create:shown\"}",
+            "{count:1,id:\"create:search_only\"}",
+            "{count:1,id:\"other:item\"}"
+        ])
+    );
+    assert_eq!(doc["tabs"][0]["lines"].as_array().unwrap().len(), 3);
+    assert_eq!(doc["tabs"][0]["tags"].as_array().unwrap().len(), 3);
+}
