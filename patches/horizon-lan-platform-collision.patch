+    /// The player's feet overlap the top of a native platform.
+    fn platform_support(&self, i: usize, at: [f64; 3]) -> bool {
+        let half = f64::from(self.guests[i].dimensions().width) / 2.0;
+        self.platform_collisions.iter().any(|bounds| {
+            let min = bounds.min_position();
+            let max = bounds.max_position();
+            (at[1] - max.y).abs() <= 1.0e-5
+                && at[0] + half > min.x
+                && at[0] - half < max.x
+                && at[2] + half > min.z
+                && at[2] - half < max.z
+        })
+    }
