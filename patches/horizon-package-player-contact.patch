+/// Player-origin pushes precede the Package's own travel and contact phase.
+fn package_player_contact(m: &mut Mob, w: &MobWorld, events: &mut Vec<MobEvent>) {
+    if m.kind.id != "create:package" || m.removed || m.rider.is_some() {
+        return;
+    }
+    let Some(player) = &w.player else { return };
+    let bounds = m.bounds();
+    if !player.alive
+        || player.spectator
+        || !player.bounds.intersects(bounds)
+        || !crate::scoreboard::pushable_by(w.teams.of(Who::Player), w.teams.of(Who::Mob(m.id)), true)
+    {
+        return;
+    }
+    events.push(MobEvent::ClearPackageTossedBy { target: m.id });
+    if player.bounds.min_position().y > bounds.min_position().y {
+        return;
+    }
+    let Some(impulse) = living_push_impulse(m.position, player.position) else { return };
+    m.velocity = Vec3::new(m.velocity.x + impulse.x, m.velocity.y, m.velocity.z + impulse.z);
+    if !player.remote {
+        events.push(MobEvent::Push {
+            target: Who::Player,
+            velocity: [-impulse.x, 0.0, -impulse.z],
+        });
+    }
+}
+
+fn living_push_impulse(pusher: Vec3, receiver: Vec3) -> Option<Vec3> {
+    let (mut x, mut z) = (pusher.x - receiver.x, pusher.z - receiver.z);
+    let distance = x.abs().max(z.abs());
+    if distance < f64::from(0.01_f32) {
+        return None;
+    }
+    let root = distance.sqrt();
+    let factor = (1.0 / root).min(1.0);
+    x /= root;
+    z /= root;
+    x *= factor;
+    z *= factor;
+    x *= f64::from(0.05_f32);
+    z *= f64::from(0.05_f32);
+    Some(Vec3::new(x, 0.0, z))
 }
